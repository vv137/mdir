[input]
topology      = "topol.top"
coordinates   = "solv.gro"
include_paths = ["@TOP@"]
defines       = ["FLEXIBLE"]

[output]
energy_interval = 0

[energy]
cutoff            = 9.0
pairlist_distance = 10.0
electrostatics    = "REACTION_FIELD"
reaction_field_dielectric = 78.5

[constraints]
hydrogen_bonds = false
rigid_water    = false

[dynamics]
integrator    = "VELOCITY_VERLET"
time_step     = 0.0005
steps         = 0

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[boundary]
type = "PERIODIC"
