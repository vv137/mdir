        %bx_r_t1 = arith.mulf %bx_r_wj, %bx_r_lo : !pme_real
        %bx_r_t2 = arith.mulf %bx_r_kjw, %bx_r_hi : !pme_real
        %bx_r_sum = arith.addf %bx_r_t1, %bx_r_t2 : !pme_real
