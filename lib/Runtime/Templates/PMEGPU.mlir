        %by_f_t1 = arith.mulf %by_f_wj, %by_f_lo : !pme_real
        %by_f_t2 = arith.mulf %by_f_kjw, %by_f_hi : !pme_real
        %by_f_sum = arith.addf %by_f_t1, %by_f_t2 : !pme_real
