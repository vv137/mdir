      %by_zero = arith.constant 0.0 : !pme_real
      %by_one = arith.constant 1.0 : !pme_real
      scf.for %by_j = %by_c0 to %by_c8 step %by_c1 {
        memref.store %by_zero, %wy[%by_j] : memref<8x!pme_real>
