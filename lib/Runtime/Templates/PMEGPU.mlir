      %by_r_omw = arith.subf %by_one, %py_w : !pme_real
      %by_r_d0 = arith.mulf %by_r_div, %by_r_omw : !pme_real
      %by_r_bottom = arith.mulf %by_r_d0, %by_r_first : !pme_real
      memref.store %by_r_bottom, %wy[%by_c0] : memref<8x!pme_real>
