      %by_v0 = memref.load %wy[%by_c0] : memref<8x!pme_real>
      %by_s0 = arith.negf %by_v0 : !pme_real
      memref.store %by_s0, %dy[%by_c0] : memref<8x!pme_real>
      scf.for %by_js = %by_c1 to %order step %by_c1 {
        %by_jm1 = arith.subi %by_js, %by_c1 : index
