    }
    gpu.barrier
    %d_first = arith.cmpi eq, %d_warp, %d_i0 : index
    scf.if %d_first {
      %d_in8 = arith.cmpi ult, %d_lane, %d_i8 : index
      %d_at = arith.select %d_in8, %d_lane, %d_i0 : index
      %d_w = memref.load %gs_wg[%d_at] : memref<9xi32, #gpu.address_space<workgroup>>
      %d_u0 = arith.select %d_in8, %d_w, %d_zero : i32
      %d_wo0 = arith.constant 1 : i32
      %d_wy0, %d_wv0 = gpu.shuffle up %d_u0, %d_wo0, %d_width : i32
      %d_wh0 = arith.cmpi sge, %d_lane32, %d_wo0 : i32
      %d_wa0 = arith.select %d_wh0, %d_wy0, %d_zero : i32
      %d_u1 = arith.addi %d_u0, %d_wa0 : i32
      %d_wo1 = arith.constant 2 : i32
      %d_wy1, %d_wv1 = gpu.shuffle up %d_u1, %d_wo1, %d_width : i32
      %d_wh1 = arith.cmpi sge, %d_lane32, %d_wo1 : i32
      %d_wa1 = arith.select %d_wh1, %d_wy1, %d_zero : i32
      %d_u2 = arith.addi %d_u1, %d_wa1 : i32
      %d_wo2 = arith.constant 4 : i32
      %d_wy2, %d_wv2 = gpu.shuffle up %d_u2, %d_wo2, %d_width : i32
      %d_wh2 = arith.cmpi sge, %d_lane32, %d_wo2 : i32
      %d_wa2 = arith.select %d_wh2, %d_wy2, %d_zero : i32
      %d_u3 = arith.addi %d_u2, %d_wa2 : i32
      %d_uex = arith.subi %d_u3, %d_u0 : i32
      %d_t7 = arith.cmpi eq, %d_lane, %d_i7 : index
      scf.if %d_in8 {
        memref.store %d_uex, %gs_wg[%d_lane] : memref<9xi32, #gpu.address_space<workgroup>>
      }
      scf.if %d_t7 {
        memref.store %d_u3, %gs_wg[%d_i8] : memref<9xi32, #gpu.address_space<workgroup>>
      }
    }
    gpu.barrier
    %d_woff = memref.load %gs_wg[%d_warp] : memref<9xi32, #gpu.address_space<workgroup>>
    %d_total = memref.load %gs_wg[%d_i8] : memref<9xi32, #gpu.address_space<workgroup>>
    %d_inwarp = arith.subi %d_x5, %mine : i32
    %d_before = arith.addi %d_inwarp, %d_woff : i32
    %offset = memref.load %gs_sums[%bx] : memref<?xi32, 1>
    %from = arith.addi %offset, %d_before : i32
    %end = scf.for %k = %i0 to %i4 step %i1 iter_args(%before = %from) -> (i32) {
      %c = arith.addi %first, %k : index
      %in = arith.cmpi ult, %c, %gcells : index
      %safe = arith.select %in, %c, %i0 : index
      %v0 = memref.load %gcount[%safe] : memref<?xi32, 1>
      %v = arith.select %in, %v0, %none : i32
      scf.if %in {
        memref.store %before, %gstart[%c] : memref<?xi32, 1>
      memref.store %before, %gcursor[%c] : memref<?xi32, 1>
      }
      %t = arith.addi %before, %v : i32
      scf.yield %t : i32
    }
    gpu.terminator
  }
  %gs_sums_plain = memref.memory_space_cast %gs_sums : memref<?xi32, 1> to memref<?xi32>
  gpu.dealloc %gs_sums_plain : memref<?xi32>
  gpu.launch blocks(%bx, %by, %bz) in (%gx = %grid_of_capacity, %gy = %c1, %gz = %c1)
             threads(%tx, %ty, %tz) in (%sx = %block, %sy = %c1, %sz = %c1) {
    %base = arith.muli %bx, %block : index
    %item = arith.addi %base, %tx : index
    %inside = arith.cmpi ult, %item, %capacity : index
    scf.if %inside {
      %zero = arith.constant 0 : i32
      %one = arith.constant 1 : i32
      %k = memref.load %gkey[%item] : memref<?xi32, 1>
      %real = arith.cmpi sge, %k, %zero : i32
      scf.if %real {
        %ki = arith.index_cast %k : i32 to index
        %gc_base = memref.extract_aligned_pointer_as_index %gcursor : memref<?xi32, 1> -> index
        %gc_bi = arith.index_cast %gc_base : index to i64
        %gc_ki = arith.index_cast %ki : index to i64
        %gc_four = arith.constant 4 : i64
        %gc_off = arith.muli %gc_ki, %gc_four : i64
        %gc_addr = arith.addi %gc_bi, %gc_off : i64
        %gc_ptr = llvm.inttoptr %gc_addr : i64 to !llvm.ptr<1>
        %slot32 = llvm.atomicrmw add %gc_ptr, %one syncscope("device") monotonic : !llvm.ptr<1>, i32
        %slot = arith.index_cast %slot32 : i32 to index
        %p32 = arith.index_cast %item : index to i32
        memref.store %p32, %gplace[%slot] : memref<?xi32, 1>
      }
    }
    gpu.terminator
  }
  gpu.launch blocks(%bx, %by, %bz) in (%gx = %grid_of_gcells, %gy = %c1, %gz = %c1)
             threads(%tx, %ty, %tz) in (%sx = %block, %sy = %c1, %sz = %c1) {
    %base = arith.muli %bx, %block : index
    %item = arith.addi %base, %tx : index
    %inside = arith.cmpi ult, %item, %gcells : index
    scf.if %inside {
      %i1 = arith.constant 1 : index
      %next = arith.addi %item, %i1 : index
      %begin32 = memref.load %gstart[%item] : memref<?xi32, 1>
      %end32 = memref.load %gstart[%next] : memref<?xi32, 1>
      %begin = arith.index_cast %begin32 : i32 to index
      %end = arith.index_cast %end32 : i32 to index
      %first = arith.addi %begin, %i1 : index
      scf.for %p = %first to %end step %i1 {
        %value = memref.load %gplace[%p] : memref<?xi32, 1>
        %hole = scf.while (%q = %p) : (index) -> index {
          %more = arith.cmpi ugt, %q, %begin : index
          %before = arith.subi %q, %i1 : index
          %safe = arith.select %more, %before, %begin : index
          %left = memref.load %gplace[%safe] : memref<?xi32, 1>
          %larger = arith.cmpi sgt, %left, %value : i32
          %go = arith.andi %more, %larger : i1
          scf.condition(%go) %q : index
        } do {
        ^bb0(%q: index):
          %before = arith.subi %q, %i1 : index
          %left = memref.load %gplace[%before] : memref<?xi32, 1>
          memref.store %left, %gplace[%q] : memref<?xi32, 1>
          scf.yield %before : index
        }
        memref.store %value, %gplace[%hole] : memref<?xi32, 1>
      }
    }
    gpu.terminator
  }
  //===--------------------------------------------------------------------===//
  // The boxes of the groups: a half-warp a group, relative to its first
  // particle in the minimum image
  //===--------------------------------------------------------------------===//

  %box_threads = arith.muli %group_capacity, %c16b : index
  %grid_of_boxes = func.call @mdrt_gpu_groups_grid(%box_threads, %block) : (index, index) -> index
  gpu.launch blocks(%bx, %by, %bz) in (%gx = %grid_of_boxes, %gy = %c1, %gz = %c1)
             threads(%tx, %ty, %tz) in (%sx = %block, %sy = %c1, %sz = %c1) {
    %base = arith.muli %bx, %block : index
    %item = arith.addi %base, %tx : index
    %c0w = arith.constant 0 : index
    %c1w = arith.constant 1 : index
    %c2w = arith.constant 2 : index
    %c16w = arith.constant 16 : index
    %zero = arith.constant 0 : i32
    %places32 = memref.load %sizes_device[%c0w] : memref<3xi32, 1>
    %places = arith.index_cast %places32 : i32 to index
    %groups = arith.divui %places, %c16w : index
    %g = arith.divui %item, %c16w : index
    %u = arith.remui %item, %c16w : index
    %inside = arith.cmpi ult, %g, %groups : index
    %gs = arith.select %inside, %g, %c0w : index
    %first = arith.muli %gs, %c16w : index
    %p = arith.addi %first, %u : index
    %pi = memref.load %order[%p] : memref<?xi32, 1>
    %real0 = arith.cmpi sge, %pi, %zero : i32
    %real = arith.andi %inside, %real0 : i1
    %ox = memref.load %xp[%first, %c0w] : memref<?x4xf32, 1>
    %oy = memref.load %xp[%first, %c1w] : memref<?x4xf32, 1>
    %oz = memref.load %xp[%first, %c2w] : memref<?x4xf32, 1>
    %vx = memref.load %xp[%p, %c0w] : memref<?x4xf32, 1>
    %vy = memref.load %xp[%p, %c1w] : memref<?x4xf32, 1>
    %vz = memref.load %xp[%p, %c2w] : memref<?x4xf32, 1>
    %dx = arith.subf %vx, %ox : f32
    %dy = arith.subf %vy, %oy : f32
    %dz = arith.subf %vz, %oz : f32
    %rx = func.call @mdrt_gpu_groups_image(%dx, %flx, %filx) : (f32, f32, f32) -> f32
    %ry = func.call @mdrt_gpu_groups_image(%dy, %fly, %fily) : (f32, f32, f32) -> f32
    %rz = func.call @mdrt_gpu_groups_image(%dz, %flz, %filz) : (f32, f32, f32) -> f32
    %big = arith.constant 1.0e30 : f32
    %small = arith.constant -1.0e30 : f32
    %ax0 = arith.select %real, %rx, %big : f32
    %ay0 = arith.select %real, %ry, %big : f32
    %az0 = arith.select %real, %rz, %big : f32
    %bx0 = arith.select %real, %rx, %small : f32
    %by0 = arith.select %real, %ry, %small : f32
    %bz0 = arith.select %real, %rz, %small : f32
    %ax_s0 = arith.constant 8 : i32
    %ax_w0 = arith.constant 32 : i32
    %ax_o0, %ax_ok0 = gpu.shuffle xor %ax0, %ax_s0, %ax_w0 : f32
    %ax1 = arith.minimumf %ax0, %ax_o0 : f32
    %ay_s0 = arith.constant 8 : i32
    %ay_w0 = arith.constant 32 : i32
    %ay_o0, %ay_ok0 = gpu.shuffle xor %ay0, %ay_s0, %ay_w0 : f32
    %ay1 = arith.minimumf %ay0, %ay_o0 : f32
    %az_s0 = arith.constant 8 : i32
    %az_w0 = arith.constant 32 : i32
    %az_o0, %az_ok0 = gpu.shuffle xor %az0, %az_s0, %az_w0 : f32
    %az1 = arith.minimumf %az0, %az_o0 : f32
    %bx_s0 = arith.constant 8 : i32
    %bx_w0 = arith.constant 32 : i32
    %bx_o0, %bx_ok0 = gpu.shuffle xor %bx0, %bx_s0, %bx_w0 : f32
    %bx1 = arith.maximumf %bx0, %bx_o0 : f32
    %by_s0 = arith.constant 8 : i32
    %by_w0 = arith.constant 32 : i32
    %by_o0, %by_ok0 = gpu.shuffle xor %by0, %by_s0, %by_w0 : f32
    %by1 = arith.maximumf %by0, %by_o0 : f32
    %bz_s0 = arith.constant 8 : i32
    %bz_w0 = arith.constant 32 : i32
    %bz_o0, %bz_ok0 = gpu.shuffle xor %bz0, %bz_s0, %bz_w0 : f32
    %bz1 = arith.maximumf %bz0, %bz_o0 : f32
    %ax_s1 = arith.constant 4 : i32
    %ax_w1 = arith.constant 32 : i32
    %ax_o1, %ax_ok1 = gpu.shuffle xor %ax1, %ax_s1, %ax_w1 : f32
    %ax2 = arith.minimumf %ax1, %ax_o1 : f32
    %ay_s1 = arith.constant 4 : i32
    %ay_w1 = arith.constant 32 : i32
    %ay_o1, %ay_ok1 = gpu.shuffle xor %ay1, %ay_s1, %ay_w1 : f32
    %ay2 = arith.minimumf %ay1, %ay_o1 : f32
    %az_s1 = arith.constant 4 : i32
    %az_w1 = arith.constant 32 : i32
    %az_o1, %az_ok1 = gpu.shuffle xor %az1, %az_s1, %az_w1 : f32
    %az2 = arith.minimumf %az1, %az_o1 : f32
    %bx_s1 = arith.constant 4 : i32
    %bx_w1 = arith.constant 32 : i32
    %bx_o1, %bx_ok1 = gpu.shuffle xor %bx1, %bx_s1, %bx_w1 : f32
    %bx2 = arith.maximumf %bx1, %bx_o1 : f32
    %by_s1 = arith.constant 4 : i32
    %by_w1 = arith.constant 32 : i32
    %by_o1, %by_ok1 = gpu.shuffle xor %by1, %by_s1, %by_w1 : f32
    %by2 = arith.maximumf %by1, %by_o1 : f32
    %bz_s1 = arith.constant 4 : i32
    %bz_w1 = arith.constant 32 : i32
    %bz_o1, %bz_ok1 = gpu.shuffle xor %bz1, %bz_s1, %bz_w1 : f32
    %bz2 = arith.maximumf %bz1, %bz_o1 : f32
    %ax_s2 = arith.constant 2 : i32
    %ax_w2 = arith.constant 32 : i32
    %ax_o2, %ax_ok2 = gpu.shuffle xor %ax2, %ax_s2, %ax_w2 : f32
    %ax3 = arith.minimumf %ax2, %ax_o2 : f32
    %ay_s2 = arith.constant 2 : i32
    %ay_w2 = arith.constant 32 : i32
    %ay_o2, %ay_ok2 = gpu.shuffle xor %ay2, %ay_s2, %ay_w2 : f32
    %ay3 = arith.minimumf %ay2, %ay_o2 : f32
    %az_s2 = arith.constant 2 : i32
    %az_w2 = arith.constant 32 : i32
    %az_o2, %az_ok2 = gpu.shuffle xor %az2, %az_s2, %az_w2 : f32
    %az3 = arith.minimumf %az2, %az_o2 : f32
    %bx_s2 = arith.constant 2 : i32
    %bx_w2 = arith.constant 32 : i32
    %bx_o2, %bx_ok2 = gpu.shuffle xor %bx2, %bx_s2, %bx_w2 : f32
    %bx3 = arith.maximumf %bx2, %bx_o2 : f32
    %by_s2 = arith.constant 2 : i32
    %by_w2 = arith.constant 32 : i32
    %by_o2, %by_ok2 = gpu.shuffle xor %by2, %by_s2, %by_w2 : f32
    %by3 = arith.maximumf %by2, %by_o2 : f32
    %bz_s2 = arith.constant 2 : i32
    %bz_w2 = arith.constant 32 : i32
    %bz_o2, %bz_ok2 = gpu.shuffle xor %bz2, %bz_s2, %bz_w2 : f32
    %bz3 = arith.maximumf %bz2, %bz_o2 : f32
    %ax_s3 = arith.constant 1 : i32
    %ax_w3 = arith.constant 32 : i32
    %ax_o3, %ax_ok3 = gpu.shuffle xor %ax3, %ax_s3, %ax_w3 : f32
    %ax4 = arith.minimumf %ax3, %ax_o3 : f32
    %ay_s3 = arith.constant 1 : i32
    %ay_w3 = arith.constant 32 : i32
    %ay_o3, %ay_ok3 = gpu.shuffle xor %ay3, %ay_s3, %ay_w3 : f32
    %ay4 = arith.minimumf %ay3, %ay_o3 : f32
    %az_s3 = arith.constant 1 : i32
    %az_w3 = arith.constant 32 : i32
    %az_o3, %az_ok3 = gpu.shuffle xor %az3, %az_s3, %az_w3 : f32
    %az4 = arith.minimumf %az3, %az_o3 : f32
    %bx_s3 = arith.constant 1 : i32
    %bx_w3 = arith.constant 32 : i32
    %bx_o3, %bx_ok3 = gpu.shuffle xor %bx3, %bx_s3, %bx_w3 : f32
    %bx4 = arith.maximumf %bx3, %bx_o3 : f32
    %by_s3 = arith.constant 1 : i32
    %by_w3 = arith.constant 32 : i32
    %by_o3, %by_ok3 = gpu.shuffle xor %by3, %by_s3, %by_w3 : f32
    %by4 = arith.maximumf %by3, %by_o3 : f32
    %bz_s3 = arith.constant 1 : i32
    %bz_w3 = arith.constant 32 : i32
    %bz_o3, %bz_ok3 = gpu.shuffle xor %bz3, %bz_s3, %bz_w3 : f32
    %bz4 = arith.maximumf %bz3, %bz_o3 : f32
    // The frame of a group: its first particle where it is wrapped, the others
    // at their places relative to it, as the loops over the groups take it. The
    // shift of the place to that frame, in cells, from its particle as it is
    // kept, unwrapped: ten bits for each axis, from -512. The cells between the
    // frame and the wrapped position, packed the same way, go in the fourth lane
    // of the wrapped position, which the lists read with it; they are -1 to 1,
    // so that the shifts of the entries stay small however far the particles
    // have gone.
    scf.if %real {
      %qp = arith.index_cast %pi : i32 to index
      %pxd = memref.load %x[%qp, %c0w] : memref<?x3xf64, 1>
      %pyd = memref.load %x[%qp, %c1w] : memref<?x3xf64, 1>
      %pzd = memref.load %x[%qp, %c2w] : memref<?x3xf64, 1>
      %pxf = arith.truncf %pxd : f64 to f32
      %pyf = arith.truncf %pyd : f64 to f32
      %pzf = arith.truncf %pzd : f64 to f32
      %tx0 = arith.addf %ox, %rx : f32
      %ty0 = arith.addf %oy, %ry : f32
      %tz0 = arith.addf %oz, %rz : f32
      %sx0 = arith.subf %tx0, %pxf : f32
      %sy0 = arith.subf %ty0, %pyf : f32
      %sz0 = arith.subf %tz0, %pzf : f32
      %sx1 = arith.mulf %sx0, %filx : f32
      %sy1 = arith.mulf %sy0, %fily : f32
      %sz1 = arith.mulf %sz0, %filz : f32
      %sx2 = math.roundeven %sx1 : f32
      %sy2 = math.roundeven %sy1 : f32
      %sz2 = math.roundeven %sz1 : f32
      %six = arith.fptosi %sx2 : f32 to i32
      %siy = arith.fptosi %sy2 : f32 to i32
      %siz = arith.fptosi %sz2 : f32 to i32
      %wx0 = arith.subf %tx0, %vx : f32
      %wy0 = arith.subf %ty0, %vy : f32
      %wz0 = arith.subf %tz0, %vz : f32
      %wx1 = arith.mulf %wx0, %filx : f32
      %wy1 = arith.mulf %wy0, %fily : f32
      %wz1 = arith.mulf %wz0, %filz : f32
      %wx2 = math.roundeven %wx1 : f32
      %wy2 = math.roundeven %wy1 : f32
      %wz2 = math.roundeven %wz1 : f32
      %wix = arith.fptosi %wx2 : f32 to i32
      %wiy = arith.fptosi %wy2 : f32 to i32
      %wiz = arith.fptosi %wz2 : f32 to i32
      %off = arith.constant 512 : i32
      %ten = arith.constant 10 : i32
      %twenty = arith.constant 20 : i32
      %six1 = arith.addi %six, %off : i32
      %siy1 = arith.addi %siy, %off : i32
      %siz1 = arith.addi %siz, %off : i32
      %siy2 = arith.shli %siy1, %ten : i32
      %siz2 = arith.shli %siz1, %twenty : i32
      %sxy = arith.ori %six1, %siy2 : i32
      %packed = arith.ori %sxy, %siz2 : i32
      memref.store %packed, %shift[%p] : memref<?xi32, 1>
      %wix1 = arith.addi %wix, %off : i32
      %wiy1 = arith.addi %wiy, %off : i32
      %wiz1 = arith.addi %wiz, %off : i32
      %wiy2 = arith.shli %wiy1, %ten : i32
      %wiz2 = arith.shli %wiz1, %twenty : i32
      %wxy = arith.ori %wix1, %wiy2 : i32
      %wpacked = arith.ori %wxy, %wiz2 : i32
      %wpacked_f = arith.bitcast %wpacked : i32 to f32
      %c3s = arith.constant 3 : index
      memref.store %wpacked_f, %xp[%p, %c3s] : memref<?x4xf32, 1>
    } else {
      %none_shift = arith.constant 537395712 : i32
      scf.if %inside {
        memref.store %none_shift, %shift[%p] : memref<?xi32, 1>
      }
    }
    %lead = arith.cmpi eq, %u, %c0w : index
    %store = arith.andi %lead, %inside : i1
    scf.if %store {
      %lo_x = arith.addf %ox, %ax4 : f32
      %lo_y = arith.addf %oy, %ay4 : f32
      %lo_z = arith.addf %oz, %az4 : f32
      %hi_x = arith.addf %ox, %bx4 : f32
      %hi_y = arith.addf %oy, %by4 : f32
      %hi_z = arith.addf %oz, %bz4 : f32
      %c3w = arith.constant 3 : index
      %c4w = arith.constant 4 : index
      %c5w = arith.constant 5 : index
      memref.store %lo_x, %boxes[%g, %c0w] : memref<?x8xf32, 1>
      memref.store %lo_y, %boxes[%g, %c1w] : memref<?x8xf32, 1>
      memref.store %lo_z, %boxes[%g, %c2w] : memref<?x8xf32, 1>
      memref.store %hi_x, %boxes[%g, %c3w] : memref<?x8xf32, 1>
      memref.store %hi_y, %boxes[%g, %c4w] : memref<?x8xf32, 1>
      memref.store %hi_z, %boxes[%g, %c5w] : memref<?x8xf32, 1>
    }
    gpu.terminator
  }
  //===--------------------------------------------------------------------===//
  // The lists: a warp a group, a lane a candidate
  //===--------------------------------------------------------------------===//

  %c32b = arith.constant 32 : index
  %list_threads = arith.muli %group_capacity, %c32b : index
  %grid_of_lists = func.call @mdrt_gpu_groups_grid(%list_threads, %block) : (index, index) -> index
  gpu.launch blocks(%bx, %by, %bz) in (%gx = %grid_of_lists, %gy = %c1, %gz = %c1)
             threads(%tx, %ty, %tz) in (%sx = %block, %sy = %c1, %sz = %c1)
             workgroup(%rel_wg : memref<64x4xf32, #gpu.address_space<workgroup>>, %partners : memref<1024xi32, #gpu.address_space<workgroup>>, %queue : memref<256xi32, #gpu.address_space<workgroup>>) {
    %base = arith.muli %bx, %block : index
    %item = arith.addi %base, %tx : index
    %c0w = arith.constant 0 : index
    %c1w = arith.constant 1 : index
    %c2w = arith.constant 2 : index
    %c3w = arith.constant 3 : index
    %c4w = arith.constant 4 : index
    %c16w = arith.constant 16 : index
    %c32w = arith.constant 32 : index
    %zero_i = arith.constant 0 : i32
    %one_i = arith.constant 1 : i32
    %c2i = arith.constant 2 : i32
    %c16i = arith.constant 16 : i32
    %c32i = arith.constant 32 : i32
    %all = arith.constant -1 : i32
    %g = arith.divui %item, %c32w : index
    %lane = arith.remui %tx, %c32w : index
    %lane32 = arith.index_cast %lane : index to i32
    %warp = arith.divui %tx, %c32w : index
    %places32 = memref.load %sizes_device[%c0w] : memref<3xi32, 1>
    %places = arith.index_cast %places32 : i32 to index
    %groups = arith.divui %places, %c16w : index
    %real_group = arith.cmpi ult, %g, %groups : index
    scf.if %real_group {
      %first = arith.muli %g, %c16w : index
      %first32 = arith.index_cast %first : index to i32
      // The particles of the group relative to the center of its box, in the
      // memory of the block: x, y, z, and 1 or 0 for a real one.
      %box_lo_x = memref.load %boxes[%g, %c0w] : memref<?x8xf32, 1>
      %box_lo_y = memref.load %boxes[%g, %c1w] : memref<?x8xf32, 1>
      %box_lo_z = memref.load %boxes[%g, %c2w] : memref<?x8xf32, 1>
      %box_hi_x = memref.load %boxes[%g, %c3w] : memref<?x8xf32, 1>
      %c4b = arith.constant 4 : index
      %c5b = arith.constant 5 : index
      %box_hi_y = memref.load %boxes[%g, %c4b] : memref<?x8xf32, 1>
      %box_hi_z = memref.load %boxes[%g, %c5b] : memref<?x8xf32, 1>
      %halff = arith.constant 0.5 : f32
      %sum_x = arith.addf %box_lo_x, %box_hi_x : f32
      %sum_y = arith.addf %box_lo_y, %box_hi_y : f32
      %sum_z = arith.addf %box_lo_z, %box_hi_z : f32
      %cx = arith.mulf %sum_x, %halff : f32
      %cy = arith.mulf %sum_y, %halff : f32
      %cz = arith.mulf %sum_z, %halff : f32
      %dif_x = arith.subf %box_hi_x, %box_lo_x : f32
      %dif_y = arith.subf %box_hi_y, %box_lo_y : f32
      %dif_z = arith.subf %box_hi_z, %box_lo_z : f32
      %hx = arith.mulf %dif_x, %halff : f32
      %hy = arith.mulf %dif_y, %halff : f32
      %hz = arith.mulf %dif_z, %halff : f32
      // The frame of the group less the wrapped positions, in cells, for its
      // first particle (whose place shift is zero).
      %wfirst_f = memref.load %xp[%first, %c3w] : memref<?x4xf32, 1>
      %wfirst = arith.bitcast %wfirst_f : f32 to i32
      %rel0 = arith.muli %warp, %c16w : index
      %mine_lane = arith.cmpi ult, %lane, %c16w : index
      scf.if %mine_lane {
        %p = arith.addi %first, %lane : index
        %pi = memref.load %order[%p] : memref<?xi32, 1>
        %real = arith.cmpi sge, %pi, %zero_i : i32
        %xi = memref.load %xp[%p, %c0w] : memref<?x4xf32, 1>
        %yi = memref.load %xp[%p, %c1w] : memref<?x4xf32, 1>
        %zi = memref.load %xp[%p, %c2w] : memref<?x4xf32, 1>
        %ex0 = arith.subf %xi, %cx : f32
        %ey0 = arith.subf %yi, %cy : f32
        %ez0 = arith.subf %zi, %cz : f32
        %rx = func.call @mdrt_gpu_groups_image(%ex0, %flx, %filx) : (f32, f32, f32) -> f32
        %ry = func.call @mdrt_gpu_groups_image(%ey0, %fly, %fily) : (f32, f32, f32) -> f32
        %rz = func.call @mdrt_gpu_groups_image(%ez0, %flz, %filz) : (f32, f32, f32) -> f32
        %one_ff = arith.constant 1.0 : f32
        %zero_ff = arith.constant 0.0 : f32
        %flag = arith.select %real, %one_ff, %zero_ff : f32
        %at = arith.addi %rel0, %lane : index
        memref.store %rx, %rel_wg[%at, %c0w] : memref<64x4xf32, #gpu.address_space<workgroup>>
        memref.store %ry, %rel_wg[%at, %c1w] : memref<64x4xf32, #gpu.address_space<workgroup>>
        memref.store %rz, %rel_wg[%at, %c2w] : memref<64x4xf32, #gpu.address_space<workgroup>>
        memref.store %flag, %rel_wg[%at, %c3w] : memref<64x4xf32, #gpu.address_space<workgroup>>
      }
      // The partners of the excluded pairs of the group: (place << 4) | u,
      // sorted, 256 at most; a group with more takes its excluded pairs from
      // their rows (D106).
      %c256 = arith.constant 256 : index
      %pbase = arith.muli %warp, %c256 : index
      %c64q = arith.constant 64 : index
      %qbase = arith.muli %warp, %c64q : index
      %largest_i = arith.constant 2147483647 : i32
      scf.for %s = %lane to %c256 step %c32w {
        %at = arith.addi %pbase, %s : index
        memref.store %largest_i, %partners[%at] : memref<1024xi32, #gpu.address_space<workgroup>>
      }
      nvvm.bar.warp.sync %all : i32
      // Each particle of the group in a lane of each half-warp: its partners
      // at even k from the first half, at odd k from the second, from where
      // the counts of the particles before it end (D105).
      %rows = memref.dim %excluded, %c0w : memref<?x?xi32, 1>
      %u16 = arith.remui %lane, %c16w : index
      %hk = arith.divui %lane, %c16w : index
      %u16_32 = arith.index_cast %u16 : index to i32
      %pe = arith.addi %first, %u16 : index
      %pie = memref.load %order[%pe] : memref<?xi32, 1>
      %piie = arith.index_cast %pie : i32 to index
      %reale = arith.cmpi sge, %pie, %zero_i : i32
      %in_rowse = arith.cmpi ult, %piie, %rows : index
      %hase = arith.andi %reale, %in_rowse : i1
      %counte = scf.if %hase -> (index) {
        %c32v = memref.load %excluded[%piie, %c0w] : memref<?x?xi32, 1>
        %cv = arith.index_cast %c32v : i32 to index
        scf.yield %cv : index
      } else {
        scf.yield %c0w : index
      }
      %count32e = arith.index_cast %counte : index to i32
      // Shuffles over the whole warp: the halves hold the same counts, so a
      // lane reads one of its own half (shuffles up by segments of 16 lost
      // excluded pairs).
      %wexcl = arith.constant 32 : i32
      %pre0 = arith.addi %count32e, %zero_i : i32
      %d1 = arith.constant 1 : i32
      %up1, %upv1 = gpu.shuffle up %pre0, %d1, %wexcl : i32
