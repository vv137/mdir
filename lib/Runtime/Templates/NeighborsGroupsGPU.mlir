    %c_i0 = arith.constant 0 : index
    %c_i7 = arith.constant 7 : index
    %c_i8 = arith.constant 8 : index
    %c_i31 = arith.constant 31 : index
    %c_i32x = arith.constant 32 : index
    %c_width = arith.constant 32 : i32
