      %bh1_11_0_k = arith.select %bh1_11_0_take, %bh1_11_0_pk, %bh1_10_0_k : f32
      %bh1_11_0_i = arith.select %bh1_11_0_take, %bh1_11_0_pi, %bh1_10_0_i : i32
      %bh1_12_0_s = arith.constant 8 : i32
      %bh1_12_0_w = arith.constant 32 : i32
      %bh1_12_0_pk, %bh1_12_0_vk = gpu.shuffle xor %bh1_11_0_k, %bh1_12_0_s, %bh1_12_0_w : f32
      %bh1_12_0_pi, %bh1_12_0_vi = gpu.shuffle xor %bh1_11_0_i, %bh1_12_0_s, %bh1_12_0_w : i32
      %bh1_12_0_off = arith.constant 0 : i32
      %bh1_12_0_pos = arith.addi %lane32, %bh1_12_0_off : i32
      %bh1_12_0_sz = arith.constant 32 : i32
      %bh1_12_0_zero = arith.constant 0 : i32
      %bh1_12_0_upb = arith.andi %bh1_12_0_pos, %bh1_12_0_sz : i32
      %bh1_12_0_up = arith.cmpi eq, %bh1_12_0_upb, %bh1_12_0_zero : i32
      %bh1_12_0_lob = arith.andi %bh1_12_0_pos, %bh1_12_0_s : i32
      %bh1_12_0_lower = arith.cmpi eq, %bh1_12_0_lob, %bh1_12_0_zero : i32
      %bh1_12_0_plt0 = arith.cmpf olt, %bh1_12_0_pk, %bh1_11_0_k : f32
      %bh1_12_0_peq = arith.cmpf oeq, %bh1_12_0_pk, %bh1_11_0_k : f32
      %bh1_12_0_pilt = arith.cmpi slt, %bh1_12_0_pi, %bh1_11_0_i : i32
      %bh1_12_0_pitie = arith.andi %bh1_12_0_peq, %bh1_12_0_pilt : i1
      %bh1_12_0_plt = arith.ori %bh1_12_0_plt0, %bh1_12_0_pitie : i1
      %bh1_12_0_pgt0 = arith.cmpf ogt, %bh1_12_0_pk, %bh1_11_0_k : f32
      %bh1_12_0_pigt = arith.cmpi sgt, %bh1_12_0_pi, %bh1_11_0_i : i32
      %bh1_12_0_pgtie = arith.andi %bh1_12_0_peq, %bh1_12_0_pigt : i1
      %bh1_12_0_pgt = arith.ori %bh1_12_0_pgt0, %bh1_12_0_pgtie : i1
      // The lower of a pair keeps the smaller when the run goes up.
      %bh1_12_0_min = arith.cmpi eq, %bh1_12_0_up, %bh1_12_0_lower : i1
      %bh1_12_0_take = arith.select %bh1_12_0_min, %bh1_12_0_plt, %bh1_12_0_pgt : i1
      %bh1_12_0_k = arith.select %bh1_12_0_take, %bh1_12_0_pk, %bh1_11_0_k : f32
      %bh1_12_0_i = arith.select %bh1_12_0_take, %bh1_12_0_pi, %bh1_11_0_i : i32
      %bh1_13_0_s = arith.constant 4 : i32
      %bh1_13_0_w = arith.constant 32 : i32
      %bh1_13_0_pk, %bh1_13_0_vk = gpu.shuffle xor %bh1_12_0_k, %bh1_13_0_s, %bh1_13_0_w : f32
      %bh1_13_0_pi, %bh1_13_0_vi = gpu.shuffle xor %bh1_12_0_i, %bh1_13_0_s, %bh1_13_0_w : i32
      %bh1_13_0_off = arith.constant 0 : i32
      %bh1_13_0_pos = arith.addi %lane32, %bh1_13_0_off : i32
      %bh1_13_0_sz = arith.constant 32 : i32
      %bh1_13_0_zero = arith.constant 0 : i32
      %bh1_13_0_upb = arith.andi %bh1_13_0_pos, %bh1_13_0_sz : i32
      %bh1_13_0_up = arith.cmpi eq, %bh1_13_0_upb, %bh1_13_0_zero : i32
      %bh1_13_0_lob = arith.andi %bh1_13_0_pos, %bh1_13_0_s : i32
      %bh1_13_0_lower = arith.cmpi eq, %bh1_13_0_lob, %bh1_13_0_zero : i32
      %bh1_13_0_plt0 = arith.cmpf olt, %bh1_13_0_pk, %bh1_12_0_k : f32
      %bh1_13_0_peq = arith.cmpf oeq, %bh1_13_0_pk, %bh1_12_0_k : f32
      %bh1_13_0_pilt = arith.cmpi slt, %bh1_13_0_pi, %bh1_12_0_i : i32
      %bh1_13_0_pitie = arith.andi %bh1_13_0_peq, %bh1_13_0_pilt : i1
      %bh1_13_0_plt = arith.ori %bh1_13_0_plt0, %bh1_13_0_pitie : i1
      %bh1_13_0_pgt0 = arith.cmpf ogt, %bh1_13_0_pk, %bh1_12_0_k : f32
      %bh1_13_0_pigt = arith.cmpi sgt, %bh1_13_0_pi, %bh1_12_0_i : i32
      %bh1_13_0_pgtie = arith.andi %bh1_13_0_peq, %bh1_13_0_pigt : i1
      %bh1_13_0_pgt = arith.ori %bh1_13_0_pgt0, %bh1_13_0_pgtie : i1
      // The lower of a pair keeps the smaller when the run goes up.
      %bh1_13_0_min = arith.cmpi eq, %bh1_13_0_up, %bh1_13_0_lower : i1
      %bh1_13_0_take = arith.select %bh1_13_0_min, %bh1_13_0_plt, %bh1_13_0_pgt : i1
      %bh1_13_0_k = arith.select %bh1_13_0_take, %bh1_13_0_pk, %bh1_12_0_k : f32
      %bh1_13_0_i = arith.select %bh1_13_0_take, %bh1_13_0_pi, %bh1_12_0_i : i32
      %bh1_14_0_s = arith.constant 2 : i32
      %bh1_14_0_w = arith.constant 32 : i32
      %bh1_14_0_pk, %bh1_14_0_vk = gpu.shuffle xor %bh1_13_0_k, %bh1_14_0_s, %bh1_14_0_w : f32
      %bh1_14_0_pi, %bh1_14_0_vi = gpu.shuffle xor %bh1_13_0_i, %bh1_14_0_s, %bh1_14_0_w : i32
      %bh1_14_0_off = arith.constant 0 : i32
      %bh1_14_0_pos = arith.addi %lane32, %bh1_14_0_off : i32
      %bh1_14_0_sz = arith.constant 32 : i32
      %bh1_14_0_zero = arith.constant 0 : i32
      %bh1_14_0_upb = arith.andi %bh1_14_0_pos, %bh1_14_0_sz : i32
      %bh1_14_0_up = arith.cmpi eq, %bh1_14_0_upb, %bh1_14_0_zero : i32
      %bh1_14_0_lob = arith.andi %bh1_14_0_pos, %bh1_14_0_s : i32
      %bh1_14_0_lower = arith.cmpi eq, %bh1_14_0_lob, %bh1_14_0_zero : i32
      %bh1_14_0_plt0 = arith.cmpf olt, %bh1_14_0_pk, %bh1_13_0_k : f32
      %bh1_14_0_peq = arith.cmpf oeq, %bh1_14_0_pk, %bh1_13_0_k : f32
      %bh1_14_0_pilt = arith.cmpi slt, %bh1_14_0_pi, %bh1_13_0_i : i32
      %bh1_14_0_pitie = arith.andi %bh1_14_0_peq, %bh1_14_0_pilt : i1
      %bh1_14_0_plt = arith.ori %bh1_14_0_plt0, %bh1_14_0_pitie : i1
      %bh1_14_0_pgt0 = arith.cmpf ogt, %bh1_14_0_pk, %bh1_13_0_k : f32
      %bh1_14_0_pigt = arith.cmpi sgt, %bh1_14_0_pi, %bh1_13_0_i : i32
      %bh1_14_0_pgtie = arith.andi %bh1_14_0_peq, %bh1_14_0_pigt : i1
      %bh1_14_0_pgt = arith.ori %bh1_14_0_pgt0, %bh1_14_0_pgtie : i1
      // The lower of a pair keeps the smaller when the run goes up.
      %bh1_14_0_min = arith.cmpi eq, %bh1_14_0_up, %bh1_14_0_lower : i1
      %bh1_14_0_take = arith.select %bh1_14_0_min, %bh1_14_0_plt, %bh1_14_0_pgt : i1
      %bh1_14_0_k = arith.select %bh1_14_0_take, %bh1_14_0_pk, %bh1_13_0_k : f32
      %bh1_14_0_i = arith.select %bh1_14_0_take, %bh1_14_0_pi, %bh1_13_0_i : i32
      %bh1_15_0_s = arith.constant 1 : i32
      %bh1_15_0_w = arith.constant 32 : i32
      %bh1_15_0_pk, %bh1_15_0_vk = gpu.shuffle xor %bh1_14_0_k, %bh1_15_0_s, %bh1_15_0_w : f32
      %bh1_15_0_pi, %bh1_15_0_vi = gpu.shuffle xor %bh1_14_0_i, %bh1_15_0_s, %bh1_15_0_w : i32
      %bh1_15_0_off = arith.constant 0 : i32
      %bh1_15_0_pos = arith.addi %lane32, %bh1_15_0_off : i32
      %bh1_15_0_sz = arith.constant 32 : i32
      %bh1_15_0_zero = arith.constant 0 : i32
      %bh1_15_0_upb = arith.andi %bh1_15_0_pos, %bh1_15_0_sz : i32
      %bh1_15_0_up = arith.cmpi eq, %bh1_15_0_upb, %bh1_15_0_zero : i32
      %bh1_15_0_lob = arith.andi %bh1_15_0_pos, %bh1_15_0_s : i32
      %bh1_15_0_lower = arith.cmpi eq, %bh1_15_0_lob, %bh1_15_0_zero : i32
      %bh1_15_0_plt0 = arith.cmpf olt, %bh1_15_0_pk, %bh1_14_0_k : f32
      %bh1_15_0_peq = arith.cmpf oeq, %bh1_15_0_pk, %bh1_14_0_k : f32
      %bh1_15_0_pilt = arith.cmpi slt, %bh1_15_0_pi, %bh1_14_0_i : i32
      %bh1_15_0_pitie = arith.andi %bh1_15_0_peq, %bh1_15_0_pilt : i1
      %bh1_15_0_plt = arith.ori %bh1_15_0_plt0, %bh1_15_0_pitie : i1
      %bh1_15_0_pgt0 = arith.cmpf ogt, %bh1_15_0_pk, %bh1_14_0_k : f32
      %bh1_15_0_pigt = arith.cmpi sgt, %bh1_15_0_pi, %bh1_14_0_i : i32
      %bh1_15_0_pgtie = arith.andi %bh1_15_0_peq, %bh1_15_0_pigt : i1
      %bh1_15_0_pgt = arith.ori %bh1_15_0_pgt0, %bh1_15_0_pgtie : i1
      // The lower of a pair keeps the smaller when the run goes up.
      %bh1_15_0_min = arith.cmpi eq, %bh1_15_0_up, %bh1_15_0_lower : i1
      %bh1_15_0_take = arith.select %bh1_15_0_min, %bh1_15_0_plt, %bh1_15_0_pgt : i1
      %bh1_15_0_k = arith.select %bh1_15_0_take, %bh1_15_0_pk, %bh1_14_0_k : f32
      %bh1_15_0_i = arith.select %bh1_15_0_take, %bh1_15_0_pi, %bh1_14_0_i : i32
      // Quarter 2 or 3: the first ceil(count / 2) by y, then the rest.
      %h1_c1 = arith.addi %h1_count, %one_i : i32
      %h1_q = arith.divsi %h1_c1, %c2i : i32
      %h1_second = arith.cmpi sge, %lane32, %h1_q : i32
      %h1_rank_b = arith.subi %lane32, %h1_q : i32
      %h1_rank = arith.select %h1_second, %h1_rank_b, %lane32 : i32
      %h1_quarter_b = arith.constant 3 : i32
      %h1_quarter_a = arith.constant 2 : i32
      %h1_quarter = arith.select %h1_second, %h1_quarter_b, %h1_quarter_a : i32
      %h1_q16 = arith.muli %h1_quarter, %c16i : i32
      %h1_in_chunk = arith.addi %h1_q16, %h1_rank : i32
      %h1_in_chunk_i = arith.index_cast %h1_in_chunk : i32 to index
      %h1_place = arith.addi %chunk_place0, %h1_in_chunk_i : index
      scf.if %h1_has {
        memref.store %bh1_15_0_i, %order[%h1_place] : memref<?xi32, 1>
        %ii = arith.index_cast %bh1_15_0_i : i32 to index
        %place32 = arith.index_cast %h1_place : index to i32
        memref.store %place32, %place_of[%ii] : memref<?xi32, 1>
      }
    }
    gpu.terminator
  }
  %key_plain = memref.memory_space_cast %key : memref<?xi32, 1> to memref<?xi32>
  gpu.dealloc %key_plain : memref<?xi32>
  %key_count_plain = memref.memory_space_cast %key_count : memref<?xi32, 1> to memref<?xi32>
  gpu.dealloc %key_count_plain : memref<?xi32>
  %key_start_plain = memref.memory_space_cast %key_start : memref<?xi32, 1> to memref<?xi32>
  gpu.dealloc %key_start_plain : memref<?xi32>
  %key_cursor_plain = memref.memory_space_cast %key_cursor : memref<?xi32, 1> to memref<?xi32>
  gpu.dealloc %key_cursor_plain : memref<?xi32>
  %sorted_plain = memref.memory_space_cast %sorted : memref<?xi32, 1> to memref<?xi32>
  gpu.dealloc %sorted_plain : memref<?xi32>
  %chunk_base_plain = memref.memory_space_cast %chunk_base : memref<?xi32, 1> to memref<?xi32>
  gpu.dealloc %chunk_base_plain : memref<?xi32>
  %column_chunks_plain = memref.memory_space_cast %column_chunks : memref<?xi32, 1> to memref<?xi32>
  gpu.dealloc %column_chunks_plain : memref<?xi32>

  //===--------------------------------------------------------------------===//
  // The positions of the places, and the grid of the candidates
  //===--------------------------------------------------------------------===//

  gpu.launch blocks(%bx, %by, %bz) in (%gx = %grid_of_gcells, %gy = %c1, %gz = %c1)
             threads(%tx, %ty, %tz) in (%sx = %block, %sy = %c1, %sz = %c1) {
    %base = arith.muli %bx, %block : index
    %item = arith.addi %base, %tx : index
    %inside = arith.cmpi ult, %item, %gcells : index
    scf.if %inside {
      %v = arith.constant 0 : i32
      memref.store %v, %gcount[%item] : memref<?xi32, 1>
    }
    gpu.terminator
  }
  gpu.launch blocks(%bx, %by, %bz) in (%gx = %grid_of_capacity, %gy = %c1, %gz = %c1)
             threads(%tx, %ty, %tz) in (%sx = %block, %sy = %c1, %sz = %c1) {
    %base = arith.muli %bx, %block : index
    %item = arith.addi %base, %tx : index
    %inside = arith.cmpi ult, %item, %capacity : index
    scf.if %inside {
      %i0 = arith.constant 0 : index
      %i1 = arith.constant 1 : index
      %i2 = arith.constant 2 : index
      %i3 = arith.constant 3 : index
      %zero = arith.constant 0 : i32
      %one = arith.constant 1 : i32
      %places32 = memref.load %sizes_device[%i0] : memref<3xi32, 1>
      %places = arith.index_cast %places32 : i32 to index
      %used = arith.cmpi ult, %item, %places : index
      %pi = memref.load %order[%item] : memref<?xi32, 1>
      %real0 = arith.cmpi sge, %pi, %zero : i32
      %real = arith.andi %used, %real0 : i1
      %none = arith.constant -1 : i32
      scf.if %real {
        %ii = arith.index_cast %pi : i32 to index
        %xw = memref.load %wrapped[%ii, %i0] : memref<?x3xf32, 1>
        %yw = memref.load %wrapped[%ii, %i1] : memref<?x3xf32, 1>
        %zw = memref.load %wrapped[%ii, %i2] : memref<?x3xf32, 1>
        memref.store %xw, %xp[%item, %i0] : memref<?x4xf32, 1>
        memref.store %yw, %xp[%item, %i1] : memref<?x4xf32, 1>
        memref.store %zw, %xp[%item, %i2] : memref<?x4xf32, 1>
        %gxf_ = arith.sitofp %gnx32 : i32 to f32
        %gyf_ = arith.sitofp %gny32 : i32 to f32
        %gzf_ = arith.sitofp %gnz32 : i32 to f32
        %ux_ = arith.mulf %xw, %filx : f32
        %uy_ = arith.mulf %yw, %fily : f32
        %uz_ = arith.mulf %zw, %filz : f32
        %tx_ = arith.mulf %ux_, %gxf_ : f32
        %ty_ = arith.mulf %uy_, %gyf_ : f32
        %tz_ = arith.mulf %uz_, %gzf_ : f32
        %kx0 = arith.fptosi %tx_ : f32 to i32
        %ky0 = arith.fptosi %ty_ : f32 to i32
        %kz0 = arith.fptosi %tz_ : f32 to i32
        %gx1 = arith.subi %gnx32, %one : i32
        %gy1 = arith.subi %gny32, %one : i32
        %gz1 = arith.subi %gnz32, %one : i32
        %kx1 = arith.minsi %kx0, %gx1 : i32
        %ky1 = arith.minsi %ky0, %gy1 : i32
        %kz1 = arith.minsi %kz0, %gz1 : i32
        %kx = arith.maxsi %kx1, %zero : i32
        %ky = arith.maxsi %ky1, %zero : i32
        %kz = arith.maxsi %kz1, %zero : i32
        %rz = arith.muli %kz, %gny32 : i32
        %rzy = arith.addi %rz, %ky : i32
        %r = arith.muli %rzy, %gnx32 : i32
        %k = arith.addi %r, %kx : i32
        memref.store %k, %gkey[%item] : memref<?xi32, 1>
        %ki = arith.index_cast %k : i32 to index
        %ga_base = memref.extract_aligned_pointer_as_index %gcount : memref<?xi32, 1> -> index
        %ga_bi = arith.index_cast %ga_base : index to i64
        %ga_ki = arith.index_cast %ki : index to i64
        %ga_four = arith.constant 4 : i64
        %ga_off = arith.muli %ga_ki, %ga_four : i64
        %ga_addr = arith.addi %ga_bi, %ga_off : i64
        %ga_ptr = llvm.inttoptr %ga_addr : i64 to !llvm.ptr<1>
        %ga_old = llvm.atomicrmw add %ga_ptr, %one syncscope("device") monotonic : !llvm.ptr<1>, i32
      } else {
        memref.store %none, %gkey[%item] : memref<?xi32, 1>
        %big = arith.constant 1.0e30 : f32
        memref.store %big, %xp[%item, %i0] : memref<?x4xf32, 1>
        memref.store %big, %xp[%item, %i1] : memref<?x4xf32, 1>
        memref.store %big, %xp[%item, %i2] : memref<?x4xf32, 1>
      }
    }
    gpu.terminator
  }
  %gs_per_block = arith.constant 1024 : index
  %gs_threads = arith.constant 256 : index
  %gs_blocks0 = func.call @mdrt_gpu_groups_grid(%gcells, %gs_per_block) : (index, index) -> index
  %gs_blocks = arith.maxui %gs_blocks0, %c1 : index
  %gs_sums = gpu.alloc (%gs_blocks) : memref<?xi32, 1>
  gpu.launch blocks(%bx, %by, %bz) in (%gx = %gs_blocks, %gy = %c1, %gz = %c1)
             threads(%tx, %ty, %tz) in (%sx = %gs_threads, %sy = %c1, %sz = %c1)
             workgroup(%gs_wg : memref<9xi32, #gpu.address_space<workgroup>>) {
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    %i4 = arith.constant 4 : index
    %none = arith.constant 0 : i32
    %per_block = arith.constant 1024 : index
    %block_base = arith.muli %bx, %per_block : index
    %thread_base = arith.muli %tx, %i4 : index
    %first = arith.addi %block_base, %thread_base : index
    %mine = scf.for %k = %i0 to %i4 step %i1 iter_args(%s = %none) -> (i32) {
      %c = arith.addi %first, %k : index
      %in = arith.cmpi ult, %c, %gcells : index
      %safe = arith.select %in, %c, %i0 : index
      %v0 = memref.load %gcount[%safe] : memref<?xi32, 1>
      %v = arith.select %in, %v0, %none : i32
      %t = arith.addi %s, %v : i32
      scf.yield %t : i32
    }
    %b_zero = arith.constant 0 : i32
    %b_i0 = arith.constant 0 : index
    %b_i7 = arith.constant 7 : index
    %b_i8 = arith.constant 8 : index
    %b_i31 = arith.constant 31 : index
    %b_i32x = arith.constant 32 : index
    %b_width = arith.constant 32 : i32
    %b_lane = arith.remui %tx, %b_i32x : index
    %b_warp = arith.divui %tx, %b_i32x : index
    %b_lane32 = arith.index_cast %b_lane : index to i32
    %b_x0 = arith.addi %mine, %b_zero : i32
    %b_o0 = arith.constant 1 : i32
    %b_y0, %b_v0 = gpu.shuffle up %b_x0, %b_o0, %b_width : i32
    %b_h0 = arith.cmpi sge, %b_lane32, %b_o0 : i32
    %b_a0 = arith.select %b_h0, %b_y0, %b_zero : i32
    %b_x1 = arith.addi %b_x0, %b_a0 : i32
    %b_o1 = arith.constant 2 : i32
    %b_y1, %b_v1 = gpu.shuffle up %b_x1, %b_o1, %b_width : i32
    %b_h1 = arith.cmpi sge, %b_lane32, %b_o1 : i32
    %b_a1 = arith.select %b_h1, %b_y1, %b_zero : i32
    %b_x2 = arith.addi %b_x1, %b_a1 : i32
    %b_o2 = arith.constant 4 : i32
    %b_y2, %b_v2 = gpu.shuffle up %b_x2, %b_o2, %b_width : i32
    %b_h2 = arith.cmpi sge, %b_lane32, %b_o2 : i32
    %b_a2 = arith.select %b_h2, %b_y2, %b_zero : i32
    %b_x3 = arith.addi %b_x2, %b_a2 : i32
    %b_o3 = arith.constant 8 : i32
    %b_y3, %b_v3 = gpu.shuffle up %b_x3, %b_o3, %b_width : i32
    %b_h3 = arith.cmpi sge, %b_lane32, %b_o3 : i32
