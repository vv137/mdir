# Influence "P3M" of PME (D304) under compute-sanitizer: the
# tables of the edges of eight threads a point with their shuffles
# (@mdrt_gpu_pme_tables_p3m), which read 18 rows of the table of the op and
# write five values a point into a scratch of 5 (k1 + k2 + k3) values, and
# the product with the energy and the virial (@mdrt_gpu_pme_convolve_p3m),
# which reads them, at every step of 5, on the three waters of
# pme-p3m.test (16 x 20 x 24 points), in double and mixed precision.
#
# REQUIRES: cuda, compute-sanitizer
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/../Driver/Inputs/opc/three.prmtop %S/../Driver/Inputs/opc/three.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %S/../Driver/pme-p3m.test | sed '1d;$d' \
# RUN:   | sed -e 's/^steps .*/steps = 5/' -e 's/^energy_interval .*/energy_interval = 1/' \
# RUN:         -e 's|^type = "PERIODIC"|type = "PERIODIC"\n[execution]\ntarget = "gpu"\nprecision = "double"|' > %t/double.toml
# RUN: sed 's/^precision = "double"/precision = "mixed"/' %t/double.toml > %t/mixed.toml
# RUN: cd %t && %compute_sanitizer --tool memcheck --error-exitcode 1 mdir run double.toml 2>&1 | FileCheck %s
# RUN: cd %t && %compute_sanitizer --tool initcheck --error-exitcode 1 mdir run double.toml 2>&1 | FileCheck %s
# RUN: cd %t && %compute_sanitizer --tool racecheck --error-exitcode 1 mdir run double.toml 2>&1 | FileCheck %s --check-prefix=RACE
# RUN: cd %t && %compute_sanitizer --tool synccheck --error-exitcode 1 mdir run double.toml 2>&1 | FileCheck %s
# RUN: cd %t && %compute_sanitizer --tool memcheck --error-exitcode 1 mdir run mixed.toml 2>&1 | FileCheck %s
# RUN: cd %t && %compute_sanitizer --tool initcheck --error-exitcode 1 mdir run mixed.toml 2>&1 | FileCheck %s

# CHECK: ERROR SUMMARY: 0 errors
# RACE: RACECHECK SUMMARY: 0 hazards displayed (0 errors, 0 warnings)
