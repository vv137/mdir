# The segmented SIMT schedule of md_alg.traverse_pairs and its pruning in
# the loop (D421) under compute-sanitizer, on the test
# route of the pair term over the segments of rigid kinds
# (MDIR_RIGID_UNITS_TEST): alanine dipeptide in OPC (the waters taken, the
# solute the rest, with anchors and excluded pairs), 10 / 9.5 Angstrom with
# PME, and the rhombic dodecahedron of TIP3P of test/Driver/triclinic.test,
# rigid, 7 / 6.6 Angstrom (its cell takes no more), over 20 steps each,
# which prune in the loop. Each warp
# writes its window of its row's inner records and reads it back after a
# barrier of the warp. The list of units prunes in the loop wherever its
# loop follows its refresh, as here, without a least number of groups.
#
# REQUIRES: cuda, compute-sanitizer
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/../Driver/Inputs/opc/opc.prmtop %S/../Driver/Inputs/opc/opc.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %S/../Driver/pme-settle.test | sed '1d;$d' \
# RUN:     | sed -e 's|energy_interval = 50|energy_interval = 10|' -e 's|^steps *= 100|steps = 20|' \
# RUN:           -e 's|^pairlist_distance = 10.0|pairlist_distance = 10.0\npruned_distance = 9.5|' \
# RUN:           -e 's|^type = "PERIODIC"|type = "PERIODIC"\n[execution]\ntarget = "gpu"\nprecision = "mixed"\nneighbor_structure = "GROUPS"|' > %t/opc.toml
# RUN: cp %S/../Driver/Inputs/triclinic/water.top %S/../Driver/Inputs/triclinic/dodecahedron.gro %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %S/../Driver/triclinic.test | sed '1d;$d' \
# RUN:   | sed -e 's/^steps .*/steps = 20/' -e 's/^energy_interval .*/energy_interval = 10/' \
# RUN:         -e 's/^target .*/target = "GPU"\nneighbor_structure = "GROUPS"/' -e 's/^precision .*/precision = "MIXED"/' \
# RUN:         -e '/^defines/d' -e 's/^cutoff .*/cutoff = 6.0/' -e 's/^pairlist_distance .*/pairlist_distance = 7.0\npruned_distance = 6.6/' \
# RUN:         -e 's/^hydrogen_bonds .*/hydrogen_bonds = true/' -e 's/^rigid_water .*/rigid_water = true/' > %t/triclinic.toml
# RUN: cd %t && env MDIR_RIGID_UNITS_TEST=1 %compute_sanitizer --tool memcheck --error-exitcode 1 mdir run opc.toml 2>&1 | FileCheck %s
# RUN: cd %t && env MDIR_RIGID_UNITS_TEST=1 %compute_sanitizer --tool racecheck --error-exitcode 1 mdir run opc.toml 2>&1 | FileCheck %s --check-prefix=RACE
# RUN: cd %t && env MDIR_RIGID_UNITS_TEST=1 %compute_sanitizer --tool initcheck --error-exitcode 1 mdir run opc.toml 2>&1 | FileCheck %s
# RUN: cd %t && env MDIR_RIGID_UNITS_TEST=1 %compute_sanitizer --tool memcheck --error-exitcode 1 mdir run triclinic.toml 2>&1 | FileCheck %s
# RUN: cd %t && env MDIR_RIGID_UNITS_TEST=1 %compute_sanitizer --tool racecheck --error-exitcode 1 mdir run triclinic.toml 2>&1 | FileCheck %s --check-prefix=RACE
# RUN: cd %t && env MDIR_RIGID_UNITS_TEST=1 %compute_sanitizer --tool initcheck --error-exitcode 1 mdir run triclinic.toml 2>&1 | FileCheck %s

# CHECK: md_alg.traverse_pairs{determinism=unordered strategy=segments rotate(16)
# CHECK: the inner lists were pruned {{[1-9][0-9]*}} times
# CHECK: ERROR SUMMARY: 0 errors
# RACE: RACECHECK SUMMARY: 0 hazards displayed (0 errors, 0 warnings)
