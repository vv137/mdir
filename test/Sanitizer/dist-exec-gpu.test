# The loops of the domains through md_exec on a device (D290,
# docs/distributed-ml2.md, Section 7.2) under compute-sanitizer: the
# loops over the centers of each domain, whose places in the order of the
# cells skip the ghost rows, and the policy (directed, atomic), whose
# additions at the center and at the neighbor are both atomic. Lennard-Jones
# on the grid 3x2x1 with the unique traversal (the kernel's value taken
# where the identity of the center is the lesser), and EAM in the
# derivative's form on the directed traversal (the kernel halved), as
# ../Integration/dist-lj-exec.mlir and ../Integration/dist-eam-exec.mlir
# run them, in double precision.
#
# REQUIRES: cuda, compute-sanitizer
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: sed 's/GRID/3, 2, 1/; s/TOLERANCE/1.0e-10/' %S/../Integration/dist-lj-exec.mlir \
# RUN: | mdir-opt --md-distribute="grid=3,2,1 traversal=unique potentials=lj" \
# RUN:     %md_passes --md-exec-assign-algebra --convert-md-dist-to-md-exec="functions=derived,energy,handwritten" \
# RUN:     --convert-md-dist-to-loops \
# RUN:     --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_transforms \
# RUN:     --md-exec-assign-algebra --md-exec-assign-storage=memory=device --convert-md-exec-to-gpu \
# RUN: | mlir-opt %lower_gpu_to_llvm > %t/lj.mlir
# RUN: sed 's/TOLERANCE/1.0e-10/' %S/../Integration/dist-eam-exec.mlir \
# RUN: | mdir-opt --md-distribute="grid=3,2,1 traversal=directed potentials=eam,linear" \
# RUN:     %md_passes --md-exec-assign-algebra --convert-md-dist-to-md-exec="functions=derived,energy,vjp" \
# RUN:     --convert-md-dist-to-loops \
# RUN:     --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_transforms \
# RUN:     --md-exec-assign-algebra --md-exec-assign-storage=memory=device --convert-md-exec-to-gpu \
# RUN: | mlir-opt %lower_gpu_to_llvm > %t/eam.mlir
# RUN: %compute_sanitizer --tool memcheck --error-exitcode 1 \
# RUN:     mlir-runner %t/lj.mlir -e main --entry-point-result=void \
# RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda 2>&1 | FileCheck %s
# RUN: %compute_sanitizer --tool initcheck --error-exitcode 1 \
# RUN:     mlir-runner %t/lj.mlir -e main --entry-point-result=void \
# RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda 2>&1 | FileCheck %s
# RUN: %compute_sanitizer --tool racecheck --error-exitcode 1 \
# RUN:     mlir-runner %t/lj.mlir -e main --entry-point-result=void \
