# The NPT run of #347 on examples/ala3 (velocity Verlet, V-RESCALE every 10
# steps, C-RESCALE, SETTLE and SHAKE, PME) on a GPU in mixed precision, for
# 20 steps under compute-sanitizer. The kernels of an integration run (D110)
# read the first tuple of every particle in the incidence structure that
# the device builds, and keep it only where the particle's count is not
# zero; the slots past the count were never written, and initcheck reported
# 4.7 million reads of them. The build now writes zeros there.
#
# REQUIRES: cuda, compute-sanitizer, hdf5
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/../../examples/ala3/ala3.prmtop %S/../../examples/ala3/ala3.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/run.toml
# RUN: cd %t && %compute_sanitizer --tool initcheck --error-exitcode 1 mdir run run.toml 2>&1 \
# RUN:   | FileCheck %s
# RUN: rm -f %t/out.h5 && cd %t && %compute_sanitizer --tool memcheck --error-exitcode 1 mdir run run.toml 2>&1 \
# RUN:   | FileCheck %s
# RUN: rm -f %t/out.h5 && cd %t && %compute_sanitizer --tool racecheck --error-exitcode 1 mdir run run.toml 2>&1 \
# RUN:   | FileCheck %s --check-prefix=RACE

# CHECK: ERROR SUMMARY: 0 errors
# RACE: RACECHECK SUMMARY: 0 hazards displayed (0 errors, 0 warnings)

#--- run.toml
[input]
topology    = "ala3.prmtop"
coordinates = "ala3.inpcrd"

[output]
checkpoint          = "out.h5"
energy_interval     = 10
checkpoint_interval = 10

[energy]
cutoff            = 9.0
pairlist_distance = 10.0
electrostatics    = "PME"
coulomb_modifier  = "POTENTIAL_SHIFT"

[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.002
steps      = 20

[ensemble]
ensemble    = "NPT"
temperature = 300.0
pressure    = 1.0

[thermostat]
method        = "V-RESCALE"
time_constant = 0.5
interval      = 10

[barostat]
method        = "C-RESCALE"
time_constant = 2.0

[constraints]
hydrogen_bonds = true
rigid_water    = true

[boundary]
type = "PERIODIC"

[execution]
target    = "GPU"
precision = "MIXED"
#--- end
