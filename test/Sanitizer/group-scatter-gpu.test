# The table of a block in the loops over groups (D[scatter-op]) under
# compute-sanitizer: the program of Integration/eam.mlir, whose density and
# forces are loops over groups, in mixed precision with `pair-hash=on`; the
# slots claimed by compare-and-swap, the additions in block memory, the
# barriers around them, and the flush to the destinations. The checks of
# the program print 1 as well.
#
# REQUIRES: cuda, compute-sanitizer
#
# RUN: sed 's/%%tol = arith.constant 1.0e-10/%%tol = arith.constant 1.0e-5/' \
# RUN:     %S/../Integration/eam.mlir \
# RUN: | mdir-opt %md_passes \
# RUN:     --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_transforms \
# RUN:     --md-exec-choose-neighbors="kind=groups" \
# RUN:     --md-exec-assign-precision="mode=mixed" \
# RUN:     --md-exec-choose-scatter="pair-hash=on" \
# RUN:     --md-exec-assign-storage="memory=device" --convert-md-exec-to-gpu \
# RUN: | mlir-opt %lower_gpu_to_llvm > %t.mlir
# RUN: %compute_sanitizer --tool memcheck --error-exitcode 1 mlir-runner %t.mlir \
# RUN:     -e main --entry-point-result=void \
# RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda 2>&1 \
# RUN: | FileCheck %s
# RUN: %compute_sanitizer --tool initcheck --error-exitcode 1 mlir-runner %t.mlir \
# RUN:     -e main --entry-point-result=void \
# RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda 2>&1 \
# RUN: | FileCheck %s
# RUN: %compute_sanitizer --tool racecheck --error-exitcode 1 mlir-runner %t.mlir \
# RUN:     -e main --entry-point-result=void \
# RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda 2>&1 \
# RUN: | FileCheck %s --check-prefix=RACE

