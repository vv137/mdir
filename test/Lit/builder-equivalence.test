# The equivalence check of the builder (#568, scripts/builder-equivalence,
# docs/driver.md): the script finds the control files of a corpus, emits
# each with two builds for the CPU and the GPU target, and reports every
# case that differs. Here a small corpus of the kind "tests" (a test that
# split-file divides, with an input that its RUN line copies), each control
# file as the program of a run and of segments (`mdir emit --segments`), is checked
# with one build against itself, and against two wrappers of it that
# perturb the module: one adds a comment, which only the raw form sees, and
# one changes the cutoff, which both forms see. A file of hashes recorded
# with the build is checked again with the build and with the second
# wrapper. emit uses no device.
# A control file read from the disk is read once, before either build runs
# (#631): the first build is a wrapper that rewrites the cutoff of the file
# before it emits, and the second build still takes the text of before, so
# the case is identical. The file is the control of argon.test, divided out.
# The test of the corpus is written from argon.test.in, whose markers and
# RUN line are disguised, since split-file and lit would take them here.
# RUN: mdir-term-ir-test %S/../Driver/Inputs/model-stages/painn-scalar-export.mlir
# RUN: rm -rf %t && split-file %s %t && mkdir -p %t/root/test/Driver
# RUN: sed -e 's/^#=== /#--- /' -e 's/R-U-N/RUN/' %t/argon.test.in > %t/root/test/Driver/argon.test
# RUN: cp %S/../../examples/argon/argon.pdb %t/root/test/Driver
# RUN: %python %t/diagnostics.py %S/../../scripts/builder-equivalence/check.py
# RUN: chmod +x %t/comment %t/cutoff
# RUN: %python %S/../../scripts/builder-equivalence/check.py compare mdir mdir \
# RUN:   --root %t/root --only tests --printer mdir-opt | FileCheck %s --check-prefix=SAME
# RUN: env MDIR_REAL=mdir not %python %S/../../scripts/builder-equivalence/check.py compare \
# RUN:   mdir %t/comment --root %t/root --only tests --printer mdir-opt \
# RUN:   | FileCheck %s --check-prefix=COMMENT
# RUN: env MDIR_REAL=mdir %python %S/../../scripts/builder-equivalence/check.py compare \
# RUN:   mdir %t/comment --root %t/root --only tests --printer mdir-opt --forms printed \
# RUN:   | FileCheck %s --check-prefix=PRINTED
# RUN: env MDIR_REAL=mdir not %python %S/../../scripts/builder-equivalence/check.py compare \
# RUN:   mdir %t/cutoff --root %t/root --only tests --printer mdir-opt --forms printed \
# RUN:   | FileCheck %s --check-prefix=CUTOFF
# RUN: split-file %t/root/test/Driver/argon.test %t/extra && cp %t/root/test/Driver/argon.pdb %t/extra
# RUN: chmod +x %t/rewrite
# RUN: env MDIR_REAL=mdir MDIR_REWRITE=%t/extra/argon.toml %python \
# RUN:   %S/../../scripts/builder-equivalence/check.py compare %t/rewrite mdir --jobs 1 \
# RUN:   --only extra --control %t/extra/argon.toml --printer mdir-opt \
# RUN:   | FileCheck %s --check-prefix=SNAPSHOT
# RUN: grep -q '^cutoff = 9.0$' %t/extra/argon.toml
# RUN: %python %S/../../scripts/builder-equivalence/check.py record mdir \
# RUN:   --root %t/root --only tests --printer mdir-opt --output %t/hashes.tsv
# RUN: %python %S/../../scripts/builder-equivalence/check.py verify mdir \
# RUN:   --root %t/root --only tests --printer mdir-opt --hashes %t/hashes.tsv \
# RUN:   | FileCheck %s --check-prefix=SAME
# RUN: env MDIR_REAL=mdir not %python %S/../../scripts/builder-equivalence/check.py verify \
# RUN:   %t/cutoff --root %t/root --only tests --printer mdir-opt --hashes %t/hashes.tsv \
# RUN:   | FileCheck %s --check-prefix=VERIFY
# The axes of #739. --precisions emits each case in each precision, set in
# [execution], and --instances counts the lowered cases whose program holds
# each instance of the templates of the lowering: argon in double precision
# takes the neighbor matrix in f64, and in single precision the one in f32.
# RUN: %python %S/../../scripts/builder-equivalence/check.py compare mdir mdir \
# RUN:   --root %t/root --only tests --targets cpu --kinds run --stages lowered \
# RUN:   --precisions single,double --instances | FileCheck %s --check-prefix=PRECISIONS
# A case written for the corpus (scripts/builder-equivalence/cases, the kind
# "cases"): a Python script, run with the interpreter of --python and the
# Python package of the build on PYTHONPATH, which takes the target, the
# precision, and the stage. The variables of --env, and those that the file
# names on a line "# check.py env:", reach it; each --env is one more
# variant, beside the case without it. The script stops with an error that
# names what it was given, which --show-errors prints.
# RUN: mkdir -p %t/root/scripts/builder-equivalence/cases
# RUN: cp %t/case.py %t/root/scripts/builder-equivalence/cases
# RUN: %python %S/../../scripts/builder-equivalence/check.py compare mdir mdir \
# RUN:   --root %t/root --only cases --targets gpu --forms raw --python %python \
# RUN:   --precisions mixed --env CHECK_PY_VALUE=7 --show-errors \
# RUN:   | FileCheck %s --check-prefix=CASES
# RUN: not %python %S/../../scripts/builder-equivalence/check.py compare mdir mdir \
# RUN:   --root %t/root --only cases --env NOVALUE 2>&1 | FileCheck %s --check-prefix=BAD-ENV
# RUN: not %python %S/../../scripts/builder-equivalence/check.py compare mdir mdir \
# RUN:   --root %t/root --only cases --instances 2>&1 | FileCheck %s --check-prefix=BAD-INSTANCES

# Two control files: one that builds, and one that stops with an error (an
# unknown key), whose message is compared as well.
# SAME: control files: 2
# SAME-NEXT: cases (control file and variant): 8
# SAME-NEXT: compared: module printed, module raw
# SAME-NEXT: identical: 8 (of which stop with the same error in both: 4)
# SAME-NEXT: different: 0

# COMMENT: DIFFERENT: test/Driver/argon.test:argon.toml [cpu] module raw
# COMMENT-NEXT: output: lines removed or added: 1
# COMMENT: +// a comment
# COMMENT: DIFFERENT: test/Driver/argon.test:argon.toml [gpu] module raw
# COMMENT: identical: 4 (of which stop with the same error in both: 4)
# COMMENT-NEXT: different: 4

# PRINTED: compared: module printed
# PRINTED-NEXT: identical: 8 (of which stop with the same error in both: 4)
# PRINTED-NEXT: different: 0

# CUTOFF: DIFFERENT: test/Driver/argon.test:argon.toml [cpu] module printed
# CUTOFF: -{{.*}}cutoff(0.85000000000000008){{.*}}
# CUTOFF-NEXT: +{{.*}}cutoff(9.000000e-01){{.*}}
# CUTOFF: DIFFERENT: test/Driver/argon.test:argon.toml [gpu] module printed
# CUTOFF: different: 4

# SNAPSHOT-NOT: DIFFERENT
# SNAPSHOT: control files: 1
# SNAPSHOT-NEXT: cases (control file and variant): 4
# SNAPSHOT-NEXT: compared: module printed, module raw
# SNAPSHOT-NEXT: identical: 4 (of which stop with the same error in both: 0)
# SNAPSHOT-NEXT: different: 0

# VERIFY: DIFFERENT: test/Driver/argon.test:argon.toml [cpu] module printed: the output differs from the recorded hash
# VERIFY-NEXT: DIFFERENT: test/Driver/argon.test:argon.toml [cpu] module raw: the output differs from the recorded hash
# VERIFY: different: 4

# argon.toml in two precisions; broken.toml stops with an error in both.
# PRECISIONS: cases (control file and variant): 4
# PRECISIONS-NEXT: compared: lowered printed
# PRECISIONS-NEXT: identical: 4 (of which stop with the same error in both: 2)
# PRECISIONS-NEXT: different: 0
# PRECISIONS-NEXT: instances (lowered cases that hold each):
# PRECISIONS-NEXT:   cpu matrix f32: 1
# PRECISIONS-NEXT:   cpu matrix f64: 1

# A Python case has the program of a run alone: one target, one precision,
# and two sets of variables (none, and that of --env), so two variants.
# CASES: ERROR: cases/case.py [gpu mixed] module: case GPU MIXED module file=3 value=- package=python
# CASES-NEXT: ERROR: cases/case.py [gpu mixed env:CHECK_PY_VALUE=7] module: case GPU MIXED module file=3 value=7 package=python
# CASES-NEXT: control files: 1
# CASES-NEXT: cases (control file and variant): 2
# CASES-NEXT: compared: module raw
# CASES-NEXT: identical: 2 (of which stop with the same error in both: 2)
# CASES-NEXT: different: 0

# BAD-ENV: --env takes NAME=VALUE[,NAME=VALUE], not 'NOVALUE'
# BAD-INSTANCES: --instances needs the lowered stage (--stages lowered)

#--- argon.test.in
# R-U-N: cp %S/argon.pdb %t
#=== argon.toml
[input]
coordinates = "argon.pdb"

[energy]
cutoff            = 8.5
pairlist_distance = 9.5

[[energy.pair]]
name       = "lj"
expression = "4*epsilon*((sigma/r)^12 - (sigma/r)^6)"

[[energy.type]]
name    = "AR"
mass    = 39.948
sigma   = 3.4
epsilon = 0.238

[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.005
steps      = 10

[ensemble]
ensemble    = "NVE"
temperature = 183.0

[boundary]
type = "PERIODIC"
box  = [34.7786, 34.7786, 34.7786]

[execution]
precision = "DOUBLE"
#=== broken.toml
[input]
coordinates = "argon.pdb"
unknown = 1
#--- comment
#!/usr/bin/env python3
import os, subprocess, sys
done = subprocess.run([os.environ["MDIR_REAL"], *sys.argv[1:]], capture_output=True)
sys.stderr.buffer.write(done.stderr)
sys.stdout.buffer.write(done.stdout + (b"// a comment\n" if done.returncode == 0 else b""))
sys.exit(done.returncode)
#--- rewrite
#!/usr/bin/env python3
import os, re, subprocess, sys
path = os.environ["MDIR_REWRITE"]
with open(path) as file:
    text = file.read()
with open(path, "w") as file:
    file.write(re.sub(r"(?m)^cutoff\s*=\s*8\.5$", "cutoff = 9.0", text))
sys.exit(subprocess.run([os.environ["MDIR_REAL"], *sys.argv[1:]]).returncode)
#--- cutoff
#!/usr/bin/env python3
import os, subprocess, sys
done = subprocess.run([os.environ["MDIR_REAL"], *sys.argv[1:]], capture_output=True)
sys.stderr.buffer.write(done.stderr)
sys.stdout.buffer.write(done.stdout.replace(b"cutoff(0.85000000000000008)", b"cutoff(9.0e-01)"))
sys.exit(done.returncode)

#--- case.py
# check.py env: CHECK_PY_FILE=3
import os
import sys
package = os.path.basename(os.environ["PYTHONPATH"].split(os.pathsep)[0])
sys.stderr.write(f"case {' '.join(sys.argv[1:])} file={os.environ.get('CHECK_PY_FILE', '-')} "
                 f"value={os.environ.get('CHECK_PY_VALUE', '-')} package={package}\n")
sys.exit(1)

#--- diagnostics.py
import importlib.util
import sys
spec = importlib.util.spec_from_file_location("equivalence", sys.argv[1])
checker = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = checker
spec.loader.exec_module(checker)

# Source-manager and explicit-location renderings of the same verifier
# failure compare equally, including the complete generic operation note.
source = (b'<stdin>:10:1: error: rejected program\nraw source\n^\n'
          b'<stdin>:10:1: note: see current operation:\n'
          b'"dyn.program"() : () -> ()\n')
explicit = (b'-:400:9: error: rejected program\n'
            b'-:400:9: note: see current operation:\n'
            b'"dyn.program"() : () -> ()\n')
normalize = checker.printed_result
assert normalize((1, b"", source)) == normalize((1, b"", explicit))
located = explicit.replace(b'-:400:9', b'loc("-":400:9)')
assert normalize((1, b"", source)) == normalize((1, b"", located))
for changed in (explicit.replace(b'rejected', b'accepted'),
                explicit.replace(b'dyn.program', b'dyn.changed')):
    assert normalize((1, b"", source)) != normalize((1, b"", changed))
assert normalize((1, b"", source)) != normalize((2, b"", explicit))
assert normalize((0, b"", source)) == (0, b"", source)
assert normalize((1, b"a", source)) != normalize((1, b"b", explicit))

# A parser failure has no generic operation note: its source excerpt is
# essential, since the message alone does not identify the missing SSA name.
parser = (b'<stdin>:10:17: error: use of undeclared SSA value name\n'
          b'memref.store %missing\n                ^\n')
shifted = parser.replace(b'<stdin>:10:17', b'-:400:17')
assert normalize((1, b"", parser)) == normalize((1, b"", shifted))
assert normalize((1, b"", parser)) != normalize(
    (1, b"", shifted.replace(b'%missing', b'%other_missing')))
user = b'input.toml:10:5: error: invalid key\n'
assert normalize((1, b"", user)) != normalize(
    (1, b"", user.replace(b':10:', b':11:')))
