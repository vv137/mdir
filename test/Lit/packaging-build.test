# scripts/packaging/build.sh, the one entry point of the container and binary
# builds (#639): its dry run, which needs no container program, prints the
# command of each target as publish.sh and the CI image ran them before; the
# tag of the CI image is the hash that ci.yml and ci-image.yml now take from
# it; a wrong option is refused.
# RUN: rm -rf %t && mkdir -p %t
# RUN: %python %S/Inputs/packaging_build.py %S/../.. %t | FileCheck %s
# CHECK: == runtime: status 0
# CHECK-NEXT: source: TREE
# CHECK-NEXT: commit: abc123
# CHECK-NEXT: version: 9.9.9
# CHECK-NEXT: result: mdir:9.9.9
# CHECK-NEXT: build: DOCKER_BUILDKIT=1 docker build -f packaging/Dockerfile -t mdir:9.9.9 --build-arg MDIR_GIT_COMMIT=abc123 .
# CHECK-NEXT: log: WORK/w/build-runtime.log
# CHECK: == tarball: status 0
# CHECK: result: TREE/dist/tarball
# CHECK-NEXT: build: DOCKER_BUILDKIT=1 docker build -f packaging/Dockerfile.manylinux --build-arg MDIR_GIT_COMMIT=abc123 --build-arg VERSION=9.9.9 --target tarball --output type=local,dest=TREE/dist/tarball .
# CHECK: == wheels: status 0
# CHECK: result: WORK/wheels
# CHECK-NEXT: build: DOCKER_BUILDKIT=1 docker build -f packaging/Dockerfile.manylinux --build-arg MDIR_GIT_COMMIT=abc123 --build-arg VERSION=9.9.9 --target wheels --output type=local,dest=WORK/wheels .
# CHECK: == ci: status 0
# CHECK: result: ghcr.io/vv137/mdir-ci:llvm-23.1.2-{{[0-9a-f]+}}
# CHECK-NEXT: build: DOCKER_BUILDKIT=1 docker build -f packaging/Dockerfile --target ci --build-arg JOBS=16 --build-arg LINK_JOBS=4 -t ghcr.io/vv137/mdir-ci:llvm-23.1.2-{{[0-9a-f]+}} .
# CHECK-NEXT: push: docker push ghcr.io/vv137/mdir-ci:llvm-23.1.2-{{[0-9a-f]+}}
# CHECK: the tag of ci.yml and ci-image.yml: yes
# CHECK-NEXT: bogus: status 2, usage:
# CHECK-NEXT: ci --bogus: status 2, usage:
# CHECK-NEXT: tarball --push: status 2, build.sh: --push is for the CI image
# CHECK-NEXT: runtime --print-tag: status 2, build.sh: --print-tag is for the CI image
# CHECK-NEXT: ci --tag x: status 2, build.sh: --tag is for the runtime image
# CHECK-NEXT: runtime --out x: status 2, build.sh: --out is for the tarball and the wheels
# CHECK-NEXT: ci --login: status 2, build.sh: --login is for --push
# CHECK-NEXT: ci --source . --clone main: status 2, build.sh: --source and --clone exclude each other
# CHECK-NEXT: ci --keep: status 2, build.sh: --keep is for --clone
#
# publish.sh and the two workflows build through it, with no docker line of
# their own.
# RUN: grep -c -E '^\s*build (tarball|wheels|runtime)\b' %S/../../scripts/release/publish.sh | FileCheck %s --check-prefix=PUBLISH
# PUBLISH: {{^}}3{{$}}
# RUN: not grep -n -E '"\$DOCKER" build|docker build' %S/../../scripts/release/publish.sh %S/../../.github/workflows/ci.yml %S/../../.github/workflows/ci-image.yml
# RUN: grep -c 'scripts/packaging/build.sh' %S/../../.github/workflows/ci.yml %S/../../.github/workflows/ci-image.yml | FileCheck %s --check-prefix=WORKFLOWS
# WORKFLOWS: ci.yml:1
# WORKFLOWS-NEXT: ci-image.yml:4
