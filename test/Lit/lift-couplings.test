#--- ala3-exact.toml
[input]
topology    = "ala3.prmtop"
coordinates = "ala3.inpcrd"

[output]
energy_interval = 50

[energy]
cutoff            = 9.0
pairlist_distance = 10.0
electrostatics    = "PME"
coulomb_modifier  = "POTENTIAL_SHIFT"

[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.002
steps      = 100

[ensemble]
ensemble    = "NPT"
temperature = 300.0
pressure    = 1.0

[thermostat]
method        = "V-RESCALE"
time_constant = 0.5
interval      = 10

[barostat]
method        = "C-RESCALE"
time_constant = 2.0
work          = "EXACT"

[constraints]
hydrogen_bonds = true
rigid_water    = true

[boundary]
type = "PERIODIC"

[execution]
target    = "CPU"
precision = "DOUBLE"
