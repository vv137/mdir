# RUN: mdir-opt %S/scatter-add.mlir --md-exec-assign-algebra --test-md-exec-loop-effects -o /dev/null | FileCheck %s --check-prefix=SCATTER
# RUN: mdir-opt %S/Transforms/choose-scatter-pairs.mlir --md-exec-assign-algebra --test-md-exec-loop-effects -o /dev/null | FileCheck %s --check-prefix=PAIR
# RUN: mdir-opt %S/domain-rows.mlir --md-exec-assign-algebra --test-md-exec-loop-effects -o /dev/null | FileCheck %s --check-prefix=ATOMIC
