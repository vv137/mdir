# REQUIRES: python-api
# RUN: rm -f %t
# RUN: %mdir_python %S/reciprocal-grid.py emit --mixed --grid 188 90 90 | sed -E '/md_exec.reciprocal/s/(coulomb\([^)]+\))/\1 prolate spline_assignment/' > %t
# RUN: mdir-opt %t --md-exec-assign-algebra --md-exec-assign-storage="memory=device pme-axis-fft=on" --convert-md-exec-to-gpu --symbol-dce | FileCheck %s --implicit-check-not=fft_stage
# CHECK: backend = "cufft"
# CHECK-SAME: reason = "unsupported axis length"
# CHECK: call @mdrtCudaFFTForward3DF32
# CHECK: call @mdrt_gpu_pme_radial_spline_tables_
# CHECK: call @mdrt_gpu_pme_prolate_convolve_
# CHECK: call @mdrtCudaFFTBackward3DF32
