# The test of tangent-pme.test on a GPU, in double and mixed precision.
#
# REQUIRES: cuda, python-api
#
# RUN: %mdir_python %S/Inputs/tangent_pme.py 2e-8 %t.double.mlir
# RUN: mdir-opt %t.double.mlir %md_passes \
# RUN:     --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_gpu_passes \
# RUN: | mlir-opt %lower_gpu_to_llvm --convert-ub-to-llvm --reconcile-unrealized-casts \
# RUN: | mlir-runner -e main --entry-point-result=void \
# RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda \
# RUN: | FileCheck %S/tangent-pme.test
#
# RUN: %mdir_python %S/Inputs/tangent_pme.py 1e-5 %t.mixed.mlir
# RUN: mdir-opt %t.mixed.mlir %md_passes \
# RUN:     --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_transforms \
# RUN:     --md-exec-assign-precision="mode=mixed" \
# RUN:     --md-exec-assign-algebra --md-exec-assign-storage="memory=device" --convert-md-exec-to-gpu \
# RUN: | mlir-opt %lower_gpu_to_llvm --convert-ub-to-llvm --reconcile-unrealized-casts \
# RUN: | mlir-runner -e main --entry-point-result=void \
# RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda \
# RUN: | FileCheck %S/tangent-pme.test
