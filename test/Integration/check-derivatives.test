# Each generated potential is checked at the same actual configuration,
# including a pair across a periodic boundary. All three coordinates of
# both particles, six cell strains, and lambda are checked in f64.
# RUN: %python %S/Inputs/derivative_fuzzer.py %t.mlir 15
# RUN: mdir-opt %t.mlir --md-check-derivative-coverage --md-check-derivatives %md_passes --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_passes | mlir-opt %lower_loops_to_llvm | mlir-runner -e main --entry-point-result=void --shared-libs=%mdrt,%mlir_c_runner_utils
# RUN: %python %S/Inputs/derivative_fuzzer.py %t.mlir 161
# RUN: mdir-opt %t.mlir --md-check-derivative-coverage --md-check-derivatives %md_passes --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_passes | mlir-opt %lower_loops_to_llvm | mlir-runner -e main --entry-point-result=void --shared-libs=%mdrt,%mlir_c_runner_utils
# The same coordinates with an intentionally incorrect analytic force.
# RUN: %python %S/Inputs/derivative_fuzzer.py %t.bad.mlir 15 1 bad-rule
# RUN: mdir-opt %t.bad.mlir --md-check-derivatives %md_passes --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_passes | mlir-opt %lower_loops_to_llvm > %t.bad.llvm
# RUN: not --crash mlir-runner %t.bad.llvm -e main --entry-point-result=void --shared-libs=%mdrt,%mlir_c_runner_utils 2>&1 | FileCheck %s
# CHECK: derivative check of 'random0': force component
# Invalid checker options and precision must fail before executing.
# RUN: not mdir-opt %t.mlir --md-check-derivatives="step=0" 2>&1 | FileCheck %s --check-prefix=STEP
# STEP: derivative check needs a finite positive step
# RUN: not mdir-opt %t.mlir --md-check-derivatives %md_passes --convert-md-to-md-exec --md-exec-assign-precision="mode=mixed" 2>&1 | FileCheck %s --check-prefix=PRECISION
# PRECISION: derivative checking requires double precision for every role
# RUN: not mdir-opt %t.mlir --md-check-derivatives %md_passes --convert-md-to-md-exec --md-exec-assign-storage="memory=device" --convert-md-exec-to-gpu 2>&1 | FileCheck %s --check-prefix=TARGET
# TARGET: derivative checking requires the CPU lowering
