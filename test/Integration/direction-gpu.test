# The tests of direction.mlir and direction-pme.test on a GPU, in double
# precision (D389, #726). The values are printed for the
# record.
#
# REQUIRES: cuda, python-api
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: mdir-opt %S/direction.mlir %md_passes \
# RUN:     --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_gpu_passes \
# RUN: | mlir-opt %lower_gpu_to_llvm --convert-ub-to-llvm --reconcile-unrealized-casts \
# RUN: | mlir-runner -e main --entry-point-result=void \
# RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda > %t/pairs.out
# RUN: FileCheck %S/direction.mlir < %t/pairs.out
# RUN: cat %t/pairs.out
#
# RUN: %mdir_python %S/Inputs/tangent_pme.py 1e-12 %t/base.mlir
# RUN: %mdir_python %S/Inputs/direction_pme.py %t/base.mlir %t/double.mlir
# RUN: mdir-opt %t/double.mlir %md_passes \
# RUN:     --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_gpu_passes \
# RUN: | mlir-opt %lower_gpu_to_llvm --convert-ub-to-llvm --reconcile-unrealized-casts \
# RUN: | mlir-runner -e main --entry-point-result=void \
# RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda > %t/pme.out
