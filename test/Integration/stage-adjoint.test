# The adjoint identity of each stage of the synthetic model of
# Inputs/synthetic_mp.py (#377, step 3; D[ml4-neural-op]):
# <ȳ, J v> = <J^T ȳ, v> at three points a stage, J v from MDIR's forward
# rules (D183) on the forward body and J^T ȳ from the bound product, which
# the script wrote by a reverse sweep of its own. Each stage prints 1 if
# the largest relative difference is at most 1e-12, then that difference.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: %python %S/Inputs/synthetic_mp.py stages > %t/stages.mlir
# RUN: %python %S/Inputs/synthetic_mp.py adjoint > %t/main.mlir
# RUN: cat %t/stages.mlir %t/main.mlir \
# RUN: | mdir-opt --test-md-stage-adjoint \
# RUN: | mlir-opt %lower_loops_to_llvm \
# RUN: | mlir-runner -e main --entry-point-result=void \
# RUN:     --shared-libs=%mlir_c_runner_utils \
# RUN: | FileCheck %s
#
# A product that is not the transpose of the body's derivative (its first
# cotangent scaled by 1.001) fails the identity.
#
# RUN: %python %S/Inputs/synthetic_mp.py stages node1 > %t/wrong.mlir
# RUN: cat %t/wrong.mlir %t/main.mlir \
# RUN: | mdir-opt --test-md-stage-adjoint \
# RUN: | mlir-opt %lower_loops_to_llvm \
# RUN: | mlir-runner -e main --entry-point-result=void \
# RUN:     --shared-libs=%mlir_c_runner_utils \
# RUN: | FileCheck %s --check-prefix=WRONG

#
# The script writes every constant as an MLIR float literal, also where
# repr() has no point ('1e-05', which MLIR does not parse as a float); the
# values come back unchanged.
#
# RUN: %python %S/Inputs/synthetic_mp.py floats | mdir-opt \
# RUN: | FileCheck %s --check-prefix=FLOATS

# FLOATS: arith.constant 1.000000e-05 : f64
# FLOATS: arith.constant 3.000000e+20 : f64
# FLOATS: arith.constant -2.000000e-300 : f64
# FLOATS: arith.constant 5.000000e+00 : f64
# FLOATS: arith.constant 1.000000e-01 : f64
# FLOATS: arith.constant -1.000000e+16 : f64

# edge1, node1, edge2, node2, readout:
# CHECK:      {{^}}1{{$}}
# CHECK-NEXT: {{^[0-9.e+-]+$}}
# CHECK-NEXT: {{^}}1{{$}}
# CHECK-NEXT: {{^[0-9.e+-]+$}}
# CHECK-NEXT: {{^}}1{{$}}
# CHECK-NEXT: {{^[0-9.e+-]+$}}
# CHECK-NEXT: {{^}}1{{$}}
# CHECK-NEXT: {{^[0-9.e+-]+$}}
# CHECK-NEXT: {{^}}1{{$}}
# CHECK-NEXT: {{^[0-9.e+-]+$}}

# WRONG:      {{^}}1{{$}}
# WRONG-NEXT: {{^[0-9.e+-]+$}}
# WRONG-NEXT: {{^}}0{{$}}
