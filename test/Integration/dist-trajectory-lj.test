# and an uneven grid; in mixed precision on sixteen.
# RUN: sed 's/GRID/16, 1, 1/; s/STEPS/200/; s/XTOL/1.0e-12/; s/VTOL/1.0e-11/; s/ETOL/1.0e-12/; s/DTOL/1.0e-3/' %S/Inputs/dist-trajectory-lj.mlir \
# RUN: | mdir-opt --md-exec-assign-algebra --convert-md-dist-to-loops %md_passes \
