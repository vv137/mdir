#
# The halo events of D310 inside the step: every start is waited for before
# its buffers are packed, released, or freed, which the verifier proves.
# RUN: sed 's/GRID/2, 2, 2/; s/STEPS/200/; s/XTOL/1.0e-12/; s/VTOL/1.0e-11/; s/ETOL/1.0e-12/; s/DTOL/1.0e-3/' %S/Inputs/dist-trajectory-lj.mlir \
# RUN: | mdir-opt --md-exec-assign-algebra \
# RUN:     --convert-md-dist-to-md-exec="functions=main halo-events=true" \
# RUN:     --convert-md-dist-to-loops="halo-events=true" --lower-mdrt-halo-events \
# RUN:     %md_passes --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_passes \
# RUN: | mlir-opt %lower_loops_to_llvm \
# RUN: | mlir-runner -e main --entry-point-result=void \
# RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt \
# RUN: | FileCheck %s
#
# The particles cross faces, edges, and corners of the 2 x 2 x 2 grid: the
# trace of the transport counts, at each migration, the particles whose
# owner changes along one, two, or three axes of the grid, and the totals.
# RUN: sed 's/GRID/2, 2, 2/; s/STEPS/200/; s/XTOL/1.0e-12/; s/VTOL/1.0e-11/; s/ETOL/1.0e-12/; s/DTOL/1.0e-3/' %S/Inputs/dist-trajectory-lj.mlir \
