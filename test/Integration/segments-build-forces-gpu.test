# RUN: | env MDRT_SEGMENTS_DUMP=%t/dipeptide/dumps mlir-runner -e main --entry-point-result=void --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda
# RUN: mdir emit --stage=module %t/dipeptide/control.toml > %t/dipeptide/module.mlir
# RUN: mdir-kind-pairs-test generate %t/dipeptide/control.toml %t/dipeptide/module.mlir 1 0.09582 --func-entry > %t/dipeptide/entry.mlir
# RUN: mdir-opt %t/dipeptide/entry.mlir --pass-pipeline="builtin.module(md-check-exchange,md-differentiate,md-expand-truncation,md-inline,convert-md-to-md-exec{skin=0.1},md-exec-fuse-loops,md-exec-accumulate-destinations,md-exec-assign-precision{mode=double},md-exec-assign-algebra,md-exec-assign-storage,convert-md-exec-to-md-alg)" > %t/dipeptide/alg.mlir
# RUN: sed "/^#/d" %t/dipeptide/system.top > %t/dipeptide/oracle.top
# RUN: %mdir_python %S/Inputs/segments_forces.py emit %t/dipeptide/oracle.top %t/dipeptide/system.gro %t/dipeptide/alg.mlir WAT %t/dipeptide/probe.mlir %t/dipeptide/dumps/dump_000000.bin %t/dipeptide/positions.txt
# RUN: mdir-opt %t/dipeptide/probe.mlir --convert-md-alg-to-scf | mlir-opt %lower_loops_to_llvm | mlir-runner -e main --entry-point-result=void --shared-libs=%mlir_c_runner_utils > %t/dipeptide/values.txt
# RUN: %mdir_python %S/Inputs/segments_forces.py compare %t/dipeptide/oracle.top %t/dipeptide/system.gro WAT %t/dipeptide/positions.txt %t/dipeptide/values.txt %t/dipeptide/forces.txt double 0.8 --excluded=%t/dipeptide/excluded.npy | FileCheck %s --check-prefix=DIPEPTIDE
#
# The list built without the first excluded pair of the solute: its pair
# enters the sums, and the forces of the solute differ.
# RUN: mkdir -p %t/unexcluded/dumps && cp %t/dipeptide/system.top %t/dipeptide/system.gro %t/unexcluded/
# RUN: %mdir_python %S/Inputs/segments_coverage.py emit dipeptide-gro %S/../Driver/Inputs %t/unexcluded --positions=%t/dipeptide/positions.txt --drop-exclusion
# RUN: mdir-opt %t/unexcluded/harness.mlir --convert-md-exec-to-gpu="dump-segments=true" --convert-md-alg-to-gpu \
# RUN: | mlir-opt %lower_gpu_to_llvm \
# RUN: | env MDRT_SEGMENTS_DUMP=%t/unexcluded/dumps mlir-runner -e main --entry-point-result=void --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda
# RUN: %mdir_python %S/Inputs/segments_forces.py emit %t/dipeptide/oracle.top %t/dipeptide/system.gro %t/dipeptide/alg.mlir WAT %t/unexcluded/probe.mlir %t/unexcluded/dumps/dump_000000.bin %t/dipeptide/positions.txt
# RUN: mdir-opt %t/unexcluded/probe.mlir --convert-md-alg-to-scf | mlir-opt %lower_loops_to_llvm | mlir-runner -e main --entry-point-result=void --shared-libs=%mlir_c_runner_utils > %t/unexcluded/values.txt
# RUN: not %mdir_python %S/Inputs/segments_forces.py compare %t/dipeptide/oracle.top %t/dipeptide/system.gro WAT %t/dipeptide/positions.txt %t/unexcluded/values.txt %t/dipeptide/forces.txt double 0.8 --excluded=%t/dipeptide/excluded.npy | FileCheck %s --check-prefix=UNEXCLUDED
#
# Two taken kinds of different extents, TIP3P and OPC with its site, and
# sodium ions, in the rhombic dodecahedron (D417's K = 2): the list's six
# segments, and the placement of OPC's site from the device's records.
