# The test of synthetic-mp.mlir on a GPU (D288): the
# synthetic two-layer model in stages, with the bodies inlined into the
# kernels, with both neighbor structures in double precision, and in mixed
# precision within 3e-5 of the largest value.
#
# REQUIRES: cuda
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: %python %S/Inputs/synthetic_mp.py stages > %t/stages.mlir
# RUN: cat %t/stages.mlir %S/synthetic-mp.mlir > %t/model.mlir
# RUN: mdir-opt %t/model.mlir %md_passes \
# RUN:     --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_gpu_passes \
# RUN: | mlir-opt %lower_gpu_to_llvm \
# RUN: | mlir-runner -e main --entry-point-result=void \
# RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda \
# RUN: | FileCheck %S/synthetic-mp.mlir

# RUN: mdir-opt %t/model.mlir %md_passes \
# RUN:     --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_transforms \
# RUN:     --md-exec-choose-neighbors="kind=groups" \
# RUN:     --md-exec-assign-algebra --md-exec-assign-storage="memory=device" --convert-md-exec-to-gpu \
# RUN: | mlir-opt %lower_gpu_to_llvm \
# RUN: | mlir-runner -e main --entry-point-result=void \
# RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda \
# RUN: | FileCheck %S/synthetic-mp.mlir

# RUN: sed -e 's/arith.constant 1.0e-12 : f64/arith.constant 3.0e-5 : f64/' \
# RUN:     %S/synthetic-mp.mlir > %t/mixed.mlir
# RUN: cat %t/stages.mlir %t/mixed.mlir \
# RUN: | mdir-opt %md_passes \
# RUN:     --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_transforms \
# RUN:     --md-exec-choose-neighbors="kind=groups" \
# RUN:     --md-exec-assign-precision="mode=mixed" \
# RUN:     --md-exec-assign-algebra --md-exec-assign-storage="memory=device" --convert-md-exec-to-gpu \
