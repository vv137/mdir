# The same linear FFT transform and independent NumPy oracle on a device.
# The GPU library transform is enqueued on the current stream. D[pme-primitives].
# REQUIRES: cuda
#
# RUN: %mdir_python %S/Inputs/linear_transform_oracle.py emit --length 5 --precision double --backend gpu \
# RUN: | mdir-opt --convert-md-exec-to-gpu | mlir-opt %lower_gpu_to_llvm \
# RUN: | mlir-runner -e main --entry-point-result=void --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda \
# RUN: | %mdir_python %S/Inputs/linear_transform_oracle.py check --length 5 --precision double
# RUN: %mdir_python %S/Inputs/linear_transform_oracle.py emit --length 6 --precision double --backend gpu \
# RUN: | mdir-opt --convert-md-exec-to-gpu | mlir-opt %lower_gpu_to_llvm \
# RUN: | mlir-runner -e main --entry-point-result=void --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda \
# RUN: | %mdir_python %S/Inputs/linear_transform_oracle.py check --length 6 --precision double
# RUN: %mdir_python %S/Inputs/linear_transform_oracle.py emit --length 5 --precision mixed --backend gpu \
# RUN: | mdir-opt --convert-md-exec-to-gpu | mlir-opt %lower_gpu_to_llvm \
# RUN: | mlir-runner -e main --entry-point-result=void --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda \
# RUN: | %mdir_python %S/Inputs/linear_transform_oracle.py check --length 5 --precision mixed
# RUN: %mdir_python %S/Inputs/linear_transform_oracle.py emit --length 6 --precision mixed --backend gpu \
# RUN: | mdir-opt --convert-md-exec-to-gpu | mlir-opt %lower_gpu_to_llvm \
# RUN: | mlir-runner -e main --entry-point-result=void --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda \
# RUN: | %mdir_python %S/Inputs/linear_transform_oracle.py check --length 6 --precision mixed
