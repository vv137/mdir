// The test of eam.mlir on a GPU, over groups (each pair once, D89):
// the density, a gather whose value goes to both particles of a pair, and
// the forces through the embedding, with each strategy of the scatter of
// the loops over groups (D291): an atomic of the device for each
// value (`pair-hash=off`), and the table of a block (`pair-hash=on`), in
// double precision to 1e-10 of the reference and in mixed precision to
// 1e-5. All 8 checks must print 1.
//
// REQUIRES: cuda
//
// RUN: mdir-opt %S/eam.mlir %md_passes \
// RUN:     --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_transforms \
// RUN:     --md-exec-choose-neighbors="kind=groups" \
// RUN:     --md-exec-assign-algebra --md-exec-choose-scatter="pair-hash=off" \
// RUN:     --md-exec-assign-storage="memory=device" --convert-md-exec-to-gpu \
// RUN: | mlir-opt %lower_gpu_to_llvm \
// RUN: | mlir-runner -e main --entry-point-result=void \
// RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda \
// RUN: | FileCheck %S/eam.mlir
//
// RUN: mdir-opt %S/eam.mlir %md_passes \
// RUN:     --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_transforms \
// RUN:     --md-exec-choose-neighbors="kind=groups" \
// RUN:     --md-exec-assign-algebra --md-exec-choose-scatter="pair-hash=on" \
// RUN:     --md-exec-assign-storage="memory=device" --convert-md-exec-to-gpu \
// RUN: | mlir-opt %lower_gpu_to_llvm \
// RUN: | mlir-runner -e main --entry-point-result=void \
// RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda \
// RUN: | FileCheck %S/eam.mlir
//
// RUN: sed 's/%%tol = arith.constant 1.0e-10/%%tol = arith.constant 1.0e-5/' \
// RUN:     %S/eam.mlir \
// RUN: | mdir-opt %md_passes \
// RUN:     --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_transforms \
// RUN:     --md-exec-choose-neighbors="kind=groups" \
// RUN:     --md-exec-assign-precision="mode=mixed" \
// RUN:     --md-exec-assign-algebra --md-exec-choose-scatter="pair-hash=off" \
// RUN:     --md-exec-assign-storage="memory=device" --convert-md-exec-to-gpu \
// RUN: | mlir-opt %lower_gpu_to_llvm \
// RUN: | mlir-runner -e main --entry-point-result=void \
// RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda \
// RUN: | grep -c '^1$' | FileCheck %s --check-prefix=MIXED
//
// RUN: sed 's/%%tol = arith.constant 1.0e-10/%%tol = arith.constant 1.0e-5/' \
// RUN:     %S/eam.mlir \
// RUN: | mdir-opt %md_passes \
// RUN:     --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_transforms \
// RUN:     --md-exec-choose-neighbors="kind=groups" \
// RUN:     --md-exec-assign-precision="mode=mixed" \
// RUN:     --md-exec-assign-algebra --md-exec-choose-scatter="pair-hash=on" \
// RUN:     --md-exec-assign-storage="memory=device" --convert-md-exec-to-gpu \
// RUN: | mlir-opt %lower_gpu_to_llvm \
// RUN: | mlir-runner -e main --entry-point-result=void \
// RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda \
// RUN: | grep -c '^1$' | FileCheck %s --check-prefix=MIXED
// MIXED: 8
//
// The loops over groups take the table only with `pair-hash=on`: the
// density, the forces through the embedding, and the pair term.
//
// RUN: mdir-opt %S/eam.mlir %md_passes \
// RUN:     --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_transforms \
// RUN:     --md-exec-choose-neighbors="kind=groups" \
// RUN:     --md-exec-assign-precision="mode=mixed" \
// RUN:     --md-exec-assign-algebra --md-exec-choose-scatter="pair-hash=on" \
// RUN: | FileCheck %s --check-prefix=CHOSEN
// CHOSEN: md_exec.pair_for {{.*}} policy(unique, atomic) scatter(hash(512, 8, 0))
