# The test of device-primitives.mlir on a device (D296):
# each emitter of CompactionEmitter.h, called by name, expanded, and run:
# the warp compaction, the warp scans, the block scan, both device scan
# strategies with and without the cursor, the chunked scan, and the counting sort
# with the insertion sort, the stable rank, and the order by another
# buffer. The results are integers, compared exactly.
#
# REQUIRES: cuda
#
# RUN: mdir-opt %S/device-primitives.mlir --expand-device-primitives \
# RUN: | mlir-opt %lower_gpu_to_llvm \
# RUN: | mlir-runner -e main --entry-point-result=void \
# RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda \
# RUN: | FileCheck %S/device-primitives.mlir
#
# Under compute-sanitizer (with -Dsanitize=1): memcheck and racecheck,
# for the barriers of the block scan, the scan's state, and the atomics
# of the scatter.
# RUN: %if compute-sanitizer %{ mdir-opt %S/device-primitives.mlir \
# RUN:     --expand-device-primitives \
# RUN:   | mlir-opt %lower_gpu_to_llvm > %t.mlir %}
# RUN: %if compute-sanitizer %{ %compute_sanitizer --tool memcheck \
# RUN:     --error-exitcode 1 mlir-runner %t.mlir -e main \
# RUN:     --entry-point-result=void \
# RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda 2>&1 \
# RUN:   | FileCheck %s %}
# RUN: %if compute-sanitizer %{ %compute_sanitizer --tool racecheck \
# RUN:     --error-exitcode 1 mlir-runner %t.mlir -e main \
# RUN:     --entry-point-result=void \
# RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda 2>&1 \
# RUN:   | FileCheck %s --check-prefix=RACE %}
# CHECK: ERROR SUMMARY: 0 errors
# RACE: RACECHECK SUMMARY: 0 hazards displayed (0 errors, 0 warnings)
