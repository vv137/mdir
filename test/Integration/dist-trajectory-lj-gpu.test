# The trajectory of dist-trajectory-lj.test with the loops of each domain on
# a GPU (D399, D290): the md_dist.state and the
# transfers on the host, the pair loops of md_exec on the device, in double
# and mixed precision, with the bounds of that test.
#
# REQUIRES: cuda
#
# RUN: sed 's/GRID/2, 2, 2/; s/STEPS/200/; s/XTOL/2.0e-14/; s/VTOL/3.0e-13/; s/FTOL/2.0e-13/; s/ETOL/2.0e-14/; s/DTOL/1.0e-3/' %S/Inputs/dist-trajectory-lj.mlir \
# RUN: | mdir-opt --md-exec-assign-algebra --convert-md-dist-to-md-exec="functions=main" \
# RUN:     --convert-md-dist-to-loops %md_passes \
# RUN:     --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_transforms \
# RUN:     --md-exec-assign-algebra --md-exec-assign-storage=memory=device --convert-md-exec-to-gpu --md-alg-transform-collections --convert-md-alg-to-gpu \
# RUN: | mlir-opt %lower_gpu_to_llvm \
# RUN: | mlir-runner -e main --entry-point-result=void \
# RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda \
# RUN: | FileCheck %S/dist-trajectory-lj.test
# RUN: sed 's/GRID/16, 1, 1/; s/STEPS/200/; s/XTOL/2.0e-6/; s/VTOL/4.0e-5/; s/FTOL/2.0e-5/; s/ETOL/2.0e-6/; s/DTOL/1.0e-3/' %S/Inputs/dist-trajectory-lj.mlir \
# RUN: | mdir-opt --md-exec-assign-algebra --convert-md-dist-to-md-exec="functions=main" \
# RUN:     --convert-md-dist-to-loops %md_passes \
# RUN:     --convert-md-to-md-exec="skin=0.2 width=64" %md_exec_transforms \
# RUN:     --md-exec-assign-precision="mode=mixed" \
# RUN:     --md-exec-assign-algebra --md-exec-assign-storage=memory=device --convert-md-exec-to-gpu --md-alg-transform-collections --convert-md-alg-to-gpu \
# RUN: | mlir-opt %lower_gpu_to_llvm \
# RUN: | mlir-runner -e main --entry-point-result=void \
# RUN:     --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda \
