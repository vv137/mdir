# REQUIRES: cuda
# Expected: under 180 seconds on RTX 5090; submit with lit --timeout=300.
# Exact marked fused/unfused publication and independent energy: normal groups, renumbered/nonconsecutive
# OHH spanning warps, a partial tail, extra points, and a marked constrained
# triplet excluded from template membership (ordinary atom-unit publication).
# RUN: rm -rf %t && mkdir -p %t
# RUN: %python %S/Inputs/template_integration_publication.py %t/normal.mlir %t/normal.json --snapshot
# RUN: mdir-opt %t/normal.mlir --md-exec-assign-algebra --convert-md-exec-to-gpu=check-template-reach=false > %t/normal-fused-gpu.mlir
# RUN: %python %S/Inputs/template_publication_snapshot.py instrument %t/normal-fused-gpu.mlir %t/normal-fused-snapshot.mlir --expect-publications fused
# RUN: mlir-opt %t/normal-fused-snapshot.mlir %lower_gpu_to_llvm | mlir-runner -e main --entry-point-result=void --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda > %t/normal-fused.out
# RUN: mdir-opt %t/normal.mlir --md-exec-assign-algebra '--convert-md-exec-to-gpu=fuse-integration=false check-template-reach=false' > %t/normal-standalone-gpu.mlir
# RUN: %python %S/Inputs/template_publication_snapshot.py instrument %t/normal-standalone-gpu.mlir %t/normal-standalone-snapshot.mlir --expect-publications unfused
# RUN: mlir-opt %t/normal-standalone-snapshot.mlir %lower_gpu_to_llvm | mlir-runner -e main --entry-point-result=void --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda > %t/normal-standalone.out
# RUN: %python %S/Inputs/template_publication_snapshot.py compare %t/normal-fused.out %t/normal-standalone.out %t/normal.json
# RUN: %python %S/Inputs/template_integration_publication.py %t/across.mlir %t/across.json --across --snapshot
