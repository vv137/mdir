# RUN: %python %S/Inputs/template_publication_snapshot.py instrument %t/across-fused-gpu.mlir %t/across-fused-snapshot.mlir --expect-publications fused
# RUN: mlir-opt %t/across-fused-snapshot.mlir %lower_gpu_to_llvm | mlir-runner -e main --entry-point-result=void --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda > %t/across-fused.out
# RUN: mdir-opt %t/across.mlir --md-exec-assign-algebra '--convert-md-exec-to-gpu=fuse-integration=false check-template-reach=false' > %t/across-standalone-gpu.mlir
# RUN: %python %S/Inputs/template_publication_snapshot.py instrument %t/across-standalone-gpu.mlir %t/across-standalone-snapshot.mlir --expect-publications unfused
# RUN: mlir-opt %t/across-standalone-snapshot.mlir %lower_gpu_to_llvm | mlir-runner -e main --entry-point-result=void --shared-libs=%mlir_c_runner_utils,%mdrt,%mdrt_cuda > %t/across-standalone.out
