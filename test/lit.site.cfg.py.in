config.mdir_mpi = @MDIR_TEST_MPI@
config.mdir_mpiexec = "@MPIEXEC_EXECUTABLE@"

config.llvm_tools_dir = lit_config.substitute("@LLVM_TOOLS_DIR@")
config.llvm_lib_dir = lit_config.substitute("@LLVM_LIBRARY_DIR@")
config.llvm_shlib_ext = "@SHLIBEXT@"
config.mdir_obj_root = "@MDIR_BINARY_DIR@"
config.mdir_cuda = @MDIR_TEST_CUDA@
config.mdir_hdf5 = @MDIR_TEST_HDF5@
