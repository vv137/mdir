# Whole-water reconstruction is shared across extent and publication.
# Inspect before canonicalization so CSE cannot hide duplicate emission.
# Two O-H minimum images require two vector rounds in a rectangular cell,
# or six scalar rounds in a tilted cell; validity itself never wraps.
# RUN: rm -f %t.rect.mlir %t.rect.reference %t.tilt.mlir %t.tilt.reference
# RUN: %python %S/../../Integration/Inputs/template_writer_oracle.py generate %t.rect.mlir %t.rect.reference
# RUN: mdir-opt %t.rect.mlir --test-md-template-writer | FileCheck %s --check-prefix=RECT
# RUN: %python %S/../../Integration/Inputs/template_writer_oracle.py generate %t.tilt.mlir %t.tilt.reference --triclinic
# RUN: mdir-opt %t.tilt.mlir --test-md-template-writer | FileCheck %s --check-prefix=TILT
# RECT-LABEL: func.func private @writer_frame
# RECT-COUNT-2: math.roundeven
# RECT-NOT: math.roundeven
# TILT-LABEL: func.func private @writer_frame
# TILT-COUNT-6: math.roundeven
# TILT-NOT: math.roundeven
