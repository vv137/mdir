# REQUIRES: cuda
# The registry and the pool of the blocks of the device (#622,
# Inputs/device_blocks.py), through the functions of the runtime.
#
# More blocks than the 4096 that the registry held before #622, in use in
# one activation: all of them are taken back when it closes, and the next
# activation takes them from the pool, without new allocations of the
# driver. A trim gives them back.
# RUN: %python %S/Inputs/device_blocks.py %mdrt_cuda registry | FileCheck %s --check-prefix=REGISTRY
# REGISTRY: 5000 blocks in use: live 5000, live bytes 20480000, idle 0, idle bytes 0, driver blocks 5000
# REGISTRY-NEXT: closed: live 0, live bytes 0, idle 5000, idle bytes 20480000, driver blocks 5000
# REGISTRY-NEXT: again, from the pool: live 5000, live bytes 20480000, idle 0, idle bytes 0, driver blocks 5000
# REGISTRY-NEXT: closed again: live 0, live bytes 0, idle 5000, idle bytes 20480000, driver blocks 5000
# REGISTRY-NEXT: trimmed 20480000 bytes
# REGISTRY-NEXT: after the trim: live 0, live bytes 0, idle 0, idle bytes 0, driver blocks 0
#
# The budget of the idle blocks in bytes: past 1 MiB, the blocks that an
# activation leaves go back to the driver.
# RUN: env MDIR_DEVICE_POOL_BYTES=1048576 %python %S/Inputs/device_blocks.py %mdrt_cuda budget | FileCheck %s --check-prefix=BUDGET
# BUDGET: 1000 blocks closed under a budget of 1 MiB: live 0, live bytes 0, idle 256, idle bytes 1048576, driver blocks 256
# BUDGET-NEXT: trimmed 1048576 bytes
# BUDGET-NEXT: after the trim: live 0, live bytes 0, idle 0, idle bytes 0, driver blocks 0
#
# A request that the driver refuses for want of memory is made once more
# after the idle blocks of the pool are given back. The refusal is made by
# MDRT_FAIL_ALLOCATION, at the 101st request, so that the test needs no
# memory of the device that the other tests of the suite use.
# RUN: env MDRT_FAIL_ALLOCATION=101 %python %S/Inputs/device_blocks.py %mdrt_cuda retry | FileCheck %s --check-prefix=RETRY
# RETRY: 100 idle blocks: live 0, live bytes 0, idle 100, idle bytes 409600, driver blocks 100
# RETRY-NEXT: a request refused once, after the trim: live 1, live bytes 8192, idle 0, idle bytes 0, driver blocks 1
# RETRY-NEXT: after the trim: live 0, live bytes 0, idle 0, idle bytes 0, driver blocks 0
# RETRY-NEXT: device blocks retry passed
#
# The best fit with splitting and coalescing (D[device-pool-split]). Each
# scenario fails on a pool that does not do what its comment says.
#
# A request is served from a larger idle arena, cut at its size rounded up
# to 256 bytes: the second piece starts 1024 bytes after the first, and
# the rest stays idle. Freed, the pieces merge into the arena again.
# RUN: %python %S/Inputs/device_blocks.py %mdrt_cuda split | FileCheck %s --check-prefix=SPLIT
# SPLIT: taken from the arena: True True
# SPLIT-NEXT: two pieces of one arena: live 2, live bytes 1300, idle 1, idle bytes 1047040, driver blocks 1
# SPLIT-NEXT: both freed: live 0, live bytes 0, idle 1, idle bytes 1048576, driver blocks 1
# SPLIT-NEXT: closed and trimmed: live 0, live bytes 0, idle 0, idle bytes 0, driver blocks 0
#
# A rest of fewer than 256 bytes is not cut off: the request takes the
# whole piece, and no idle piece is left.
# RUN: %python %S/Inputs/device_blocks.py %mdrt_cuda tail | FileCheck %s --check-prefix=TAIL
# TAIL: the whole arena taken: True
# TAIL-NEXT: a rest of 200 bytes not cut off: live 1, live bytes 4096, idle 0, idle bytes 0, driver blocks 1
# TAIL-NEXT: freed: live 0, live bytes 0, idle 1, idle bytes 4296, driver blocks 1
#
# The smallest idle piece that holds the request is taken, not the first
# or the last in the list, nor the largest.
# RUN: %python %S/Inputs/device_blocks.py %mdrt_cuda best | FileCheck %s --check-prefix=BEST
# BEST: three idle arenas: live 0, live bytes 0, idle 3, idle bytes 114688, driver blocks 3
# BEST-NEXT: the smallest that holds 10 KiB, of 16, 64, and 32 KiB: 16 KiB
#
# A freed piece merges with the idle pieces on both sides, and the arena
# serves a request of its full size again without the driver.
# RUN: %python %S/Inputs/device_blocks.py %mdrt_cuda coalesce | FileCheck %s --check-prefix=COALESCE
# COALESCE: the left and the right piece freed: live 1, live bytes 4096, idle 2, idle bytes 1044480, driver blocks 1
# COALESCE-NEXT: the middle piece freed: live 0, live bytes 0, idle 1, idle bytes 1048576, driver blocks 1
# COALESCE-NEXT: the arena serves its full size again: True
# COALESCE-NEXT: in use as a whole: live 1, live bytes 1048576, idle 0, idle bytes 0, driver blocks 1
#
# Two arenas that the driver placed next to each other do not merge: a
# request of both takes a third arena. The first line checks the premise,
# that the driver places two of 64 allocations of 4 KiB next to each other,
# as it suballocates small requests; if it fails on a device, the driver
# placed them otherwise, and the test needs another way to make neighbors.
# RUN: %python %S/Inputs/device_blocks.py %mdrt_cuda arenas | FileCheck %s --check-prefix=ARENAS
# ARENAS: two arenas next to each other: True
# ARENAS-NEXT: two neighboring arenas idle: live 0, live bytes 0, idle 2, idle bytes 8192, driver blocks 2
# ARENAS-NEXT: 8 KiB from neither: True
# ARENAS-NEXT: a request of both: live 1, live bytes 8192, idle 2, idle bytes 8192, driver blocks 3
#
# A trim returns the idle arena, not the one that holds a piece in use,
# whose idle rest stays; once the piece is freed, a trim returns it.
# RUN: %python %S/Inputs/device_blocks.py %mdrt_cuda trim | FileCheck %s --check-prefix=TRIM
# TRIM: the piece is from the smaller arena: True
# TRIM-NEXT: a piece in use, two arenas: live 1, live bytes 4096, idle 2, idle bytes 1110016, driver blocks 2
# TRIM-NEXT: trimmed 1048576 bytes
# TRIM-NEXT: after the trim: live 1, live bytes 4096, idle 1, idle bytes 61440, driver blocks 1
# TRIM-NEXT: trimmed 65536 bytes
# TRIM-NEXT: after the second trim: live 0, live bytes 0, idle 0, idle bytes 0, driver blocks 0
#
# The budget, with pieces: an idle piece of an arena that holds a block in
# use stays, even past the budget; the arena, once idle as a whole, goes
# back to the driver as the budget has no room for it.
# RUN: env MDIR_DEVICE_POOL_BYTES=1048576 %python %S/Inputs/device_blocks.py %mdrt_cuda pieces | FileCheck %s --check-prefix=PIECES
# PIECES: two pieces of an arena of 1 MiB in use: live 2, live bytes 1044480, idle 1, idle bytes 4096, driver blocks 1
# PIECES-NEXT: a second arena idle: live 2, live bytes 1044480, idle 2, idle bytes 1044480, driver blocks 2
# PIECES-NEXT: the large piece freed, past the budget: live 1, live bytes 4096, idle 2, idle bytes 2084864, driver blocks 2
# PIECES-NEXT: the first arena idle as a whole: live 0, live bytes 0, idle 1, idle bytes 1040384, driver blocks 1
#
# With the pool off (a budget of 0 bytes, as D414's memcheck uses it), a
# freed arena goes back to the driver at once and a later request takes a
# new one: no piece is ever split, and an access after a free is an access
# to memory that the driver has freed.
# RUN: env MDIR_DEVICE_POOL_BYTES=0 %python %S/Inputs/device_blocks.py %mdrt_cuda off | FileCheck %s --check-prefix=OFF
# OFF: an arena freed with the pool off: live 0, live bytes 0, idle 0, idle bytes 0, driver blocks 0
# OFF-NEXT: a smaller request after it: live 1, live bytes 1000, idle 0, idle bytes 0, driver blocks 1
# OFF-NEXT: freed: live 0, live bytes 0, idle 0, idle bytes 0, driver blocks 0
#
# A buffer of the runtime that a growth replaces (D312): an arena of its
# own goes back to the driver; a piece of a larger arena goes back to the
# pool and merges with its idle neighbor.
# RUN: %python %S/Inputs/device_blocks.py %mdrt_cuda replaced | FileCheck %s --check-prefix=REPLACED
# REPLACED: a matrix in an arena of its own: live 1, live bytes 1024, idle 0, idle bytes 0, driver blocks 1
# REPLACED-NEXT: grown: the old rows back to the driver: live 1, live bytes 2048, idle 0, idle bytes 0, driver blocks 1
# REPLACED-NEXT: a matrix in a piece of an arena: live 3, live bytes 7168, idle 1, idle bytes 1043456, driver blocks 2
# REPLACED-NEXT: grown: the old rows back to the pool: live 3, live bytes 1286144, idle 1, idle bytes 1044480, driver blocks 3
#
# The order of the streams: a piece freed while work on stream A still
# writes it (held back half a second by a host function), merged with an
# idle neighbor, and taken whole on stream B after the runtime changes to
# B, is written on B only after A's work: B's value is the last.
# RUN: %python %S/Inputs/device_blocks.py %mdrt_cuda streams | FileCheck %s --check-prefix=STREAMS
# STREAMS: the early piece freed while stream A writes it: live 0, live bytes 0, idle 1, idle bytes 1048576, driver blocks 1
# STREAMS-NEXT: the merged arena taken on stream B: True
# STREAMS-NEXT: the values after both streams: [2]
# STREAMS-NEXT: closed and trimmed: live 0, live bytes 0, idle 0, idle bytes 0, driver blocks 0
