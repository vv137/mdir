# REQUIRES: cuda
# A driver that supports an older major version of CUDA than the build
# (#657): the runtime compares the version that the driver reports with the
# major version of the toolkit of the build before it loads a module, and
# the run ends with both versions instead of crashing in the driver at the
# load. MDRT_DRIVER_VERSION stands for the version the driver reports, so
# that the test needs no older driver: 12040 is CUDA 12.4, the driver of the
# report in #657.
#
# RUN: rm -rf %t && mkdir -p %t && split-file %s %t
# With MDRT_TRACE, a module that was loaded would be printed.
# RUN: cd %t && env MDRT_DRIVER_VERSION=12040 MDRT_TRACE=1 not mdir run run.toml 2>&1 | FileCheck %s --check-prefix=OLD
# OLD-NOT: TRACE module
# OLD: mdrt: the NVIDIA driver supports CUDA 12.4; this build of MDIR, with CUDA {{[0-9]+\.[0-9]+}}, needs a driver that supports CUDA {{[0-9]+}}.0 or later (D177). Update the NVIDIA driver, or run on the CPU (target = "CPU")
#
# A driver of a later version runs, as without the variable.
# RUN: cd %t && env MDRT_DRIVER_VERSION=99000 mdir run run.toml | FileCheck %s --check-prefix=NEW
# NEW: INFO: 0
#
# `mdir doctor` reports the same, and does not run the GPU check.
# RUN: mkdir -p %t/doctor && env TMPDIR=%t/doctor MDRT_DRIVER_VERSION=12040 not mdir doctor --target=gpu 2>&1 | FileCheck %s --check-prefix=DOCTOR
# DOCTOR: CUDA driver API: 12.4
# DOCTOR-NEXT: FAIL CUDA driver: the NVIDIA driver supports CUDA 12.4; this build of MDIR, with CUDA {{[0-9]+\.[0-9]+}}, needs a driver that supports CUDA {{[0-9]+}}.0 or later (D177); update the NVIDIA driver, or use --target=cpu
# DOCTOR-NOT: Checking gpu

#--- run.toml
[input]
topology    = "argon.top"
coordinates = "argon.gro"

[energy]
cutoff            = 9.0
pairlist_distance = 10.0

[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.002
steps      = 0

[ensemble]
ensemble = "NVE"

[boundary]
type = "PERIODIC"

[execution]
target = "GPU"

[output]
energy_interval = 1
#--- argon.top
[ defaults ]
1 2 no 1.0 1.0
[ atomtypes ]
AR 18 39.948 0.0 A 0.34 0.0
[ moleculetype ]
AR 1
[ atoms ]
1 AR 1 AR AR 1 0.0 39.948
[ system ]
Two argon atoms
[ molecules ]
AR 2
#--- argon.gro
Two argon atoms
    2
    1AR      AR    1   0.600   0.600   0.600
    2AR      AR    2   1.200   1.200   1.200
   2.40000   2.40000   2.40000
