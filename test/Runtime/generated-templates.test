# The templates that say "Generated by ... Do not edit." are what their
# scripts generate, byte for byte (#211): a fix made in a template and not in
# its script would be lost at the next run of the script. Each script writes
# its templates to a directory of the test, and they are compared with those
# of the repository.
#
# RUN: rm -rf %t && mkdir -p %t/pme %t/groups
# RUN: %python %S/../../scripts/generate-pme-gpu-template.py %t/pme
# RUN: cmp %t/pme/PMEGPU.mlir %S/../../lib/Runtime/Templates/PMEGPU.mlir
# RUN: cmp %t/pme/PMEGPUTriclinic.mlir %S/../../lib/Runtime/Templates/PMEGPUTriclinic.mlir
# RUN: %python %S/../../scripts/generate-groups-gpu-template.py %t/groups
# RUN: cmp %t/groups/NeighborsGroupsGPU.mlir %S/../../lib/Runtime/Templates/NeighborsGroupsGPU.mlir
# RUN: cmp %t/groups/NeighborsGroupsGPUTriclinic.mlir %S/../../lib/Runtime/Templates/NeighborsGroupsGPUTriclinic.mlir
