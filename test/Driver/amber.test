# A run from a topology of Amber: alanine dipeptide in TIP3P water with
# ff14SB, made with tleap (Inputs/dipeptide/dipeptide.leap), with a plain
# cutoff of 9 Å for Lennard-Jones and Coulomb.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/dipeptide/dipeptide.prmtop %S/Inputs/dipeptide/dipeptide.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/run.toml
# RUN: mdir check %t/run.toml | FileCheck %s --check-prefix=CHECK-INPUT
# RUN: mdir run %t/run.toml | FileCheck %s

# The counts agree with those of ParmEd for the same files.
#
# CHECK-INPUT: particles:          1168
# CHECK-INPUT: residues:           385
# CHECK-INPUT: types:              9
# CHECK-INPUT: bonds:              1167, 1158 with hydrogen
# CHECK-INPUT: angles:             36
# CHECK-INPUT: dihedrals:          67, 4 improper
# CHECK-INPUT: pairs 1-4:          41
# CHECK-INPUT: total charge:       {{-?}}0.000000 e
# CHECK-INPUT: box:                27.1882 29.7181 25.397 Å

# The terms at the start. sander of AmberTools 26 gives, with
# Inputs/dipeptide/sander-single-point.in (eedmeth = 4, vdwmeth = 1):
#
#   BOND 0.0390, ANGLE 0.3620, DIHED 9.6440, 1-4 VDW 5.0157,
#   1-4 EEL 48.9355, EEL -2333.9044, VDWAALS 373.7948 (with the correction)
#
# The terms agree but for the conventions of docs/conventions.md: the
# electrostatic terms of MDIR are larger by 332.0637 / 332.0522, the ratio
# of the Coulomb constant of CODATA 2018 to that of Amber, and the
# correction for the dispersion is N² times the mean of C6 over the pairs
# of distinct particles that are not excluded, as GROMACS takes it, where
# sander sums over all pairs of types (design-m1.md, Section 7.2).
#
# CHECK:      MDIR: the terms at the start, in kcal/mol:
# CHECK-NEXT: MDIR:   Lennard-Jones                386.7447
# CHECK-NEXT: MDIR:   Coulomb                    -2333.9851
# CHECK-NEXT: MDIR:   bonds                          0.0390
# CHECK-NEXT: MDIR:   angles                         0.3619
# CHECK-NEXT: MDIR:   dihedrals                      9.6439
# CHECK-NEXT: MDIR:   Lennard-Jones 1-4              5.0156
# CHECK-NEXT: MDIR:   Coulomb 1-4                   48.9371
# CHECK-NEXT: MDIR:   dispersion                   -12.9450
# CHECK-NEXT: MDIR:   total                      -1896.1875
# CHECK:      INFO:         0         0.0000 {{ *-?[0-9.]+}} {{ *}}-1896.1876

#--- run.toml
[input]
topology   = "dipeptide.prmtop"
coordinates = "dipeptide.inpcrd"

[output]
energy_interval = 10
[energy]
cutoff        = 9.0
pairlist_distance = 10.0
electrostatics = "CUTOFF"

[dynamics]
integrator    = "VELOCITY_VERLET"
time_step     = 0.0005
steps         = 10

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[boundary]
type = "PERIODIC"
#--- end
