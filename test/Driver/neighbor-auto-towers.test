# rigid_units = "ON" takes lists of units: a water box.
# RUN: sed -e 's|^coordinates = "small.pdb"|format = "AMBER"\ntopology = "%S/Inputs/opc/opc.prmtop"\ncoordinates = "%S/Inputs/opc/opc.inpcrd"|' \
# RUN:     -e '/^\[\[energy.pair\]\]/,/^sigma/d' -e '/^box /d' -e 's|^cutoff = 9.0|cutoff = 6.0\nelectrostatics = "PME"|' %t/run.toml > %t/water.toml
# RUN: printf '\n[constraints]\nhydrogen_bonds = true\nrigid_water = true\n\n[performance]\nrigid_units = "ON"\n' >> %t/water.toml
# RUN: cd %t && env CUDA_VISIBLE_DEVICES= mdir check water.toml | FileCheck %s --check-prefix=UNITS

# NODEVICE: neighbors: matrix, reach 10.5 Ang (AUTO: 8000 particles, fewer than {{[0-9]+}})
# NODEVICE-NEXT: AUTO traversal: TOWERS not taken: no visible CUDA device
# CPU: AUTO traversal: TOWERS not taken: the target is the CPU
# PRECISION: AUTO traversal: TOWERS not taken: TOWERS takes mixed precision
# DETERMINISTIC: AUTO traversal: TOWERS not taken: the deterministic mode
# INTERVAL: AUTO traversal: TOWERS not taken: 'rebuild_interval' is given
# REACH: AUTO traversal: TOWERS not taken: a list reach is given, which TOWERS does not use
# OPEN: AUTO traversal: TOWERS not taken: the cell is not periodic
# MINIMIZE: AUTO traversal: TOWERS not taken: a minimization
# GIVEN: neighbors: matrix, reach 10.5 Ang{{$}}
# JSON: matrix | 8000 particles, fewer than {{[0-9]+}} | not taken: no visible CUDA device
# JSONGIVEN: None
# UNITS: AUTO traversal: TOWERS not taken: 'rigid_units = "ON"' takes lists of units

#--- run.toml
[input]
coordinates = "small.pdb"

[output]
energy_interval = 10

[energy]
cutoff = 9.0

[[energy.pair]]
name       = "lj"
expression = "4*epsilon*((sigma/r)^12 - (sigma/r)^6)"
mixing     = "lorentz-berthelot"

[[energy.type]]
name    = "AR"
mass    = 39.95
epsilon = 0.238465
sigma   = 3.4

[dynamics]
integrator = "VELOCITY_VERLET"
time_step = 0.002
steps = 20

[ensemble]
ensemble    = "NVT"
temperature = 100.0

[thermostat]
method = "V-RESCALE"
interval = 10
time_constant = 0.5

[boundary]
type = "PERIODIC"
box  = [76.0, 76.0, 76.0]

[execution]
target = "GPU"
precision = "MIXED"
#--- end
