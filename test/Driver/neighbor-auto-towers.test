# RUN: cd %t && env CUDA_VISIBLE_DEVICES= mdir check --json matrix.toml | %python -c "import json, sys; print(json.load(sys.stdin)['run']['neighbors']['towers_auto'])" | FileCheck %s --check-prefix=JSONGIVEN
