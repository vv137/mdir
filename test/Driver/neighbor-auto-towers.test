# RUN: sed -e 's|^precision = "MIXED"|precision = "SINGLE"|' %t/run.toml > %t/single.toml
# RUN: sed -e 's|^target = "GPU"|target = "GPU"\ndeterministic = true|' %t/run.toml > %t/deterministic.toml
# RUN: sed -e 's|^cutoff = 9.0|cutoff = 9.0\nrebuild_interval = 10|' %t/run.toml > %t/interval.toml
# RUN: sed -e 's|^cutoff = 9.0|cutoff = 9.0\npairlist_distance = 11.0|' %t/run.toml > %t/outer.toml
# RUN: sed -e 's|^cutoff = 9.0|cutoff = 9.0\npruned_distance = 9.3|' %t/run.toml > %t/inner.toml
# RUN: sed -e 's|^type = "PERIODIC"|type = "NONE"|' -e '/^box /d' %t/run.toml > %t/open.toml
# RUN: sed -e '/^\[dynamics\]/,/^steps/d' -e '/^\[ensemble\]/,/^temperature/d' -e '/^\[thermostat\]/,/^time_constant/d' %t/run.toml > %t/minimize.toml
# RUN: printf '[minimize]\nmethod = "STEEPEST_DESCENT"\nsteps = 10\n' >> %t/minimize.toml
