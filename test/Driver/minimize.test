# Steepest descent on the target of D65 (ff19SB in OPC) with rigid water,
# rigid bonds of hydrogen, and particle mesh Ewald, and a run of dynamics
# that begins where the minimization ends.
#
# REQUIRES: hdf5
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/ff19sb/ff19.prmtop %S/Inputs/ff19sb/ff19.inpcrd %t
# RUN: sed -n '/^#--- min.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/min.toml
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/run.toml
# RUN: mdir run %t/min.toml > %t/both.log
# RUN: mdir run %t/run.toml >> %t/both.log
# RUN: FileCheck %s < %t/both.log
# RUN: %python %S/Inputs/check_bonds.py %t/ff19.prmtop %t/min.dcd | FileCheck %s --check-prefix=BONDS

# The log has the forces without their parts along the constraints. Each
# step that raises the energy is not taken, and the next one is shorter.
# The minimization begins from the positions of the file on the surface of
# the constraints: the bonds of hydrogen of tleap are not at their lengths,
# and taken there the energy is -5348.8659 rather than -5348.4328.
#
# CHECK:      MDIR: 2332 particles, 100 steps of steepest descent
# CHECK:      INFO:      STEP  POTENTIAL_ENE      RMS_FORCE      MAX_FORCE  MAX_ATOM      STEP_SIZE
# CHECK:      INFO:         0     -5348.8659         8.6909        51.7726        35       0.100000
# CHECK-NEXT: INFO:        50     -6587.5294         2.3869        32.3543        24       0.117032
# CHECK-NEXT: INFO:       100     [[LAST:-[0-9]+\.[0-9]+]]
# CHECK:      MDIR: wrote 1 checkpoints to '{{.*}}min.h5'
# CHECK:      MDIR: the potential energy went from -5348.8659 to [[LAST]] kcal/mol

# The run of dynamics takes the positions, and draws velocities.
#
# CHECK:      MDIR: begins at the positions of '{{.*}}min.h5'
# CHECK:      INFO:         0         0.0000 {{ *}}{{-[0-9.]+}} {{ *}}[[LAST]] {{ *}}{{[0-9.]+}} {{ *}}300.0000

# The minimization keeps the bonds of hydrogen and the waters rigid.
#
# BONDS: bonds ok

#--- min.toml
[input]
topology   = "ff19.prmtop"
coordinates = "ff19.inpcrd"

[output]
checkpoint = "min.h5"
trajectory = "min.dcd"
energy_interval = 50
trajectory_interval = 50

[energy]
cutoff        = 9.0
pairlist_distance = 10.0
electrostatics = "PME"
coulomb_modifier     = "POTENTIAL_SHIFT"

[minimize]
steps         = 100

[constraints]
hydrogen_bonds = true
rigid_water = true

[boundary]
type = "PERIODIC"
#--- end
#--- run.toml
[input]
topology   = "ff19.prmtop"
coordinates = "ff19.inpcrd"
checkpoint = "min.h5"

[output]
energy_interval = 10
[energy]
cutoff        = 9.0
pairlist_distance = 10.0
electrostatics = "PME"
coulomb_modifier     = "POTENTIAL_SHIFT"

[dynamics]
time_step     = 0.002
steps         = 10

[ensemble]
temperature = 300.0

[constraints]
hydrogen_bonds = true
rigid_water = true

[boundary]
type = "PERIODIC"
#--- end
