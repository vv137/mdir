# Particle mesh Ewald on the three OPC waters of virtual-sites.test, whose
# extra points carry the negative charge (docs/pme-m1.md).
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/opc/three.prmtop %S/Inputs/opc/three.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/run.toml
# RUN: mdir run %t/run.toml | FileCheck %s
# RUN: %python %S/Inputs/ewald_reference.py %t/three.prmtop %t/three.inpcrd 9.0 3.47045919371208278 \
# RUN: | FileCheck %s --check-prefix=EWALD
# RUN: %python %S/Inputs/check_virial.py mdir %t/run.toml %t/three.inpcrd 8e-3 3e-5 \
# RUN: | FileCheck %s --check-prefix=VIRIAL

# The terms of the Coulomb energy agree with the Ewald sum of
# Inputs/ewald_reference.py, which sums over the wave vectors instead of a
# grid: the direct sum, the excluded pairs, and the self term exactly, and
# the reciprocal sum to its six digits with a grid of 64 points and splines
# of order 8. With the default grid, 35 points and order 4, the reciprocal
# sum is 4.693822 kcal/mol, off by 7e-4 of it.
#
# EWALD:      direct       -14.3572978
# EWALD-NEXT: excluded     535.1260685
# EWALD-NEXT: reciprocal   4.6972413
# EWALD-NEXT: self         -539.7928275
#
# CHECK:      MDIR:   Coulomb                      -14.357298
# CHECK:      MDIR:   Coulomb excluded             535.126069
# CHECK-NEXT: MDIR:   Coulomb reciprocal             4.697241
# CHECK-NEXT: MDIR:   Coulomb self                -539.792828

# The forces are the derivatives of the energy: the total energy changes
# as the square of the time step, with the extra points placed from their
# atoms and their forces moved to them.
#
# CHECK: MDIR: the total energy changed by {{[0-9.]+}}e-0{{[4-9]}} of its value

# The virial of each term was checked apart against its analytic value,
# the reciprocal sum against Σ_m E_m (1 − 2π² m² / β²) of a script, to 10⁻⁵.
# Here the trace of the whole is checked against −dU/dλ; the rounding of
# the coordinates of the scaled files limits the difference to about 10⁻⁵.
#
# VIRIAL: virial ok

#--- run.toml
[input]
prmtopfile = "three.prmtop"
ambcrdfile = "three.inpcrd"

[energy]
cutoffdist    = 9.0
pairlistdist  = 10.0
electrostatic = "PME"
pme_alpha     = 0.347045919371208278
pme_ngrid_x   = 64
pme_ngrid_y   = 64
pme_ngrid_z   = 64
pme_nspline   = 8

[dynamics]
integrator    = "VVER"
timestep      = 0.0001
nsteps        = 1000
eneout_period = 1000

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[boundary]
type = "PBC"
#--- end
