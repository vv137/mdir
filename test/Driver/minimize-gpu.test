# The minimization of minimize.test on a GPU in mixed precision.
#
# REQUIRES: cuda
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/ff19sb/ff19.prmtop %S/Inputs/ff19sb/ff19.inpcrd %t
# RUN: sed -n '/^#--- min.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/min.toml
# RUN: mdir run %t/min.toml | FileCheck %s
# RUN: %python %S/Inputs/check_bonds.py %t/ff19.prmtop %t/min.dcd | FileCheck %s --check-prefix=BONDS

# The steps of double precision to within the rounding of the forces,
# whose terms take the positions in f32 (D79): after 50 steps the energy is
# within 0.5 kcal/mol of that in double precision, -6587.1 (from -6587.6 to
# -6586.6; the floating-point atomics move it by about 0.1 from run to run).
#
# CHECK: INFO:         0     -5348.43{{[0-9]+}}         8.69{{[0-9]+}}
# CHECK: INFO:        50     -{{6587\.[0-5][0-9]+|6586\.[6-9][0-9]+}}
# CHECK: MDIR: the potential energy went from -5348.43{{[0-9]+}} to -67{{[0-9]+}}.{{[0-9]+}} kcal/mol

# BONDS: bonds ok

#--- min.toml
[input]
topology   = "ff19.prmtop"
coordinates = "ff19.inpcrd"

[output]
trajectory = "min.dcd"
energy_interval = 50
trajectory_interval = 50

[energy]
cutoff        = 9.0
pairlist_distance = 10.0
electrostatics = "PME"
coulomb_modifier     = "POTENTIAL_SHIFT"

[minimize]
steps         = 100

[constraints]
hydrogen_bonds = true
rigid_water = true

[boundary]
type = "PERIODIC"

[execution]
target    = "gpu"
precision = "mixed"
#--- end
