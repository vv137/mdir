# REQUIRES: mpi
# RUN: rm -rf %t && mkdir -p %t
# RUN: sed -n '/^#--- control/,/^#--- end/p' %s | sed '1d;$d' > %t/run.toml
# RUN: cp %S/../../examples/ala3/ala3.prmtop %S/../../examples/ala3/ala3.inpcrd %t
# RUN: cd %t && mdir emit run.toml --stage=lowered > lowered.mlir
# RUN: FileCheck %s < %t/lowered.mlir
# RUN: FileCheck %s --check-prefix=SPECTRUM < %t/lowered.mlir
#
# The coupling loop has zero iterations because the energy interval and
# the thermostat interval coincide. The active plain and reporting steps
# must pass the same epoch handle to the partition runtime.
# CHECK: llvm.call @mdrtDistShardEpochPartition({{.*}}, [[EPOCH:%[0-9]+]], {{%[a-z0-9]+}}, {{%[a-z0-9]+}}, {{%[a-z0-9]+}})
# CHECK: llvm.call @mdrtDistShardEpochPartition({{.*}}, [[EPOCH]], {{%[a-z0-9]+}}, {{%[a-z0-9]+}}, {{%[a-z0-9]+}})
#
# The lowered PME calls request the full energy and virial, energy
# alone, or just forces according to their SSA consumers.
# SPECTRUM-LABEL: llvm.func @mdir_run(
# SPECTRUM-DAG: [[ENERGY:%[0-9]+]] = llvm.mlir.constant(1 : index) : i64
# SPECTRUM-DAG: [[FORCE:%[0-9]+]] = llvm.mlir.constant(0 : index) : i64
# SPECTRUM-DAG: [[VIRIAL:%[0-9]+]] = llvm.mlir.constant(10 : index) : i64
# SPECTRUM: llvm.call @mdrtDistSpatialPME({{.*}}, [[VIRIAL]]) :
# SPECTRUM: llvm.call @mdrtDistSpatialPME({{.*}}, [[ENERGY]]) :
# SPECTRUM: [[HANDLE:%[0-9]+]] = llvm.call @mdrtDistStartSpatialPME({{.*}}, [[FORCE]]) :
# SPECTRUM: llvm.call @mdrtDistFinishSpatialPME([[HANDLE]],
#
#--- control
[input]
topology="ala3.prmtop"
coordinates="ala3.inpcrd"
[output]
energy_interval=8
[energy]
cutoff=8
pairlist_distance=10
electrostatics="PME"
[pme]
grid=[24,24,24]
order=4
beta=0.39467022824439113
[dynamics]
integrator="VELOCITY_VERLET"
time_step=0.002
steps=24
seed=4123
[ensemble]
ensemble="NVT"
temperature=300
[thermostat]
method="V-RESCALE"
time_constant=0.5
interval=8
[constraints]
hydrogen_bonds=true
rigid_water=true
analytic_bonds=true
[boundary]
type="PERIODIC"
[execution]
target="CPU"
threads=2
precision="MIXED"
[distribute]
domains=8
transport="mpi"
traversal="midpoint"
#--- end
