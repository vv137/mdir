# The reciprocal sums of PME over the particles whose coefficient can be
# nonzero (D262): the dipeptide in OPC, whose oxygens carry no
# charge and whose hydrogens and virtual sites have no coefficient of the
# dispersion. The program lists them in a field of the particles, which
# the builder makes from the topology and md_exec.nonzero makes again where
# the particles take a new order, at the start and at each segment of
# checkpoints. On a device, where more than half the particles are
# listed, the spreading takes the list and the gathering every particle
# (gather_all). The energies of the rows, at the start and after two
# segments, were those of main ae971477 to the digits of the log, as the
# states were to the bit; the rows below are re-pinned after D263 and D264,
# which change the thermostat's kinetic energy and the virial and pressure
# columns, not the reciprocal sums (the run is on the CPU, deterministic); a TIP3P
# system, all of whose charges are nonzero, has no list for the charges.
#
# RUN: rm -rf %t && split-file %s %t
# RUN: cp %S/Inputs/opc/opc.prmtop %S/Inputs/opc/opc.inpcrd %t
# RUN: cp %S/Inputs/fep/eth_wat.prmtop %S/Inputs/fep/eth_wat.inpcrd %t
# RUN: cd %t && mdir emit run.toml --stage=module > module.mlir
# RUN: FileCheck %s --check-prefix=MODULE < %t/module.mlir
# RUN: FileCheck %s --check-prefix=NONZERO < %t/module.mlir
# RUN: cd %t && mdir run run.toml | FileCheck %s
# RUN: sed -e 's|^spatial_order = true|spatial_order = false|' %t/run.toml > %t/fixed.toml
# RUN: cd %t && mdir emit fixed.toml --stage=module | FileCheck %s --check-prefix=FIXED
# RUN: cd %t && mdir emit tip3p.toml --stage=module | FileCheck %s --check-prefix=TIP3P

# The lists of the charges and of the coefficients, made at the start and
# in the loop over segments.
# NONZERO-COUNT-4: md_exec.nonzero
# NONZERO-NOT: md_exec.nonzero

# A quarter of the particles have a coefficient of the dispersion, and a
# device gathers them alone; three quarters have a charge, and a device
# gathers every particle (gather_all).
# The arguments of md.reciprocal are the positions (%arg0), the values,
# the cell (%arg1), and the moduli, then the list of the particles.
# MODULE: md.reciprocal %arg0, {{%arg[0-9]+}}, %arg1, {{%arg[0-9]+}} listed({{%arg[0-9]+}}) grid({{.*}}) coulomb(1.000000e+00) dispersion :
# MODULE: md.reciprocal %arg0, {{%arg[0-9]+}}, %arg1, {{%arg[0-9]+}} listed({{%arg[0-9]+}}) grid({{.*}}) coulomb({{[0-9.e+]+}}) gather_all :

# FIXED-NOT: md_exec.nonzero
# FIXED: md.reciprocal %arg0, {{%arg[0-9]+}}, %arg1, {{%arg[0-9]+}} listed({{%arg[0-9]+}}) {{.*}} dispersion
# FIXED: md.reciprocal %arg0, {{%arg[0-9]+}}, %arg1, {{%arg[0-9]+}} listed({{%arg[0-9]+}}) {{.*}} coulomb(138.

# TIP3P: md.reciprocal %arg0, {{%arg[0-9]+}}, %arg1, {{%arg[0-9]+}} listed({{%arg[0-9]+}}) {{.*}} dispersion :
# TIP3P: md.reciprocal %arg0, {{%arg[0-9]+}}, %arg1, {{%arg[0-9]+}} grid({{.*}}) coulomb(138.{{[0-9]+}}) :

# CHECK: INFO: {{ *}}0 {{ *}}0.0000 {{ *}}-2815.0592 {{ *}}-3522.4045 {{ *}}707.3454 {{ *}}300.0000 {{ *}}-101.7588 {{ *}}685.7587 {{ *}}-2815.0592 {{ *}}19810.9175
# CHECK: INFO: {{ *}}20 {{ *}}0.0400 {{ *}}-2824.3441 {{ *}}-3674.3254 {{ *}}849.9813 {{ *}}362.3977 {{ *}}-1189.8576 {{ *}}-488.2131 {{ *}}-2815.7859 {{ *}}19787.0778
# CHECK: INFO: {{ *}}40 {{ *}}0.0800 {{ *}}-2826.0722 {{ *}}-3750.9414 {{ *}}924.8692 {{ *}}394.1229 {{ *}}-1896.6624 {{ *}}-1209.2868 {{ *}}-2816.8306 {{ *}}19745.6709

#--- run.toml
[input]
topology    = "opc.prmtop"
coordinates = "opc.inpcrd"

[output]
checkpoint          = "run.h5"
energy_interval     = 20
checkpoint_interval = 20

[energy]
cutoff            = 9.0
pairlist_distance = 10.0
electrostatics    = "PME"
coulomb_modifier  = "POTENTIAL_SHIFT"
lennard_jones     = "PME"

[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.002
steps      = 40

[ensemble]
ensemble    = "NPT"
temperature = 300.0
pressure    = 1.0

[thermostat]
method        = "V-RESCALE"
time_constant = 0.5
interval      = 10

[barostat]
method        = "C-RESCALE"
time_constant = 2.0

[constraints]
hydrogen_bonds = true
rigid_water    = true

[boundary]
type = "PERIODIC"

[execution]
target        = "CPU"
threads       = 4
spatial_order = true
#--- tip3p.toml
[input]
topology    = "eth_wat.prmtop"
coordinates = "eth_wat.inpcrd"

[energy]
cutoff            = 9.0
pairlist_distance = 10.0
electrostatics    = "PME"
lennard_jones     = "PME"

[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.002
steps      = 10

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[constraints]
rigid_water = true

[boundary]
type = "PERIODIC"
#--- end
