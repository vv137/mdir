# RUN: sed -e 's/^groups     = \[":1-3", ":4"\]/groups     = [":1-3", ":9999"]/' %t/terms.toml > %t/empty.toml
# RUN: not mdir run %t/empty.toml 2>&1 | FileCheck %s --check-prefix=EMPTY
# RUN: sed -e 's/^groups     = \[":1-3", ":4"\]/groups     = [":1-3", ":4-400"]/' %t/terms.toml > %t/wide.toml
# RUN: not mdir run %t/wide.toml 2>&1 | FileCheck %s --check-prefix=WIDE
# RUN: sed -e 's/^groups     = \[":1-3", ":4"\]/groups     = [":1-3"]/' %t/terms.toml > %t/count.toml
# RUN: not mdir check %t/count.toml 2>&1 | FileCheck %s --check-prefix=COUNT
# RUN: sed -e 's/^weighting  = "NONE"/weighting  = "CHARGE"/' %t/terms.toml > %t/weighting.toml
# RUN: not mdir check %t/weighting.toml 2>&1 | FileCheck %s --check-prefix=WEIGHTING
# RUN: sed -e 's/^expression = "k\*(theta - t0)^2"/expression = "k*(theta - t0)^2 + dx"/' %t/terms.toml > %t/name.toml
# RUN: not mdir check %t/name.toml 2>&1 | FileCheck %s --check-prefix=NAME
# RUN: sed -e 's/^groups     = \[":1-3", ":4"\]/&\nparticles  = [[1, 2]]/' %t/terms.toml > %t/both.toml
# RUN: not mdir check %t/both.toml 2>&1 | FileCheck %s --check-prefix=BOTH

# CHECK:      MDIR:   pull                         247.012569
# CHECK-NEXT: MDIR:   bend                           2.234300
# CHECK-NEXT: MDIR:   twist                          1.161051

# PULL: 15 columns: ok

# PYTHON:      pull 247.012569
# PYTHON-NEXT: bend 2.234300
# PYTHON-NEXT: twist 1.161051
# PYTHON-NEXT: forces against differences of the energy: ok
# PYTHON-NEXT: virial: ok

# EMPTY: the group ':9999' of the term 'pull' selects no particle
# WIDE: of the group ':4-400' of the term 'pull' is 0.{{[0-9]+}} of the cell along an edge from the particle {{[0-9]+}}, from which the center is taken in the minimum image; a group must lie within 0.45 of the cell around it
# COUNT: expected 'groups' as 2 masks of particles
# WEIGHTING: expected 'weighting' as "MASS" or "NONE"
# NAME: the expression uses 'dx', which is neither 'theta', the time 't', nor a parameter of the term
# BOTH: a term takes 'particles' or 'groups', not both

#--- run.toml
[input]
topology    = "dipeptide.prmtop"
coordinates = "dipeptide.inpcrd"
[output]
energy_interval = 0
checkpoint = "terms.h5"
checkpoint_interval = 1
[energy]
cutoff            = 9.0
pairlist_distance = 10.0
electrostatics    = "CUTOFF"
[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 1e-9
steps      = 1
[ensemble]
ensemble    = "NVE"
temperature = 0.0
[boundary]
type = "PERIODIC"
[execution]
target    = "CPU"
precision = "DOUBLE"
#--- terms
[[energy.bond]]
name       = "pull"
expression = "k*(r - r0)^2 + c*dz"
groups     = [":1-3", ":4"]
k  = 2.0
r0 = 6.0
c  = 0.3
[[energy.angle]]
name       = "bend"
expression = "k*(theta - t0)^2"
groups     = [":1", ":2", ":3"]
weighting  = "NONE"
k  = 5.0
t0 = 2.0
[[energy.dihedral]]
name       = "twist"
expression = "k*(1 + cos(theta - p))"
groups     = [":1", ":2", ":3", ":5"]
k = 1.0
p = 0.5
#--- end
