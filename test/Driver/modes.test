# The mixture of mixture.toml with leapfrog, with threads, in single
# precision, and without the rewrites that change rounding.
#
# RUN: sed -e 's|Inputs/|%S/Inputs/|' -e 's|"VELOCITY_VERLET"|"LEAPFROG"|' %S/mixture.toml \
# RUN:     > %t.toml
# RUN: echo '[execution]' >> %t.toml
# RUN: echo 'threads = 4' >> %t.toml
# RUN: echo 'precision = "single"' >> %t.toml
# RUN: echo 'fast_math = false' >> %t.toml
# RUN: mdir run %t.toml | FileCheck %s

# With leapfrog the stored velocities are half a step behind the
# positions. The log has the kinetic energy of the time of the row all the
# same.
#
# CHECK:      INFO:         0         0.0000 {{ *-[0-9.]+}} {{ *}}-497.7{{[0-9]+}} {{ *[0-9.]+}} {{ *}}120.00{{[0-9]+}} {{ *}}-1117.7{{[0-9]+}} {{ *}}-1712.0{{[0-9]+}}
# CHECK:      INFO:       200         0.8000
# CHECK:      MDIR: the total energy changed by {{[0-9.]+}}e-0{{[5-9]}} of its value
