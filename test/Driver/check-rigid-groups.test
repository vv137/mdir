# The rigid groups of a topology in `mdir check` (D[rigid-groups],
# docs/constraints.md, Section 3): molecules of five kinds in one topology
# of GROMACS. Three waters of three sites, two of four sites whose site
# [ virtual_sites3 ] places, a rigid molecule of three atoms that all have
# Lennard-Jones, and an ion are rigid groups of four kinds, the most
# populous first; two waters with bonds and an angle are left out, and
# counted with the reason.
#
# RUN: rm -rf %t && split-file %s %t
# RUN: mdir check %t/run.toml | FileCheck %s
# RUN: mdir check --json %t/run.toml | FileCheck %s --check-prefix=JSON

# CHECK: degrees of freedom: 54
# CHECK-NEXT: rigid groups: 7 of 9 molecules, 4 kinds
# CHECK-NEXT: kind 1: 3 molecules of 3 particles, 3 in the frame, 0 sites
# CHECK-NEXT: types: OW HW HW
# CHECK-NEXT: charges: -0.834 0.417 0.417 e
# CHECK-NEXT: frame: 0.9572 0.9572 1.5139 Ang
# The weights of the site are those of the file, a = b = 0.106676721, and
# 1 - a - b for the first atom.
# CHECK-NEXT: kind 2: 2 molecules of 4 particles, 3 in the frame, 1 site
# CHECK-NEXT: types: OW HW HW MW
# CHECK-NEXT: charges: 0 0.52422 0.52422 -1.04844 e
# CHECK-NEXT: frame: 0.9572 0.9572 1.5139 Ang
# CHECK-NEXT: site 4: 0.786647 0.106677 0.106677 of the frame
# CHECK-NEXT: kind 3: 1 molecule of 3 particles, 3 in the frame, 0 sites
# CHECK-NEXT: types: S C C
# CHECK-NEXT: charges: 0.2 -0.1 -0.1 e
# CHECK-NEXT: frame: 1.2 1.2 2 Ang
# CHECK-NEXT: kind 4: 1 molecule of 1 particle, 1 in the frame, 0 sites
# CHECK-NEXT: types: NA
# CHECK-NEXT: charges: 1 e
# CHECK-NEXT: left out: 2 molecules with a pair of massive atoms without a constrained distance
# CHECK-NEXT: ensemble:

# JSON: "rigid_groups": {
# JSON-NEXT: "kinds": [
# JSON: "first_particle": 0,
# JSON: "incomplete_exclusions": 0,
# JSON-NEXT: "molecules": 3,
# JSON-NEXT: "outside_exclusions": 0,
# JSON-NEXT: "particles": 3,
# JSON-NEXT: "scattered": 0,
# JSON-NEXT: "sites": [],
# JSON: "first_particle": 9,
# JSON: "molecules": 2,
# JSON: "particles": 4,
# JSON: "place": 3,
# JSON-NEXT: "weights": [
# JSON-NEXT: 0.78664655{{[0-9]*}},
# JSON-NEXT: 0.106676721,
# JSON-NEXT: 0.106676721
# JSON: "first_particle": 17,
# JSON: "first_particle": 20,
# JSON: "left_out": {
# JSON-NEXT: "flexible_frame": 2,
# JSON-NEXT: "site_not_constant_weight": 0
# JSON-NEXT: },
# JSON-NEXT: "molecules": 9

# The facts of a kind are counted and leave no molecule out: without the
# exclusions of the site, the two waters of four sites are a kind as before.
#
# RUN: sed -i -e 's/^  \([123]\)  \(.*\)  4$/  \1  \2/' -e '/^  4  1  2  3$/d' %t/system.top
# RUN: mdir check %t/run.toml | FileCheck %s --check-prefix=FACT
# RUN: mdir check --json %t/run.toml | FileCheck %s --check-prefix=FACT-JSON
#
# FACT: rigid groups: 7 of 9 molecules, 4 kinds
# FACT: kind 2: 2 molecules of 4 particles, 3 in the frame, 1 site
# FACT: site 4: 0.786647 0.106677 0.106677 of the frame
# FACT-NEXT: 2 with a pair of their own that is not excluded
# FACT-NEXT: kind 3:
# FACT-JSON: "first_particle": 9,
# FACT-JSON-NEXT: "frame": [
# FACT-JSON: "incomplete_exclusions": 2,

# The waters of Amber with an extra point on the bisector of the
# hydrogens (amber-opc.test): with their constraints, 387 rigid groups of
# one kind, the weights derived from the lengths of the frame,
# 0.1594 / (2 sqrt(0.87243313^2 - 1.3712051^2 / 4)) = 0.147721 for each
# hydrogen; the peptide is left out. With its bonds to hydrogen
# constrained it is left out as well: those hold 12 of its 231 pairs.
# Without the constraints of the waters no molecule is a rigid group, and
# the reason is that of the frame, not of the site.
#
# RUN: cp %S/Inputs/opc/opc.prmtop %S/Inputs/opc/opc.inpcrd %t
# RUN: sed -e 's/system.top/opc.prmtop/' -e 's/system.gro/opc.inpcrd/' %t/run.toml > %t/opc.toml
# RUN: mdir check %t/opc.toml | FileCheck %s --check-prefix=OPC
# RUN: sed -i -e 's/^rigid_water = true/rigid_water = true\nhydrogen_bonds = true/' %t/opc.toml
# RUN: mdir check %t/opc.toml | FileCheck %s --check-prefix=OPC
# RUN: sed -i -e '/^rigid_water = true/d' -e '/^hydrogen_bonds = true/d' %t/opc.toml
# RUN: mdir check %t/opc.toml | FileCheck %s --check-prefix=FLEXIBLE
#
# OPC: rigid groups: 387 of 388 molecules, 1 kind
# OPC-NEXT: kind 1: 387 molecules of 4 particles, 3 in the frame, 1 site
# OPC-NEXT: types: OW HW HW EP
# OPC-NEXT: charges: 0 0.679142 0.679142 -1.35828 e
# OPC-NEXT: frame: 0.872433 0.872433 1.37121 Ang
# OPC-NEXT: site 4: 0.704559 0.147721 0.147721 of the frame
# OPC-NEXT: left out: 1 molecule with a pair of massive atoms without a constrained distance
# OPC-NEXT: ensemble:
#
# FLEXIBLE: rigid groups: 0 of 388 molecules, 0 kinds
# FLEXIBLE-NEXT: left out: 388 molecules with a pair of massive atoms without a constrained distance
# FLEXIBLE-NEXT: ensemble:

#--- run.toml
[input]
topology   = "system.top"
coordinates = "system.gro"

[energy]
cutoff       = 9.0
pairlist_distance = 10.0

[dynamics]
integrator    = "VELOCITY_VERLET"
time_step     = 0.0005
steps         = 10

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[boundary]
type = "PERIODIC"

[constraints]
rigid_water = true
#--- system.top
[ defaults ]
; nbfunc  comb-rule  gen-pairs  fudgeLJ  fudgeQQ
  1       2          yes        0.5      0.8333

[ atomtypes ]
; name  at.num  mass     charge  ptype  sigma     epsilon
  OW    8       16.0000  0.0     A      0.315061  0.636386
  HW    1        1.0080  0.0     A      0.0       0.0
  MW    0        0.0000  0.0     D      0.0       0.0
  S     16      32.0600  0.0     A      0.36      1.0
  C     6       12.0110  0.0     A      0.34      0.4
  NA    11      22.9900  0.0     A      0.24      0.37

[ moleculetype ]
  SOL   2
[ atoms ]
  1  OW  1  SOL  OW   1  -0.834  16.00000
  2  HW  1  SOL  HW1  1   0.417   1.00800
  3  HW  1  SOL  HW2  1   0.417   1.00800
[ settles ]
  1  1  0.09572  0.15139
[ exclusions ]
  1  2  3
  2  1  3
  3  1  2

[ moleculetype ]
  W4    2
[ atoms ]
  1  OW  1  W4   OW   1   0.0      16.00000
  2  HW  1  W4   HW1  1   0.52422   1.00800
  3  HW  1  W4   HW2  1   0.52422   1.00800
  4  MW  1  W4   MW   1  -1.04844   0.00000
[ settles ]
  1  1  0.09572  0.15139
[ virtual_sites3 ]
  4     1  2  3  1      0.106676721  0.106676721
[ exclusions ]
  1  2  3  4
  2  1  3  4
  3  1  2  4
  4  1  2  3

[ moleculetype ]
  LJ3   2
[ atoms ]
  1  S   1  LJ3  S    1   0.2  32.06000
  2  C   1  LJ3  C1   1  -0.1  12.01100
  3  C   1  LJ3  C2   1  -0.1  12.01100
[ settles ]
  1  1  0.12  0.2
[ exclusions ]
  1  2  3
  2  1  3
  3  1  2

[ moleculetype ]
  NA    1
[ atoms ]
  1  NA  1  NA   NA   1   1.0  22.99000

[ moleculetype ]
  FLX   2
[ atoms ]
  1  OW  1  FLX  OW   1  -0.834  16.00000
  2  HW  1  FLX  HW1  1   0.417   1.00800
  3  HW  1  FLX  HW2  1   0.417   1.00800
[ bonds ]
  1  2  1  0.1  502416.0
  1  3  1  0.1  502416.0
[ angles ]
  2  1  3  1  106.26  628.02

[ system ]
Molecules of five kinds

[ molecules ]
  SOL  3
  W4   2
  LJ3  1
  NA   1
  FLX  2
