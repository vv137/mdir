# [output] observables (D[cv]): the energy of each term that gives
# `observe`, and its derivative in each constant it lists, at every energy
# of the log, without [free_energy]. The first row against the energies and
# derivatives written out by hand from the input positions, for terms of
# the positions, over tuples, over centers, over pairs, and compound; a
# constant the expression does not use is exactly 0. The derivative in the
# position of a wall equals dH/dλ of the same wall taken through
# [free_energy], to the printed digits, at every row.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/dipeptide/dipeptide.prmtop %S/Inputs/dipeptide/dipeptide.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/run.toml
# RUN: cd %t && mdir run run.toml > run.log
# RUN: FileCheck %s --check-prefix=HEADER < %t/run.obs
# RUN: %python %S/Inputs/check_observables.py %t/dipeptide.prmtop %t/dipeptide.inpcrd %t/run.obs %t/run.log | FileCheck %s --check-prefix=PYTHON
#
# RUN: sed -n '/^#--- wall.toml/,/^#--- wall end/p' %s | sed '1d;$d' > %t/wall.toml
# RUN: sed -e 's/^observe    = \["zw"\]//' -e 's/zw)/lambda_wall)/' -e 's/^zw = 6.0//' -e 's/^observables = "wall.obs"/free_energy = "wall.dhdl"/' %t/wall.toml > %t/lambda.toml
# RUN: printf '[free_energy]\n[free_energy.lambdas]\nwall = [6.0]\n' >> %t/lambda.toml
# RUN: cd %t && mdir run wall.toml > wall.log && mdir run lambda.toml > lambda.log
# RUN: awk '!/^#/{print $1, $4}' %t/wall.obs > %t/wall.cols
# RUN: awk '!/^#/{print $1, $3}' %t/wall.dhdl > %t/lambda.cols
# RUN: cmp %t/wall.cols %t/lambda.cols
#
# RUN: sed -e '/^observables/d' %t/run.toml > %t/nofile.toml
# RUN: not mdir check %t/nofile.toml 2>&1 | FileCheck %s --check-prefix=NOFILE
# RUN: sed -e '/^observe /d' %t/run.toml > %t/none.toml
# RUN: not mdir check %t/none.toml 2>&1 | FileCheck %s --check-prefix=NONE
# RUN: sed -e 's/^observe    = \["z0"\]/observe    = ["z1"]/' %t/run.toml > %t/unknown.toml
# RUN: not mdir check %t/unknown.toml 2>&1 | FileCheck %s --check-prefix=UNKNOWN
# RUN: sed -e 's/^r0 = 4.0/r0 = [4.0, 4.5]/' %t/run.toml > %t/list.toml
# RUN: not mdir check %t/list.toml 2>&1 | FileCheck %s --check-prefix=LIST
# RUN: sed -e 's/^observe    = \["z0", "k"\]/observe    = ["z0", "z0"]/' %t/run.toml > %t/twice.toml
# RUN: not mdir check %t/twice.toml 2>&1 | FileCheck %s --check-prefix=TWICE
# RUN: sed -e 's/^\[dynamics\]/[minimize]/' -e '/^integrator/d' -e '/^time_step/d' -e '/^\[ensemble\]/,/^temperature/d' %t/run.toml > %t/minimize.toml
# RUN: not mdir check %t/minimize.toml 2>&1 | FileCheck %s --check-prefix=MINIMIZE

# HEADER:      # step time lower.energy lower.d_z0 upper.energy upper.d_z0 upper.d_k flat.energy flat.d_r0 pull.energy pull.d_r0 soft.energy soft.d_k comp.energy comp.d_k comp.d_m
# HEADER-NEXT: # - ps kcal/mol kcal/mol/z0 kcal/mol kcal/mol/z0 kcal/mol/k kcal/mol kcal/mol/r0 kcal/mol kcal/mol/r0 kcal/mol kcal/mol/k kcal/mol kcal/mol/k kcal/mol/m
# HEADER-NEXT: 0 0.000000 5035.071714 3978.941620 {{.*}} -2969.590190 338.946279 108.296187 -65.816772
# HEADER:      {{^}}20 0.010000

# PYTHON-NOT: FAILED
# PYTHON:     lower.energy ok
# PYTHON:     comp.d_m ok

# NOFILE: the term 'lower' gives 'observe', but [output] has no 'observables'
# NONE: [output] names 'observables', but no term gives 'observe'
# UNKNOWN: the term 'lower' observes 'z1', which is not a constant of the term given as one number
# LIST: the term 'flat' observes 'r0', which has a value for each particle or tuple
# TWICE: 'z0' is observed twice
# MINIMIZE: 'observables' is written at the energies of a run of dynamics

#--- run.toml
[input]
topology    = "dipeptide.prmtop"
coordinates = "dipeptide.inpcrd"
[output]
energy_interval = 5
observables = "run.obs"
[energy]
cutoff            = 9.0
pairlist_distance = 10.0
electrostatics    = "CUTOFF"
[[energy.external]]
name       = "lower"
expression = "0.5*k*max(0, z0 - z)^2"
selection  = ":WAT"
observe    = ["z0"]
k  = 10.0
z0 = 6.0
[[energy.external]]
name       = "upper"
expression = "0.5*k*max(0, z - z0)^2"
selection  = ":WAT"
observe    = ["z0", "k"]
k  = 10.0
z0 = 20.0
[[energy.bond]]
name       = "flat"
expression = "k*max(0, r - r0)^2"
particles  = [[2, 19], [5, 15]]
observe    = ["r0"]
k  = 10.0
r0 = 4.0
[[energy.bond]]
name       = "pull"
expression = "k*(r - r0)^2"
groups     = [":1-2", ":3"]
observe    = ["r0"]
k  = 2.0
r0 = 3.0
[[energy.pair]]
name       = "soft"
expression = "k*exp(-r/1.5)"
observe    = ["k"]
k = 0.5
[[energy.compound]]
name       = "comp"
expression = "k*(distance(p1, p3) - 3)^2"
particles  = [[2, 5, 7]]
observe    = ["k", "m"]
k = 1.5
m = 1.0
[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.0005
steps      = 20
[ensemble]
ensemble    = "NVE"
temperature = 0.0
[boundary]
type = "PERIODIC"
[execution]
target    = "CPU"
precision = "DOUBLE"
#--- end

#--- wall.toml
[input]
topology    = "dipeptide.prmtop"
coordinates = "dipeptide.inpcrd"
[output]
energy_interval = 5
observables = "wall.obs"
[energy]
cutoff            = 9.0
pairlist_distance = 10.0
electrostatics    = "CUTOFF"
[[energy.external]]
name       = "membrane"
expression = "0.5*k*max(0, abs(z - zc) - zw)^2"
selection  = ":WAT"
scaling    = "NONE"
observe    = ["zw"]
k  = 10.0
zc = 13.0
zw = 6.0
[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.0005
steps      = 20
[ensemble]
ensemble    = "NVE"
temperature = 0.0
[boundary]
type = "PERIODIC"
[execution]
target    = "CPU"
precision = "DOUBLE"
#--- wall end
