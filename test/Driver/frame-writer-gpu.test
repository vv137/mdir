# The test of frame-writer.test on a GPU (D[async-output], #113): the
# call of each frame copies the positions and the numbers of the particles
# within the device, on the stream of the kernels, and from there to pinned
# memory of the host on a stream of copies, which the thread of the frames
# waits for. Each write is held back by 100 ms, so the ring fills and the
# steps go on past frames whose copies the thread has not yet read. The
# trajectories in DCD and H5MD, the energies, and the checkpoints are those
# of a run whose frames are not held back, byte for byte, and so are those
# of a run stopped at its first checkpoint and continued.
#
# REQUIRES: hdf5, cuda, h5py
#
# RUN: rm -rf %t && mkdir -p %t/plain %t/held %t/part
# RUN: sed -e 's|Inputs/|%S/Inputs/|' \
# RUN:     -e 's|energy_interval = 50|energy_interval = 10\nenergy = "energies.txt"\ntrajectory = "run.dcd"\ntrajectory_interval = 10\ncheckpoint = "run.h5"\ncheckpoint_interval = 100|' \
# RUN:     %S/mixture.toml > %t/run.toml
# RUN: printf '[execution]\ntarget = "GPU"\ndeterministic = true\n' >> %t/run.toml
# RUN: cp %t/run.toml %t/plain/run.toml && cp %t/run.toml %t/held/run.toml && cp %t/run.toml %t/part/run.toml
# RUN: sed -e 's|run.dcd|run.h5md|' -e 's|run.h5"|exact.h5"|' -e 's|energies.txt|exact.txt|' %t/run.toml > %t/plain/exact.toml
# RUN: cp %t/plain/exact.toml %t/held/exact.toml
# RUN: cd %t/plain && mdir run run.toml > out && mdir run exact.toml > /dev/null
# RUN: cd %t/held && env MDIR_FRAME_WRITE_DELAY=100 MDIR_CHECKPOINT_TIMES=1 mdir run run.toml > out 2> err
# RUN: cd %t/held && env MDIR_FRAME_WRITE_DELAY=100 mdir run exact.toml > /dev/null
# RUN: FileCheck %s < %t/held/err
# RUN: cmp %t/plain/run.dcd %t/held/run.dcd
# RUN: cmp %t/plain/energies.txt %t/held/energies.txt
# RUN: cmp %t/plain/exact.txt %t/held/exact.txt
# RUN: %h5md_python -c "import h5py, numpy, sys; a, b = (h5py.File(p, 'r')['particles/all/position/value'][()] for p in sys.argv[1:]); print('frames', len(a), 'identical' if a.shape == b.shape and numpy.array_equal(a.view(numpy.uint64), b.view(numpy.uint64)) else 'different')" %t/plain/run.h5md %t/held/run.h5md | FileCheck %s --check-prefix=EXACT
# RUN: grep 'INFO: ' %t/plain/out > %t/plain/rows
# RUN: grep 'INFO: ' %t/held/out > %t/held/rows
# RUN: diff %t/plain/rows %t/held/rows
# RUN: mdir checkpoint %t/plain/run.h5 %t/held/run.h5 | FileCheck %s --check-prefix=SAME
#
# RUN: cd %t/part && env MDIR_FRAME_WRITE_DELAY=100 %python %S/Inputs/exit_status.py mdir run --continue --max-walltime 0.000001 run.toml | FileCheck %s --check-prefix=STOP
# RUN: cd %t/part && env MDIR_FRAME_WRITE_DELAY=100 mdir run --continue run.toml > /dev/null
# RUN: cmp %t/plain/run.dcd %t/part/run.dcd
# RUN: cmp %t/plain/energies.txt %t/part/energies.txt
# RUN: mdir checkpoint %t/plain/run.h5 %t/part/run.h5 | FileCheck %s --check-prefix=SAME

# CHECK: MDIR: times of the frame at step {{[0-9]+}}: copy {{[0-9.]+}} ms, wait {{[1-9][0-9]+}}.{{[0-9]}} ms
# CHECK: MDIR: times of the write of the frame at step {{[0-9]+}}: copy

# EXACT: frames 20 identical

# STOP: MDIR: stopped after step 100 on the wall time
# STOP: exit status 75

# SAME: the states are identical
