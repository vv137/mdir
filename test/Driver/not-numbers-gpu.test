# A run whose positions are no longer numbers stops with a word, on a
# device, with either neighbor structure (D107): a time step of 0.5 ps
# sends the particles beyond any cell within a few steps.
#
# REQUIRES: cuda
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/ff19sb/ff19.prmtop %S/Inputs/ff19sb/ff19.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/groups.toml
# RUN: sed 's/neighbor_structure = "GROUPS"/neighbor_structure = "MATRIX"/' %t/groups.toml > %t/matrix.toml
# RUN: not mdir run %t/groups.toml 2>&1 | FileCheck %s
# RUN: not mdir run %t/matrix.toml 2>&1 | FileCheck %s

# CHECK: mdir: {{(a position is not a number or is|[0-9]+ positions are not numbers or are)}} far outside the cell at a build of the neighbor structure; the run has failed

#--- run.toml
[input]
topology   = "ff19.prmtop"
coordinates = "ff19.inpcrd"

[output]
energy_interval = 10

[energy]
cutoff        = 9.0
pairlist_distance = 10.0
electrostatics = "PME"

[dynamics]
integrator        = "VELOCITY_VERLET"
time_step         = 0.5
steps             = 100

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[constraints]
hydrogen_bonds = true
rigid_water = true

[boundary]
type = "PERIODIC"

[execution]
target    = "GPU"
precision = "MIXED"
neighbor_structure = "GROUPS"
#--- end
