# REQUIRES: cuda
# The sums of a block of the tuples evaluated once (D[tuple-block-sums]):
# the bonded terms, the 1-4 pairs, and the excluded pairs of a solvated
# protein, with the table of a block (MDIR_TUPLE_SUMS=blocks: this system is
# smaller than the run that takes it by default) against an atomic for each
# value (=atomics), both in mixed precision, and each against the double
# mode. The two ways add the same values in another order, so they agree to
# the rounding of f32 sums: two runs with atomics differ by about 1e-6 of
# the RMS force on the systems of the Amber suite, so the tolerance is 2e-6.
# The default lowering chooses on the host by the count of the tuples.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/ff19sb/ff19.prmtop %S/Inputs/ff19sb/ff19.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/blocks.toml
# RUN: sed -e 's/blocks.h5/atomics.h5/' %t/blocks.toml > %t/atomics.toml
# RUN: sed -e 's/blocks.h5/double.h5/' -e 's/"MIXED"/"DOUBLE"/' %t/blocks.toml > %t/double.toml
#
# RUN: env MDIR_TUPLE_SUMS=blocks MDIR_PRINT_AFTER=convert-md-exec-to-gpu mdir run %t/blocks.toml 2>&1 >/dev/null | FileCheck %s --check-prefix=BLOCKS
# RUN: env MDIR_TUPLE_SUMS=atomics MDIR_PRINT_AFTER=convert-md-exec-to-gpu mdir run %t/atomics.toml 2>&1 >/dev/null | FileCheck %s --check-prefix=ATOMICS
# BLOCKS: red.shared.add.f32
# ATOMICS-NOT: red.shared.add
#
# RUN: cd %t && env MDIR_TUPLE_SUMS=blocks mdir run blocks.toml > blocks.log
# RUN: cd %t && env MDIR_TUPLE_SUMS=atomics mdir run atomics.toml > atomics.log
# RUN: cd %t && env MDIR_TUPLE_SUMS=blocks mdir run double.toml > double.log
# RUN: mdir checkpoint --print=forces %t/blocks.h5 > %t/blocks.forces
# RUN: mdir checkpoint --print=forces %t/atomics.h5 > %t/atomics.forces
# RUN: mdir checkpoint --print=forces %t/double.h5 > %t/double.forces
# RUN: %python %S/Inputs/compare_forces_rms.py %t/blocks.forces %t/atomics.forces 2e-6 "blocks against atomics" | FileCheck %s
# RUN: %python %S/Inputs/compare_forces_rms.py %t/blocks.forces %t/double.forces 1e-4 "blocks against double" | FileCheck %s
# RUN: %python %S/Inputs/compare_forces_rms.py %t/atomics.forces %t/double.forces 1e-4 "atomics against double" | FileCheck %s
# CHECK: relative difference {{.*}} ok

#--- run.toml
[input]
topology    = "ff19.prmtop"
coordinates = "ff19.inpcrd"
[output]
energy_interval = 0
checkpoint = "blocks.h5"
checkpoint_interval = 1
[energy]
cutoff            = 9.0
pairlist_distance = 10.0
electrostatics    = "PME"
[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 1e-9
steps      = 1
[ensemble]
ensemble    = "NVE"
temperature = 0.0
[boundary]
type = "PERIODIC"
[execution]
target    = "GPU"
precision = "MIXED"
#--- end
