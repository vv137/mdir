# The dipeptide in OPC of amber-opc.test at constant energy with particle
# mesh Ewald, the direct sum shifted to 0 at the cutoff, and rigid water:
# the run that a plain cutoff could not conserve. Over 0.5 ps the total
# energy stays within 0.3 kcal/mol while the potential energy changes by
# 260 kcal/mol; its largest change falls from 5.9e-5 of it at 1 fs to
# 7.8e-6 at 0.5 fs, the bonds of hydrogen of the peptide being free.
#
# The forces of the reciprocal sum do not add up to 0 on the grid, so the
# momentum is not kept: 2 amu nm/ps after 100 steps here, a velocity of the
# center of mass of 3e-4 nm/ps. sander removes the net force at every step
# by default; MDIR removes the motion of the center of mass with
# 'comm_period'.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/opc/opc.prmtop %S/Inputs/opc/opc.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/run.toml
# RUN: mdir run %t/run.toml | FileCheck %s

# CHECK: INFO:         0         0.0000 {{ *}}-2811.4253 {{ *}}-3522.3477
# CHECK: MDIR: the total energy changed by {{[0-9.]+}}e-0{{[5-9]}} of its value

#--- run.toml
[input]
prmtopfile = "opc.prmtop"
ambcrdfile = "opc.inpcrd"

[energy]
cutoffdist    = 9.0
pairlistdist  = 10.0
electrostatic = "PME"
pme_shift     = true

[dynamics]
integrator    = "VVER"
timestep      = 0.001
nsteps        = 100
eneout_period = 50

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[constraints]
fast_water = true

[boundary]
type = "PBC"
#--- end
