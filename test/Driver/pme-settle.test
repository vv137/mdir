# The dipeptide in OPC of amber-opc.test at constant energy with particle
# mesh Ewald, the direct sum shifted to 0 at the cutoff, and rigid water:
# the run that a plain cutoff could not conserve. Over 0.5 ps the total
# energy stays within 0.3 kcal/mol while the potential energy changes by
# 260 kcal/mol; its largest change falls from 5.9e-5 of it at 1 fs to
# 7.8e-6 at 0.5 fs, the bonds of hydrogen of the peptide being free.
#
# The forces of the reciprocal sum do not add up to 0 on the grid, so the
# momentum is not kept: 2 amu nm/ps after 100 steps here, a velocity of the
# center of mass of 3e-4 nm/ps. sander removes the net force at every step
# by default; MDIR removes the motion of the center of mass with
# 'center_of_mass_interval'.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/opc/opc.prmtop %S/Inputs/opc/opc.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/run.toml
# RUN: mdir run %t/run.toml | FileCheck %s
# RUN: sed -e 's|^steps *= 100|steps = 2|' -e 's|energy_interval = 50|energy_interval = 1|' \
# RUN:     %t/run.toml > %t/start.toml
# RUN: mdir run %t/start.toml | FileCheck %s --check-prefix=START

# CHECK: INFO:         0         0.0000 {{ *}}-2811.4253 {{ *}}-3522.3477
# CHECK: MDIR: the total energy changed by {{[0-9.]+}}e-0{{[5-9]}} of its value

# At the start no step has given the forces of the constraints; their
# virial is that of the forces that keep the accelerations on the
# constraints, less twice the kinetic energy within the rigid waters. The
# pressure of step 0 then continues those of the steps after it, which
# fall by about 135 atm per step here, rather than being 20000 atm.
#
# START: INFO:         0 {{.*}} -818.5888 {{ *}}695.9850
# START: INFO:         1 {{.*}} -950.4970 {{ *}}554.4190
# START: INFO:         2 {{.*}} -1078.0753 {{ *}}424.2331

#--- run.toml
[input]
topology   = "opc.prmtop"
coordinates = "opc.inpcrd"

[output]
energy_interval = 50
[energy]
cutoff        = 9.0
pairlist_distance = 10.0
electrostatics = "PME"
coulomb_modifier     = "POTENTIAL_SHIFT"

[dynamics]
integrator    = "VELOCITY_VERLET"
time_step     = 0.001
steps         = 100

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[constraints]
rigid_water = true

[boundary]
type = "PERIODIC"
#--- end
