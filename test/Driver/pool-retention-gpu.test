# The pool of device blocks does not grow with the length of a run
# (D312, #471): the dipeptide in water with groups, 200 and
# 3,000 steps. A loop over the groups takes its positions and fields in the
# order of the places, in buffers sized by the room of the structure's
# places. Sized by the number of places that a build occupied, which
# changes by 64 from one build to another, they left three blocks in the
# pool for each new number, since the pool reuses a block only for a
# request of the same size: runs of 1,000 steps took 3 to 6 blocks more
# from the driver than one of 100 steps (7 runs on an RTX 4090). A buffer
# of the runtime that a growth of the structure replaces goes back to the
# driver, so the blocks held from the driver (taken less returned) are the
# same in both runs, up to a slack of 2 that does not grow with the run
# (see the script).
#
# The short run was of 100 steps until the pool split larger pieces
# (D[device-pool-split]). The run's peak in use is reached between steps
# 100 and 200 (1.0 and 1.1 MiB), and the blocks held rise there once: 95
# to 97 on the pool that reused a block only for its own size, 70 to 73
# arenas on the pool that splits, then the same up to 10,000 steps (runs
# on an RTX 4090). From 100 steps the second was past the slack; from 200
# steps both hold the same count, in 5 of 5 runs each. The defect still
# fails the test from 200 steps: the lowering of D312 undone (the gather
# buffers sized by the places that a build occupied) with the pool that
# reuses a block only for its own size, or with the pool that splits
# limited to exact sizes, held 98 blocks at 200 steps and 104 or 107 at
# 3,000 (6 of 6 runs fail). With the pool that splits, the same lowering
# holds 73 and 73: the pool serves the changing sizes from larger pieces.
#
# REQUIRES: cuda
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' | sed 's|INPUTS|%S/Inputs/dipeptide|' > %t/run.toml
# RUN: sed 's/^steps = 200$/steps = 3000/' %t/run.toml > %t/long.toml
# RUN: cd %t && env MDIR_DEVICE_MEMORY=2 mdir run run.toml > short.log 2>&1
# RUN: cd %t && env MDIR_DEVICE_MEMORY=2 mdir run long.toml > long.log 2>&1
# RUN: %python %S/Inputs/check_pool_retention.py %t/short.log %t/long.log 2 | FileCheck %s
#
# CHECK: short run: {{[0-9]+}} blocks of the driver
# CHECK: long run: {{[0-9]+}} blocks of the driver
# CHECK: the pool did not grow with the length of the run

#--- run.toml
[input]
topology = "INPUTS/dipeptide.prmtop"
coordinates = "INPUTS/dipeptide.inpcrd"
[energy]
cutoff = 8.0
pairlist_distance = 8.5
electrostatics = "PME"
[constraints]
hydrogen_bonds = true
rigid_water = true
[dynamics]
time_step = 0.002
steps = 200
[output]
energy_interval = 100
[ensemble]
ensemble = "NVE"
temperature = 300.0
[boundary]
type = "PERIODIC"
[execution]
target = "GPU"
precision = "MIXED"
neighbor_structure = "GROUPS"
#--- end
