# GRID: MDIR: domain grid 2 x 2 x 2, local transport, directed traversal
# REBUILD: mdrt_dist: migrate:
# RUN: sed 's/domains = 8/domains = [1, 0, 2]/' %t/grid.toml > %t/bad.toml
# RUN: not mdir run %t/bad.toml 2>&1 | FileCheck %s --check-prefix=ZERO
# ZERO: domain division must be a positive integer
# RUN: sed 's/domains = 8/domains = [2, 2]/' %t/grid.toml > %t/bad.toml
# RUN: not mdir run %t/bad.toml 2>&1 | FileCheck %s --check-prefix=SHAPE
# SHAPE: domains grid requires three positive integers
# RUN: sed 's/domains = 8/domains = [9223372036854775807, 2, 1]/' %t/grid.toml > %t/bad.toml
# RUN: not mdir run %t/bad.toml 2>&1 | FileCheck %s --check-prefix=OVERFLOW
# OVERFLOW: product of domain divisions overflows i64
