# RUN: not mdir run %t/refused.toml 2>&1 | FileCheck %s --check-prefix=REFUSE-4
# REFUSE-4: at least 0
# RUN: sed 's/^#PME$/kernel = "PROLATE"\ncontinuity = 2\nbasis_terms = 3/' %t/base.toml > %t/refused.toml
# RUN: not mdir run %t/refused.toml 2>&1 | FileCheck %s --check-prefix=REFUSE-5
# REFUSE-5: continuity + 2
# RUN: sed 's/^#PME$/kernel = "PROLATE"\ncontinuity = 2\nbasis_terms = 41/' %t/base.toml > %t/refused.toml
# RUN: not mdir run %t/refused.toml 2>&1 | FileCheck %s --check-prefix=REFUSE-6
# REFUSE-6: at most 40
# RUN: sed 's/^#PME$/kernel = "PROLATE"\ncontinuity = 2\nwindow = "CUBIC"/' %t/base.toml > %t/refused.toml
# RUN: not mdir run %t/refused.toml 2>&1 | FileCheck %s --check-prefix=REFUSE-7
# REFUSE-7: BSPLINE or PROLATE
# RUN: sed 's/^#PME$/kernel = "PROLATE"\ncontinuity = 2\nwindow_bandwidth = 9.0/' %t/base.toml > %t/refused.toml
# RUN: not mdir run %t/refused.toml 2>&1 | FileCheck %s --check-prefix=REFUSE-8
# REFUSE-8: only to a PROLATE window
# RUN: sed 's/^#PME$/kernel = "PROLATE"\ncontinuity = 2\norder = 5/' %t/base.toml > %t/refused.toml
