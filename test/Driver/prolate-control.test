# REFUSE-11: 'beta' is for kernel

#--- run.toml
[input]
topology   = "opc.prmtop"
coordinates = "opc.inpcrd"

[output]
energy_interval = 0
[energy]
cutoff        = 9.0
pairlist_distance = 10.0
electrostatics = "PME"

[pme]
#PME

[dynamics]
integrator    = "VELOCITY_VERLET"
time_step     = 0.0005
steps         = 0

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[boundary]
type = "PERIODIC"
#--- end
