# The keys of [pme] for the prolate kernel (D[prolate-ewald]): what belongs
# to the other kernel is refused, not ignored, and so is an order of the
# window outside 5 to 8.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/opc/opc.prmtop %S/Inputs/opc/opc.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/base.toml
# RUN: sed 's/^#PME$/kernel = "PROLATE"\nbeta = 0.35/' %t/base.toml > %t/beta.toml
# RUN: not mdir run %t/beta.toml 2>&1 | FileCheck %s --check-prefix=BETA
# BETA: 'beta' is for kernel = "GAUSSIAN"
# RUN: sed 's/^#PME$/kernel = "PROLATE"\ninfluence = "OPTIMAL"/' %t/base.toml > %t/influence.toml
# RUN: not mdir run %t/influence.toml 2>&1 | FileCheck %s --check-prefix=INFLUENCE
# INFLUENCE: 'influence' is for kernel = "GAUSSIAN"
# RUN: sed 's/^#PME$/bandwidth = 12.0/' %t/base.toml > %t/bandwidth.toml
# RUN: not mdir run %t/bandwidth.toml 2>&1 | FileCheck %s --check-prefix=BANDWIDTH
# BANDWIDTH: 'bandwidth' is for kernel = "PROLATE"
# RUN: sed 's/^#PME$/window_bandwidth = 12.0/' %t/base.toml > %t/window.toml
# RUN: not mdir run %t/window.toml 2>&1 | FileCheck %s --check-prefix=WINDOW
# WINDOW: 'window_bandwidth' is for kernel = "PROLATE"
# RUN: sed 's/^#PME$/kernel = "PROLATE"\norder = 4/' %t/base.toml > %t/order4.toml
# RUN: not mdir run %t/order4.toml 2>&1 | FileCheck %s --check-prefix=ORDER4
# ORDER4: expected 5, 6, 7, or 8 points of the window for 'order' with kernel = "PROLATE"
# RUN: sed 's/^#PME$/order = 5/' %t/base.toml > %t/order5.toml
# RUN: not mdir run %t/order5.toml 2>&1 | FileCheck %s --check-prefix=ORDER5
# ORDER5: expected 4, 6, or 8 for 'order'
# RUN: sed 's/^#PME$/kernel = "ELLIPTIC"/' %t/base.toml > %t/kernel.toml
# RUN: not mdir run %t/kernel.toml 2>&1 | FileCheck %s --check-prefix=KERNEL
# KERNEL: expected one of GAUSSIAN, PROLATE for 'kernel', got 'ELLIPTIC'

#--- run.toml
[input]
topology   = "opc.prmtop"
coordinates = "opc.inpcrd"

[output]
energy_interval = 0
[energy]
cutoff        = 9.0
pairlist_distance = 10.0
electrostatics = "PME"

[pme]
#PME

[dynamics]
integrator    = "VELOCITY_VERLET"
time_step     = 0.0005
steps         = 0

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[boundary]
type = "PERIODIC"
#--- end
