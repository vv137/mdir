# RUN: not mdir run %t/refused.toml 2>&1 | FileCheck %s --check-prefix=REFUSE-2
# REFUSE-2: is for kernel
# RUN: sed 's/^#PME$/kernel = "PROLATE"\ncontinuity = 4/' %t/base.toml > %t/refused.toml
# RUN: not mdir run %t/refused.toml 2>&1 | FileCheck %s --check-prefix=REFUSE-3
