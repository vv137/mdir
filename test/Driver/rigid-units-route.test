# The route of the rigid units, `[performance] rigid_units`
# (D424): `ON` builds the pair term over the segments of the
# kinds it takes, and refuses, naming the reason, every program where the
# route cannot apply; `AUTO` and `OFF` keep the general program (the corpus
# of D406 checks that it is `main`'s). `mdir check` reports, for each kind,
# whether it is taken and why.
#
# RUN: rm -rf %t && mkdir -p %t && cd %t
# RUN: cp %S/Inputs/opc/opc.prmtop %S/Inputs/opc/opc.inpcrd %t
# RUN: sed -n '/^#--- base.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/general.toml
# RUN: cp %t/general.toml %t/base.toml && printf '[performance]\nrigid_units = "ON"\n' >> %t/base.toml
# RUN: mdir emit --stage=module %t/base.toml | FileCheck %s --check-prefix=ROUTE
# RUN: mdir emit --stage=module %t/general.toml | FileCheck %s --check-prefix=GENERAL
# RUN: sed 's/"ON"/"off"/' %t/base.toml > %t/off.toml
# RUN: mdir emit --stage=module %t/off.toml | FileCheck %s --check-prefix=GENERAL
# RUN: sed 's/"ON"/"AUTO"/' %t/base.toml > %t/auto.toml
# RUN: mdir emit --stage=module %t/auto.toml | FileCheck %s --check-prefix=GENERAL
#
# ROUTE: md.tuple_set @kind_0 on(@atoms) arity(4) orientation(ordered) disjoint
# ROUTE: md.tuple_set @kind_anchors on(@atoms) arity(2) orientation(ordered)
# ROUTE: md.tuple_set @segment_1_1 on(@atoms) arity(2) orientation(unordered)
# ROUTE: md.kind_pairs
# GENERAL-NOT: md.kind_pairs
# GENERAL-NOT: @kind_0
#
# The report of `mdir check`: the kind taken under ON with its nominal
# radius, which the input (an inpcrd, within the margin of 0.001 Ang) does
# not exceed, the rest's anchors, and the reach against half the least face
# width; under AUTO what ON would take; under OFF no kind. The JSON report
# says the same.
# RUN: mdir check %t/base.toml | FileCheck %s --check-prefix=CHECK-ON
# CHECK-ON: rigid units: ON: the units (ON was given)
# CHECK-ON-NEXT: kind 1: taken, 387 units of 4 places (3 in the frame, 1 site), radius 0.8734 Ang{{$}}
# CHECK-ON-NEXT: the rest: 22 particles, 12 anchored, radius 1.0910 Ang{{$}}
# CHECK-ON-NEXT: reach: 12.18 Ang, half the least face width 12.58 Ang
# RUN: mdir check %t/auto.toml | FileCheck %s --check-prefix=CHECK-AUTO
# CHECK-AUTO: rigid units: AUTO: general (AUTO takes the general route until its rule is measured)
# CHECK-AUTO-NEXT: kind 1: ON would take: 387 units of 4 places
# RUN: mdir check %t/off.toml | FileCheck %s --check-prefix=CHECK-OFF
# CHECK-OFF: rigid units: OFF: general (OFF was given)
# CHECK-OFF-NOT: kind 1:
# RUN: mdir check --json %t/base.toml | %python -c "import json, sys; r = json.load(sys.stdin)['run']['rigid_units']; k = r['kinds'][0]; print(r['requested'], r['route'], k['kind'], k['taken'], k['units'], k['sites'], '%%.4f %%.4f %%.4f %%.5f' %% (k['radius_angstrom'], k['constrained_radius_angstrom'], k['input_distance_angstrom'], k['widened_angstrom']), r['rest']['anchored'], '%%.2f %%.2f' %% (r['reach_angstrom'], r['half_least_face_width_angstrom']))" | FileCheck %s --check-prefix=JSON
# JSON: ON units 1 True 387 1 0.8734 0.8734 0.8733 0.00000 12 12.18 12.58
#
# A radius widened at the input (the maintainer's ruling on #915): the
# rhombic dodecahedron of 403 TIP3P waters in nm to three decimals has its
# bonds O-H up to 1.0091 Ang at the input, beyond the 0.9582 Ang of the
# constrained frame and its margin; the radius becomes 1.0101 Ang, and the
# reach 7 + 2 x 1.0101 Ang still fits half the least face width, 9.192 Ang.
# RUN: cp %S/Inputs/triclinic/water.top %S/Inputs/triclinic/dodecahedron.gro %t
# RUN: sed -n '/^#--- dodecahedron.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/dodecahedron.toml
# RUN: mdir check %t/dodecahedron.toml | FileCheck %s --check-prefix=WIDENED
# WIDENED: kind 1: taken, 403 units of 3 places (3 in the frame, 0 sites), radius 1.0101 Ang (0.9582 constrained, widened by 0.052 Ang to the input's 1.0091)
# WIDENED-NEXT: the rest: 0 particles, 0 anchored
# WIDENED-NEXT: reach: 9.02 Ang, half the least face width 9.192 Ang
# RUN: mdir check --json %t/dodecahedron.toml | %python -c "import json, sys; k = json.load(sys.stdin)['run']['rigid_units']['kinds'][0]; print('%%.4f %%.4f %%.4f' %% (k['radius_angstrom'], k['input_distance_angstrom'], k['widened_angstrom']))" | FileCheck %s --check-prefix=WIDENED-JSON
# WIDENED-JSON: 1.0101 1.0091 0.0519
#
# A water split by a face of the cell at the input: its second atom moved by
# the lattice vector c of the dodecahedron (tilted), and in another file by
# a, as a file that wraps each atom on its own writes it. Each bond is taken
# in its image nearest the anchor, so the radius is the same as above.
# RUN: %python %S/Inputs/rigid_units_split.py %t/dodecahedron.gro %t/split-c.gro 2 c
# RUN: %python %S/Inputs/rigid_units_split.py %t/dodecahedron.gro %t/split-a.gro 2 a
# RUN: sed 's/"dodecahedron.gro"/"split-c.gro"/' %t/dodecahedron.toml > %t/split-c.toml
# RUN: sed 's/"dodecahedron.gro"/"split-a.gro"/' %t/dodecahedron.toml > %t/split-a.toml
# RUN: mdir check %t/split-c.toml | FileCheck %s --check-prefix=WIDENED
# RUN: mdir check %t/split-a.toml | FileCheck %s --check-prefix=WIDENED
#
# Amber's extra point at an input off the constraints (the maintainer's
# ruling on #915): its definition is not linear in the frame, so where the
# input does not hold the constraints the units' weights place it
# elsewhere than the general route, and the first evaluation differs. ON
# warns, in the text and the JSON of `mdir check`, naming the kind, the
# largest violation, and how far the sites move; the input is not changed.
# The dipeptide's inpcrd is off by 2.5e-3; the three waters put on their
# constraints (Inputs/constrain_opc.py) give no warning; AUTO does not warn.
# RUN: mdir check %t/base.toml 2>&1 | FileCheck %s --check-prefix=OFFC
# OFFC: mdir: warning: kind 1: 387 of 387 molecules lie off their constraints at the input, the largest by 0.00254 (|r^2/d^2 - 1|, beyond the tolerance 0.0001); its sites are placed by a definition that is not linear in the frame, which the units take by its weights, so the first evaluation places them up to 0.000288 Ang from the topology's place
# RUN: mdir check --json %t/base.toml | %python -c "import json, sys; d = json.load(sys.stdin); o = d['run']['rigid_units']['kinds'][0]['input_off_constraints']; print([w['code'] for w in d['warnings'] if w['code'].startswith('rigid')], o['molecules'], '%%.3g %%.3g' %% (o['largest_violation'], o['site_offset_angstrom']))" | FileCheck %s --check-prefix=OFFC-JSON
# OFFC-JSON: ['rigid_units_off_constraints'] 387 0.00254 0.000288
# RUN: mdir check %t/auto.toml 2>&1 | FileCheck %s --check-prefix=OFFC-AUTO
# OFFC-AUTO-NOT: off their constraints
# RUN: cp %S/Inputs/opc/three.prmtop %t && %python %S/Inputs/constrain_opc.py %S/Inputs/opc/three.inpcrd %t/held.inpcrd
# RUN: sed -e 's/"opc.prmtop"/"three.prmtop"/' -e 's/"opc.inpcrd"/"held.inpcrd"/' %t/base.toml > %t/held.toml
# RUN: mdir check %t/held.toml 2>&1 | FileCheck %s --check-prefix=HELD
# HELD: rigid units: ON: the units
# HELD-NOT: off their constraints
# RUN: mdir check --json %t/held.toml | %python -c "import json, sys; d = json.load(sys.stdin); o = d['run']['rigid_units']['kinds'][0]['input_off_constraints']; print([w['code'] for w in d['warnings'] if w['code'].startswith('rigid')], o['molecules'])" | FileCheck %s --check-prefix=HELD-JSON
# HELD-JSON: [] 0
#
# A value that is not a choice.
# RUN: sed 's/"ON"/"YES"/' %t/base.toml > %t/yes.toml
# RUN: not mdir check %t/yes.toml 2>&1 | FileCheck %s --check-prefix=VALUE
# VALUE: expected one of AUTO, ON, OFF for 'rigid_units', got 'YES'
#
# The refusals of the program.
# RUN: sed 's/"GPU"/"CPU"/' %t/base.toml > %t/cpu.toml
# RUN: not mdir emit --stage=module %t/cpu.toml 2>&1 | FileCheck %s --check-prefix=CPU
# CPU: 'rigid_units = "ON"' cannot apply: the CPU target: lists of units run on a GPU
#
# RUN: sed 's/"MIXED"/"DOUBLE"/' %t/base.toml > %t/double.toml
# RUN: not mdir emit --stage=module %t/double.toml 2>&1 | FileCheck %s --check-prefix=DOUBLE
# DOUBLE: 'rigid_units = "ON"' cannot apply: precision DOUBLE: the units take MIXED
# RUN: sed 's/"MIXED"/"SINGLE"/' %t/base.toml > %t/single.toml
# RUN: not mdir emit --stage=module %t/single.toml 2>&1 | FileCheck %s --check-prefix=SINGLE
# SINGLE: 'rigid_units = "ON"' cannot apply: precision SINGLE: the units take MIXED
#
# RUN: sed 's/^precision = "MIXED"/precision = "MIXED"\ndeterministic = true/' %t/base.toml > %t/deterministic.toml
# RUN: not mdir emit --stage=module %t/deterministic.toml 2>&1 | FileCheck %s --check-prefix=DETERMINISTIC
# DETERMINISTIC: 'rigid_units = "ON"' cannot apply: the deterministic mode
#
# RUN: sed -e 's/\[dynamics\]/[minimize]/' -e '/integrator/d' -e '/time_step/d' %t/base.toml > %t/minimize.toml
# RUN: not mdir emit --stage=module %t/minimize.toml 2>&1 | FileCheck %s --check-prefix=MINIMIZE
# MINIMIZE: 'rigid_units = "ON"' cannot apply: a minimization
#
# RUN: sed -e 's/"PME"/"CUTOFF"/' -e 's/"PERIODIC"/"NONE"/' %t/base.toml > %t/open.toml
# RUN: not mdir emit --stage=module %t/open.toml 2>&1 | FileCheck %s --check-prefix=OPEN
# OPEN: 'rigid_units = "ON"' cannot apply: a cell that is not periodic
#
# RUN: cp %t/base.toml %t/fe.toml && printf '[free_energy]\ncouple = ":1-3"\nstate = 0\n[free_energy.lambdas]\ncoulomb = [1.0, 0.0]\nvdw = [1.0, 1.0]\n' >> %t/fe.toml
# RUN: not mdir emit --stage=module %t/fe.toml 2>&1 | FileCheck %s --check-prefix=FE
# FE: 'rigid_units = "ON"' cannot apply: [free_energy]
#
# RUN: sed 's/^electrostatics = "PME"/electrostatics = "PME"\nlennard_jones = "PME"/' %t/base.toml > %t/ljpme.toml
# RUN: not mdir emit --stage=module %t/ljpme.toml 2>&1 | FileCheck %s --check-prefix=LJPME
# LJPME: 'rigid_units = "ON"' cannot apply: lennard_jones = "PME"
#
# RUN: cp %t/base.toml %t/prolate.toml && printf '[pme]\nkernel = "PROLATE"\n' >> %t/prolate.toml
# RUN: not mdir emit --stage=module %t/prolate.toml 2>&1 | FileCheck %s --check-prefix=PROLATE
# PROLATE: 'rigid_units = "ON"' cannot apply: a kernel of PME other than GAUSSIAN
#
# RUN: sed 's/^\[energy\]/[output]\nobservables = "obs.txt"\n\n[energy]/' %t/base.toml > %t/observe.toml
# RUN: printf '[[energy.external]]\nname = "wall"\nexpression = "k*max(0, z - z0)^2"\nselection = ":1-3"\nk = 2.0\nz0 = 13.0\nobserve = ["k"]\n' >> %t/observe.toml
# RUN: not mdir emit --stage=module %t/observe.toml 2>&1 | FileCheck %s --check-prefix=OBSERVE
# OBSERVE: 'rigid_units = "ON"' cannot apply: frame, tunable, or derivative programs
#
# RUN: sed -e 's|"argon.pdb"|"%S/../../examples/argon/argon.pdb"|' -e 's/target    = "CPU"/target    = "GPU"/' \
# RUN:     -e 's/precision = "DOUBLE"/precision = "MIXED"/' %S/../../examples/argon/argon.toml > %t/argon.toml
# RUN: printf '[performance]\nrigid_units = "ON"\n' >> %t/argon.toml
# RUN: not mdir emit --stage=module %t/argon.toml 2>&1 | FileCheck %s --check-prefix=ARGON
# ARGON: 'rigid_units = "ON"' cannot apply: a system without a topology
#
# The refusals of the system: no rigid kind (the waters flexible), no kind
# that ON takes (two ions, a kind of one particle), and a covering reach
# beyond half the least face width of the cell (25.16 Ang): 10.3 Ang plus
# twice the rest's 1.091 Ang.
# RUN: sed -e 's/rigid_water    = true/rigid_water    = false/' -e 's/hydrogen_bonds = true/hydrogen_bonds = false/' %t/base.toml > %t/flexible.toml
# RUN: not mdir emit --stage=module %t/flexible.toml 2>&1 | FileCheck %s --check-prefix=NONE
# NONE: 'rigid_units = "ON"' cannot apply: no rigid kind: the system has no rigid group (D403)
# RUN: mkdir -p %t/ions && %python %S/Inputs/kind_pairs_mixture.py %t/ions ions
# RUN: printf '[execution]\ntarget = "GPU"\nprecision = "MIXED"\n[performance]\nrigid_units = "ON"\n' >> %t/ions/run.toml
# RUN: not mdir emit --stage=module %t/ions/run.toml 2>&1 | FileCheck %s --check-prefix=IONS
# IONS: 'rigid_units = "ON"' cannot apply: no kind is eligible (kind 1: one particle)
# RUN: sed 's/pairlist_distance = 10.0/pairlist_distance = 10.5/' %t/base.toml > %t/far.toml
# RUN: not mdir emit --stage=module %t/far.toml 2>&1 | FileCheck %s --check-prefix=FAR
# FAR: 'rigid_units = "ON"' cannot apply: the covering reach, 12.68 Ang (the pair list distance plus twice 1.091 Ang, the largest covering radius of the units), exceeds half the least face width of the cell, 12.58 Ang
# RUN: sed 's/"ON"/"AUTO"/' %t/far.toml > %t/far-auto.toml
# RUN: mdir emit --stage=module %t/far-auto.toml | FileCheck %s --check-prefix=GENERAL
#
# The choice of the kinds (the maintainer's ruling on #915): of the four
# kinds of D405's mixture, three waters of three sites, two of four, two
# rigid molecules of three atoms, and one ion, ON takes the two most
# populous of two or more particles; the third is beyond them (its two
# atoms anchored to its first, as in the rest of D421), and the ion
# is of one particle. The molecules of three atoms without their
# exclusions (`incomplete`), or with an excluded ion outside them
# (`outside`), are not eligible, with that reason.
# RUN: mkdir -p %t/mixture %t/incomplete %t/outside
# RUN: %python %S/Inputs/kind_pairs_mixture.py %t/mixture
# RUN: printf '[execution]\ntarget = "GPU"\nprecision = "MIXED"\n[performance]\nrigid_units = "ON"\n' >> %t/mixture/run.toml
# RUN: mdir check %t/mixture/run.toml | FileCheck %s --check-prefix=MIXTURE
# MIXTURE: rigid units: ON: the units (ON was given)
# MIXTURE-NEXT: kind 1: taken, 3 units of 3 places (3 in the frame, 0 sites)
# MIXTURE-NEXT: kind 2: taken, 2 units of 4 places (3 in the frame, 1 site)
# MIXTURE-NEXT: kind 3: not taken: beyond the two most populous
# MIXTURE-NEXT: kind 4: not taken: one particle
# MIXTURE-NEXT: the rest: 7 particles, 4 anchored, radius {{[0-9.]+}} Ang
# RUN: mdir emit --stage=module %t/mixture/run.toml | FileCheck %s --check-prefix=MIXTURE-ROUTE
# MIXTURE-ROUTE: md.tuple_set @kind_0 on(@atoms) arity(3)
# MIXTURE-ROUTE: md.tuple_set @kind_1 on(@atoms) arity(4)
# MIXTURE-ROUTE-NOT: @kind_2
# RUN: %python %S/Inputs/kind_pairs_mixture.py %t/incomplete incomplete
# RUN: printf '[execution]\ntarget = "GPU"\nprecision = "MIXED"\n[performance]\nrigid_units = "ON"\n' >> %t/incomplete/run.toml
# RUN: mdir check %t/incomplete/run.toml | FileCheck %s --check-prefix=INCOMPLETE
# INCOMPLETE: kind 3: not taken: 2 molecules with a pair of their own that is not excluded
# RUN: %python %S/Inputs/kind_pairs_mixture.py %t/outside outside
# RUN: printf '[execution]\ntarget = "GPU"\nprecision = "MIXED"\n[performance]\nrigid_units = "ON"\n' >> %t/outside/run.toml
# RUN: mdir check %t/outside/run.toml | FileCheck %s --check-prefix=OUTSIDE
# OUTSIDE: not taken: 2 molecules with an excluded pair outside the molecule
#
# The list of units reads a copy of a taken kind from its first particle,
# its places being consecutive particles (D[water-layout]). A kind whose
# molecules are not consecutive in the input is not refused: it is not
# taken, its particles run in the rest, and `mdir check` and the run warn.
# The waters of four sites with an ion of their own listed between the
# second hydrogen and the site are such a kind, and the third kind is taken
# in their place (`rigid-units-frames-gpu.test` runs it against the general
# route). With the site listed before its frame they are consecutive, and
# taken.
# RUN: mkdir -p %t/scattered %t/scattered-only %t/site-first
# RUN: %python %S/Inputs/kind_pairs_mixture.py %t/scattered scattered
# RUN: printf '[execution]\ntarget = "GPU"\nprecision = "MIXED"\n[performance]\nrigid_units = "ON"\n' >> %t/scattered/run.toml
# RUN: mdir check %t/scattered/run.toml | FileCheck %s --check-prefix=SCATTERED
# SCATTERED: rigid units: ON: the units (ON was given)
# SCATTERED-NEXT: kind 1: taken, 3 units of 3 places (3 in the frame, 0 sites)
# SCATTERED-NEXT: kind 2: not taken: one particle
# SCATTERED-NEXT: kind 3: not taken: 2 molecules not of consecutive particles; its particles run in the rest
# SCATTERED-NEXT: kind 4: taken, 2 units of 3 places (3 in the frame, 0 sites)
# RUN: mdir check %t/scattered/run.toml 2>&1 >/dev/null | FileCheck %s --check-prefix=SCATTERED-WARN
# SCATTERED-WARN: warning: kind 3: 2 of 2 molecules are not of consecutive particles in the input
# RUN: mdir check --json %t/scattered/run.toml | %python -c "import json, sys; d = json.load(sys.stdin); k = d['run']['rigid_units']['kinds'][2]; print([w['code'] for w in d['warnings'] if w['code'].startswith('rigid')], k['taken'], k['scattered'])" | FileCheck %s --check-prefix=SCATTERED-JSON
# SCATTERED-JSON: ['rigid_units_scattered'] False 2
#
# Where the kinds that are not consecutive are the only eligible ones, ON
# takes the general route with that reason, and the program is the general
# one; under AUTO there is no warning.
# RUN: %python %S/Inputs/kind_pairs_mixture.py %t/scattered-only scattered-only
# RUN: cp %t/scattered-only/run.toml %t/scattered-only/auto.toml
# RUN: printf '[execution]\ntarget = "GPU"\nprecision = "MIXED"\n[performance]\nrigid_units = "ON"\n' >> %t/scattered-only/run.toml
# RUN: mdir check %t/scattered-only/run.toml | FileCheck %s --check-prefix=SCATTERED-ONLY
# SCATTERED-ONLY: rigid units: ON: general (ON was given, but no kind of consecutive particles is eligible: the general route)
# RUN: mdir check %t/scattered-only/run.toml 2>&1 >/dev/null | FileCheck %s --check-prefix=SCATTERED-WARN-ONLY
# SCATTERED-WARN-ONLY: warning: kind 1: 2 of 2 molecules are not of consecutive particles in the input
# RUN: mdir emit --stage=module %t/scattered-only/run.toml | FileCheck %s --check-prefix=GENERAL
# RUN: mdir check %t/scattered-only/auto.toml 2>&1 | FileCheck %s --check-prefix=SCATTERED-AUTO
# SCATTERED-AUTO-NOT: not of consecutive particles in the input
# SCATTERED-AUTO: rigid units: AUTO: general
# SCATTERED-AUTO-NOT: not of consecutive particles in the input
# RUN: %python %S/Inputs/kind_pairs_mixture.py %t/site-first site-first
# RUN: printf '[execution]\ntarget = "GPU"\nprecision = "MIXED"\n[performance]\nrigid_units = "ON"\n' >> %t/site-first/run.toml
# RUN: mdir check %t/site-first/run.toml | FileCheck %s --check-prefix=SITE-FIRST
# SITE-FIRST: kind 2: taken, 2 units of 4 places (3 in the frame, 1 site)

#--- base.toml
[input]
topology   = "opc.prmtop"
coordinates = "opc.inpcrd"

[energy]
cutoff        = 9.0
pairlist_distance = 10.0
electrostatics = "PME"

[dynamics]
integrator    = "VELOCITY_VERLET"
time_step     = 0.002
steps         = 10

[constraints]
hydrogen_bonds = true
rigid_water    = true

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[boundary]
type = "PERIODIC"

[execution]
target    = "GPU"
precision = "MIXED"
#--- end

#--- dodecahedron.toml
[input]
topology    = "water.top"
coordinates = "dodecahedron.gro"
format      = "GROMACS"

[energy]
cutoff            = 6.0
pairlist_distance = 7.0
electrostatics    = "PME"

[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.002
steps      = 10

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[constraints]
rigid_water = true

[boundary]
type = "PERIODIC"

[execution]
target    = "GPU"
precision = "MIXED"

[performance]
rigid_units = "ON"
#--- end
