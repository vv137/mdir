# Leapfrog with SETTLE, SHAKE and RATTLE: the peptide with ff19SB in OPC
# water of barostat-ff19sb-gpu.test, at a step of 2 fs. The constraints
# bring the positions of both integrators to the same place, so leapfrog
# takes the steps of velocity Verlet; the log, with the virial of the
# constraints and the pressure, is the same row by row (D76).
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/ff19sb/ff19.prmtop %S/Inputs/ff19sb/ff19.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/verlet.toml
# RUN: sed -e 's|"VELOCITY_VERLET"|"LEAPFROG"|' -e 's|verlet.dcd|leapfrog.dcd|' %t/verlet.toml > %t/leapfrog.toml
# RUN: mdir run %t/verlet.toml > %t/verlet.log
# RUN: mdir run %t/leapfrog.toml > %t/leapfrog.log
# RUN: %python %S/Inputs/compare_logs.py %t/verlet.log %t/leapfrog.log 1e-7 | FileCheck %s
# RUN: %python %S/Inputs/check_bonds.py %t/ff19.prmtop %t/leapfrog.dcd | FileCheck %s --check-prefix=BONDS
# RUN: mdir emit %t/leapfrog.toml | FileCheck %s --check-prefix=MODULE

# CHECK: VIRIAL:
# CHECK: logs agree

# BONDS: bonds ok

# The step of energy kicks by a whole step, as the plain step does, and
# leaves its state (#285). For the virial of the constraints it takes, on
# the side, the stored velocities to the time of the positions, with no
# velocity along the bonds, and the first half kick and the drift of
# velocity Verlet from there.
#
# The arguments of a step program are x, v, f, m, the cell, and dt, in
# that order (%arg0 to %arg5).
# MODULE:      dyn.program @step(
# MODULE:      dyn.kick %arg1, %arg2, %arg3, %arg5 : !md.field<@atoms, 3 x f64>
# MODULE-NOT:  dyn.kick %arg1, %arg2, %arg3, %{{[0-9]+}}
# MODULE:      dyn.program @step_energy(
# MODULE:      [[V1:%[0-9]+]] = dyn.kick %arg1, %arg2, %arg3, %arg5 : !md.field<@atoms, 3 x f64>
# MODULE:      dyn.kick %arg1, %arg2, %arg3, [[HALF:%[0-9]+]] : !md.field<@atoms, 3 x f64>
# MODULE:      [[V1P:%[0-9]+]] = dyn.kick {{%[0-9]+}}, %arg2, %arg3, [[HALF]] : !md.field<@atoms, 3 x f64>
# MODULE:      dyn.drift %arg0, [[V1]], %arg5 : !md.field<@atoms, 3 x f64>
# MODULE:      dyn.drift %arg0, [[V1P]], %arg5 : !md.field<@atoms, 3 x f64>

#--- run.toml
[input]
topology   = "ff19.prmtop"
coordinates = "ff19.inpcrd"

[output]
trajectory = "verlet.dcd"
energy_interval = 10
trajectory_interval = 10

[energy]
cutoff        = 9.0
pairlist_distance = 10.0
electrostatics = "PME"
coulomb_modifier     = "POTENTIAL_SHIFT"

[dynamics]
integrator        = "VELOCITY_VERLET"
time_step         = 0.002
steps             = 100

[ensemble]
ensemble    = "NVE"

[constraints]
hydrogen_bonds = true
rigid_water = true

[boundary]
type = "PERIODIC"
#--- end
