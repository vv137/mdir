# The target of M1 (D65) as it is meant to run: the peptide of
# amber-ff19sb.test with ff19SB in OPC water, with CMAP, the extra points
# of the waters, rigid water (SETTLE), rigid bonds of hydrogen (SHAKE and
# RATTLE), particle mesh Ewald, and the thermostat, at a step of 2 fs on a
# GPU in mixed precision.
#
# REQUIRES: cuda
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/ff19sb/ff19.prmtop %S/Inputs/ff19sb/ff19.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/run.toml
# RUN: mdir run %t/run.toml | FileCheck %s
# RUN: %python %S/Inputs/check_bonds.py %t/ff19.prmtop %t/run.dcd | FileCheck %s --check-prefix=BONDS
# RUN: mdir emit %t/run.toml | FileCheck %s --check-prefix=MODULE
# RUN: mdir emit %t/run.toml --stage=lowered | FileCheck %s --check-prefix=KERNELS

# The energy that the thermostat exchanges is counted, and the conserved
# energy changes little over 2 ps; the momentum stays 0.
#
# CHECK: MDIR:   CMAP                           0.0963
# CHECK: MDIR: the momentum at the end is {{[0-9.]+}}e-{{(0[4-9]|1[0-9])}} amu nm/ps
# CHECK: MDIR: the conserved energy changed by {{[0-9.]+}}e-0{{[3-9]}} of its value

# The bonds of hydrogen of the peptide and of the waters (which SETTLE
# keeps) have their lengths in every frame.
#
# BONDS: bonds ok

# The groups of the constraints share no atom (D83): the loops over them
# read the positions and velocities before the updates of the other groups,
# and run as one kernel.
#
# MODULE: md.disjoint_union @constraints on(@atoms) of [@settles, @shake1
# KERNELS: tuple_for_l{{[0-9]+}}_run{{[2-9]}}

#--- run.toml
[input]
topology   = "ff19.prmtop"
coordinates = "ff19.inpcrd"

[output]
trajectory = "run.dcd"
energy_interval = 250
trajectory_interval = 250

[energy]
cutoff        = 9.0
pairlist_distance = 10.0
electrostatics = "PME"
coulomb_modifier     = "POTENTIAL_SHIFT"

[dynamics]
integrator        = "VELOCITY_VERLET"
time_step         = 0.002
steps             = 1000

[ensemble]
ensemble    = "NVT"
temperature = 300.0

[thermostat]
method = "V-RESCALE"
interval = 10
time_constant = 0.5

[constraints]
hydrogen_bonds = true
rigid_water = true

[boundary]
type = "PERIODIC"

[execution]
target    = "gpu"
precision = "mixed"
#--- end
