# Device-free construction verifies the class arities, loop-carried partner
# state, partial-batch mask, and callback signatures. Numerical GPU coverage
# belongs to the complete list/kernel gates, not this structural fixture.
# RUN: mdir-water-template-test --unit-ir | mdir-opt --verify-each | FileCheck %s
# CHECK-LABEL: func.func @unit_ww(
# CHECK: scf.for
# CHECK: arith.select
# CHECK: scf.for
# CHECK: scf.if
# CHECK: gpu.shuffle idx
# CHECK: call @unit_ww_second
# CHECK: gpu.shuffle xor
# CHECK: call @unit_ww_first
# CHECK: return
# CHECK-LABEL: func.func @unit_sw(
# CHECK: gpu.shuffle idx
# CHECK: call @unit_sw_second
# CHECK: gpu.shuffle xor
# CHECK: call @unit_sw_first
# CHECK: return
# CHECK-LABEL: func.func @unit_ss(
# CHECK: gpu.shuffle idx
# CHECK: call @unit_ss_second
# CHECK: gpu.shuffle xor
# CHECK: call @unit_ss_first
# CHECK: return
# CHECK-LABEL: func.func @unit_energy(
# CHECK: gpu.shuffle idx
# CHECK-NOT: gpu.shuffle xor
# CHECK-NOT: call @unit_energy_first
# CHECK-NOT: call @unit_energy_second
# CHECK: return
# CHECK-LABEL: func.func @unit_three(
# CHECK: gpu.shuffle idx
# CHECK: call @unit_three_second
# CHECK: gpu.shuffle xor
# CHECK: call @unit_three_first
# CHECK: return
# The select form (TemplateUnit::speculate): no divergent guard inside the
# rotation; the paired bit selects each contribution or +0.
# CHECK-LABEL: func.func @unit_select(
# CHECK: scf.for
# CHECK: scf.for
# CHECK-NOT: scf.if
# CHECK: arith.select
# CHECK-NOT: scf.if
# CHECK: gpu.shuffle idx
# CHECK: scf.yield
# CHECK: call @unit_select_second
# CHECK: gpu.shuffle xor
# CHECK: call @unit_select_first
# CHECK: return
