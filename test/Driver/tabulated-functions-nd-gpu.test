# The functions of tabulated-functions-nd.test on a GPU (D165): in double
# precision the energies of OpenMM to the printed digits and the forces of
# check_functions.py within 1e-6 of the largest; in mixed precision, where
# the kernels compute in f32, the forces within 2e-5 (6.3e-6 against
# OpenMM when this was written).
#
# REQUIRES: hdf5, cuda
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/dipeptide/dipeptide.prmtop %S/Inputs/dipeptide/dipeptide.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %S/tabulated-functions-nd.test | sed '1d;$d' | sed -e 's/^target    = "CPU"/target    = "GPU"/' > %t/terms.toml
# RUN: sed -n '/^#--- run.toml/,/^#--- terms/p' %S/tabulated-functions-nd.test | sed '1d;$d' | sed -e 's/terms.h5/plain.h5/' -e 's/^target    = "CPU"/target    = "GPU"/' > %t/plain.toml
# RUN: cd %t && mdir run plain.toml > plain.log && mdir run terms.toml > terms.log
# RUN: FileCheck %S/tabulated-functions-nd.test < %t/terms.log
# RUN: mdir checkpoint --print=forces %t/plain.h5 > %t/plain.forces
# RUN: mdir checkpoint --print=forces %t/terms.h5 > %t/terms.forces
# RUN: %python %S/Inputs/check_functions.py %t/terms.toml %t/dipeptide.prmtop %t/dipeptide.inpcrd %t/plain.forces %t/terms.forces 1e-6 | FileCheck %S/tabulated-functions-nd.test --check-prefix=PYTHON
#
# RUN: sed -e 's/^precision = "DOUBLE"/precision = "MIXED"/' -e 's/terms.h5/mixed.h5/' %t/terms.toml > %t/mixed.toml
# RUN: sed -e 's/^precision = "DOUBLE"/precision = "MIXED"/' -e 's/plain.h5/mixed-plain.h5/' %t/plain.toml > %t/mixed-plain.toml
# RUN: cd %t && mdir run mixed-plain.toml > mixed-plain.log && mdir run mixed.toml > mixed.log
# RUN: FileCheck %s < %t/mixed.log
# RUN: mdir checkpoint --print=forces %t/mixed-plain.h5 > %t/mixed-plain.forces
# RUN: mdir checkpoint --print=forces %t/mixed.h5 > %t/mixed.forces
# RUN: %python %S/Inputs/check_functions.py %t/mixed.toml %t/dipeptide.prmtop %t/dipeptide.inpcrd %t/mixed-plain.forces %t/mixed.forces 2e-5 | FileCheck %s --check-prefix=FORCES

# CHECK:      MDIR:   twist2 -1.7830{{[0-9]+}}
# CHECK:      MDIR:   surface 18694.50{{[0-9]+}}
# CHECK-NEXT: MDIR:   field 19.3764{{[0-9]+}}

# FORCES: forces against differences of the energy: ok
