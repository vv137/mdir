# The target of M1 (D65) of ff19sb-gpu.test at constant pressure: the
# peptide with ff19SB in OPC water, with SETTLE, SHAKE and RATTLE, particle
# mesh Ewald, the thermostat and the barostat, at a step of 2 fs on a GPU
# in mixed precision. The box of tleap holds the water at about 0.6 g/cm^3,
# and the barostat compresses it by a fifth over 10 ps.
#
# REQUIRES: cuda
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/ff19sb/ff19.prmtop %S/Inputs/ff19sb/ff19.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/run.toml
# RUN: mdir run %t/run.toml | FileCheck %s
# RUN: %python %S/Inputs/check_bonds.py %t/ff19.prmtop %t/run.dcd | FileCheck %s --check-prefix=BONDS
#
# Leapfrog couples the velocities of the time of the positions, and keeps
# those half a kick behind; the conserved energy changes as little. The
# coupling removes the motion of the center of mass from the velocities it
# takes; the stored ones are half a kick of the forces behind, and the
# forces of PME sum to a little more than zero (their interpolation does
# not conserve momentum), so those keep h Σ F of it.
#
# RUN: sed -e 's|"VELOCITY_VERLET"|"LEAPFROG"|' -e 's|run.dcd|leap.dcd|' %t/run.toml > %t/leap.toml
# RUN: mdir run %t/leap.toml | FileCheck %s --check-prefix=LEAP
# RUN: %python %S/Inputs/check_bonds.py %t/ff19.prmtop %t/leap.dcd | FileCheck %s --check-prefix=BONDS
#
# With the work counted exactly, from the energy of the scaled positions
# (D77), the conserved energy changes less.
#
# RUN: sed -e 's|^\[barostat\]$|[barostat]\nwork = "EXACT"|' -e 's|run.dcd|exact.dcd|' %t/run.toml > %t/exact.toml
# RUN: mdir run %t/exact.toml | FileCheck %s --check-prefix=EXACT

# The rigid groups move with their centers, and the work of the scaling is
# counted, so the conserved energy changes little through the compression.
# By default the cell scales within the drift of a step (Trotter type,
# D92) and its work is counted from the virials before and after it, which
# a compression of a fifth in 10 ps, with strains far larger than at
# equilibrium, makes drift by about 1e-2 of the value; counted exactly, by
# about 4e-3.
#
# CHECK:      INFO:         0 {{.*}} 28634.{{[0-9]+}}
# CHECK:      INFO:      5000 {{.*}} {{2[0-3][0-9]{3}\.[0-9]+$}}
# CHECK:      MDIR: the momentum at the end is {{[0-9.]+}}e-{{(0[4-9]|1[0-9])}} amu nm/ps
# CHECK:      MDIR: the conserved energy changed by {{[0-9.]+}}e-0{{[2-9]}} of its value
# EXACT:      MDIR: the conserved energy changed by {{[0-9.]+}}e-0{{[3-9]}} of its value
#
# LEAP:       INFO:         0 {{.*}} 28634.{{[0-9]+}}
# LEAP:       INFO:      5000 {{.*}} {{2[0-3][0-9]{3}\.[0-9]+$}}
# LEAP:       MDIR: the momentum at the end is {{[0-9.]+}}e-{{(0[2-9]|1[0-9])}} amu nm/ps
# LEAP:       MDIR: the conserved energy changed by {{[0-9.]+}}e-0{{[2-9]}} of its value

# The bonds of hydrogen keep their lengths in every frame, which has the
# cell of its step.
#
# BONDS: bonds ok

#--- run.toml
[input]
topology   = "ff19.prmtop"
coordinates = "ff19.inpcrd"

[output]
trajectory = "run.dcd"
energy_interval = 1000
trajectory_interval = 1000

[energy]
cutoff        = 9.0
pairlist_distance = 10.0
electrostatics = "PME"
coulomb_modifier     = "POTENTIAL_SHIFT"

[dynamics]
integrator        = "VELOCITY_VERLET"
time_step         = 0.002
steps             = 5000

[ensemble]
ensemble    = "NPT"
temperature = 300.0
pressure    = 1.0

[thermostat]
method = "V-RESCALE"
interval = 10
time_constant = 0.5

[barostat]
method = "C-RESCALE"
time_constant = 2.0

[constraints]
hydrogen_bonds = true
rigid_water = true

[boundary]
type = "PERIODIC"

[execution]
target    = "gpu"
precision = "mixed"
#--- end
