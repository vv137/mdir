# The terms over the centers of groups of centroid-terms.test on a GPU in
# double precision (D139): the same energies, and the forces and the virial
# that check_centroid.py computes.
#
# REQUIRES: hdf5, cuda
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/dipeptide/dipeptide.prmtop %S/Inputs/dipeptide/dipeptide.inpcrd %t
# RUN: %python %S/Inputs/shift_inpcrd.py %t/dipeptide.inpcrd > %t/shifted.inpcrd
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %S/centroid-terms.test | sed '1d;$d' | sed -e 's/^target    = "CPU"/target    = "GPU"/' -e 's/dipeptide.inpcrd/shifted.inpcrd/' > %t/terms.toml
# RUN: sed -n '/^#--- run.toml/,/^#--- terms/p' %S/centroid-terms.test | sed '1d;$d' | sed -e 's/terms.h5/plain.h5/' -e 's/^target    = "CPU"/target    = "GPU"/' -e 's/dipeptide.inpcrd/shifted.inpcrd/' > %t/plain.toml
# RUN: cd %t && mdir run plain.toml > plain.log && mdir run terms.toml > terms.log
# RUN: FileCheck %S/centroid-terms.test < %t/terms.log
# RUN: mdir checkpoint --print=forces %t/plain.h5 > %t/plain.forces
# RUN: mdir checkpoint --print=forces %t/terms.h5 > %t/terms.forces
# RUN: %python %S/Inputs/check_centroid.py %t/dipeptide.prmtop %t/shifted.inpcrd %t/plain.forces %t/terms.forces %t/plain.log %t/terms.log | FileCheck %S/centroid-terms.test --check-prefix=PYTHON
