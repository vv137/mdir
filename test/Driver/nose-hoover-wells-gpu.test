# The chain on identical harmonic wells of nose-hoover-wells.test on a GPU,
# in mixed and in double precision (#117): the device sums the kinetic
# energy, and the host moves the chain.
#
# REQUIRES: cuda
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: %python %S/Inputs/brownian_wells.py write %t 125
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %S/nose-hoover-wells.test | sed '1d;$d' > %t/base.toml
# RUN: cat %t/base.toml %t/wells.toml > %t/mixed.toml
# RUN: cp %t/mixed.toml %t/double.toml
# RUN: printf '[execution]\ntarget = "gpu"\nprecision = "mixed"\n' >> %t/mixed.toml
# RUN: printf '[execution]\ntarget = "gpu"\nprecision = "double"\n' >> %t/double.toml
# RUN: cd %t && mdir run mixed.toml > mixed.log
# RUN: %python %S/Inputs/nose_hoover_wells.py %t/mixed.log 372 800 | FileCheck %s
# RUN: cd %t && mdir run double.toml > double.log
# RUN: %python %S/Inputs/nose_hoover_wells.py %t/double.log 372 800 | FileCheck %s

# CHECK: 81 rows
# CHECK: within 0.01 kcal/mol: yes
