# `neighbor_structure = "AUTO"` on a GPU (D[best-defaults]). On an
# architecture whose entry of the traversal table admits the size (sm_89),
# argon on a lattice of 8,000 atoms takes TOWERS with the derived launch,
# without the timed trial, and its energies are those of TOWERS given with
# the trial's launch: at a fixed cell height every launch gives the same
# words (D428); its own compile cache keeps it from a trial that the
# explicit run stores. Elsewhere it takes the structure of D261, the matrix, and
# its energies are those of MATRIX given. 1,728 atoms stay on the matrix
# on every device. An input that the rule admits but the TOWERS preflight
# refuses (3,375 atoms with a cutoff of 20 Å in a cell of 57 Å: fewer than
# three cells across) falls back to the matrix and says why, in `mdir
# check` and in the run alike. The manifest records the choice and its
# table lookup, and satisfies the schema.
#
# REQUIRES: cuda, towers-mma
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: %python %S/Inputs/argon_lattice.py 20 %t/big.pdb
# RUN: %python %S/Inputs/argon_lattice.py 12 %t/small.pdb
# RUN: %python %S/Inputs/argon_lattice.py 15 %t/narrow.pdb
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/auto.toml
# RUN: sed -e 's|^precision = "MIXED"|precision = "MIXED"\nneighbor_structure = "TOWERS"|' -e '/^manifest/d' %t/auto.toml > %t/towers.toml
# RUN: sed -e 's|^precision = "MIXED"|precision = "MIXED"\nneighbor_structure = "MATRIX"|' -e '/^manifest/d' %t/auto.toml > %t/matrix.toml
# RUN: sed -e 's|big.pdb|small.pdb|' -e 's|76.0|45.6|g' -e '/^manifest/d' %t/auto.toml > %t/small.toml
# RUN: sed -e 's|big.pdb|narrow.pdb|' -e 's|76.0|57.0|g' -e 's|^cutoff = 9.0|cutoff = 20.0|' -e '/^manifest/d' %t/auto.toml > %t/narrow.toml
# RUN: cd %t && env MDIR_COMPILE_CACHE_DIR=%t/cache-auto mdir run auto.toml > auto.out
# RUN: cd %t && mdir run towers.toml > towers.out
# RUN: cd %t && mdir run matrix.toml > matrix.out
# RUN: cd %t && mdir run small.toml | FileCheck %s --check-prefix=SMALL
# RUN: cd %t && mdir run narrow.toml | FileCheck %s --check-prefix=NARROW
# RUN: cd %t && mdir check narrow.toml | FileCheck %s --check-prefix=NARROWCHECK
# RUN: FileCheck %s --check-prefix=AUTO < %t/auto.out
#
# The energies of AUTO are those of the structure that it states.
# RUN: grep 'INFO: ' %t/auto.out > %t/auto.log
# RUN: grep 'INFO: ' %t/towers.out > %t/towers.log
# RUN: grep 'INFO: ' %t/matrix.out > %t/matrix.log
# RUN: test -s %t/auto.log
# RUN: cd %t && sh -c 'if grep -q "neighbor structure: TOWERS" auto.out; then diff auto.log towers.log; else diff auto.log matrix.log; fi'
# RUN: cd %t && sh -c 'if grep -q "neighbor structure: TOWERS" auto.out; then grep -q "\"selection\":\"derived (AUTO structure, no cached trial)\"" auto.out && grep -q "\"selection\":\"setup trial\"" towers.out; fi'
#
# RUN: %python -c "import json; c = json.loads(open('%t/auto.jsonl').readline())['resolved_choices']['neighbor_structure']; print(c['category'], c['requested'], c['value'], '|', c['towers'], '|', c['towers_rule']['device_architecture'], c['towers_rule']['basis']['decision'])" | FileCheck %s --check-prefix=MANIFEST
# RUN: %python %S/Inputs/manifest_schema.py %S/../../docs/run-manifest.schema.json %t/auto.jsonl | FileCheck %s --check-prefix=SCHEMA

# AUTO: MDIR: AUTO traversal: TOWERS {{taken: 8000 particles, at least [0-9]+ on sm_89|not taken: TOWERS was not measured as the choice of AUTO on sm_[0-9]+}}
# AUTO: MDIR: neighbor structure: {{TOWERS \(AUTO: 8000 particles, at least [0-9]+ on sm_89 .*|the matrix with the reach 10.5 Ang \(AUTO: 8000 particles, fewer than [0-9]+\)}}
# SMALL: MDIR: AUTO traversal: TOWERS not taken: {{1728 particles, fewer than [0-9]+ on sm_89|TOWERS was not measured as the choice of AUTO on sm_[0-9]+}}
# SMALL: MDIR: neighbor structure: the matrix
# NARROW: MDIR: AUTO traversal: TOWERS {{refused at preflight: towers_shape: cell height is unsupported for this box and cutoff|not taken: TOWERS was not measured as the choice of AUTO on sm_[0-9]+}}
# NARROW: MDIR: neighbor structure: the matrix with the reach 21.5 Ang (AUTO: 3375 particles, fewer than {{[0-9]+}})
# NARROWCHECK: neighbors: matrix, reach 21.5 Ang (AUTO: 3375 particles, fewer than {{[0-9]+}})
# NARROWCHECK-NEXT: AUTO traversal: TOWERS {{refused at preflight: towers_shape: cell height is unsupported for this box and cutoff|not taken: TOWERS was not measured as the choice of AUTO on sm_[0-9]+}}
# MANIFEST: rule AUTO {{towers|matrix}} | {{taken|not taken}}: {{.*}} | sm_{{[0-9]+}} {{D.best-defaults.|D261}}
# SCHEMA: valid

#--- run.toml
[input]
coordinates = "big.pdb"

[output]
energy_interval = 10
manifest = "auto.jsonl"

[energy]
cutoff = 9.0

[[energy.pair]]
name       = "lj"
expression = "4*epsilon*((sigma/r)^12 - (sigma/r)^6)"
mixing     = "lorentz-berthelot"

[[energy.type]]
name    = "AR"
mass    = 39.95
epsilon = 0.238465
sigma   = 3.4

[dynamics]
integrator = "VELOCITY_VERLET"
time_step = 0.002
steps = 40
seed = 2718

[ensemble]
ensemble    = "NVT"
temperature = 100.0

[thermostat]
method = "V-RESCALE"
interval = 10
time_constant = 0.5

[boundary]
type = "PERIODIC"
box  = [76.0, 76.0, 76.0]

[execution]
target = "GPU"
precision = "MIXED"
#--- end
