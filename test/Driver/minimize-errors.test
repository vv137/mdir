# What is wrong with a minimization in the control file is reported.
#
# RUN: split-file %s %t
# RUN: not mdir run %t/both.toml 2>&1 | FileCheck %s --check-prefix=BOTH
# RUN: not mdir run %t/bath.toml 2>&1 | FileCheck %s --check-prefix=BATH
# RUN: not mdir run %t/multiple.toml 2>&1 | FileCheck %s --check-prefix=MULTIPLE
# RUN: not mdir run %t/frames.toml 2>&1 | FileCheck %s --check-prefix=FRAMES
# RUN: not mdir run %t/method.toml 2>&1 | FileCheck %s --check-prefix=METHOD
# RUN: not mdir run %t/size.toml 2>&1 | FileCheck %s --check-prefix=SIZE
# RUN: not mdir run %t/tolerance.toml 2>&1 | FileCheck %s --check-prefix=TOLERANCE
# RUN: not mdir run %t/infinite.toml 2>&1 | FileCheck %s --check-prefix=INFINITE

# BOTH: both.toml:{{[0-9]+}}: expected [dynamics] or [minimize], not both
# BATH: bath.toml:{{[0-9]+}}: a minimization has no thermostat or barostat
# MULTIPLE: multiple.toml:{{[0-9]+}}: 'steps' is not a multiple of 'energy_interval'
# FRAMES: frames.toml:{{[0-9]+}}: 'trajectory_interval' is not a multiple of 'energy_interval'
# METHOD: method.toml:{{[0-9]+}}: expected one of
# SIZE: size.toml:{{[0-9]+}}: expected a positive number for 'initial_step'
# TOLERANCE: tolerance.toml:{{[0-9]+}}: expected a positive number for 'force_tolerance'
# INFINITE: infinite.toml:{{[0-9]+}}: expected a finite number for 'force_tolerance'

#--- one.pdb
HETATM    1  AR  AR  A   1       1.000   1.000   1.000  1.00  0.00          AR
HETATM    2  AR  AR  A   1       5.000   1.000   1.000  1.00  0.00          AR
#--- both.toml
[input]
coordinates = "one.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[minimize]
steps  = 10
[dynamics]
steps  = 10
[boundary]
type = "PERIODIC"
box = [30.0, 30.0, 30.0]
#--- bath.toml
[input]
coordinates = "one.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[minimize]
steps  = 10
[ensemble]
ensemble = "NVT"

[thermostat]
method = "V-RESCALE"

[boundary]
type = "PERIODIC"
box = [30.0, 30.0, 30.0]
#--- multiple.toml
[input]
coordinates = "one.pdb"
[output]
energy_interval = 10

[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[minimize]
steps  = 15
[boundary]
type = "PERIODIC"
box = [30.0, 30.0, 30.0]
#--- frames.toml
[input]
coordinates = "one.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[minimize]
steps  = 20
[output]
trajectory = "a.dcd"
energy_interval = 10
trajectory_interval = 15

[boundary]
type = "PERIODIC"
box = [30.0, 30.0, 30.0]
#--- method.toml
[input]
coordinates = "one.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[minimize]
method = "CG"
steps  = 10
[boundary]
type = "PERIODIC"
box = [30.0, 30.0, 30.0]
#--- size.toml
[input]
coordinates = "one.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[minimize]
steps  = 10
initial_step = -1.0
[boundary]
type = "PERIODIC"
box = [30.0, 30.0, 30.0]
#--- tolerance.toml
[input]
coordinates = "one.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[minimize]
steps  = 10
force_tolerance = 0.0
[boundary]
type = "PERIODIC"
box = [30.0, 30.0, 30.0]
#--- infinite.toml
[input]
coordinates = "one.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[minimize]
steps  = 10
force_tolerance = inf
[boundary]
type = "PERIODIC"
box = [30.0, 30.0, 30.0]
