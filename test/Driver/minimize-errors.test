# What is wrong with a minimization in the control file is reported.
#
# RUN: split-file %s %t
# RUN: not mdir run %t/both.toml 2>&1 | FileCheck %s --check-prefix=BOTH
# RUN: not mdir run %t/bath.toml 2>&1 | FileCheck %s --check-prefix=BATH
# RUN: not mdir run %t/multiple.toml 2>&1 | FileCheck %s --check-prefix=MULTIPLE
# RUN: not mdir run %t/frames.toml 2>&1 | FileCheck %s --check-prefix=FRAMES
# RUN: not mdir run %t/method.toml 2>&1 | FileCheck %s --check-prefix=METHOD
# RUN: not mdir run %t/size.toml 2>&1 | FileCheck %s --check-prefix=SIZE

# BOTH: both.toml:{{[0-9]+}}: expected [dynamics] or [minimize], not both
# BATH: bath.toml:{{[0-9]+}}: a minimization has no thermostat or barostat
# MULTIPLE: multiple.toml:{{[0-9]+}}: 'nsteps' is not a multiple of 'eneout_period'
# FRAMES: frames.toml:{{[0-9]+}}: 'crdout_period' is not a multiple of 'eneout_period'
# METHOD: method.toml:{{[0-9]+}}: expected one of
# SIZE: size.toml:{{[0-9]+}}: expected a positive number for 'step_size'

#--- one.pdb
HETATM    1  AR  AR  A   1       1.000   1.000   1.000  1.00  0.00          AR
HETATM    2  AR  AR  A   1       5.000   1.000   1.000  1.00  0.00          AR
#--- both.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[minimize]
nsteps = 10
[dynamics]
nsteps = 10
[boundary]
type = "PBC"
box_size_x = 30.0
box_size_y = 30.0
box_size_z = 30.0
#--- bath.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[minimize]
nsteps = 10
[ensemble]
ensemble = "NVT"
thermostat = "BUSSI"
[boundary]
type = "PBC"
box_size_x = 30.0
box_size_y = 30.0
box_size_z = 30.0
#--- multiple.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[minimize]
nsteps = 15
eneout_period = 10
[boundary]
type = "PBC"
box_size_x = 30.0
box_size_y = 30.0
box_size_z = 30.0
#--- frames.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[minimize]
nsteps = 20
eneout_period = 10
crdout_period = 15
[output]
dcdfile = "a.dcd"
[boundary]
type = "PBC"
box_size_x = 30.0
box_size_y = 30.0
box_size_z = 30.0
#--- method.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[minimize]
method = "CG"
nsteps = 10
[boundary]
type = "PBC"
box_size_x = 30.0
box_size_y = 30.0
box_size_z = 30.0
#--- size.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[minimize]
nsteps = 10
step_size = -1.0
[boundary]
type = "PBC"
box_size_x = 30.0
box_size_y = 30.0
box_size_z = 30.0
