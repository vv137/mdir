# REQUIRES: cuda-toolkit
# The mechanism table of the segmented SIMT schedule (D421;
# D417, Section 8, S3), as structural checks of the module and of the PTX
# of its lowered program (Inputs/segments_ptx.py), on alanine dipeptide in
# OPC (387 waters of four places, the solute the rest) with
# `rigid_units = "ON"`,
# with Coulomb cut off. `mdir emit` uses no device.
#
# RUN: rm -rf %t && mkdir -p %t && cd %t
# RUN: cp %S/Inputs/opc/opc.prmtop %S/Inputs/opc/opc.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/run.toml
# RUN: printf '[performance]\nrigid_units = "ON"\n' >> %t/run.toml
# RUN: env MDIR_SKIN_SEARCH=never MDIR_SKIN_CACHE=off mdir emit --stage=module %t/run.toml > %t/module.mlir
# RUN: env MDIR_SKIN_SEARCH=never MDIR_SKIN_CACHE=off MDIR_COMPILE_CACHE=off MDIR_GPU_BINARY=ptx MDIR_GPU_ARCH=sm_89 mdir emit --stage=lowered %t/run.toml > %t/lowered.mlir
# RUN: %python %S/Inputs/segments_ptx.py %t/module.mlir %t/lowered.mlir | FileCheck %s
#
# The constants of a slice inline (E3): the coefficients of the waters'
# Lennard-Jones are constants, the segment of two waters reads no table;
# the pairs of a water and the solute read the solute's types.
# CHECK: segment (0, 0): 0 lookups
# CHECK: segment (1, 0): 2 lookups
# CHECK: segment (1, 1): 2 lookups
#
# No load of a stored extra point: after a build the refresh packs the
# frames from three members of a water and one particle of the rest, 12
# loads of f64 positions; the water's fourth place, the stored site, is not
# among them. The writer of each step (D422), a thread a
# member, loads 18: for a water the anchor, the member of its thread, and
# the anchor's reference point; for a particle of the rest itself, its
# reference point, and the anchor of an anchored member (each three). The
# stored site would add three.
# CHECK: packing: 12 loads of 64 bits
# CHECK: writer: 18 loads of 64 bits
#
# The rotation and the table: the kernel of Lennard-Jones alone (the pairs
# (O, O) of two waters, a water and an atom, two atoms: 3 guards), of
# Coulomb alone (9 + 3 + 1 charged pairs), and of the whole term (15
# pairs, of the 16 + 4 + 1 that the shapes allow): one guard for each site
# pair of the tables and none for another. Each turn shuffles the partner's
# anchor, its two offsets, its mask, and the accumulators of its places
# that the table names: for the whole term 3 + 6 + 1 + 12 for the water
# partners of segments (0, 0) and (1, 0), and the anchor, the two fields
# (type and charge), the mask, and one accumulator of an atom of (1, 1):
# 22 + 22 + 9 = 53.
# CHECK: schedule: 13 index shuffles, 3 guards of site pairs
# CHECK: schedule: 25 index shuffles, 13 guards of site pairs
# CHECK: schedule: 53 index shuffles, 15 guards of site pairs

#--- run.toml
[input]
topology   = "opc.prmtop"
coordinates = "opc.inpcrd"

[energy]
cutoff        = 9.0
pairlist_distance = 10.0
electrostatics = "CUTOFF"

[dynamics]
integrator    = "VELOCITY_VERLET"
time_step     = 0.002
steps         = 10

[constraints]
hydrogen_bonds = true
rigid_water    = true

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[boundary]
type = "PERIODIC"

[execution]
target    = "GPU"
precision = "MIXED"
#--- end
