# Influence "P3M" of particle mesh Ewald on the CPU (D[p3m-influence]): eq.
# 2.28 of Ballenegger et al. (2012), optimal for the forces of analytic
# differentiation, on the three OPC waters of pme.test with a grid of
# 16 x 20 x 24 points of order 4 in the cube of 40 A, so that the three
# edges differ.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/opc/three.prmtop %S/Inputs/opc/three.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/run.toml
# RUN: mdir run %t/run.toml | FileCheck %s
# RUN: mdir emit %t/run.toml | FileCheck %s --check-prefix=MODULE
# RUN: %python %S/Inputs/check_virial.py mdir %t/run.toml %t/three.inpcrd 8e-3 3e-5 \
# RUN: | FileCheck %s --check-prefix=VIRIAL
# RUN: %python %S/Inputs/check_virial_axes.py mdir %t/run.toml %t/three.inpcrd 8e-3 3e-5 \
# RUN: | FileCheck %s --check-prefix=VIRIAL
# A triclinic cell is refused (the prolate kernel refuses 'influence' of
# any value, prolate-control.test).
# RUN: sed 's/  90.0000000  90.0000000  90.0000000$/  80.0000000  90.0000000  90.0000000/' %t/three.inpcrd > %t/tilted.inpcrd
# RUN: sed 's/three.inpcrd/tilted.inpcrd/' %t/run.toml > %t/tilted.toml
# RUN: not mdir run %t/tilted.toml 2>&1 | FileCheck %s --check-prefix=TILTED

# The reciprocal sum, against the Ewald sum of Inputs/ewald_reference.py,
# 4.6972413 kcal/mol (pme.test): "SPME" gives 4.459840 on this grid,
# "OPTIMAL" 4.586860, and "P3M" 4.586208. Eq. 2.28 minimizes the error of
# the forces, not of the energy; its energy is within 1.4e-4 of that of
# eq. 4.2 ("OPTIMAL") here.
#
# CHECK: MDIR:   Coulomb reciprocal 4.586208

# The forces are the derivatives of the energy (analytic differentiation,
# for any influence function): the total energy changes as the square of
# the time step.
#
# CHECK: MDIR: the total energy changed by {{[0-9.]+}}e-0{{[4-9]}} of its value

# MODULE: md.reciprocal
# MODULE-NEXT: grid([16, 20, 24]) order(4) {{.*}} p3m

# The virial of the influence function through every alias of eq. 2.28
# (docs/pme-m1.md, Section 1.1): its trace against -dU/dlambda under a
# uniform scaling (2.2e-5) and each diagonal component against -dU/de_aa
# under a strain of axis a alone (1.3e-5 of the largest), at the noise of
# the rounding of the coordinates as for "SPME" (2.2e-5 and 1.7e-5). The
# formula, off the diagonal too, is checked against differences of the
# direct sum under each of the nine strains by influence-function.test.
#
# VIRIAL: {{virial( of the axes)? ok}}

# TILTED: influence = "P3M" takes a rectangular cell

#--- run.toml
[input]
topology   = "three.prmtop"
coordinates = "three.inpcrd"

[output]
energy_interval = 1000
[energy]
cutoff        = 9.0
pairlist_distance = 10.0
electrostatics = "PME"

[pme]
beta = 0.347045919371208278
order = 4
grid = [16, 20, 24]
influence = "P3M"

[dynamics]
integrator    = "VELOCITY_VERLET"
time_step     = 0.0001
steps         = 1000

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[boundary]
type = "PERIODIC"
#--- end
