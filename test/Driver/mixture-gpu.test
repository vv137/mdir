# The mixture of mixture.toml on a GPU, in mixed precision.
#
# REQUIRES: cuda
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: sed -e 's|Inputs/|%S/Inputs/|' %S/mixture.toml > %t/run.toml
# RUN: echo '[execution]' >> %t/run.toml
# RUN: echo 'target = "gpu"' >> %t/run.toml
# RUN: echo 'precision = "mixed"' >> %t/run.toml
# RUN: mdir run %t/run.toml | FileCheck %s

# The virial is a sum of vectors, which the device adds up.
#
# CHECK:      INFO:         0         0.0000 {{ *-[0-9.]+}} {{ *}}-497.729{{[0-9]}} {{ *[0-9.]+}} {{ *}}120.0020 {{ *}}-1117.77{{[0-9]+}} {{ *}}-1712.03{{[0-9]+}}
# CHECK:      INFO:       200         0.8000
# CHECK:      MDIR: the total energy changed by {{[0-9.]+}}e-0{{[5-9]}} of its value
