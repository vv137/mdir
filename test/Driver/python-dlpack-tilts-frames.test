# REQUIRES: python-api
# The use of the frame evaluator (#138) with a triclinic cell, on the CPU
# (D238, docs/python-dlpack.md): 20 frames of a run of
# `mdir run` at constant pressure in a rhombic dodecahedron, whose barostat
# scales the tilts with the cell, are put one by one into a second
# simulation through a writable borrow; the potential, the virial, the
# volume, and the forces of each equal those of a simulation compiled from
# that frame, in double and in mixed precision in the deterministic mode.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/triclinic/water.top %S/Inputs/triclinic/dodecahedron.gro %t/
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/npt.toml
# RUN: cd %t && mdir run npt.toml > /dev/null
# RUN: %mdir_python %S/Inputs/python_dlpack_tilts.py %S/Inputs/triclinic CPU frames %t/npt.dcd | FileCheck %s
# CHECK: Double: 20 frames of a run at constant pressure (c_x from {{[0-9.]+}} to {{[0-9.]+}} nm) put into one simulation: the potential, the virial, the volume, and the forces of each equal those of a simulation compiled from the frame, difference 0.0
# CHECK: Mixed: 20 frames of a run at constant pressure (c_x from {{[0-9.]+}} to {{[0-9.]+}} nm) put into one simulation: the potential, the virial, the volume, and the forces of each equal those of a simulation compiled from the frame, difference 0.0
# CHECK: dlpack tilts frames CPU passed

#--- run.toml
[input]
topology    = "water.top"
coordinates = "dodecahedron.gro"
format      = "GROMACS"

[output]
energy_interval     = 100
trajectory          = "npt.dcd"
trajectory_interval = 20

[energy]
cutoff            = 8.0
pairlist_distance = 9.0
electrostatics    = "PME"

[pme]
tolerance = 1e-05
order     = 4
grid      = [28, 28, 28]

[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.002
steps      = 400

[ensemble]
ensemble    = "NPT"
temperature = 300.0
pressure    = 1.0

[thermostat]
method        = "V-RESCALE"
time_constant = 0.5
interval      = 10

[barostat]
method        = "C-RESCALE"
time_constant = 1.0
interval      = 10

[constraints]
rigid_water = true

[boundary]
type = "PERIODIC"

[execution]
target    = "CPU"
precision = "DOUBLE"
#--- end
