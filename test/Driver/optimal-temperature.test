# The optimal temperature of the log (D[optimal-temperature]). 125 atoms
# of argon, each in a harmonic well of its own, under velocity Verlet at
# omega dt = 0.5 with velocity rescaling at 150 K, which holds the kinetic
# energy of the velocities of the steps at the target. The log's
# temperature, (K + 2 K_half) / 3 over N_f k_B / 2, is above it: that of
# the steps is (1 - w/4) / (1 - w/12) of it, w = (omega dt)^2, and that of
# the configurations 1 / (1 - w/12) of it (with N_f = 3N - 3 against the 3N
# of the wells), the closed forms of an orbit of velocity Verlet.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: %python %S/Inputs/brownian_wells.py write %t 125
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/base.toml
# RUN: cat %t/base.toml %t/wells.toml > %t/run.toml
# RUN: cd %t && mdir run run.toml > run.log
# RUN: %python %S/Inputs/optimal_temperature.py %t/run.log 125 0.50002 150 | FileCheck %s

# CHECK: temperature of the steps {{.*}}: agrees
# CHECK: full / optimal {{.*}}: agrees
# CHECK: configurations / optimal {{.*}}: agrees

#--- run.toml
[input]
topology    = "wells.top"
coordinates = "wells.gro"

[output]
energy_interval = 10

[energy]
cutoff = 9.0

[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.10925
steps      = 50000
seed       = 7
center_of_mass_interval = 0

[ensemble]
ensemble    = "NVT"
temperature = 150.0

[thermostat]
method        = "V-RESCALE"
time_constant = 5.0

[boundary]
type = "PERIODIC"
#--- end
