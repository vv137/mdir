# Pair terms given by expressions with a topology (D137): [[energy.pair]]
# over the pairs of the topology that are not excluded, in r (Å), the
# charges q1 and q2, the parameters sigma and epsilon of the pair and
# sigma1, sigma2, epsilon1, epsilon2 of each particle (Å, kcal/mol), as the
# custom nonbonded force of OpenMM. On the dipeptide: a copy of the
# Lennard-Jones of the topology, which the log gives as that term, and a
# term of all the variables over the pairs of two interaction groups that
# overlap, the dipeptide and the first 20 residues. check_pair_terms.py
# computes their energies from the topology and the coordinates, and the
# forces that they add against central differences of its energies.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/dipeptide/dipeptide.prmtop %S/Inputs/dipeptide/dipeptide.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/terms.toml
# RUN: sed -n '/^#--- run.toml/,/^#--- terms/p' %s | sed '1d;$d' | sed 's/terms.h5/plain.h5/' > %t/plain.toml
# RUN: cd %t && mdir run plain.toml > /dev/null && mdir run terms.toml | FileCheck %s
# RUN: mdir checkpoint --print=forces %t/plain.h5 > %t/plain.forces
# RUN: mdir checkpoint --print=forces %t/terms.h5 > %t/terms.forces
# RUN: %python %S/Inputs/check_pair_terms.py %t/dipeptide.prmtop %t/dipeptide.inpcrd %t/plain.forces %t/terms.forces | FileCheck %s --check-prefix=PYTHON
#
# The truncation of the Lennard-Jones applies to the terms as well: the copy
# is the term of the topology shifted, and with its force switched.
# RUN: sed -e 's/^electrostatics    = "CUTOFF"/&\nlennard_jones_modifier = "POTENTIAL_SHIFT"/' %t/terms.toml > %t/shift.toml
# RUN: cd %t && mdir run shift.toml | FileCheck %s --check-prefix=TRUNCATED
# RUN: sed -e 's/^electrostatics    = "CUTOFF"/&\nlennard_jones_modifier = "FORCE_SWITCH"\nswitch_distance = 7.0/' %t/terms.toml > %t/switch.toml
# RUN: cd %t && mdir run switch.toml | FileCheck %s --check-prefix=TRUNCATED
# RUN: sed -e 's/FORCE_SWITCH/POWER_FORCE_SWITCH/' %t/switch.toml > %t/power.toml
# RUN: not mdir check %t/power.toml 2>&1 | FileCheck %s --check-prefix=POWER
#
#
# The correction for the dispersion integrates each pair term beyond the
# cutoff (D[pair-dispersion-correction]), and the Coulomb-like part of
# 'grouped' has no finite tail.
# RUN: sed -e 's/^dispersion_correction = "NONE"/dispersion_correction = "ENERGY_PRESSURE"/' %t/terms.toml > %t/tail.toml
# RUN: cd %t && not mdir run tail.toml 2>&1 | FileCheck %s --check-prefix=TAIL
#
# RUN: sed -e 's/^scale = 0.5/mixing = { scale = "ARITHMETIC" }/' %t/terms.toml > %t/mixing.toml
# RUN: not mdir check %t/mixing.toml 2>&1 | FileCheck %s --check-prefix=MIXING
# RUN: sed -e 's/q1\*q2/q1*charge/' %t/terms.toml > %t/name.toml
# RUN: not mdir check %t/name.toml 2>&1 | FileCheck %s --check-prefix=NAME
# RUN: sed -e 's/q1\*q2/q1*q1*q2/' %t/terms.toml > %t/order.toml
# RUN: not mdir check %t/order.toml 2>&1 | FileCheck %s --check-prefix=ORDER
# RUN: sed -e 's/^groups = .*/groups = [":1-3", ":9999"]/' %t/terms.toml > %t/empty.toml
# RUN: mdir check %t/empty.toml 2>&1 | FileCheck %s --check-prefix=EMPTY
# RUN: sed -e 's/^groups = .*/groups = [":1-3"]/' %t/terms.toml > %t/one.toml
# RUN: not mdir check %t/one.toml 2>&1 | FileCheck %s --check-prefix=ONE

# CHECK:      MDIR:   Lennard-Jones [[LJ:[-0-9.]+]]
# CHECK:      MDIR:   copy [[LJ]]
# CHECK-NEXT: MDIR:   grouped                  -29.631865

# TRUNCATED:      MDIR:   Lennard-Jones [[LJ:[-0-9.]+]]
# TRUNCATED:      MDIR:   copy [[LJ]]

# PYTHON:      copy 386.744746
# PYTHON-NEXT: grouped -29.631865
# PYTHON-NEXT: forces against differences of the energy: ok

# POWER: a pair term is truncated as the whole of its energy, which "POWER_FORCE_SWITCH" does not say; use "FORCE_SWITCH"
# MIXING: with a topology a pair term takes the parameters of the topology, not 'mixing' or 'dispersion_correction'
# NAME: the expression uses 'charge', which is not r, q1, q2, sigma, epsilon, sigma1, sigma2, epsilon1, epsilon2, coulomb, the time t, or a constant of the term
# ORDER: the energy of a pair must not change when its two particles are exchanged (q1 with q2, sigma1 with sigma2, epsilon1 with epsilon2), and this expression does
# EMPTY: mdir: warning: the group ':9999' of the pair term 'grouped' selects no particle; the term adds nothing
# TAIL: the correction for the dispersion integrates the pair term 'grouped' beyond the cutoff, and its tail diverges or cannot be integrated (its energy must decay faster than 1/r^3); give 'dispersion_correction = "NONE"'
# ONE: expected 'groups' as two masks of particles

#--- run.toml
[input]
topology    = "dipeptide.prmtop"
coordinates = "dipeptide.inpcrd"
[output]
energy_interval = 0
checkpoint = "terms.h5"
checkpoint_interval = 1
[energy]
cutoff            = 9.0
pairlist_distance = 10.0
electrostatics    = "CUTOFF"
dispersion_correction = "NONE"
[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 1e-9
steps      = 1
[ensemble]
ensemble    = "NVE"
temperature = 0.0
[boundary]
type = "PERIODIC"
[execution]
target    = "CPU"
precision = "DOUBLE"
#--- terms
[[energy.pair]]
name       = "copy"
expression = "4*epsilon*((sigma/r)^12 - (sigma/r)^6)"
[[energy.pair]]
name       = "grouped"
expression = "scale*coulomb*q1*q2/r + 4*e12*((s12/r)^12 - (s12/r)^6) + b*epsilon*(sigma/r)^6; s12 = 0.5*(sigma1 + sigma2); e12 = sqrt(epsilon1*epsilon2)"
groups = [":1-3", ":1-20"]
scale = 0.5
b = 0.3
#--- end
