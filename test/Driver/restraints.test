# RUN: mdir check %t/wrong2.toml 2>> %t/wrong.txt > /dev/null
# RUN: sed -e 's/SELECTION/(:1/' %t/min.toml > %t/wrong3.toml
# RUN: not mdir check %t/wrong3.toml 2>> %t/wrong.txt
# RUN: sed -e 's/SELECTION/@/' %t/min.toml > %t/wrong4.toml
# RUN: not mdir check %t/wrong4.toml 2>> %t/wrong.txt
# RUN: sed -e 's/SELECTION/:1-2/' %t/min.toml > %t/wrong5.toml
# RUN: printf '[[restraints]]\nselection = ":2"\nforce_constant = 1.0\nreference_scaling = "ALL"\n' >> %t/wrong5.toml
# RUN: not mdir check %t/wrong5.toml 2>> %t/wrong.txt
# RUN: sed -e 's/SELECTION/:2/' %t/min.toml > %t/wrong6.toml
# RUN: printf 'reference_scaling = "COM"\n' >> %t/wrong6.toml
# RUN: not mdir check %t/wrong6.toml 2>> %t/wrong.txt
# RUN: FileCheck %s --check-prefix=WRONG < %t/wrong.txt
#
# WRONG:      mdir: in the mask ':1-', at 4: expected a number or a range such as 1-10, not '1-'
# WRONG-NEXT: mdir: in the mask '@CA)', at 4: unexpected ')'
# WRONG-NEXT: mdir: warning: the restraint of ':XYZ' selects no particle with mass; it restrains nothing
# WRONG-NEXT: mdir: in the mask '(:1', at 4: expected ')'
# WRONG-NEXT: mdir: in the mask '@', at 2: expected a number, a range, or a name
# WRONG-NEXT: mdir: the restraint of ':2' selects particle 7, which another restraint selects with another 'reference_scaling'
# WRONG-NEXT: mdir: {{.*}}expected one of CENTER, ALL for 'reference_scaling', got 'COM'

# A minimization with the heavy atoms of the peptide restrained, and a run
# at constant energy from where it ends, which keeps the total energy with
# that of the restraints as well as a run without them does.
#
# RUN: sed -e 's/SELECTION/!:WAT \& !@H*/' %t/min.toml > %t/heavy.toml
# RUN: mdir run %t/heavy.toml > %t/both.log
# RUN: mdir run %t/run.toml >> %t/both.log
# RUN: FileCheck %s < %t/both.log
#
# CHECK:      MDIR:   restraints                     0.000000
# CHECK:      MDIR: the potential energy went from -5348.8659 to [[LAST:-[0-9.]+]] kcal/mol
# CHECK:      MDIR:   restraints {{ *}}[[REST:[0-9.]+]]
# CHECK:      INFO:         0         0.0000 {{ *}}{{-[0-9.]+}} {{ *}}[[LAST]]{{[0-9]*}}
# CHECK:      MDIR: the total energy changed by {{[0-9.]+}}e-0{{[4-9]}} of its value

#--- min.toml
[input]
topology   = "ff19.prmtop"
coordinates = "ff19.inpcrd"

[output]
checkpoint = "min.h5"
energy_interval = 50

[energy]
cutoff        = 9.0
pairlist_distance = 10.0
electrostatics = "PME"
coulomb_modifier     = "POTENTIAL_SHIFT"

[minimize]
steps         = 100

[constraints]
hydrogen_bonds = true
rigid_water = true

[boundary]
type = "PERIODIC"

[[restraints]]
selection      = "SELECTION"
force_constant = 10.0
#--- end
#--- run.toml
[input]
topology   = "ff19.prmtop"
coordinates = "ff19.inpcrd"
checkpoint = "min.h5"

[output]
energy_interval = 250
[energy]
cutoff        = 9.0
pairlist_distance = 10.0
electrostatics = "PME"
coulomb_modifier     = "POTENTIAL_SHIFT"

[dynamics]
time_step     = 0.001
steps         = 500

[ensemble]
temperature = 300.0

[constraints]
hydrogen_bonds = true
rigid_water = true

[boundary]
type = "PERIODIC"

[[restraints]]
selection      = "!:WAT & !@H*"
force_constant = 10.0
#--- end
