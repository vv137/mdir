# Harmonic restraints to the positions of the file of coordinates, on the
# target of D65 (ff19SB in OPC), with the particles that masks of Amber
# select.
#
# REQUIRES: hdf5
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/ff19sb/ff19.prmtop %S/Inputs/ff19sb/ff19.inpcrd %t
# RUN: sed -n '/^#--- min.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/min.toml
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/run.toml

# The masks. The peptide is ACE-ALA-GLY-SER-NME, whose carbon of NME is C;
# the extra points of the waters have no mass and are not restrained.
#
# RUN: rm -f %t/masks.txt
# RUN: sed -e 's/SELECTION/:1-5@CA/' %t/min.toml > %t/mask0.toml
# RUN: mdir check %t/mask0.toml | grep restrained >> %t/masks.txt
# RUN: sed -e 's/SELECTION/!:WAT \& !@H*/' %t/min.toml > %t/mask1.toml
# RUN: mdir check %t/mask1.toml | grep restrained >> %t/masks.txt
# RUN: sed -e 's/SELECTION/:ALA,SER/' %t/min.toml > %t/mask2.toml
# RUN: mdir check %t/mask2.toml | grep restrained >> %t/masks.txt
# RUN: sed -e 's/SELECTION/@1-10/' %t/min.toml > %t/mask3.toml
# RUN: mdir check %t/mask3.toml | grep restrained >> %t/masks.txt
# RUN: sed -e 's/SELECTION/:WAT@O/' %t/min.toml > %t/mask4.toml
# RUN: mdir check %t/mask4.toml | grep restrained >> %t/masks.txt
# RUN: sed -e 's/SELECTION/(:1|:5)\&@C*/' %t/min.toml > %t/mask5.toml
# RUN: mdir check %t/mask5.toml | grep restrained >> %t/masks.txt
# RUN: sed -e 's/SELECTION/*/' %t/min.toml > %t/mask6.toml
# RUN: mdir check %t/mask6.toml | grep restrained >> %t/masks.txt
# RUN: sed -e 's/SELECTION/:1-3@N,CA,C,O/' %t/min.toml > %t/mask7.toml
# RUN: mdir check %t/mask7.toml | grep restrained >> %t/masks.txt
