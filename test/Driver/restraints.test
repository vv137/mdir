# RUN: mdir check %t/mask8.toml | grep restrained >> %t/masks.txt
# RUN: FileCheck %s --check-prefix=MASK < %t/masks.txt
#
# MASK:      restrained: 3 particles
# MASK-NEXT: restrained: 20 particles
# MASK-NEXT: restrained: 21 particles
# MASK-NEXT: restrained: 10 particles
# MASK-NEXT: restrained: 573 particles
# MASK-NEXT: restrained: 3 particles
# MASK-NEXT: restrained: 1759 particles
