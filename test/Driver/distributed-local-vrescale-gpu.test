# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %S/shake.test | sed -e '1d;$d' -e 's|= "vacuum|= "%S/Inputs/ff19sb/vacuum|' -e 's/= 500/= 10/' -e 's/= 100/= 2/g' -e 's/= 28.0/= 8.0/' -e 's/= 29.0/= 11.0/' -e 's/"CUTOFF"/"REACTION_FIELD"/' -e '/^electrostatics/a reaction_field_dielectric = 0' -e 's/"NVE"/"NVT"/' -e '/^\[dynamics\]/a seed = 314159' > %t/ordinary.toml
