# REQUIRES: python-api, hdf5
# Same predeclared bounds and independent SHAKE/RATTLE oracle.
# RUN: rm -rf %t && mkdir -p %t
# RUN: %mdir_python %S/Inputs/leapfrog_npt_storage.py collect %S/Inputs %t/verlet.npz --integrator VelocityVerlet --target CPU --precision Mixed
# RUN: %mdir_python %S/Inputs/leapfrog_npt_storage.py collect %S/Inputs %t/verlet-double.npz --integrator VelocityVerlet --target CPU --precision Double
# RUN: %mdir_python %S/Inputs/leapfrog_npt_storage.py collect %S/Inputs %t/verlet-ulp.npz --integrator VelocityVerlet --target CPU --precision Mixed --perturb-f32-ulp
# RUN: %mdir_python %S/Inputs/leapfrog_npt_storage.py collect %S/Inputs %t/leapfrog.npz --target CPU --precision Mixed
# RUN: %mdir_python %S/Inputs/leapfrog_npt_storage.py check %S/Inputs %t/leapfrog.npz --base %t/verlet.npz --reference-integrator VelocityVerlet --target CPU --precision Mixed --baseline-double %t/verlet-double.npz --baseline-ulp %t/verlet-ulp.npz | FileCheck %s
# CHECK: Mixed Trotter: reference/oracle passed
