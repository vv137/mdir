# REQUIRES: python-api
# The build in the key of the cache of the skins (D[skin-budget-record]):
# a clean build is named by its commit, LLVM, and the LLVM options of the
# command line, so `mdir` and the Python extension, two images of one build,
# have one key (`mdir check --json`'s `run.skins.cache_key` and
# `Program.plan["skin_cache_key"]`); a dirty build is named by its image as
# well, so the two differ. An LLVM option of the command line changes the
# key. MDIR_SKIN_SALT_DIRTY_OVERRIDE stands for the state of the build, which
# is that of the tree the suite was built from. Another commit is in
# Driver/compile-cache.test (composeSkinSalt).
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: %python %S/Inputs/argon_lattice.py 20 %t/small.pdb
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %S/neighbor-auto.test | sed '1d;$d' \
# RUN:     | sed -e 's|big.pdb|small.pdb|' -e 's|152.0|76.0|g' -e 's|^cutoff = 9.0|cutoff = 9.0\npairlist_distance = "AUTO"|' > %t/auto.toml
# RUN: cd %t && env MDIR_SKIN_SALT_DIRTY_OVERRIDE=no mdir check --json auto.toml > clean.json
# RUN: cd %t && env MDIR_SKIN_SALT_DIRTY_OVERRIDE=no mdir check --json auto.toml -nvptx-prec-divf32=0 > option.json
# RUN: cd %t && env MDIR_SKIN_SALT_DIRTY_OVERRIDE=yes mdir check --json auto.toml > dirty.json
# RUN: env MDIR_SKIN_SALT_DIRTY_OVERRIDE=no %mdir_python %S/Inputs/skin_salt.py python %S/Inputs/dipeptide > %t/clean.txt
# RUN: %python %S/Inputs/skin_salt.py check %t/clean.json >> %t/clean.txt
# RUN: %python %S/Inputs/skin_salt.py check %t/option.json >> %t/clean.txt
# RUN: FileCheck %s --check-prefix=CLEAN < %t/clean.txt
# RUN: %python %S/Inputs/skin_salt.py compare %t/clean.txt | FileCheck %s --check-prefix=CLEAN-SAME-KEY
# RUN: env MDIR_SKIN_SALT_DIRTY_OVERRIDE=yes %mdir_python %S/Inputs/skin_salt.py python %S/Inputs/dipeptide > %t/dirty.txt
# RUN: %python %S/Inputs/skin_salt.py check %t/dirty.json >> %t/dirty.txt
# RUN: FileCheck %s --check-prefix=DIRTY < %t/dirty.txt
# RUN: %python %S/Inputs/skin_salt.py compare %t/dirty.txt | FileCheck %s --check-prefix=DIRTY-KEY

# CLEAN: python {{[0-9a-f]+}} image=False
# CLEAN-NEXT: mdir {{[0-9a-f]+}} image=False
# CLEAN-NEXT: mdir {{[0-9a-f]+}} image=False
# CLEAN-SAME-KEY: python -> mdir same
# CLEAN-SAME-KEY-NEXT: mdir -> mdir different
# DIRTY: python {{[0-9a-f]+}} image=True
# DIRTY-NEXT: mdir {{[0-9a-f]+}} image=True
# DIRTY-KEY: python -> mdir different
