# Virtual sites of GROMACS: the three waters of virtual-sites.test as
# flexible TIP4P-Ew in a topology of GROMACS, whose sites [ virtual_sites3 ]
# places as a linear combination of the oxygen and the two hydrogens. The
# site in the file is placed where its atoms put it.
#
# RUN: split-file %s %t
# RUN: mdir check %t/run.toml | FileCheck %s --check-prefix=INPUT
# RUN: mdir run --overwrite %t/run.toml | FileCheck %s
# A site whose atom type is of the particle type A, as in the OPC of
# amber19sb.ff, is a site all the same, as grompp takes it.
# RUN: sed -i 's/^  MW    0        0.0000  0.0     D /  MW    0        0.0000  0.0     A /' %t/system.top
# RUN: mdir check %t/run.toml | FileCheck %s --check-prefix=INPUT

# The exclusions are those of [ exclusions ]: GROMACS makes none for a
# virtual site.
#
# INPUT: particles:          12
# INPUT: excluded pairs:     18
# INPUT: virtual sites:      3
# INPUT: degrees of freedom: 24

# CHECK: MDIR: the momentum at the end is {{[0-9.]+}}e-1{{[0-9]}} amu nm/ps
# CHECK: MDIR: the total energy changed by {{[0-9.]+}}e-0{{[4-9]}} of its value

#--- run.toml
[input]
topology   = "system.top"
coordinates = "system.gro"

[output]
energy_interval = 1000
[energy]
cutoff       = 18.0
pairlist_distance = 19.0

[dynamics]
integrator    = "VELOCITY_VERLET"
time_step     = 0.0001
steps         = 1000

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[boundary]
type = "PERIODIC"
#--- system.top
[ defaults ]
; nbfunc  comb-rule  gen-pairs  fudgeLJ  fudgeQQ
  1       2          yes        0.5      0.8333

[ atomtypes ]
; name  at.num  mass     charge  ptype  sigma     epsilon
  OW    8       16.0000  0.0     A      0.316435  0.680946
  HW    1        1.0080  0.0     A      0.0       0.0
  MW    0        0.0000  0.0     D      0.0       0.0

[ moleculetype ]
; name  nrexcl
  SOL   2

[ atoms ]
  1  OW  1  SOL  OW   1   0.0      16.00000
  2  HW  1  SOL  HW1  1   0.52422   1.00800
  3  HW  1  SOL  HW2  1   0.52422   1.00800
  4  MW  1  SOL  MW   1  -1.04844   0.00000

[ bonds ]
  1  2  1  0.09572  502416.0
  1  3  1  0.09572  502416.0

[ angles ]
  2  1  3  1  104.52  628.02

[ virtual_sites3 ]
; site  from     funct  a            b
  4     1  2  3  1      0.106676721  0.106676721

[ exclusions ]
  1  2  3  4
  2  1  3  4
  3  1  2  4
  4  1  2  3

[ system ]
Three waters of four sites

[ molecules ]
  SOL  3
#--- system.gro
Three waters of four sites
   12
    1SOL     OW    1   1.9345583   2.0738500   2.0834917
    1SOL    HW1    2   1.8904583   2.0856500   2.1577917
    1SOL    HW2    3   1.9062583   1.9963500   2.0549917
    1SOL     MW    4   1.9345583   2.0738500   2.0834917
    2SOL     OW    5   2.1854583   2.1434500   1.9913917
    2SOL    HW1    6   2.2462583   2.1264500   2.0516917
    2SOL    HW2    7   2.1103583   2.1294500   2.0334917
    2SOL     MW    8   2.1854583   2.1434500   1.9913917
    3SOL     OW    9   1.8912583   1.8355500   1.8945917
    3SOL    HW1   10   1.8727583   1.7516500   1.9097917
    3SOL    HW2   11   1.9571583   1.8319500   1.8375917
    3SOL     MW   12   1.8912583   1.8355500   1.8945917
   4.0000000   4.0000000   4.0000000
