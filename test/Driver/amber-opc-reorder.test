# The OPC system of amber-opc.test in the order of the positions, where
# each segment begins: the members of the virtual sites are renumbered with
# the particles, and the states agree with those of a run in the order of
# the files.
#
# REQUIRES: hdf5
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/opc/opc.prmtop %S/Inputs/opc/opc.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %S/amber-opc.test | sed '1d;$d' \
# RUN:     | sed -e 's|^steps *= 10|steps = 40|' \
# RUN:           -e 's|energy_interval = 10|energy_interval = 10\ncheckpoint_interval = 10|' \
# RUN:     > %t/on.toml
# RUN: sed -i 's|^\[output\]$|[output]\ncheckpoint = "on.h5"|' %t/on.toml
# RUN: printf '[execution]\nspatial_order = true\n' >> %t/on.toml
# RUN: sed -e 's|spatial_order = true|spatial_order = false|' -e 's|on.h5|off.h5|' %t/on.toml > %t/off.toml
# RUN: mdir run %t/on.toml | FileCheck %s
# RUN: mdir run %t/off.toml | FileCheck %s
# RUN: not mdir checkpoint %t/on.h5 %t/off.h5 | FileCheck %s --check-prefix=STATES

# The same with the waters rigid: the members of SETTLE are renumbered too.
#
# RUN: printf '[constraints]\nrigid_water = true\n' >> %t/on.toml
# RUN: printf '[constraints]\nrigid_water = true\n' >> %t/off.toml
# RUN: mdir run %t/on.toml | FileCheck %s --check-prefix=RIGID
# RUN: mdir run %t/off.toml | FileCheck %s --check-prefix=RIGID
# RUN: not mdir checkpoint %t/on.h5 %t/off.h5 | FileCheck %s --check-prefix=STATES

# RIGID: INFO:        40

# CHECK: INFO:         0         0.0000 {{ *-?[0-9.]+}} {{ *}}-12.0706
# CHECK: INFO:        40

# STATES: values of the positions differ, by up to {{[0-9.]+}}e-1{{[0-9]}}
