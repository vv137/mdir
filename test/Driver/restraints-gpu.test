# The target of barostat-ff19sb-gpu.test at constant pressure with the
# heavy atoms of the peptide restrained, as in the equilibration of a
# solvated molecule. The reference positions follow the cell, so that the
# barostat scales them with the positions.
#
# REQUIRES: cuda
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/ff19sb/ff19.prmtop %S/Inputs/ff19sb/ff19.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/run.toml
# RUN: mdir run %t/run.toml | FileCheck %s
# RUN: mdir emit %t/run.toml | FileCheck %s --check-prefix=MODULE
# RUN: %python %S/Inputs/check_bonds.py %t/ff19.prmtop %t/run.dcd | FileCheck %s --check-prefix=BONDS

# CHECK:      MDIR:   restraints                     0.000000
# CHECK:      INFO:      2000 {{.*}} {{2[4-8][0-9]{3}\.[0-9]+$}}
# CHECK:      MDIR: the conserved energy changed by {{[0-9.]+}}e-0{{[3-9]}} of its value

# The factors of the reference, the edges of the cell over those of the
# file axis by axis (D119), are taken with the cell in each loop and passed
# to the steps.
#
# MODULE:     dyn.program @step(%x: !vec, %v: !vec, %f: !vec, %m: !real,
# MODULE-NEXT:    %cell: !md.cell, %dt: f64, %rest_scale: vector<3xf64>,
# MODULE:     %rest_edges = vector.from_elements
# MODULE:     %rest_scale{{[0-9]+}}_e = vector.from_elements %edge{{[0-9]+}}_0, %edge{{[0-9]+}}_1, %edge{{[0-9]+}}_2
# MODULE-NEXT: %rest_scale{{[0-9]+}} = arith.divf %rest_scale{{[0-9]+}}_e, %rest_edges : vector<3xf64>

# BONDS: bonds ok

#--- run.toml
[input]
topology   = "ff19.prmtop"
coordinates = "ff19.inpcrd"

[output]
trajectory = "run.dcd"
energy_interval = 1000
trajectory_interval = 1000

[energy]
cutoff        = 9.0
pairlist_distance = 10.0
electrostatics = "PME"
coulomb_modifier     = "POTENTIAL_SHIFT"

[dynamics]
integrator        = "VELOCITY_VERLET"
time_step         = 0.002
steps             = 2000

[ensemble]
ensemble    = "NPT"
temperature = 300.0
pressure    = 1.0

[thermostat]
method = "V-RESCALE"
interval = 10
time_constant = 0.5

[barostat]
method = "C-RESCALE"
time_constant = 8.0

[constraints]
hydrogen_bonds = true
rigid_water = true

[boundary]
type = "PERIODIC"

[execution]
target    = "gpu"
precision = "mixed"

[[restraints]]
selection      = "!:WAT & !@H*"
force_constant = 10.0
#--- end
