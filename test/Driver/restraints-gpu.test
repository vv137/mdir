# The target of barostat-ff19sb-gpu.test at constant pressure with the
# heavy atoms of the peptide restrained, as in the equilibration of a
# solvated molecule. The center of the reference positions follows the cell,
# so that the barostat scales it with the positions, and the references keep
# their shape about it (D124).
#
# REQUIRES: cuda
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/ff19sb/ff19.prmtop %S/Inputs/ff19sb/ff19.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/run.toml
# RUN: mdir run %t/run.toml | FileCheck %s
# RUN: mdir emit %t/run.toml | FileCheck %s --check-prefix=MODULE
# RUN: %python %S/Inputs/check_bonds.py %t/ff19.prmtop %t/run.dcd | FileCheck %s --check-prefix=BONDS

# CHECK:      MDIR:   restraints                     0.000000
# CHECK:      INFO:      2000 {{.*}} {{2[4-8][0-9]{3}\.[0-9]+}} {{[0-9.]+$}}
# CHECK:      MDIR: the conserved energy changed by {{[0-9.]+}}e-0{{[3-9]}} of its value

# The factors of the reference, the edges of the cell over those of the
# file axis by axis (D119), are taken with the cell in each loop and passed
# to the steps. They scale the centers of the references, and the fields
# hold the offsets from them (D124); the virial adds the offsets to d.
#
# MODULE:     dyn.program @step(%arg0: !md.field<@atoms, 3 x f64>, %arg1: !md.field<@atoms, 3 x f64>, %arg2: !md.field<@atoms, 3 x f64>, %arg3: !md.field<@atoms, f64>, %arg4: !md.cell, %arg5: f64, [[SCALE:%arg[0-9]+]]: vector<3xf64>,
# MODULE:     [[REF:%[0-9]+]] = vector.from_elements {{.*}} : vector<3xf64>
# MODULE-NEXT: [[RC:%[0-9]+]] = vector.from_elements {{.*}} : vector<3xf64>
# MODULE-NEXT: [[RCS:%[0-9]+]] = arith.mulf [[SCALE]], [[RC]] : vector<3xf64>
# MODULE-NEXT: [[REFS:%[0-9]+]] = arith.addf [[RCS]], [[REF]] : vector<3xf64>
# MODULE-NEXT: arith.subf {{%arg[0-9]+}}, [[REFS]] : vector<3xf64>
# MODULE:     md.sum_particles gather(
# MODULE:     [[VREF:%[0-9]+]] = vector.from_elements {{.*}} : vector<3xf64>
# MODULE-NEXT: [[VRC:%[0-9]+]] = vector.from_elements {{.*}} : vector<3xf64>
# MODULE-NEXT: [[VRCS:%[0-9]+]] = arith.mulf {{%arg[0-9]+}}, [[VRC]] : vector<3xf64>
# MODULE-NEXT: [[VREFS:%[0-9]+]] = arith.addf [[VRCS]], [[VREF]] : vector<3xf64>
# MODULE-NEXT: [[VD:%[0-9]+]] = arith.subf {{%arg[0-9]+}}, [[VREFS]] : vector<3xf64>
# MODULE:     [[DPO:%[0-9]+]] = arith.addf [[VD]], [[VREF]] : vector<3xf64>
# MODULE-NEXT: arith.mulf {{%[0-9]+}}, [[DPO]] : vector<3xf64>
# The entry: the edges of the reference (values of the start), and in the
# loops the factors, the edges of the cell over them.
# MODULE:     func.func @mdir_run(
# MODULE:     [[EDGES:%[0-9]+]] = vector.from_elements {{%arg[0-9]+}}, {{%arg[0-9]+}}, {{%arg[0-9]+}} : vector<3xf64>
# MODULE-NEXT: [[CELL:%[0-9]+]] = vector.from_elements {{%[0-9a-z]+}}, {{%[0-9a-z]+}}, {{%[0-9a-z]+}} : vector<3xf64>
# MODULE-NEXT: arith.divf [[CELL]], [[EDGES]] : vector<3xf64>

# BONDS: bonds ok

#--- run.toml
[input]
topology   = "ff19.prmtop"
coordinates = "ff19.inpcrd"

[output]
trajectory = "run.dcd"
energy_interval = 1000
trajectory_interval = 1000

[energy]
cutoff        = 9.0
pairlist_distance = 10.0
electrostatics = "PME"
coulomb_modifier     = "POTENTIAL_SHIFT"

[dynamics]
integrator        = "VELOCITY_VERLET"
time_step         = 0.002
steps             = 2000

[ensemble]
ensemble    = "NPT"
temperature = 300.0
pressure    = 1.0

[thermostat]
method = "V-RESCALE"
interval = 10
time_constant = 0.5

[barostat]
method = "C-RESCALE"
time_constant = 8.0

[constraints]
hydrogen_bonds = true
rigid_water = true

[boundary]
type = "PERIODIC"

[execution]
target    = "gpu"
precision = "mixed"

[[restraints]]
selection      = "!:WAT & !@H*"
force_constant = 10.0
#--- end
