# Leapfrog and velocity Verlet take the same steps: the two differ in what
# they store. The log is the same, row by row, although the stored
# velocities of leapfrog are half a step behind the positions.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: sed -e 's|Inputs/|%S/Inputs/|' %S/mixture.toml > %t/verlet.toml
# RUN: sed -e 's|"VELOCITY_VERLET"|"LEAPFROG"|' %t/verlet.toml > %t/leapfrog.toml
# RUN: mdir run %t/verlet.toml | grep "^INFO" > %t/verlet.log
# RUN: mdir run %t/leapfrog.toml | grep "^INFO" > %t/leapfrog.log
# RUN: diff %t/verlet.log %t/leapfrog.log
# RUN: FileCheck %s < %t/leapfrog.log
# RUN: mdir emit %t/leapfrog.toml | FileCheck %s --check-prefix=MODULE

# CHECK:      INFO:         0         0.0000
# CHECK:      INFO:       200         0.8000 {{ *}}-406.5155 {{ *}}-460.4736 {{ *}}53.9581

# Leapfrog carries the forces of the positions, as velocity Verlet does,
# and evaluates once per step, at its end. The step of energy returns the
# velocities of the time of the new positions, half a kick ahead of those
# that it stores, and the kinetic energy takes them.
#
# MODULE:      dyn.program @step([[X:%[a-z0-9]+]]: !md.field<@atoms, 3 x f64>, [[V:%[a-z0-9]+]]: !md.field<@atoms, 3 x f64>, [[F:%[a-z0-9]+]]: !md.field<@atoms, 3 x f64>, [[M:%[a-z0-9]+]]: !md.field<@atoms, f64>, {{%[a-z0-9]+}}: !md.cell, [[DT:%[a-z0-9]+]]: f64,
# MODULE-SAME: velocity_offset = -5.000000e-01 : f64
# MODULE:      [[V1:%[0-9]+]] = dyn.kick [[V]], [[F]], [[M]], [[DT]] : !md.field<@atoms, 3 x f64>
# MODULE:      dyn.return {{%[0-9]+}}, [[V1]], {{%[0-9]+}} : !md.field<@atoms, 3 x f64>, !md.field<@atoms, 3 x f64>, !md.field<@atoms, 3 x f64>
# MODULE:      dyn.program @step_energy(
# MODULE:      [[EV1:%[0-9]+]] = dyn.kick {{%arg[0-9]+}}, {{%arg[0-9]+}}, [[EM:%arg[0-9]+]], {{%arg[0-9]+}} : !md.field<@atoms, 3 x f64>
# MODULE:      [[V2:%[0-9]+]] = dyn.kick [[EV1]], [[F1:%[0-9#]+]], [[EM]], {{%[0-9a-z_]+}} : !md.field<@atoms, 3 x f64>
# MODULE-NEXT: dyn.return {{%[0-9]+}}, [[EV1]], [[F1]], {{%[0-9#]+}}, {{%[0-9#]+}}, {{%[0-9]+}}, [[V2]]
# MODULE:      [[S:%[0-9]+]]:7 = dyn.step @step_energy(
# MODULE:      md.sum_particles gather([[S]]#6, [[MASS:%[0-9]+]] : !md.field<@atoms, 3 x f64>, !md.field<@atoms, f64>)
# MODULE:      md.sum_particles gather([[S]]#2, [[MASS]] : !md.field<@atoms, 3 x f64>, !md.field<@atoms, f64>)
# MODULE:      vector.reduction <add>, [[S]]#5
