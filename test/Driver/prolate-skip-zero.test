#--- ala3.toml
[input]
topology    = "ala3.prmtop"
coordinates = "ala3.inpcrd"

[output]
checkpoint          = "ala3.h5"
energy_interval     = 20
checkpoint_interval = 20

[energy]
cutoff            = 9.0
pairlist_distance = 10.0
electrostatics    = "PME"
coulomb_modifier  = "POTENTIAL_SHIFT"

[pme]
kernel = "PROLATE"

[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.002
steps      = 40

[ensemble]
ensemble    = "NPT"
temperature = 300.0
pressure    = 1.0

[thermostat]
method        = "V-RESCALE"
time_constant = 0.5
interval      = 10

[barostat]
method        = "C-RESCALE"
time_constant = 2.0

[constraints]
hydrogen_bonds = true
rigid_water    = true

[boundary]
type = "PERIODIC"

[execution]
target        = "CPU"
threads       = 4
precision     = "DOUBLE"
spatial_order = true
#--- dodec.toml
[input]
topology    = "water-half.top"
coordinates = "dodecahedron.gro"
format      = "GROMACS"
defines     = ["FLEXIBLE"]

[output]
checkpoint          = "dodec.h5"
energy_interval     = 10
checkpoint_interval = 10

[energy]
cutoff            = 9.0
pairlist_distance = 10.0
electrostatics    = "PME"
coulomb_modifier  = "POTENTIAL_SHIFT"

[pme]
kernel = "PROLATE"

[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.0005
steps      = 20

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[constraints]
hydrogen_bonds = false
rigid_water    = false

[boundary]
type = "PERIODIC"

[execution]
target        = "CPU"
threads       = 4
precision     = "DOUBLE"
spatial_order = true
#--- water-half.top
; TIP3P water, flexible with -DFLEXIBLE, for a test of triclinic cells: the
; water.top of Inputs/triclinic with the last 203 waters uncharged (SOLZ).

[ defaults ]
; nbfunc  comb-rule  gen-pairs  fudgeLJ  fudgeQQ
  1       2          yes        0.5      0.8333

[ atomtypes ]
; name  at.num  mass     charge  ptype  sigma     epsilon
  OW    8       15.9994  0.0     A      0.315061  0.636386
  HW    1       1.0080   0.0     A      0.0       0.0

[ moleculetype ]
; name  nrexcl
  SOL   2

[ atoms ]
  1  OW  1  SOL  OW   1  -0.834  15.99940
  2  HW  1  SOL  HW1  1   0.417   1.00800
  3  HW  1  SOL  HW2  1   0.417   1.00800

#ifdef FLEXIBLE
[ bonds ]
  1  2  1  0.09572  502416.0
  1  3  1  0.09572  502416.0
[ angles ]
  2  1  3  1  104.52  628.02
#else
[ settles ]
  1  1  0.09572  0.15136
#endif

[ exclusions ]
  1  2  3
  2  1  3
  3  1  2

[ moleculetype ]
; name  nrexcl
  SOLZ  2

[ atoms ]
  1  OW  1  SOLZ  OW   1   0.0  15.99940
  2  HW  1  SOLZ  HW1  1   0.0   1.00800
  3  HW  1  SOLZ  HW2  1   0.0   1.00800

#ifdef FLEXIBLE
[ bonds ]
  1  2  1  0.09572  502416.0
  1  3  1  0.09572  502416.0
[ angles ]
  2  1  3  1  104.52  628.02
#else
[ settles ]
  1  1  0.09572  0.15136
#endif

[ exclusions ]
  1  2  3
  2  1  3
  3  1  2

[ system ]
water in a rhombic dodecahedron

[ molecules ]
SOL 200
SOLZ 203
#--- end
