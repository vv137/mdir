# [[energy.model]] (D270): what the reader and the checks of
# the control file refuse before any plugin is loaded, and what `mdir check`
# says of a term that it takes. ML1 runs a model on a GPU, outside the
# deterministic mode, without derivatives that MDIR would take
# of the term (docs/metatomic-ml1.md, Sections 6.7 to 6.9).
#
# REQUIRES: python-api
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: %python %S/Inputs/hosted_default_effects.py %S/../.. %t/hosted-effects mdir mdir-opt | FileCheck %s --check-prefix=HOSTED-EFFECTS
# HOSTED-EFFECTS: effect modules: 72 verified (36 hosted, 36 classical constrained)
# HOSTED-EFFECTS-NEXT: exact/padded/search; double/mixed; NVE/NPT/min; run/segments
# RUN: %python %S/Inputs/hosted_restraint_energy.py %S/../.. %t/hosted-store mdir mdir-opt | FileCheck %s --check-prefix=STORED-RESTRAINT
# STORED-RESTRAINT: hosted restraint stores: 12 parsed and bound to their defining reduction
# STORED-RESTRAINT-NEXT: whole modules: 12 verified
# RUN: %mdir_python %S/../../scripts/mlip/water-box.py %t --n 2 --spacing 4.0
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/run.toml
# RUN: mdir check %t/run.toml | FileCheck %s --check-prefix=CHECK-OK
# CHECK-OK: model: allegro, METATOMIC, '{{.*}}allegro.pt', 16 centers per call

# An AOTInductor package of the `nequip` package (D273).
# RUN: sed -e 's/"METATOMIC"/"AOTI"/' -e 's/allegro.pt/allegro.nequip.pt2/' %t/run.toml > %t/aoti.toml
# RUN: mdir check %t/aoti.toml | FileCheck %s --check-prefix=CHECK-AOTI
# CHECK-AOTI: model: allegro, AOTI, '{{.*}}allegro.nequip.pt2', 16 centers per call

# RUN: sed 's/"METATOMIC"/"TORCHSCRIPT"/' %t/run.toml > %t/backend.toml
# RUN: not mdir check %t/backend.toml 2>&1 | FileCheck %s --check-prefix=BACKEND
# BACKEND: expected one of METATOMIC, AOTI, STAGES for 'backend', got 'TORCHSCRIPT'

# The choices are read without regard to case and kept in upper case
# (#551): "metatomic" is "METATOMIC", and "Stages" takes the checks of a
# model in stages.
# RUN: sed 's/"METATOMIC"/"metatomic"/' %t/run.toml > %t/lower.toml
# RUN: mdir check %t/lower.toml | FileCheck %s --check-prefix=CHECK-OK
# RUN: sed 's/"METATOMIC"/"Stages"/' %t/run.toml > %t/mixed-case.toml
# RUN: not mdir check %t/mixed-case.toml 2>&1 | FileCheck %s --check-prefix=STAGES-CENTERS
# The same choices of `mdir.ModelTerm` (lib/Driver/Model.cpp).
# RUN: %mdir_python %S/Inputs/model_choice_case.py %t | FileCheck %s --check-prefix=PYTHON-CASE
# PYTHON-CASE: STAGES: model: the model 'allegro' of {{.*}} in stages runs on a GPU only yet
# PYTHON-CASE-NEXT: stages: model: the model 'allegro' of {{.*}} in stages runs on a GPU only yet
# PYTHON-CASE-NEXT: Stages: model: the model 'allegro' of {{.*}} in stages runs on a GPU only yet
# PYTHON-CASE-NEXT: METATOMIC: model: the model 'allegro' of {{.*}} runs on a GPU only yet
# PYTHON-CASE-NEXT: metatomic: model: the model 'allegro' of {{.*}} runs on a GPU only yet
# PYTHON-CASE-NEXT: Aoti: model: the model 'allegro' of {{.*}} runs on a GPU only yet
# PYTHON-CASE-NEXT: TORCHSCRIPT: the model term 'allegro': backend takes "METATOMIC"
# PYTHON-CASE-NEXT: DOUBLE: cannot read the model in stages 'allegro'
# PYTHON-CASE-NEXT: double: cannot read the model in stages 'allegro'
# PYTHON-CASE-NEXT: SINGLE: model: the model 'allegro' of {{.*}} in stages takes 'stage_field_precision = "DOUBLE"' or no 'stage_field_precision'

# A model in stages (D294) takes no chunks of centers, and
# runs on a GPU.
# RUN: sed 's/"METATOMIC"/"STAGES"/' %t/run.toml > %t/stages.toml
# RUN: not mdir check %t/stages.toml 2>&1 | FileCheck %s --check-prefix=STAGES-CENTERS
# STAGES-CENTERS: a model in stages takes no 'centers_per_call': its tiles are rows of pairs
# RUN: sed -e 's/"METATOMIC"/"STAGES"/' -e '/^centers_per_call/d' -e 's/target = "GPU"/target = "CPU"/' %t/run.toml > %t/stages-cpu.toml
# RUN: not mdir check %t/stages-cpu.toml 2>&1 | FileCheck %s --check-prefix=STAGES-CPU
# STAGES-CPU: the model 'allegro' of {{.*}} in stages runs on a GPU only yet

# The storage choice belongs to a staged model and accepts only DOUBLE.
# RUN: sed '/^path = /a stage_field_precision = "DOUBLE"' %t/run.toml > %t/field-plugin.toml
# RUN: not mdir check %t/field-plugin.toml 2>&1 | FileCheck %s --check-prefix=FIELD-PLUGIN
# FIELD-PLUGIN: 'stage_field_precision' is for backend = "STAGES" only
# RUN: sed -e 's/"METATOMIC"/"STAGES"/' -e '/^centers_per_call/d' -e '/^path = /a stage_field_precision = "SINGLE"' %t/run.toml > %t/field-value.toml
# RUN: not mdir check %t/field-value.toml 2>&1 | FileCheck %s --check-prefix=FIELD-VALUE
# FIELD-VALUE: expected one of DOUBLE for 'stage_field_precision', got 'SINGLE'
# "double" is "DOUBLE" (#551): accepted for a model in stages on a GPU in
# double precision, and refused in single precision as "DOUBLE" is.
# RUN: sed -e 's/"METATOMIC"/"STAGES"/' -e '/^centers_per_call/d' -e '/^path = /a stage_field_precision = "double"' %t/run.toml > %t/field-lower.toml
# RUN: mdir check %t/field-lower.toml | FileCheck %s --check-prefix=FIELD-LOWER
# FIELD-LOWER: target: gpu, double precision
# RUN: sed 's/^precision = "DOUBLE"/precision = "SINGLE"/' %t/field-lower.toml > %t/field-single.toml
# RUN: not mdir check %t/field-single.toml 2>&1 | FileCheck %s --check-prefix=FIELD-SINGLE
# FIELD-SINGLE: takes 'stage_field_precision = "DOUBLE"' only in mixed or double precision

# RUN: sed '/^path/d' %t/run.toml > %t/nopath.toml
# RUN: not mdir check %t/nopath.toml 2>&1 | FileCheck %s --check-prefix=NOPATH
# NOPATH: expected a 'path' in {{\[\[}}energy.model{{\]\]}}

# RUN: sed 's/^centers_per_call.*/centers_per_call = -1/' %t/run.toml > %t/negative.toml
# RUN: not mdir check %t/negative.toml 2>&1 | FileCheck %s --check-prefix=NEGATIVE
# NEGATIVE: centers_per_call

# RUN: sed 's/^centers_per_call.*/selection = "@O"/' %t/run.toml > %t/unknown.toml
# RUN: not mdir check %t/unknown.toml 2>&1 | FileCheck %s --check-prefix=UNKNOWN
# UNKNOWN: 'selection'

# RUN: sed 's/target = "GPU"/target = "CPU"/' %t/run.toml > %t/cpu.toml
# RUN: not mdir check %t/cpu.toml 2>&1 | FileCheck %s --check-prefix=CPU
# CPU: the model 'allegro' of {{.*}} runs on a GPU only yet

# RUN: sed 's/^precision = .*/&\ndeterministic = true/' %t/run.toml > %t/deterministic.toml
# RUN: not mdir check %t/deterministic.toml 2>&1 | FileCheck %s --check-prefix=DETERMINISTIC
# DETERMINISTIC: is not deterministic

# RUN: sed -e 's/^\[dynamics\]/[minimize]/' -e '/^integrator/d' -e '/^time_step/d' %t/run.toml > %t/minimize.toml
# RUN: mdir check %t/minimize.toml | FileCheck %s --check-prefix=CHECK-OK

# A minimization and a barostat take the model's energy, forces, and virial
# (#367).
# RUN: sed -e 's/"NVE"/"NPT"\npressure = 1.0/' %t/run.toml > %t/npt.toml
# RUN: sed -n '/^#--- npt/,/^#--- end/p' %s | sed '1d;$d' >> %t/npt.toml
# RUN: mdir check %t/npt.toml | FileCheck %s --check-prefix=CHECK-OK

# RUN: sed -n '/^#--- second/,/^#--- end/p' %s | sed '1d;$d' >> %t/run.toml
# RUN: not mdir check %t/run.toml 2>&1 | FileCheck %s --check-prefix=SECOND
# SECOND: another model has the name 'allegro'

#--- run.toml
[input]
topology    = "system.top"
coordinates = "system.gro"

[energy]
cutoff = 3.0
electrostatics = "CUTOFF"

[[energy.model]]
name = "allegro"
backend = "METATOMIC"
path = "allegro.pt"
centers_per_call = 16

[constraints]
hydrogen_bonds = false
rigid_water = false

[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.0005
steps      = 10

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[boundary]
type = "PERIODIC"

[execution]
target = "GPU"
precision = "DOUBLE"
#--- end

#--- npt
[thermostat]
method = "V-RESCALE"
time_constant = 0.1

[barostat]
method = "C-RESCALE"
time_constant = 1.0
#--- end

#--- second
[[energy.model]]
name = "allegro"
path = "other.pt"
#--- end
