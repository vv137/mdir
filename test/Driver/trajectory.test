# The trajectory: a frame every 50 steps, in the DCD format.
#
# RUN: sed -e 's|Inputs/|%S/Inputs/|' \
# RUN:     -e 's|energy_interval = 50|energy_interval = 25\ntrajectory_interval = 50|' \
# RUN:     %S/mixture.toml > %t.toml
# RUN: echo 'trajectory = "%t.dcd"' >> %t.toml
# RUN: mdir run --overwrite %t.toml | FileCheck %s
# RUN: od -A d -t d4 -N 24 %t.dcd | FileCheck %s --check-prefix=HEADER
# RUN: od -A d -c -j 4 -N 4 %t.dcd | FileCheck %s --check-prefix=TAG
# RUN: wc -c < %t.dcd | FileCheck %s --check-prefix=SIZE
#
# Frames more frequent than the energies: the energies are computed at
# each frame and the log shows those of its period. The frames are those
# of the run above, bit for bit.
#
# RUN: sed -e 's|Inputs/|%S/Inputs/|' \
# RUN:     -e 's|energy_interval = 50|energy_interval = 100\ntrajectory_interval = 50|' \
# RUN:     %S/mixture.toml > %t.sparse.toml
# RUN: echo 'trajectory = "%t.sparse.dcd"' >> %t.sparse.toml
# RUN: mdir run --overwrite %t.sparse.toml | FileCheck %s --check-prefix=SPARSE
# RUN: cmp %t.dcd %t.sparse.dcd

# SPARSE:      INFO:         0         0.0000
# SPARSE-NEXT: INFO:       100         0.4000
# SPARSE-NEXT: INFO:       200         0.8000
# SPARSE-NEXT: MDIR:

# CHECK:      INFO:        25         0.1000
# CHECK-NEXT: INFO:        50         0.2000
# CHECK:      INFO:       200         0.8000

# The first record has 84 bytes. It begins with the tag and the number of
# frames, the first step, and the steps between two frames.
#
# HEADER:      0000000 {{ *}}84 {{ *[0-9]+}} {{ *}}4 {{ *}}50
# HEADER-NEXT: 0000016 {{ *}}50 {{ *}}200
# TAG:    C   O   R   D

# The header, and for each of 4 frames the cell and 256 particles:
# 92 + 92 + 12 + 4 (56 + 3 (8 + 4 256)).
#
# SIZE: 12804
