# The outputs of a run as one system (D149). A run of the mixture writes
# its log to a file as well as to the standard output, the rows of the log
# as columns to a file of energies, a trajectory, and checkpoints; `mdir
# check` lists them. A second run of the same control file keeps the
# outputs of the first as `#<name>.1#`, a third those of the second as
# `#<name>.2#`, the checkpoint before the last included, and says so in
# its log; `mdir check` notes what a run would keep. A run continued from
# its checkpoints, twice from the one before the last, keeps no backups:
# it keeps the rows of its file of energies up to its checkpoint and
# appends, so that the file is that of the run that was not interrupted,
# byte for byte, and its log file holds all that it printed; with
# --no-append the outputs of the continued part go to files of their own.
# Then 99 backups, which a run does not go beyond, a file of energies of
# other columns, two outputs with one name, an output named as an input, a
# file of energies without energies, and the file of a minimization.
#
# REQUIRES: hdf5
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: sed -e 's|Inputs/|%S/Inputs/|' -e 's|^steps *= 200|steps = 400|' \
# RUN:     %S/mixture.toml > %t/whole.toml
# RUN: printf 'log = "whole.log"\nenergy = "whole.energy"\ntrajectory = "whole.dcd"\ntrajectory_interval = 50\ncheckpoint = "whole.h5"\ncheckpoint_interval = 100\n[execution]\nprecision = "mixed"\n' >> %t/whole.toml
# RUN: mdir check %t/whole.toml 2>&1 | FileCheck %s --check-prefix=LIST
# RUN: mdir run %t/whole.toml > %t/whole.stdout
# RUN: cmp %t/whole.stdout %t/whole.log
# RUN: FileCheck %s --check-prefix=ENERGY < %t/whole.energy
# RUN: %python %S/Inputs/check_columns.py %t/whole.log %t/whole.energy \
# RUN: | FileCheck %s --check-prefix=ROWS
# RUN: cp %t/whole.energy %t/first.energy
# RUN: mdir check %t/whole.toml 2>&1 | FileCheck %s --check-prefix=NOTE
# RUN: mdir run %t/whole.toml > %t/second.stdout
# RUN: FileCheck %s --check-prefix=SECOND < %t/second.stdout
# RUN: cmp %t/second.stdout %t/whole.log
# RUN: cp %t/whole.energy %t/second.energy
# RUN: mdir run %t/whole.toml | FileCheck %s --check-prefix=THIRD
# RUN: %python %S/Inputs/backups.py list %t | FileCheck %s --check-prefix=KEPT
# RUN: cmp %t/first.energy %t/#whole.energy.1#
# RUN: cmp %t/second.energy %t/#whole.energy.2#

# LIST:      outputs:
# LIST-NEXT:   log: stdout and {{.*}}whole.log (text), every 50 steps, 9 rows
# LIST-NEXT:   energy: {{.*}}whole.energy (columns), every 50 steps, 9 rows
# LIST-NEXT:   pull: not configured (columns), disabled
# LIST-NEXT:   free_energy: not configured (columns), disabled
# LIST-NEXT:   observables: not configured (columns), disabled
# LIST-NEXT:   trajectory: {{.*}}whole.dcd (DCD), every 50 steps, 8 frames
# LIST-NEXT:   checkpoint: {{.*}}whole.h5 (H5MD), every 100 steps, 4 checkpoints
# LIST-NOT:  exists

# ENERGY:      # step time total potential kinetic temperature virial pressure
# ENERGY-NEXT: # - ps kcal/mol kcal/mol kcal/mol K kcal/mol atm
# ENERGY-NEXT: 0 0.000000 {{-?[0-9]+\.[0-9]+}} -497.729{{[0-9]+}}
# ENERGY:      400 1.600000
# ROWS: 9 rows of 8 columns, those of the log: ok
# NOTE:      mdir: note: log output '{{.*}}whole.log' exists; mdir run keeps it as '{{.*}}#whole.log.1#' before it writes its own, and mdir run --continue continues the run of its checkpoint instead
# NOTE-NEXT: mdir: note: energy output '{{.*}}whole.energy' exists; mdir run keeps it as '{{.*}}#whole.energy.1#'
# NOTE-NEXT: mdir: note: trajectory output '{{.*}}whole.dcd' exists; mdir run keeps it as '{{.*}}#whole.dcd.1#'
# NOTE-NEXT: mdir: note: checkpoint output '{{.*}}whole.h5' exists; mdir run keeps it as '{{.*}}#whole.h5.1#'
# NOTE-NEXT: mdir: note: checkpoint output '{{.*}}whole.h5.prev' exists; mdir run keeps it as '{{.*}}#whole.h5.prev.1#'
# NOTE-NOT:  warning
# SECOND:      MDIR: backed up '{{.*}}whole.log' as '{{.*}}#whole.log.1#'
# SECOND-NEXT: MDIR: backed up '{{.*}}whole.energy' as '{{.*}}#whole.energy.1#'
# SECOND-NEXT: MDIR: backed up '{{.*}}whole.dcd' as '{{.*}}#whole.dcd.1#'
# SECOND-NEXT: MDIR: backed up '{{.*}}whole.h5' as '{{.*}}#whole.h5.1#'
# SECOND-NEXT: MDIR: backed up '{{.*}}whole.h5.prev' as '{{.*}}#whole.h5.prev.1#'
# SECOND:      INFO:       400
# THIRD:       MDIR: backed up '{{.*}}whole.log' as '{{.*}}#whole.log.2#'
# KEPT: backups: #whole.dcd.1# #whole.dcd.2# #whole.energy.1# #whole.energy.2# #whole.h5.1# #whole.h5.2# #whole.h5.prev.1# #whole.h5.prev.2# #whole.log.1# #whole.log.2#{{$}}

# Stopped at the first checkpoint twice, put back to it, and continued to
# the end.
#
# RUN: sed -e 's|whole|part|g' %t/whole.toml > %t/part.toml
# RUN: not mdir run --continue --max-walltime 0.000001 %t/part.toml > /dev/null
# RUN: not mdir run --continue --max-walltime 0.000001 %t/part.toml > /dev/null
# RUN: cp %t/part.h5.prev %t/part.h5
# RUN: mdir run --continue %t/part.toml > /dev/null
# RUN: cmp %t/whole.energy %t/part.energy
# RUN: mdir checkpoint %t/whole.h5 %t/part.h5 | FileCheck %s --check-prefix=SAME
# RUN: FileCheck %s --check-prefix=PARTLOG < %t/part.log
# RUN: %python %S/Inputs/backups.py list %t | FileCheck %s --check-prefix=NONE-OF-PART

# SAME: the states are identical
# NONE-OF-PART:     backups:
# NONE-OF-PART-NOT: part
# PARTLOG:      MDIR: no checkpoint '{{.*}}part.h5' yet; the run begins
# PARTLOG:      INFO:       100
# PARTLOG:      MDIR: stopped after step 100 on the wall time
# PARTLOG:      MDIR: continues the run after step 100, from '{{.*}}part.h5', to step 400 (part 2)
# PARTLOG:      INFO:       200
# PARTLOG-NEXT: MDIR: stopped after step 200 on the wall time
# PARTLOG:      MDIR: continues the run after step 100, from '{{.*}}part.h5', to step 400 (part 2)
# PARTLOG:      INFO:       150
# PARTLOG:      INFO:       400

# With --no-append the continued part writes to files of its own, and the
# continuation after it appends to them.
#
# RUN: sed -e 's|whole|piece|g' %t/whole.toml > %t/piece.toml
# RUN: not mdir run --continue --max-walltime 0.000001 %t/piece.toml > /dev/null
# RUN: not mdir run --continue --no-append --max-walltime 0.000001 \
# RUN:     %t/piece.toml > /dev/null
# RUN: mdir run --continue %t/piece.toml > /dev/null
# RUN: tail -n +3 %t/piece.part0002.energy > %t/rest
# RUN: cat %t/piece.energy %t/rest > %t/joined
# RUN: cmp %t/whole.energy %t/joined
# RUN: FileCheck %s --check-prefix=PIECE < %t/piece.part0002.log
# RUN: FileCheck %s --check-prefix=FIRST < %t/piece.log

# PIECE:     MDIR: continues the run after step 100, from '{{.*}}piece.h5', to step 400 (part 2)
# PIECE:     MDIR: stopped after step 200 on the wall time
# PIECE:     MDIR: continues the run after step 200, from '{{.*}}piece.h5', to step 400 (part 3)
# PIECE:     INFO:       400
# FIRST:     MDIR: stopped after step 100 on the wall time
# FIRST-NOT: continues

# 99 backups of the file of energies: a run stops before it writes or
# moves any file, the log that it could back up included, and `mdir check`
# warns.
#
# RUN: sed -e 's|whole|cap|g' %t/whole.toml > %t/cap.toml
# RUN: %python %S/Inputs/backups.py make %t/cap.log 0
# RUN: %python %S/Inputs/backups.py make %t/cap.energy 99
# RUN: mdir check %t/cap.toml 2>&1 | FileCheck %s --check-prefix=CAPCHECK
# RUN: not mdir run %t/cap.toml 2>&1 | FileCheck %s --check-prefix=CAP
# RUN: %python %S/Inputs/backups.py list %t | FileCheck %s --check-prefix=CAPLIST

# CAPCHECK: mdir: note: log output '{{.*}}cap.log' exists; mdir run keeps it as '{{.*}}#cap.log.1#'
# CAPCHECK: mdir: warning: energy output '{{.*}}cap.energy' exists with 99 backups already; mdir run stops before it writes. Remove some of them, or continue the run with --continue
# CAP:      mdir: '{{.*}}cap.energy' exists, and its directory holds 99 backups of it already, '#cap.energy.1#' to '#cap.energy.99#'; remove some of them, or continue the run with --continue
# CAPLIST:     #cap.energy.99#
# CAPLIST-NOT: cap.log

