# The outputs of a run as one system (D149). A run of the mixture writes
# its log to a file as well as to the standard output, the rows of the log
# as columns to a file of energies, a trajectory, and checkpoints; `mdir
# check` lists them. A second run of the same control file refuses to
# write over them unless --overwrite. A run continued from its checkpoints,
# twice from the one before the last, keeps the rows of its file of
# energies up to its checkpoint and appends, so that the file is that of
# the run that was not interrupted, byte for byte, and its log file holds
# all that it printed; with --no-append the outputs of the continued part
# go to files of their own. Then a file of energies of other columns, two
# outputs with one name, an output named as an input, a file of energies
# without energies, and the file of a minimization.
#
# REQUIRES: hdf5
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: sed -e 's|Inputs/|%S/Inputs/|' -e 's|^steps *= 200|steps = 400|' \
# RUN:     %S/mixture.toml > %t/whole.toml
# RUN: printf 'log = "whole.log"\nenergy = "whole.energy"\ntrajectory = "whole.dcd"\ntrajectory_interval = 50\ncheckpoint = "whole.h5"\ncheckpoint_interval = 100\n[execution]\nprecision = "mixed"\n' >> %t/whole.toml
# RUN: mdir check %t/whole.toml 2>&1 | FileCheck %s --check-prefix=LIST
# RUN: mdir run %t/whole.toml > %t/whole.stdout
# RUN: cmp %t/whole.stdout %t/whole.log
# RUN: FileCheck %s --check-prefix=ENERGY < %t/whole.energy
# RUN: %python %S/Inputs/check_columns.py %t/whole.log %t/whole.energy \
# RUN: | FileCheck %s --check-prefix=ROWS
# RUN: not mdir run %t/whole.toml 2>&1 | FileCheck %s --check-prefix=EXISTS
# RUN: mdir check %t/whole.toml 2>&1 | FileCheck %s --check-prefix=WARN
# RUN: mdir run --overwrite %t/whole.toml > %t/again.stdout
# RUN: not mdir run --overwrite --continue %t/whole.toml 2>&1 \
# RUN: | FileCheck %s --check-prefix=BOTH

# LIST:      outputs:
# LIST-NEXT:   log: stdout and {{.*}}whole.log (text), every 50 steps, 9 rows
# LIST-NEXT:   energy: {{.*}}whole.energy (columns), every 50 steps, 9 rows
# LIST-NEXT:   pull: not configured (columns), disabled
# LIST-NEXT:   trajectory: {{.*}}whole.dcd (DCD), every 50 steps, 8 frames
# LIST-NEXT:   checkpoint: {{.*}}whole.h5 (H5MD), every 100 steps, 4 checkpoints
# LIST-NOT:  exists

# ENERGY:      # step time total potential kinetic temperature virial pressure
# ENERGY-NEXT: # - ps kcal/mol kcal/mol kcal/mol K kcal/mol atm
# ENERGY-NEXT: 0 0.000000 {{-?[0-9]+\.[0-9]+}} -497.729{{[0-9]+}}
# ENERGY:      400 1.600000
# ROWS: 9 rows of 8 columns, those of the log: ok
# EXISTS: mdir: '{{.*}}whole.log' exists, written by another run; `mdir run --overwrite` writes over it, and `mdir run --continue` continues the run whose checkpoint is named in [output]
# WARN:      mdir: warning: log output '{{.*}}whole.log' already exists; mdir run writes over it only with --overwrite, and mdir run --continue continues the run of its checkpoint
# WARN-NEXT: mdir: warning: energy output '{{.*}}whole.energy' already exists
# WARN-NEXT: mdir: warning: trajectory output '{{.*}}whole.dcd' already exists
# WARN-NEXT: mdir: warning: checkpoint output '{{.*}}whole.h5' already exists
# BOTH: mdir: --overwrite does not go with --continue, whose outputs are those of its run

# Stopped at the first checkpoint twice, put back to it, and continued to
# the end.
#
# RUN: sed -e 's|whole|part|g' %t/whole.toml > %t/part.toml
# RUN: not mdir run --continue --max-walltime 0.000001 %t/part.toml > /dev/null
# RUN: not mdir run --continue --max-walltime 0.000001 %t/part.toml > /dev/null
# RUN: cp %t/part.h5.prev %t/part.h5
# RUN: mdir run --continue %t/part.toml > /dev/null
# RUN: cmp %t/whole.energy %t/part.energy
# RUN: mdir checkpoint %t/whole.h5 %t/part.h5 | FileCheck %s --check-prefix=SAME
# RUN: FileCheck %s --check-prefix=PARTLOG < %t/part.log

# SAME: the states are identical
# PARTLOG:      MDIR: no checkpoint '{{.*}}part.h5' yet; the run begins
# PARTLOG:      INFO:       100
# PARTLOG:      MDIR: stopped after step 100 on the wall time
# PARTLOG:      MDIR: continues the run after step 100, from '{{.*}}part.h5', to step 400 (part 2)
# PARTLOG:      INFO:       200
# PARTLOG-NEXT: MDIR: stopped after step 200 on the wall time
# PARTLOG:      MDIR: continues the run after step 100, from '{{.*}}part.h5', to step 400 (part 2)
# PARTLOG:      INFO:       150
# PARTLOG:      INFO:       400

# With --no-append the continued part writes to files of its own, and the
# continuation after it appends to them.
#
# RUN: sed -e 's|whole|piece|g' %t/whole.toml > %t/piece.toml
# RUN: not mdir run --continue --max-walltime 0.000001 %t/piece.toml > /dev/null
# RUN: not mdir run --continue --no-append --max-walltime 0.000001 \
# RUN:     %t/piece.toml > /dev/null
# RUN: mdir run --continue %t/piece.toml > /dev/null
# RUN: tail -n +3 %t/piece.part0002.energy > %t/rest
# RUN: cat %t/piece.energy %t/rest > %t/joined
# RUN: cmp %t/whole.energy %t/joined
# RUN: FileCheck %s --check-prefix=PIECE < %t/piece.part0002.log
# RUN: FileCheck %s --check-prefix=FIRST < %t/piece.log

# PIECE:     MDIR: continues the run after step 100, from '{{.*}}piece.h5', to step 400 (part 2)
# PIECE:     MDIR: stopped after step 200 on the wall time
# PIECE:     MDIR: continues the run after step 200, from '{{.*}}piece.h5', to step 400 (part 3)
# PIECE:     INFO:       400
# FIRST:     MDIR: stopped after step 100 on the wall time
# FIRST-NOT: continues

# What the outputs refuse.
#
# RUN: sed -e 's|whole|short|g' %t/whole.toml > %t/short.toml
# RUN: not mdir run --continue --max-walltime 0.000001 %t/short.toml > /dev/null
# RUN: sed -i -e '1s/ total / sum /' %t/short.energy
# RUN: not mdir run --continue %t/short.toml 2>&1 \
# RUN: | FileCheck %s --check-prefix=COLUMNS
# RUN: sed -e 's|^energy = "whole.energy"|energy = "whole.log"|' %t/whole.toml \
# RUN:     > %t/same.toml
# RUN: not mdir check %t/same.toml 2>&1 | FileCheck %s --check-prefix=SAMENAME
# RUN: sed -e 's|^log = "whole.log"|log = "%S/Inputs/mixture.pdb"|' %t/whole.toml \
# RUN:     > %t/input.toml
# RUN: not mdir check %t/input.toml 2>&1 | FileCheck %s --check-prefix=INPUT
# RUN: sed -e 's|^energy_interval = 50|energy_interval = 0|' \
# RUN:     -e '/^trajectory_interval/d' -e '/^trajectory = /d' %t/whole.toml \
# RUN:     > %t/none.toml
# RUN: not mdir check %t/none.toml 2>&1 | FileCheck %s --check-prefix=NONE

# COLUMNS:  mdir: '{{.*}}short.energy' does not begin with the columns that the run writes, '# step time total potential kinetic temperature virial pressure
# SAMENAME: mdir: {{.*}}same.toml: 'log' and 'energy' of [output] name the same file, '{{.*}}whole.log'
# INPUT:    mdir: {{.*}}input.toml: 'log' of [output] names '{{.*}}Inputs/mixture.pdb', an input of the run
# NONE:     mdir: {{.*}}none.toml: 'energy' is written at the energies of the log, which needs 'energy_interval'

# A minimization: its rows as columns.
#
# RUN: sed -e 's|Inputs/|%S/Inputs/|' -e '/^\[dynamics\]/,/^steps/d' \
# RUN:     -e '/^\[ensemble\]/,/^temperature/d' %S/mixture.toml > %t/min.toml
# RUN: printf 'energy = "min.energy"\n[minimize]\nsteps = 100\n' >> %t/min.toml
# RUN: mdir run %t/min.toml > %t/min.log
# RUN: FileCheck %s --check-prefix=MIN < %t/min.energy
# RUN: %python %S/Inputs/check_columns.py %t/min.log %t/min.energy \
# RUN: | FileCheck %s --check-prefix=MINROWS

# MIN:      # step potential rms_force max_force max_atom step_size
# MIN-NEXT: # - kcal/mol kcal/mol/Å kcal/mol/Å - Å
# MIN-NEXT: 0 -497.729755 {{[0-9.]+}} {{[0-9.]+}} {{[0-9]+}} 0.100000
# MINROWS:  3 rows of 6 columns, those of the log: ok
