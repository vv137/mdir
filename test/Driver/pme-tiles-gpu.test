# The spreading of particle mesh Ewald through tiles of bins on a device
# (D[pme-tiles]) against the spreading of before (MDIR_PME_SPREAD=global:
# the bricks of D108 for order 4 in f32, atomics into the grid otherwise),
# one step of the OPC box (1,570 sites; the oxygens have no charge, so the
# particles are binned from the list of D262): the forces of the checkpoint
# within the rounding of the atomics, relative rms 2e-6 in mixed precision
# (two runs of `global` differ by 2e-7) and 1e-11 in double, and the rows of
# energies within 1e-6 and 1e-11. The B-splines of orders 4 (bins of 4, 8,
# and 16 points), 6, and 8, the prolate kernel of 6 points (D266), and the
# rhombic dodecahedron of prolate-triclinic.test with the Gaussian, whose
# cell the tiles do not depend on. The module states the choice
# (`tiles(8)` on md_exec.reciprocal); the deterministic mode takes no tiles
# even when asked, and gives the same state twice.
#
# REQUIRES: cuda, hdf5
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/opc/opc.prmtop %S/Inputs/opc/opc.inpcrd %S/Inputs/triclinic/water.top %S/Inputs/triclinic/dodecahedron.gro %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/base.toml
# RUN: sed 's/PRECISION/MIXED/; s/ORDER/4/' %t/base.toml > %t/m4.toml
# RUN: sed 's/PRECISION/DOUBLE/; s/ORDER/4/' %t/base.toml > %t/d4.toml
# RUN: sed 's/PRECISION/MIXED/; s/ORDER/6/' %t/base.toml > %t/m6.toml
# RUN: sed 's/PRECISION/MIXED/; s/ORDER/8/' %t/base.toml > %t/m8.toml
# RUN: sed 's/PRECISION/MIXED/; s/^order = ORDER/kernel = "PROLATE"/' %t/base.toml > %t/mp.toml
# RUN: sed 's/PRECISION/DOUBLE/; s/^order = ORDER/kernel = "PROLATE"/' %t/base.toml > %t/dp.toml
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %S/prolate-triclinic.test | sed '1d;$d' \
# RUN:   | sed 's/^kernel = "PROLATE"/order = 4/; s/^target    = "CPU"/target    = "GPU"/; s/^precision = "DOUBLE"/precision = "MIXED"/; s/^steps      = 0/steps = 1/; s/^energy_interval = 0/energy_interval = 1\ncheckpoint = "run.h5"\ncheckpoint_interval = 1/' > %t/tm.toml
# RUN: sed 's/^precision = "MIXED"/precision = "MIXED"\ndeterministic = true/' %t/m4.toml > %t/det.toml
# The box made 200 Å long in z with the waters in 1.6 to 23.5 Å of it, on a
# grid of 32 x 32 x 200: 400 bins of 8 points, runs of C = 2 ceil(1570 / 400)
# + 8 = 16 places, and about 56 bins holding the 1,178 charged sites, about
# 21 each, so that many particles overflow their runs and are added by the
# block of the overflow.
# RUN: sed '$ s/  25.1595755/ 200.0000000/' %t/opc.inpcrd > %t/slab.inpcrd
# RUN: sed 's/opc.inpcrd/slab.inpcrd/; s/^order = 4/order = 4\ngrid = [32, 32, 200]/' %t/m4.toml > %t/slab.toml
#
# RUN: cd %t && %python %S/Inputs/compare_spreading.py mdir %t m4 2e-6 1e-6 global tiles4 tiles8 tiles16 | FileCheck %s --check-prefix=M4
# RUN: cd %t && %python %S/Inputs/compare_spreading.py mdir %t d4 1e-11 1e-11 global tiles8 | FileCheck %s --check-prefix=D4
# RUN: cd %t && %python %S/Inputs/compare_spreading.py mdir %t m6 2e-6 1e-6 global tiles8 | FileCheck %s --check-prefix=M6
# RUN: cd %t && %python %S/Inputs/compare_spreading.py mdir %t m8 2e-6 1e-6 global tiles8 | FileCheck %s --check-prefix=M8
# RUN: cd %t && %python %S/Inputs/compare_spreading.py mdir %t mp 2e-6 1e-6 global tiles8 | FileCheck %s --check-prefix=MP
# RUN: cd %t && %python %S/Inputs/compare_spreading.py mdir %t dp 1e-11 1e-11 global tiles8 | FileCheck %s --check-prefix=DP
# RUN: cd %t && %python %S/Inputs/compare_spreading.py mdir %t tm 2e-6 1e-6 global tiles8 | FileCheck %s --check-prefix=TM
# RUN: cd %t && %python %S/Inputs/compare_spreading.py mdir %t slab 2e-6 1e-6 global tiles8 | FileCheck %s --check-prefix=SLAB
#
# The choice in the module, and none in the deterministic mode.
# RUN: cd %t && env MDIR_PME_SPREAD=tiles8 MDIR_PRINT_AFTER=md-exec-choose-spreading mdir run m4.toml 2>&1 | FileCheck %s --check-prefix=IR
# RUN: cd %t && env MDIR_PME_SPREAD=tiles8 MDIR_PRINT_AFTER=md-exec-choose-spreading mdir run det.toml > det-a.log 2>&1 && mv run.h5 det-a.h5
# RUN: FileCheck %s --check-prefix=DET < %t/det-a.log
# RUN: cd %t && env MDIR_PME_SPREAD=tiles8 mdir run det.toml > det-b.log 2>&1 && mv run.h5 det-b.h5
# RUN: mdir checkpoint %t/det-a.h5 %t/det-b.h5 | FileCheck %s --check-prefix=SAME

# M4: tiles4: forces ok, energies ok
# M4: tiles8: forces ok, energies ok
# M4: tiles16: forces ok, energies ok
# D4: tiles8: forces ok, energies ok
# M6: tiles8: forces ok, energies ok
# M8: tiles8: forces ok, energies ok
# MP: tiles8: forces ok, energies ok
# DP: tiles8: forces ok, energies ok
# TM: tiles8: forces ok, energies ok
# SLAB: tiles8: forces ok, energies ok
# IR: md_exec.reciprocal {{.*}} tiles(8)
# DET: md_exec.reciprocal
# DET-NOT: tiles(
# SAME: the states are identical

#--- run.toml
[input]
topology    = "opc.prmtop"
coordinates = "opc.inpcrd"

[output]
energy_interval = 1
checkpoint = "run.h5"
checkpoint_interval = 1

[energy]
cutoff            = 9.0
pairlist_distance = 10.0
electrostatics    = "PME"

[pme]
order = ORDER

[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.001
steps      = 1

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[constraints]
rigid_water = true

[boundary]
type = "PERIODIC"

[execution]
target    = "GPU"
precision = "PRECISION"
#--- end
