# The spreading of particle mesh Ewald through tiles of bins on a device
# (D282) against the spreading of before (MDIR_PME_SPREAD=global:
# the bricks of D108 for order 4 in f32, atomics into the grid otherwise),
# one step of 10^-6 ps of the OPC box (1,570 sites; the oxygens have no
# charge, so the particles are binned from the list of D262): the forces of
# the checkpoint within the rounding of the atomics, relative rms 2e-6 in
# mixed precision (0.7 to 1.2e-7 measured over five repeats; two runs of
# `global` differ by 0.6 to 1.1e-7) and 1e-11 in double (5.2e-16 at order
# 4, 4.9e-13 for the prolate kernel), and the numbers of the rows of
# energies within 1e-5 and 1e-11 of the largest of their columns (1.8e-6
# measured, with LJ-PME, in mixed precision). The step is that short so
# that every run evaluates the forces of the checkpoint at the same f32
# positions: the positions after it differ between runs by 4e-16 nm at
# most. After a step of 0.001 ps they differed by about 1e-12 nm, from the
# rounding of the forces of step 0, and the y of atom 4 of the dipeptide,
# 2e-12 nm from a midpoint between two f32 numbers, rounded to the other
# one in about 1 run of 400 with `tiles8` at order 8: its bonded forces
# then changed by 0.1 kJ/mol/nm, a relative rms of 2.46e-6 (#427). The B-splines of orders 4 (bins of 4, 8,
# and 16 points), 6, and 8, the prolate kernel of 6 points (D266), and the
# rhombic dodecahedron of prolate-triclinic.test with the Gaussian, whose
# cell the tiles do not depend on, the box made 200 Å long, where particles
# overflow the runs of their bins, and the sum of the dispersion of LJ-PME
# (D162), whose coefficients are spread through tiles as the charges are. The module states the choice
# (`scatter(tile(8))` on md_exec.reciprocal, which md-exec-choose-scatter
# sets, D285); the deterministic mode takes no tiles
# even when asked, and gives the same state twice.
#
# REQUIRES: cuda, hdf5
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/opc/opc.prmtop %S/Inputs/opc/opc.inpcrd %S/Inputs/triclinic/water.top %S/Inputs/triclinic/dodecahedron.gro %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/base.toml
# RUN: sed 's/PRECISION/MIXED/; s/ORDER/4/' %t/base.toml > %t/m4.toml
# RUN: sed 's/PRECISION/DOUBLE/; s/ORDER/4/' %t/base.toml > %t/d4.toml
# RUN: sed 's/PRECISION/MIXED/; s/ORDER/6/' %t/base.toml > %t/m6.toml
# RUN: sed 's/PRECISION/MIXED/; s/ORDER/8/' %t/base.toml > %t/m8.toml
# RUN: sed 's/PRECISION/MIXED/; s/^order = ORDER/kernel = "PROLATE"/' %t/base.toml > %t/mp.toml
# RUN: sed 's/PRECISION/DOUBLE/; s/^order = ORDER/kernel = "PROLATE"/' %t/base.toml > %t/dp.toml
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %S/prolate-triclinic.test | sed '1d;$d' \
# RUN:   | sed 's/^kernel = "PROLATE"/order = 4/; s/^target    = "CPU"/target    = "GPU"/; s/^precision = "DOUBLE"/precision = "MIXED"/; s/^time_step  = 0.0005/time_step = 0.000001/; s/^steps      = 0/steps = 1/; s/^energy_interval = 0/energy_interval = 1\ncheckpoint = "run.h5"\ncheckpoint_interval = 1/' > %t/tm.toml
# RUN: sed 's/^precision = "MIXED"/precision = "MIXED"\ndeterministic = true/' %t/m4.toml > %t/det.toml
# RUN: sed 's/^electrostatics    = "PME"/electrostatics    = "PME"\nlennard_jones = "PME"/' %t/m4.toml > %t/lj.toml
# The box made 200 Å long in z with the waters in 1.6 to 23.5 Å of it, on a
# grid of 32 x 32 x 200: 400 bins of 8 points, runs of C = 2 ceil(1570 / 400)
# + 8 = 16 places, and about 56 bins holding the 1,178 charged sites, about
# 21 each, so that many particles overflow their runs and are added by the
# block of the overflow.
# RUN: sed '$ s/  25.1595755/ 200.0000000/' %t/opc.inpcrd > %t/slab.inpcrd
# RUN: sed 's/opc.inpcrd/slab.inpcrd/; s/^order = 4/order = 4\ngrid = [32, 32, 200]/' %t/m4.toml > %t/slab.toml
#
# RUN: cd %t && %python %S/Inputs/compare_spreading.py mdir %t m4 2e-6 1e-5 global tiles4 tiles8 tiles16 | FileCheck %s --check-prefix=M4
# RUN: cd %t && %python %S/Inputs/compare_spreading.py mdir %t d4 1e-11 1e-11 global tiles8 | FileCheck %s --check-prefix=D4
# RUN: cd %t && %python %S/Inputs/compare_spreading.py mdir %t m6 2e-6 1e-5 global tiles8 | FileCheck %s --check-prefix=M6
# RUN: cd %t && %python %S/Inputs/compare_spreading.py mdir %t m8 2e-6 1e-5 global tiles8 | FileCheck %s --check-prefix=M8
# RUN: cd %t && %python %S/Inputs/compare_spreading.py mdir %t mp 2e-6 1e-5 global tiles8 | FileCheck %s --check-prefix=MP
# RUN: cd %t && %python %S/Inputs/compare_spreading.py mdir %t dp 1e-11 1e-11 global tiles8 | FileCheck %s --check-prefix=DP
# RUN: cd %t && %python %S/Inputs/compare_spreading.py mdir %t tm 2e-6 1e-5 global tiles8 | FileCheck %s --check-prefix=TM
# RUN: cd %t && %python %S/Inputs/compare_spreading.py mdir %t slab 2e-6 1e-5 global tiles8 | FileCheck %s --check-prefix=SLAB
# RUN: cd %t && %python %S/Inputs/compare_spreading.py mdir %t lj 2e-6 1e-5 global tiles8 | FileCheck %s --check-prefix=LJ
# RUN: cd %t && env MDIR_PME_SPREAD=tiles8 MDIR_PRINT_AFTER=md-exec-choose-scatter mdir run lj.toml > lj-ir.log 2>&1
# RUN: FileCheck %s --check-prefix=LJIR < %t/lj-ir.log
# RUN: FileCheck %s --check-prefix=LJD < %t/lj-ir.log
#
# The choice in the module, and none in the deterministic mode.
# RUN: cd %t && env MDIR_PME_SPREAD=tiles8 MDIR_PRINT_AFTER=md-exec-choose-scatter mdir run m4.toml 2>&1 | FileCheck %s --check-prefix=IR
# The default (`auto`): this grid of 24 x 28 x 24 points is below
# `min-points` (500,000) and keeps the spreading of before, at orders 4
# and 6; a grid of 64 x 64 x 128 points is tiled in mixed precision and
# not in double.
# RUN: cd %t && env MDIR_PRINT_AFTER=md-exec-choose-scatter mdir run m4.toml 2>&1 | FileCheck %s --check-prefix=AUTO
# RUN: cd %t && env MDIR_PRINT_AFTER=md-exec-choose-scatter mdir run m6.toml 2>&1 | FileCheck %s --check-prefix=AUTO
# RUN: sed 's/^order = 4/order = 4\ngrid = [64, 64, 128]/' %t/m4.toml > %t/big.toml
# RUN: sed 's/^order = 4/order = 4\ngrid = [64, 64, 128]/' %t/d4.toml > %t/dbig.toml
# RUN: cd %t && env MDIR_PRINT_AFTER=md-exec-choose-scatter mdir run big.toml 2>&1 | FileCheck %s --check-prefix=IR
# RUN: cd %t && env MDIR_PRINT_AFTER=md-exec-choose-scatter mdir run dbig.toml 2>&1 | FileCheck %s --check-prefix=AUTO
# RUN: cd %t && env MDIR_PME_SPREAD=tiles8 MDIR_PRINT_AFTER=md-exec-choose-scatter mdir run det.toml > det-a.log 2>&1 && mv run.h5 det-a.h5
# RUN: FileCheck %s --check-prefix=DET < %t/det-a.log
# RUN: cd %t && env MDIR_PME_SPREAD=tiles8 mdir run det.toml > det-b.log 2>&1 && mv run.h5 det-b.h5
# RUN: mdir checkpoint %t/det-a.h5 %t/det-b.h5 | FileCheck %s --check-prefix=SAME

# M4: tiles4: forces ok, energies ok
# M4: tiles8: forces ok, energies ok
# M4: tiles16: forces ok, energies ok
# D4: tiles8: forces ok, energies ok
# M6: tiles8: forces ok, energies ok
# M8: tiles8: forces ok, energies ok
# MP: tiles8: forces ok, energies ok
# DP: tiles8: forces ok, energies ok
# TM: tiles8: forces ok, energies ok
# SLAB: tiles8: forces ok, energies ok
# LJ: tiles8: forces ok, energies ok
# LJIR-COUNT-2: md_exec.reciprocal {{.*}} scatter(tile(8))
# LJD: md_exec.reciprocal {{.*}} dispersion {{.*}}scatter(tile(8))
# IR: md_exec.reciprocal {{.*}} scatter(tile(8))
# AUTO: md_exec.reciprocal
# AUTO-NOT: tile(
# DET: md_exec.reciprocal
# DET-NOT: tile(
# SAME: the states are identical

#--- run.toml
[input]
topology    = "opc.prmtop"
coordinates = "opc.inpcrd"

[output]
energy_interval = 1
checkpoint = "run.h5"
checkpoint_interval = 1

[energy]
cutoff            = 9.0
pairlist_distance = 10.0
electrostatics    = "PME"

[pme]
order = ORDER

[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.000001
steps      = 1

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[constraints]
rigid_water = true

[boundary]
type = "PERIODIC"

[execution]
target    = "GPU"
precision = "PRECISION"
#--- end
