# What is wrong with the thermostat and the removal of the motion of the
# center of mass is reported.
#
# RUN: split-file %s %t
# RUN: not mdir run %t/nvt.toml 2>&1 | FileCheck %s --check-prefix=NVT
# RUN: not mdir run %t/nve.toml 2>&1 | FileCheck %s --check-prefix=NVE
# RUN: not mdir run %t/npt.toml 2>&1 | FileCheck %s --check-prefix=NPT
# RUN: not mdir run %t/unused.toml 2>&1 | FileCheck %s --check-prefix=UNUSED
# RUN: not mdir run %t/differ.toml 2>&1 | FileCheck %s --check-prefix=DIFFER
# RUN: not mdir run %t/multiple.toml 2>&1 \
# RUN: | FileCheck %s --check-prefix=MULTIPLE
# RUN: not mdir run %t/energy.toml 2>&1 | FileCheck %s --check-prefix=ENERGY
# RUN: not mdir run %t/tau.toml 2>&1 | FileCheck %s --check-prefix=TAU

# NVT: nvt.toml:13: 'ensemble = "NVT"' needs 'thermostat = "BUSSI"', the thermostat of M1
# NVE: nve.toml:13: a thermostat needs 'ensemble = "NVT"'
# NPT: npt.toml:14: 'ensemble = "NPT"' is not supported yet; it is planned for M1
# UNUSED: unused.toml: 'thermostat_period' is given, but there is no thermostat
# DIFFER: differ.toml: 'comm_period' differs from 'thermostat_period'
# MULTIPLE: multiple.toml: 'nsteps' is not a multiple of the period of coupling, 10 steps
# ENERGY: energy.toml: 'eneout_period' is not a multiple of the period of coupling, 20 steps
# TAU: tau.toml:16: expected a positive number for 'tau_t'

#--- one.pdb
HETATM    1  AR  AR  A   1       1.000   1.000   1.000  1.00  0.00          AR
HETATM    2  AR  AR  A   1       5.000   1.000   1.000  1.00  0.00          AR
#--- nvt.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
nsteps = 100
[ensemble]
ensemble = "NVT"
#--- nve.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
nsteps = 100
[ensemble]
thermostat = "BUSSI"
#--- npt.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
nsteps = 100
[ensemble]
ensemble = "NPT"
#--- unused.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
nsteps = 100
thermostat_period = 10
#--- differ.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
nsteps = 100
comm_period = 10
thermostat_period = 20
[ensemble]
ensemble = "NVT"
thermostat = "BUSSI"
#--- multiple.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
nsteps = 105
eneout_period = 5
[ensemble]
ensemble = "NVT"
thermostat = "BUSSI"
#--- energy.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
nsteps = 100
eneout_period = 10
comm_period = 20
#--- tau.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
nsteps = 100
[ensemble]
ensemble = "NVT"
thermostat = "BUSSI"
tau_t = 0.0
