# What is wrong with the thermostat, the barostat, and the removal of the
# motion of the center of mass is reported.
#
# RUN: split-file %s %t
# RUN: not mdir run %t/nvt.toml 2>&1 | FileCheck %s --check-prefix=NVT
# RUN: not mdir run %t/nve.toml 2>&1 | FileCheck %s --check-prefix=NVE
# RUN: not mdir run %t/npt.toml 2>&1 | FileCheck %s --check-prefix=NPT
# RUN: not mdir run %t/unused.toml 2>&1 | FileCheck %s --check-prefix=UNUSED
# RUN: not mdir run %t/differ.toml 2>&1 | FileCheck %s --check-prefix=DIFFER
# RUN: not mdir run %t/multiple.toml 2>&1 \
# RUN: | FileCheck %s --check-prefix=MULTIPLE
# RUN: not mdir run %t/energy.toml 2>&1 | FileCheck %s --check-prefix=ENERGY
# RUN: not mdir run %t/tau.toml 2>&1 | FileCheck %s --check-prefix=TAU
# RUN: not mdir run %t/baroperiod.toml 2>&1 | FileCheck %s --check-prefix=BAROPERIOD
# RUN: not mdir run %t/pressure.toml 2>&1 | FileCheck %s --check-prefix=PRESSURE

# NVT: nvt.toml:{{[0-9]+}}: 'ensemble = "NVT"' needs a [thermostat]
# NVE: nve.toml:{{[0-9]+}}: a [thermostat] needs 'ensemble = "NVT"' or "NPT" in [ensemble]
# NPT: npt.toml:{{[0-9]+}}: 'ensemble = "NPT"' needs a [barostat]
# UNUSED: unused.toml:{{[0-9]+}}: expected 'method' in [thermostat]: "V-RESCALE", stochastic velocity rescaling
# DIFFER: differ.toml: 'center_of_mass_interval' differs from 'interval' in [thermostat]
# MULTIPLE: multiple.toml: 'steps' is not a multiple of the interval of coupling, 10 steps
# ENERGY: energy.toml: 'energy_interval' is not a multiple of the interval of coupling, 20 steps
# TAU: tau.toml:{{[0-9]+}}: expected a positive number for 'time_constant'
# BAROPERIOD: baroperiod.toml: 'interval' in [barostat] differs from that in [thermostat]
# PRESSURE: pressure.toml:{{[0-9]+}}: 'pressure' is for 'ensemble = "NPT"'

#--- one.pdb
HETATM    1  AR  AR  A   1       1.000   1.000   1.000  1.00  0.00          AR
HETATM    2  AR  AR  A   1       5.000   1.000   1.000  1.00  0.00          AR
#--- nvt.toml
[input]
coordinates = "one.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
steps  = 100
[ensemble]
ensemble = "NVT"
#--- nve.toml
[input]
coordinates = "one.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
steps  = 100
[ensemble]

[thermostat]
method = "V-RESCALE"
#--- npt.toml
[input]
coordinates = "one.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
steps  = 100
[ensemble]
ensemble = "NPT"
[thermostat]
method = "V-RESCALE"
#--- unused.toml
[input]
coordinates = "one.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
steps  = 100
[ensemble]
ensemble = "NVT"
[thermostat]
interval = 10
#--- differ.toml
[input]
coordinates = "one.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
steps  = 100
center_of_mass_interval = 10
[ensemble]
ensemble = "NVT"

[thermostat]
method = "V-RESCALE"
interval = 20
#--- multiple.toml
[input]
coordinates = "one.pdb"
[output]
energy_interval = 5

[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
steps  = 105
[ensemble]
ensemble = "NVT"

[thermostat]
method = "V-RESCALE"
#--- energy.toml
[input]
coordinates = "one.pdb"
[output]
energy_interval = 10

[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
steps  = 100
center_of_mass_interval = 20
#--- tau.toml
[input]
coordinates = "one.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
steps  = 100
[ensemble]
ensemble = "NVT"

[thermostat]
method = "V-RESCALE"
time_constant = 0.0
#--- baroperiod.toml
[input]
coordinates = "one.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
steps  = 100
[ensemble]
ensemble = "NPT"

[thermostat]
method = "V-RESCALE"
interval = 10

[barostat]
method = "C-RESCALE"
interval = 20
#--- pressure.toml
[input]
coordinates = "one.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
steps  = 100
[ensemble]
ensemble = "NVE"
pressure = 1.0
