# What is wrong with the thermostat, the barostat, and the removal of the
# motion of the center of mass is reported.
#
# RUN: split-file %s %t
# RUN: not mdir run %t/nvt.toml 2>&1 | FileCheck %s --check-prefix=NVT
# RUN: not mdir run %t/nve.toml 2>&1 | FileCheck %s --check-prefix=NVE
# RUN: not mdir run %t/npt.toml 2>&1 | FileCheck %s --check-prefix=NPT
# RUN: not mdir run %t/unused.toml 2>&1 | FileCheck %s --check-prefix=UNUSED
# RUN: not mdir run %t/differ.toml 2>&1 | FileCheck %s --check-prefix=DIFFER
# RUN: not mdir run %t/multiple.toml 2>&1 \
# RUN: | FileCheck %s --check-prefix=MULTIPLE
# RUN: not mdir run %t/energy.toml 2>&1 | FileCheck %s --check-prefix=ENERGY
# RUN: not mdir run %t/tau.toml 2>&1 | FileCheck %s --check-prefix=TAU
# RUN: not mdir run %t/baroperiod.toml 2>&1 | FileCheck %s --check-prefix=BAROPERIOD
# RUN: not mdir run %t/pressure.toml 2>&1 | FileCheck %s --check-prefix=PRESSURE
# RUN: not mdir run %t/semi.toml 2>&1 | FileCheck %s --check-prefix=SEMI

# NVT: nvt.toml:{{[0-9]+}}: 'ensemble = "NVT"' needs a [thermostat]
# NVE: nve.toml:{{[0-9]+}}: a [thermostat] needs 'ensemble = "NVT"' or "NPT" in [ensemble]
# NPT: npt.toml:{{[0-9]+}}: 'ensemble = "NPT"' needs a [barostat]
# UNUSED: unused.toml:{{[0-9]+}}: expected 'method' in [thermostat]: "V-RESCALE", stochastic velocity rescaling
# DIFFER: differ.toml: 'comm_period' differs from 'period' in [thermostat]
# MULTIPLE: multiple.toml: 'nsteps' is not a multiple of the period of coupling, 10 steps
# ENERGY: energy.toml: 'eneout_period' is not a multiple of the period of coupling, 20 steps
# TAU: tau.toml:{{[0-9]+}}: expected a positive number for 'tau_t'
# BAROPERIOD: baroperiod.toml: 'period' in [barostat] differs from that in [thermostat]
# PRESSURE: pressure.toml:{{[0-9]+}}: 'pressure' is for 'ensemble = "NPT"'
# SEMI: semi.toml:{{[0-9]+}}: 'isotropy = "SEMI-ISO"' is not supported yet

#--- one.pdb
HETATM    1  AR  AR  A   1       1.000   1.000   1.000  1.00  0.00          AR
HETATM    2  AR  AR  A   1       5.000   1.000   1.000  1.00  0.00          AR
#--- nvt.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
nsteps = 100
[ensemble]
ensemble = "NVT"
#--- nve.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
nsteps = 100
[ensemble]

[thermostat]
method = "V-RESCALE"
#--- npt.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
nsteps = 100
[ensemble]
ensemble = "NPT"
[thermostat]
method = "V-RESCALE"
#--- unused.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
nsteps = 100
[ensemble]
ensemble = "NVT"
[thermostat]
period = 10
#--- differ.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
nsteps = 100
comm_period = 10
[ensemble]
ensemble = "NVT"

[thermostat]
method = "V-RESCALE"
period = 20
#--- multiple.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
nsteps = 105
eneout_period = 5
[ensemble]
ensemble = "NVT"

[thermostat]
method = "V-RESCALE"
#--- energy.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
nsteps = 100
eneout_period = 10
comm_period = 20
#--- tau.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
nsteps = 100
[ensemble]
ensemble = "NVT"

[thermostat]
method = "V-RESCALE"
tau_t  = 0.0
#--- baroperiod.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
nsteps = 100
[ensemble]
ensemble = "NPT"

[thermostat]
method = "V-RESCALE"
period = 10

[barostat]
method = "C-RESCALE"
period = 20
#--- pressure.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
nsteps = 100
[ensemble]
ensemble = "NVE"
pressure = 1.0
#--- semi.toml
[input]
pdbfile = "one.pdb"
[energy]
cutoffdist = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
nsteps = 100
[ensemble]
ensemble = "NPT"

[thermostat]
method = "V-RESCALE"

[barostat]
method   = "C-RESCALE"
isotropy = "SEMI-ISO"
