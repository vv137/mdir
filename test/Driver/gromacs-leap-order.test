# The order of LEaP for the atoms of impropers, which grompp follows when
# the force field defines _FF_AMBER_LEAP_ATOM_REORDERING, as amber19sb.ff
# does. Two copies of one improper group, written 2 1 3 4 and 6 5 7 8 with
# the central atom third: both match X X C O by the types in the order of
# the file. The first improper of these types keeps its order; the second
# has its outer atoms sorted by type and then by index, 5 6 7 8, but keeps
# the parameters of X X C O, not those of CT N C O that 5 6 7 8 would match.
# With k (1 + cos(2φ − π)), k = 43.932 kJ/mol, φ(2 1 3 4) = 153.43°, and
# φ(1 2 3 4) = −153.87°:
#   in the order of LEaP, φ(2 1 3 4) and φ(1 2 3 4)          8.272150 kcal/mol
#   in the order of the file, without the define, φ(2 1 3 4) twice
#                                                             8.400000 kcal/mol
# grompp and a rerun of GROMACS 2026.3 give 34.6106 and 35.1455 kJ/mol.
#
# RUN: split-file %s %t
# RUN: mdir run --overwrite %t/run.toml | FileCheck %s --check-prefix=LEAP
# RUN: sed -i '/^#define _FF_AMBER_LEAP_ATOM_REORDERING/d' %t/system.top
# RUN: mdir run --overwrite %t/run.toml | FileCheck %s --check-prefix=FILE

# LEAP: MDIR:   dihedrals                      8.272150
# FILE: MDIR:   dihedrals                      8.400000

#--- run.toml
[input]
topology   = "system.top"
coordinates = "system.gro"

[output]
energy_interval = 0
[energy]
cutoff       = 12.0
pairlist_distance = 13.0
electrostatics = "CUTOFF"

[constraints]
hydrogen_bonds = false

[dynamics]
integrator    = "VELOCITY_VERLET"
time_step     = 0.0001
steps         = 1

[ensemble]
ensemble    = "NVE"
temperature = 0.0

[boundary]
type = "PERIODIC"
#--- system.top
#define _FF_AMBER_LEAP_ATOM_REORDERING

[ defaults ]
; nbfunc  comb-rule  gen-pairs  fudgeLJ  fudgeQQ
  1       2          yes        0.5      0.8333

[ atomtypes ]
; name  at.num  mass     charge  ptype  sigma  epsilon
  CT    6       12.0100  0.0     A      0.0    0.0
  N     7       14.0100  0.0     A      0.0    0.0
  C     6       12.0100  0.0     A      0.0    0.0
  O     8       16.0000  0.0     A      0.0    0.0

[ dihedraltypes ]
; i   j   k   l   func  phase   kd       pn
  CT  N   C   O   4     180.0   4.6024   2
  X   X   C   O   4     180.0   43.932   2

[ moleculetype ]
; name  nrexcl
  TWO   3

[ atoms ]
; nr  type  resnr  residue  atom  cgnr  charge  mass
  1   CT    1      TWO      CA    1     0.0     12.0100
  2   N     1      TWO      N     1     0.0     14.0100
  3   C     1      TWO      C     1     0.0     12.0100
  4   O     1      TWO      O     1     0.0     16.0000
  5   CT    1      TWO      CA2   2     0.0     12.0100
  6   N     1      TWO      N2    2     0.0     14.0100
  7   C     1      TWO      C2    2     0.0     12.0100
  8   O     1      TWO      O2    2     0.0     16.0000

[ dihedrals ]
; ai  aj  ak  al  funct
  2   1   3   4   4
  6   5   7   8   4

[ system ]
two improper groups

[ molecules ]
TWO  1
#--- system.gro
two improper groups
    8
    1TWO     CA    1   1.150   1.000   1.000
    1TWO      N    2   0.925   1.130   1.000
    1TWO      C    3   1.000   1.000   1.000
    1TWO      O    4   0.940   0.900   1.050
    1TWO    CA2    5   1.150   1.000   2.000
    1TWO     N2    6   0.925   1.130   2.000
    1TWO     C2    7   1.000   1.000   2.000
    1TWO     O2    8   0.940   0.900   2.050
   3.00000   3.00000   3.00000
