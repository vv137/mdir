# The time in the expressions of terms and the coordinates of pulling
# (D145). Two argon atoms on a spring whose rest length grows at 20 Å/ps,
# k (r - (r0 + v t))^2, given three ways: as a bond between the centers of
# two groups of one atom each, as a bond over the pair of particles, and as
# a term over the pairs of the topology. The forces of a step are those at
# the time of its end, so each run takes the positions of velocity Verlet
# with the force at time n Δt after step n; check_steer.py integrates the
# same and finds the same numbers to the last bit. `pull_coordinates`
# writes at each energy the distance and the vector between the centers,
# the energy of the term, the force along the distance, and the force on
# the second center; a run continued from the checkpoint before the last
# writes the same file. Then the errors: a parameter named `t`, a file of
# pulling without a term over centers or without energies.
#
# REQUIRES: hdf5
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: sed -n '/^#--- two.top/,/^#--- two.gro/p' %s | sed '1d;$d' > %t/two.top
# RUN: sed -n '/^#--- two.gro/,/^#--- run.toml/p' %s | sed '1d;$d' > %t/two.gro
# RUN: sed -n '/^#--- run.toml/,/^#--- tuple/p' %s | sed '1d;$d' > %t/run.toml
# RUN: sed -n '/^#--- tuple/,/^#--- pair/p' %s | sed '1d;$d' > %t/tuple.term
# RUN: sed -n '/^#--- pair/,/^#--- end/p' %s | sed '1d;$d' > %t/pair.term
# RUN: sed -e '/^pull_coordinates/d' -e '/^\[\[energy.bond\]\]/,/^v  = 20.0/d' -e 's/two.h5/tuple.h5/' -e '/^\[dynamics\]/e cat %t/tuple.term' %t/run.toml > %t/tuple.toml
# RUN: sed -e '/^pull_coordinates/d' -e '/^\[\[energy.bond\]\]/,/^v  = 20.0/d' -e 's/two.h5/pair.h5/' -e '/^\[dynamics\]/e cat %t/pair.term' %t/run.toml > %t/pair.toml
# RUN: cd %t && mdir run run.toml > run.log && mdir run tuple.toml > tuple.log && mdir run pair.toml > pair.log
# RUN: mdir checkpoint --print=positions %t/two.h5 > %t/two.positions
# RUN: mdir checkpoint --print=positions %t/tuple.h5 > %t/tuple.positions
# RUN: mdir checkpoint --print=positions %t/pair.h5 > %t/pair.positions
# RUN: %python %S/Inputs/check_steer.py %t/pull.dat %t/two.positions %t/tuple.positions %t/pair.positions | FileCheck %s
# RUN: FileCheck %s --check-prefix=FILE < %t/pull.dat
#
# RUN: cd %t && cp pull.dat full.dat && cp two.h5.prev two.h5 && mdir run run.toml --continue | FileCheck %s --check-prefix=CONTINUE
# RUN: cmp %t/full.dat %t/pull.dat
#
# RUN: sed -e 's/^v  = 20.0/&\nt  = 1.0/' %t/run.toml > %t/parameter.toml
# RUN: not mdir check %t/parameter.toml 2>&1 | FileCheck %s --check-prefix=PARAMETER
# RUN: sed -e 's/^v  = 20.0/&\nw  = 1.0/' -e 's/v\*t/w*s/' %t/run.toml > %t/name.toml
# RUN: not mdir check %t/name.toml 2>&1 | FileCheck %s --check-prefix=NAME
# RUN: sed -e 's/^energy_interval = 20/&\npull_coordinates = "pull.dat"/' %t/tuple.toml > %t/no-center.toml
# RUN: not mdir check %t/no-center.toml 2>&1 | FileCheck %s --check-prefix=NO-CENTER
# RUN: sed -e 's/^energy_interval = 20/energy_interval = 0/' %t/run.toml > %t/no-energy.toml
# RUN: not mdir check %t/no-energy.toml 2>&1 | FileCheck %s --check-prefix=NO-ENERGY

# CHECK:      6 lines, ok
# CHECK-NEXT: positions: equal
# CHECK-NEXT: positions: equal
# CHECK-NEXT: positions: equal

# FILE:      # step time steer.r steer.dx steer.dy steer.dz steer.energy steer.f_r steer.fx steer.fy steer.fz
# FILE-NEXT: # ps; Å, radians; kcal/mol; kcal/mol/Å, kcal/mol/rad
# FILE-NEXT: 0 0.000000 5.196152 5.000000 1.000000 -1.000000 0.000074 0.038476 0.037023 0.007405 -0.007405
# FILE:      100 0.100000 5.828141 5.608132 1.121626 -1.121626 9.409981 13.718587 13.200716 2.640143 -2.640143

# CONTINUE: continues the run after step 80

# PARAMETER: 't' is the time, not a parameter
# NAME: the expression uses 's', which is neither 'r', 'dx', 'dy', 'dz', the time 't', nor a parameter of the term
# NO-CENTER: [output] names 'pull_coordinates', but no term is over the centers of groups
# NO-ENERGY: 'pull_coordinates' are written at the energies of a run of dynamics, which needs 'energy_interval'

#--- two.top
[ defaults ]
1 2 no 1.0 1.0
[ atomtypes ]
AR 18 39.948 0.0 A 0.0 0.0
[ moleculetype ]
AR 1
[ atoms ]
1 AR 1 AR AR 1 0.0 39.948
[ system ]
two atoms on a spring
[ molecules ]
AR 2
#--- two.gro
Two atoms on a spring whose length grows
    2
    1AR      AR    1   1.000   1.000   1.000
    2AR      AR    2   1.500   1.100   0.900
   0.00000   0.00000   0.00000
#--- run.toml
[input]
topology    = "two.top"
coordinates = "two.gro"
[output]
energy_interval = 20
pull_coordinates = "pull.dat"
checkpoint = "two.h5"
checkpoint_interval = 20
[energy]
cutoff            = 9.0
pairlist_distance = 10.0
electrostatics    = "CUTOFF"
[[energy.bond]]
name       = "steer"
expression = "k*(r - (r0 + v*t))^2"
groups     = [":1", ":2"]
k  = 5.0
r0 = 5.2
v  = 20.0
[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.001
steps      = 100
[ensemble]
ensemble    = "NVE"
temperature = 0.0
[boundary]
type = "NONE"
[execution]
target    = "CPU"
precision = "DOUBLE"
#--- tuple
[[energy.bond]]
name       = "steer"
expression = "k*(r - (r0 + v*t))^2"
particles  = [[1, 2]]
k  = [5.0]
r0 = [5.2]
v  = [20.0]
#--- pair
[[energy.pair]]
name       = "steer"
expression = "k*(r - (r0 + v*t))^2"
k  = 5.0
r0 = 5.2
v  = 20.0
#--- end
