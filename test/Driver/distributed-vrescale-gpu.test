# REQUIRES: cuda, nccl
# RUN: rm -rf %t && mkdir -p %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %S/shake.test | sed -e '1d;$d' -e 's|= "vacuum|= "%S/Inputs/ff19sb/vacuum|' -e 's/= 500/= 4/' -e 's/= 100/= 1/g' -e 's/= 28.0/= 8.0/' -e 's/= 29.0/= 10.0/' -e 's/"NVE"/"NVT"/' -e '/^\[dynamics\]/a seed = 314159' > %t/run.toml
# RUN: printf '\n[thermostat]\nmethod = "V-RESCALE"\ntime_constant = 1.0\ninterval = 1\n[execution]\ntarget = "GPU"\nprecision = "DOUBLE"\n[distribute]\ntransport = "nccl"\ntraversal = "unique"\n' >> %t/run.toml
# RUN: cd %t && mdir run run.toml > run.log
# RUN: FileCheck %s < %t/run.log
# RUN: %python %S/Inputs/check_bonds.py %S/Inputs/ff19sb/vacuum.prmtop %t/shake.dcd | FileCheck %s --check-prefix=BONDS

# The thermostat is applied every step. Small constrained drifts keep the
# same list valid even across thermostat applications and energy reports.
# CHECK: DIST: interval step 2 halo_build min/mean/max 0 0 0 s
# CHECK: INFO: 4
# CHECK: DIST: interval step 4 halo_build min/mean/max 0 0 0 s
# BONDS: bonds ok
