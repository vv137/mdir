# What is wrong with a control file is reported with its line.
#
# RUN: split-file %s %t
# RUN: not mdir run %t/keyword.toml 2>&1 | FileCheck %s --check-prefix=KEYWORD
# RUN: not mdir run %t/choice.toml 2>&1 | FileCheck %s --check-prefix=CHOICE
# RUN: not mdir run %t/period.toml 2>&1 | FileCheck %s --check-prefix=PERIOD
# RUN: not mdir run %t/syntax.toml 2>&1 | FileCheck %s --check-prefix=SYNTAX
# RUN: not mdir run %t/name.toml 2>&1 | FileCheck %s --check-prefix=NAME
# RUN: not mdir run %t/mixing.toml 2>&1 | FileCheck %s --check-prefix=MIXING
# RUN: not mdir run %t/expression.toml 2>&1 \
# RUN: | FileCheck %s --check-prefix=EXPRESSION
# RUN: not mdir run %t/atom.toml 2>&1 | FileCheck %s --check-prefix=ATOM
# RUN: not mdir run %t/reach.toml 2>&1 | FileCheck %s --check-prefix=REACH

# KEYWORD: keyword.toml:3: unknown keyword 'cutoff_distance' in [energy]
# A neighbor structure that reaches less far than the cutoff would miss
# pairs within it.
# REACH: reach.toml:{{[0-9]+}}: 'pairlist_distance' is less than 'cutoff
# CHOICE: choice.toml:12: expected one of VELOCITY_VERLET, LEAPFROG, BROWNIAN for 'integrator', got 'RK4'
# PERIOD: period.toml:{{[0-9]+}}: 'steps' is not a multiple of 'energy_interval'
# SYNTAX: syntax.toml:2:
# NAME: the expression of 'lj' uses 'delta', which is neither 'r', nor 'coulomb', nor a number of the term, nor a parameter of the type 'AR'
# MIXING: 'sigma' differs between the types, but the term 'lj' has no rule of 'mixing' for it
# EXPRESSION: in the expression '4*epsilon*((sigma/r)^12 - ', at 27: expected a number, a name, or '('
# ATOM: atoms.pdb:1: no {{\[\[}}energy.type]] is named 'XE'

#--- atoms.pdb
HETATM    1  XE  XE  A   1       1.000   1.000   1.000  1.00  0.00          XE
#--- one.pdb
HETATM    1  AR  AR  A   1       1.000   1.000   1.000  1.00  0.00          AR
HETATM    2  AR  AR  A   1       5.000   1.000   1.000  1.00  0.00          AR
#--- two.pdb
HETATM    1  AR  AR  A   1       1.000   1.000   1.000  1.00  0.00          AR
HETATM    2  KR  KR  A   1       5.000   1.000   1.000  1.00  0.00          KR
#--- keyword.toml
[energy]
cutoff     = 9.0
cutoff_distance = 9.0
[input]
coordinates = "one.pdb"
#--- choice.toml
[input]
coordinates = "one.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
integrator = "RK4"
#--- period.toml
[input]
coordinates = "one.pdb"
[output]
energy_interval = 10

[energy]
cutoff     = 9.0
[[energy.pair]]
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
steps  = 105
#--- syntax.toml
[input]
coordinates = one.pdb
#--- name.toml
[input]
coordinates = "one.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
name = "lj"
expression = "epsilon*delta/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
steps  = 10
[boundary]
type = "PERIODIC"
box = [30.0, 30.0, 30.0]
#--- mixing.toml
[input]
coordinates = "two.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
name = "lj"
expression = "4*epsilon*((sigma/r)^12 - (sigma/r)^6)"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
sigma = 3.4
[[energy.type]]
name = "KR"
mass = 83.8
epsilon = 0.2
sigma = 3.6
[dynamics]
steps  = 10
[boundary]
type = "PERIODIC"
box = [30.0, 30.0, 30.0]
#--- expression.toml
[input]
coordinates = "two.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
name = "lj"
expression = "4*epsilon*((sigma/r)^12 - "
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
sigma = 3.4
[[energy.type]]
name = "KR"
mass = 83.8
epsilon = 0.2
sigma = 3.4
[dynamics]
steps  = 10
[boundary]
type = "PERIODIC"
box = [30.0, 30.0, 30.0]
#--- atom.toml
[input]
coordinates = "atoms.pdb"
[energy]
cutoff     = 9.0
[[energy.pair]]
name = "lj"
expression = "epsilon/r"
[[energy.type]]
name = "AR"
mass = 39.95
epsilon = 0.2
[dynamics]
steps  = 10
[boundary]
type = "PERIODIC"
box = [30.0, 30.0, 30.0]
#--- reach.toml
[input]
coordinates = "atoms.pdb"

[energy]
cutoff       = 9.0
pairlist_distance = 8.5
