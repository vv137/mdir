# Anisotropic stochastic cell rescaling (D163c) on the mixture of
# barostat.test: each axis scales by the strain of its own pressure, with
# its own noise, eq. (9b) of Bernetti and Bussi (2020) on each. The volume
# compresses as with isotropic coupling, the conserved energy changes as
# little, an axis of compressibility 0 keeps its edge to the bit, and the
# pressures of the three axes are reported at the end.
#
# REQUIRES: hdf5
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/mixture.pdb %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/aniso.toml
# RUN: mdir run %t/aniso.toml | FileCheck %s
# RUN: mdir emit %t/aniso.toml | FileCheck %s --check-prefix=MODULE
# RUN: mdir check %t/aniso.toml | FileCheck %s --check-prefix=CHECK-TOOL
# RUN: sed -e 's|^\[barostat\]$|[barostat]\nwork = "EXACT"|' -e 's|aniso.h5|exact.h5|' %t/aniso.toml > %t/exact.toml
# RUN: mdir run %t/exact.toml | FileCheck %s --check-prefix=EXACT
# RUN: sed -e 's|^coupling *= "ANISOTROPIC"|coupling = "ANISOTROPIC"\ncompressibility = [0.0, 4.5e-5, 4.5e-5]|' -e 's|aniso.h5|frozen.h5|' %t/aniso.toml > %t/frozen.toml
# RUN: mdir run %t/frozen.toml | FileCheck %s
# RUN: mdir checkpoint %t/frozen.h5 | FileCheck %s --check-prefix=FROZEN

# What is wrong with the compressibilities is reported.
#
# RUN: sed -e 's|^coupling *= "ANISOTROPIC"|compressibility = [4.5e-5, 4.5e-5, 4.5e-5]|' %t/aniso.toml > %t/isotropic.toml
# RUN: not mdir check %t/isotropic.toml 2>&1 | FileCheck %s --check-prefix=ONLY
# RUN: sed -e 's|^coupling *= "ANISOTROPIC"|coupling = "ANISOTROPIC"\ncompressibility = [4.5e-5, 4.5e-5]|' %t/aniso.toml > %t/two.toml
# RUN: not mdir check %t/two.toml 2>&1 | FileCheck %s --check-prefix=THREE
# RUN: sed -e 's|^coupling *= "ANISOTROPIC"|coupling = "ANISOTROPIC"\ncompressibility = [0, 0, 0]|' %t/aniso.toml > %t/zero.toml
# RUN: not mdir check %t/zero.toml 2>&1 | FileCheck %s --check-prefix=ZERO
# RUN: sed -e 's|^\[barostat\]$|[barostat]\nwork = "FIRST_ORDER"|' %t/aniso.toml > %t/first.toml
# RUN: not mdir check %t/first.toml 2>&1 | FileCheck %s --check-prefix=FIRST

# CHECK:      INFO:         0         0.0000 {{ *}}[[TOTAL:-[0-9.]+]] {{.*}} [[TOTAL]]     12487.1680
# CHECK:      INFO:      2000 {{.*}} {{11[0-9]{3}\.[0-9]+}} {{[0-9.]+$}}
# CHECK:      MDIR: the pressures of the barostat over 200 periods, in bar: x {{-?[0-9.]+}} ± {{[0-9.]+}}, y {{-?[0-9.]+}} ± {{[0-9.]+}}, z {{-?[0-9.]+}} ± {{[0-9.]+}}
# CHECK:      MDIR: the conserved energy changed by {{[0-9.]+}}e-0{{[4-9]}} of its value
# EXACT:      MDIR: the conserved energy changed by {{[0-9.]+}}e-0{{[5-9]}} of its value

# MODULE:     func.func private @mdrtBarostatStrainAxis(i64, i64, i64, f64, f64, f64, f64, f64, f64) -> f64
# MODULE:     %baro_beta_0 = arith.constant
# MODULE:     @mdrtBarostatStrainAxis(%seed, {{%[a-z0-9_]+}}, %baxis0_{{[a-z0-9]+}}, %bpa0_
# MODULE:     @mdrtBarostatStrainAxis(%seed, {{%[a-z0-9_]+}}, %baxis1_{{[a-z0-9]+}}, %bpa1_
# MODULE:     @mdrtBarostatStrainAxis(%seed, {{%[a-z0-9_]+}}, %baxis2_{{[a-z0-9]+}}, %bpa2_

# CHECK-TOOL: barostat: C-RESCALE, ANISOTROPIC

# FROZEN: box: 2.32 {{[0-9.]+}} {{[0-9.]+}} nm

# ONLY: a 'compressibility' of each axis needs 'coupling = "ANISOTROPIC"'; give one number
# THREE: expected three numbers that are not negative for 'compressibility', those of x, y, and z, in 1/atm
# ZERO: a barostat whose compressibilities are all 0 keeps the cell; give one that is not 0
# FIRST: 'work = "FIRST_ORDER"' counts the work from the trace of the virial

#--- run.toml
[input]
coordinates = "mixture.pdb"

[output]
energy_interval = 1000
checkpoint = "aniso.h5"
checkpoint_interval = 2000
[energy]
switch_distance = 7.5
cutoff       = 9.0
pairlist_distance = 10.0

[[energy.pair]]
name       = "lj"
expression = "4*epsilon*((sigma/r)^12 - (sigma/r)^6)"
mixing     = "lorentz-berthelot"

[[energy.type]]
name    = "AR"
mass    = 39.95
epsilon = 0.238465
sigma   = 3.4

[[energy.type]]
name    = "KR"
mass    = 83.80
epsilon = 0.3253
sigma   = 3.65

[dynamics]
integrator        = "VELOCITY_VERLET"
time_step         = 0.004
steps             = 2000

[ensemble]
ensemble    = "NPT"
temperature = 100.0
pressure    = 200.0

[thermostat]
method = "V-RESCALE"
interval = 10
time_constant = 0.5

[barostat]
method = "C-RESCALE"
time_constant = 2.0
coupling = "ANISOTROPIC"

[boundary]
type       = "PERIODIC"
box = [23.2, 23.2, 23.2]
#--- end
