# Every refusal of a distributed run, each by a control file that differs
# from an accepted one in the condition alone (D447).
# RUN: rm -rf %t && mkdir -p %t
# RUN: sed -e 's|argon.pdb|%S/../../examples/argon/argon.pdb|' \
# RUN:     -e 's/= 2000$/= 10/' -e 's/= 100$/= 5/' -e 's/= 16$/= 1/' \
# RUN:     -e 's/= 9.5$/= 8.65/' -e '/^trajectory/d' \
# RUN:     %S/../../examples/argon/argon.toml > %t/base.toml
# RUN: cp %t/base.toml %t/grid.toml && printf '\n[distribute]\ndomains = 8\n' >> %t/grid.toml
# RUN: mdir run %t/grid.toml | FileCheck %s --check-prefix=ACCEPTED
# ACCEPTED: MDIR: domain grid 2 x 2 x 2, local transport, directed traversal

# The control file. A halo of the cutoff alone misses the pairs that enter
# the cutoff between two rebuilds.
# RUN: sed 's/= 8.65$/= 8.5/' %t/grid.toml > %t/skin.toml
# RUN: not mdir run %t/skin.toml 2>&1 | FileCheck %s --check-prefix=SKIN
# SKIN: distributed halo coverage requires a positive skin
# RUN: sed 's/"DOUBLE"/"SINGLE"/' %t/grid.toml > %t/single.toml
# RUN: not mdir run %t/single.toml 2>&1 | FileCheck %s --check-prefix=SINGLE
# SINGLE: distributed state requires mixed or double position storage
# RUN: sed 's/"CPU"/"GPU"/' %t/grid.toml > %t/gpu.toml
# RUN: not mdir run %t/gpu.toml 2>&1 | FileCheck %s --check-prefix=TARGET
# TARGET: distributed execution requires a CPU target
