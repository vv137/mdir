# The forms of 'domains': a count must be a positive integer.
# RUN: sed 's/domains = 8/domains = 0/' %t/grid.toml > %t/zero.toml
# RUN: not mdir run %t/zero.toml 2>&1 | FileCheck %s --check-prefix=COUNT
# RUN: sed 's/domains = 8/domains = -2/' %t/grid.toml > %t/negative.toml
# RUN: not mdir run %t/negative.toml 2>&1 | FileCheck %s --check-prefix=COUNT
# RUN: sed 's/domains = 8/domains = 2.5/' %t/grid.toml > %t/float.toml
# RUN: not mdir run %t/float.toml 2>&1 | FileCheck %s --check-prefix=COUNT
# COUNT: domains requires a positive count or a three-axis grid
# RUN: sed 's/domains = 8/domains = [2, 2.0, 2]/' %t/grid.toml > %t/axis.toml
# RUN: not mdir run %t/axis.toml 2>&1 | FileCheck %s --check-prefix=AXIS
# AXIS: domain division must be a positive integer

# An error elsewhere in a control file with [distribute] is that error, not
# a refusal of the distribution: nothing is written to the log.
# RUN: sed -e 's/^cutoff .*/cutof = 8.5/' -e '/^\[output\]/a log = "typo.log"' %t/grid.toml > %t/typo.toml
# RUN: cd %t && not mdir run typo.toml 2> typo.err
# RUN: FileCheck %s --check-prefix=TYPO < %t/typo.err
# TYPO-NOT: distributed setup refused
# TYPO: cutof
# RUN: test ! -e %t/typo.log

# The trace of the steps may not take the name of a checkpoint.
# RUN: sed '/^\[output\]/a checkpoint = "t.rank0.log"\ncheckpoint_interval = 5' %t/grid.toml > %t/trace.toml
# RUN: cd %t && env MDIR_DIST_STEP_TRACE=t not mdir run trace.toml 2>&1 | FileCheck %s --check-prefix=TRACE
# TRACE: distributed trace path conflicts with checkpoint

# A topology: the dipeptide in water of amber.test, on two domains.
# RUN: mkdir -p %t/topology && cd %t/topology
# RUN: cp %S/Inputs/dipeptide/dipeptide.prmtop %S/Inputs/dipeptide/dipeptide.inpcrd .
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %S/amber.test | sed '1d;$d' > base.toml
# RUN: printf '\n[execution]\ntarget = "CPU"\nprecision = "DOUBLE"\n[distribute]\ndomains = [2, 1, 1]\n' >> base.toml
# RUN: sed 's/"CUTOFF"/"PME"/' base.toml > pme.toml
# The distributed mesh (D[distribute-pme]) takes electrostatic PME
# over a unique or midpoint traversal only.
# RUN: not mdir run pme.toml 2>&1 | FileCheck %s --check-prefix=MESH
# MESH: distributed PME exclusion tuples require unique or midpoint traversal
# RUN: sed 's/^electrostatics = "CUTOFF"/&\nlennard_jones = "PME"/' base.toml > ljpme.toml
# RUN: not mdir run ljpme.toml 2>&1 | FileCheck %s --check-prefix=LJMESH
# LJMESH: distributed mesh supports electrostatic PME only
# The builder: constraints, whose partners may lie in other domains.
# RUN: sed -e 's/^\[boundary\]/[constraints]\nrigid_water = true\n&/' \
# RUN:     -e '/^\[output\]/a log = "rigid.log"\nmanifest = "rigid.jsonl"' base.toml > rigid.toml
# RUN: not mdir run rigid.toml 2>&1 | FileCheck %s --check-prefix=CONSTRAINTS
# RUN: FileCheck %s --check-prefix=CONSTRAINTS-LOG < rigid.log
# RUN: FileCheck %s --check-prefix=CONSTRAINTS < rigid.jsonl
# CONSTRAINTS: distributed constraints require cross-domain constraint partners
# CONSTRAINTS-LOG: MDIR: distributed setup refused: distributed constraints require cross-domain constraint partners
# The compiler: the exclusions of the bonds are pairs of a tuple set, which
# the passes of md_dist refuse with a diagnostic, which the run records as
# the refusal of the distribution.
# RUN: sed '/^\[output\]/a log = "bonds.log"\nmanifest = "bonds.jsonl"' base.toml > bonds.toml
# RUN: not mdir run bonds.toml 2>&1 | FileCheck %s --check-prefix=EXCLUSIONS
# RUN: FileCheck %s --check-prefix=EXCLUSIONS-LOG < bonds.log
# RUN: FileCheck %s --check-prefix=EXCLUSIONS-MANIFEST < bonds.jsonl
# EXCLUSIONS: 'md.neighborhood' op cannot be distributed: exclusions are pairs of a tuple set
# EXCLUSIONS-LOG: MDIR: distributed setup refused: 'md.neighborhood' op cannot be distributed: exclusions
# EXCLUSIONS-MANIFEST: "event":"refused"
# EXCLUSIONS-MANIFEST-SAME: exclusions are pairs of a tuple set
