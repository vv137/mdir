# RUN: mdir run override.toml 2>&1 | FileCheck %s --check-prefix=OVERRIDE
# RUN: FileCheck %s --check-prefix=OVERRIDE-LOG < override.log
# OVERRIDE: MDIR: domain grid 2 x 2 x 2, local transport, directed traversal
# OVERRIDE-NOT: distributed setup refused
# OVERRIDE: MDIR: ran in
# OVERRIDE-LOG-NOT: distributed setup refused
# OVERRIDE-LOG: MDIR: ran in
