# The breakdown of the device memory (D311, #471): with
# MDIR_DEVICE_MEMORY=2 a run on a device of the dipeptide in water with PME
# and groups reports, after the two peaks of D294, the driver's use of the
# device, the accounts outside the pool (the modules, cuFFT's plans, the
# structures of the tuples, whose incidence structures it prints as they are
# made), and the blocks at its peaks by what they were allocated for: the
# buffers of the groups by name, the rest as compiled code. With
# MDIR_DEVICE_MEMORY=1 it prints the peaks alone, as before.
#
# REQUIRES: cuda
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' | sed 's|INPUTS|%S/Inputs/dipeptide|' > %t/run.toml
# RUN: cd %t && env MDIR_DEVICE_MEMORY=2 mdir run run.toml > detail.log 2>&1
# RUN: FileCheck %s < %t/detail.log
# RUN: cd %t && env MDIR_DEVICE_MEMORY=1 mdir run run.toml > peaks.log 2>&1
# RUN: FileCheck %s --check-prefix=PEAKS < %t/peaks.log
#
# CHECK: mdrt: device memory: the incidence structure of {{[0-9]+}} tuples of {{[0-9]}}: 1168 particles, rows of {{[0-9]+}} entries
# CHECK: mdrt: device memory (MDIR_DEVICE_MEMORY): peak {{[0-9.]+}} MiB allocated, {{[0-9.]+}} MiB with the pool
# CHECK-NEXT: mdrt: device memory: {{[0-9]+}} allocations of blocks, {{[0-9]+}} from the pool, 0 returned to the driver
# CHECK-NEXT: mdrt: device memory: the driver's use of the device: {{[0-9.]+}} MiB once the context was made, {{[0-9.]+}} MiB at the peak with the pool
# CHECK-NEXT: mdrt: device memory: by account, the growth of the driver's use, the bytes asked for, and the events:
# CHECK-NEXT: mdrt: the modules {{-?[0-9.]+}} MiB 0.0 MiB {{[0-9]+}}
# CHECK: mdrt: the blocks of the pool {{[0-9.]+}} MiB {{[0-9.]+}} MiB {{[0-9]+}}
# CHECK-NEXT: mdrt: the plans of cuFFT {{-?[0-9.]+}} MiB {{[0-9.]+}} MiB 2
# CHECK-NEXT: mdrt: the structures of the tuples {{[0-9.]+}} MiB {{[0-9.]+}} MiB {{[0-9]+}}
# CHECK-NEXT: mdrt: device memory at the peak in use ({{[0-9.]+}} MiB), by tag and size:
# CHECK-DAG: mdrt: in use {{[0-9.]+}} MiB {{[0-9]+}} x {{[0-9]+}} bytes groups: entries
# CHECK-DAG: mdrt: in use {{[0-9.]+}} MiB {{[0-9]+}} x {{[0-9]+}} bytes compiled code
# CHECK: mdrt: device memory at the peak with the pool ({{[0-9.]+}} MiB), by tag and size:
#
# PEAKS-NOT: mdrt: device memory:
# PEAKS: mdrt: device memory (MDIR_DEVICE_MEMORY): peak {{[0-9.]+}} MiB allocated, {{[0-9.]+}} MiB with the pool
# PEAKS-NOT: mdrt: device memory

#--- run.toml
[input]
topology = "INPUTS/dipeptide.prmtop"
coordinates = "INPUTS/dipeptide.inpcrd"
[energy]
cutoff = 8.0
pairlist_distance = 9.0
electrostatics = "PME"
[constraints]
hydrogen_bonds = true
rigid_water = true
[dynamics]
time_step = 0.002
steps = 20
[output]
energy_interval = 10
[ensemble]
ensemble = "NVE"
temperature = 300.0
[boundary]
type = "PERIODIC"
[execution]
target = "GPU"
precision = "MIXED"
neighbor_structure = "GROUPS"
#--- end
