# REQUIRES: cuda, python-api
# The build part of the key of the cache of the skins (D[skin-budget-record])
# in `mdir` and in the Python extension, two images of one build: the lines
# between the format and the version, compared as hashes, of the keys of two
# systems (the argon of `mdir check --json`, the dipeptide of
# `Program.plan`, each on a GPU with the groups, where a run reads the
# cache). A clean build (MDIR_SKIN_SALT_DIRTY_OVERRIDE=no) gives the same
# lines, without the image; a dirty one gives lines that differ, each with
# its image.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: %python %S/Inputs/argon_lattice.py 40 %t/big.pdb
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %S/neighbor-auto.test | sed '1d;$d' \
# RUN:     | sed -e 's|^cutoff = 9.0|cutoff = 9.0\npairlist_distance = "AUTO"|' > %t/auto.toml
# RUN: cd %t && env MDIR_SKIN_SALT_DIRTY_OVERRIDE=no mdir check --json auto.toml > clean.json
# RUN: cd %t && env MDIR_SKIN_SALT_DIRTY_OVERRIDE=yes mdir check --json auto.toml > dirty.json
# RUN: env MDIR_SKIN_SALT_DIRTY_OVERRIDE=no %mdir_python %S/Inputs/skin_salt.py python %S/Inputs/dipeptide > %t/clean.txt
# RUN: %python %S/Inputs/skin_salt.py check %t/clean.json >> %t/clean.txt
# RUN: FileCheck %s --check-prefix=CLEAN < %t/clean.txt
# RUN: %python %S/Inputs/skin_salt.py compare %t/clean.txt | FileCheck %s --check-prefix=CLEAN-KEY
# RUN: env MDIR_SKIN_SALT_DIRTY_OVERRIDE=yes %mdir_python %S/Inputs/skin_salt.py python %S/Inputs/dipeptide > %t/dirty.txt
# RUN: %python %S/Inputs/skin_salt.py check %t/dirty.json >> %t/dirty.txt
# RUN: FileCheck %s --check-prefix=DIRTY < %t/dirty.txt
# RUN: %python %S/Inputs/skin_salt.py compare %t/dirty.txt | FileCheck %s --check-prefix=DIRTY-KEY

# CLEAN: python {{[0-9a-f]+}} image=False
# CLEAN-NEXT: mdir {{[0-9a-f]+}} image=False
# CLEAN-KEY: python -> mdir same
# DIRTY: python {{[0-9a-f]+}} image=True
# DIRTY-NEXT: mdir {{[0-9a-f]+}} image=True
# DIRTY-KEY: python -> mdir different
