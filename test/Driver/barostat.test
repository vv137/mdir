# Stochastic cell rescaling at constant pressure and temperature, on the
# mixture of thermostat.test at 100 K, which its pressure of -1800 atm
# compresses toward 200 atm.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/mixture.pdb %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/a.toml
# RUN: sed -e 's|energy_interval = 1000|energy_interval = 100|' %t/a.toml > %t/b.toml
# RUN: sed -e 's|VELOCITY_VERLET|LEAPFROG|' %t/a.toml > %t/leap.toml
# RUN: mdir run %t/a.toml > %t/a.log
# RUN: mdir run %t/b.toml > %t/b.log
# RUN: FileCheck %s < %t/a.log
# RUN: mdir run %t/leap.toml > %t/leap.log
# RUN: FileCheck %s < %t/leap.log
# RUN: sed -e 's|^\[barostat\]$|[barostat]\nwork = "FIRST_ORDER"|' %t/a.toml > %t/first.toml
# RUN: mdir run %t/first.toml | FileCheck %s --check-prefix=FIRST
# RUN: sed -e 's|^\[barostat\]$|[barostat]\nwork = "EXACT"|' %t/a.toml > %t/exact.toml
# RUN: mdir run %t/exact.toml | FileCheck %s --check-prefix=EXACT
# RUN: mdir emit %t/exact.toml | FileCheck %s --check-prefix=EXACT-WORK
# RUN: sed -e 's|^\[barostat\]$|[barostat]\nwork = "TROTTER_FIRST_ORDER"|' %t/a.toml > %t/trotter1.toml
# RUN: mdir run %t/trotter1.toml > %t/trotter1.log
# RUN: FileCheck %s --check-prefix=FIRST < %t/trotter1.log
# RUN: grep 'INFO: *2000 ' %t/trotter1.log | awk '{$10 = ""; print}' > %t/trotter1.row
# RUN: grep 'INFO: *2000 ' %t/a.log | awk '{$10 = ""; print}' | diff - %t/trotter1.row
# RUN: mdir emit %t/a.toml | FileCheck %s --check-prefix=MODULE

# A pair is taken once, in the minimum image, so the cell must be wider
# than twice the cutoff, where the run begins and wherever the barostat
# takes it.
#
# RUN: sed -e 's|^cutoff *= 9.0|cutoff   = 12.0|' \
# RUN:     -e 's|pairlist_distance = 10.0|pairlist_distance = 13.0|' \
# RUN:     -e 's|^switch_distance *= 7.5|switch_distance   = 10.5|' %t/a.toml > %t/small.toml
# RUN: not mdir run %t/small.toml 2>&1 | FileCheck %s --check-prefix=SMALL
# RUN: sed -e 's|^cutoff *= 9.0|cutoff   = 11.4|' \
# RUN:     -e 's|pairlist_distance = 10.0|pairlist_distance = 12.0|' \
# RUN:     -e 's|^switch_distance *= 7.5|switch_distance   = 10.0|' \
# RUN:     -e 's|^pressure *= 200.0|pressure    = 5000.0|' %t/a.toml > %t/shrink.toml
# RUN: not mdir run %t/shrink.toml 2>&1 | FileCheck %s --check-prefix=SHRINK

# SMALL: mdir: the cell is 23.2000 Å along x, less than twice the cutoff, 12.0000 Å
# SHRINK: mdir: the barostat has made the cell 22.{{[0-9]+}} Å along {{[xyz]}}, less than twice the cutoff, 11.4000 Å; the run needs a larger cell

# The trajectory does not depend on how the steps are grouped into loops,
# nor on how the energy of a scaling of Trotter type is counted (only the
# conserved energy, the ninth column, does).
#
# RUN: grep 'INFO: *2000 ' %t/a.log > %t/a.row
# RUN: grep 'INFO: *2000 ' %t/b.log > %t/b.row
# RUN: diff %t/a.row %t/b.row
# RUN: grep 'INFO: *2000 ' %t/leap.log > %t/leap.row
# RUN: diff %t/a.row %t/leap.row

# The energy that the thermostat and the barostat exchange with the bath is
# added to the total energy, and the volume shrinks from 23.2^3 A^3. By
# default the cell scales within the drift of the last step of a period
# (Trotter type, D92), and the energy of the scaling is counted from the
# virials before and after it: the conserved energy drifts by about 3e-4 of
# its value here, growing with the period of coupling. Counted exactly,
# from the energy of the scaled positions, it changes as at constant energy
# (D77); counted to first order in μ − 1, as GROMACS does, it drifts as the
# square of the strain, by about 2e-3 (design-m1.md, Section 11.4).
#
# CHECK:      INFO:      STEP {{.*}}PRESSURE      CONSERVED         VOLUME
# CHECK-NEXT: INFO:         0         0.0000 {{ *}}[[TOTAL:-[0-9.]+]] {{.*}} [[TOTAL]]     12487.1680
# CHECK-NEXT: INFO:      1000 {{.*}} {{11[0-9]{3}\.[0-9]+$}}
# CHECK-NEXT: INFO:      2000 {{.*}} {{11[0-9]{3}\.[0-9]+$}}
# CHECK:      MDIR: the conserved energy changed by {{[0-9.]+}}e-0{{[4-9]}} of its value
# EXACT:      MDIR: the conserved energy changed by {{[0-9.]+}}e-0{{[5-9]}} of its value

# The exact work counts the change of the constant terms of the energy as
# well, the correction for the dispersion and the background of a net
# charge, C (1/V' - 1/V), which md.evaluate leaves out: without it the
# conserved energy carried E_c(V) - E_c(V_0), on the peptide of
# barostat-ff19sb-gpu.test -1.47 kcal/mol after 2 ps (CPU, double), the
# dispersion correction of -30.24 kcal/mol times V_0/V - 1 = 0.0487.
#
# EXACT-WORK: %baro_energy_constant = arith.constant
# EXACT-WORK: %bdc{{[a-z0-9_]*}} = arith.mulf %baro_energy_constant, %bdvi
# EXACT-WORK: %bdu{{[a-z0-9_]*}} = arith.addf %bdue
# FIRST:      MDIR: the conserved energy changed by {{[0-9.]+}}e-03 of its value

# Leapfrog takes the pressure from the velocities of the time of the
# positions, which its step of energy returns, couples those, and takes the
# forces of the scaled positions as velocity Verlet does: without
# constraints its trajectory is that of velocity Verlet (D76, D77).

# MODULE:      func.func private @mdrtBarostatStrain(
# MODULE:      func.call @mdrtSetBox(

#--- run.toml
[input]
coordinates = "mixture.pdb"

[output]
energy_interval = 1000
[energy]
switch_distance = 7.5
cutoff       = 9.0
pairlist_distance = 10.0

[[energy.pair]]
name       = "lj"
expression = "4*epsilon*((sigma/r)^12 - (sigma/r)^6)"
mixing     = "lorentz-berthelot"

[[energy.type]]
name    = "AR"
mass    = 39.95
epsilon = 0.238465
sigma   = 3.4

[[energy.type]]
name    = "KR"
mass    = 83.80
epsilon = 0.3253
sigma   = 3.65

[dynamics]
integrator        = "VELOCITY_VERLET"
time_step         = 0.004
steps             = 2000

[ensemble]
ensemble    = "NPT"
temperature = 100.0
pressure    = 200.0

[thermostat]
method = "V-RESCALE"
interval = 10
time_constant = 0.5

[barostat]
method = "C-RESCALE"
time_constant = 2.0

[boundary]
type       = "PERIODIC"
box = [23.2, 23.2, 23.2]
#--- end
