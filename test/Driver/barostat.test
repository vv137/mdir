# Stochastic cell rescaling at constant pressure and temperature, on the
# mixture of thermostat.test at 100 K, which its pressure of -1800 atm
# compresses toward 200 atm.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/mixture.pdb %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/a.toml
# RUN: sed -e 's|eneout_period = 1000|eneout_period = 100|' %t/a.toml > %t/b.toml
# RUN: sed -e 's|VVER|LEAP|' %t/a.toml > %t/leap.toml
# RUN: mdir run %t/a.toml > %t/a.log
# RUN: mdir run %t/b.toml > %t/b.log
# RUN: FileCheck %s < %t/a.log
# RUN: mdir run %t/leap.toml > %t/leap.log
# RUN: FileCheck %s < %t/leap.log
# RUN: sed -e 's|tau_p       = 2.0|tau_p       = 2.0\nbarostat_work = "FIRST_ORDER"|' %t/a.toml > %t/first.toml
# RUN: mdir run %t/first.toml | FileCheck %s --check-prefix=FIRST
# RUN: mdir emit %t/a.toml | FileCheck %s --check-prefix=MODULE

# A pair is taken once, in the minimum image, so the cell must be wider
# than twice the cutoff, where the run begins and wherever the barostat
# takes it.
#
# RUN: sed -e 's|cutoffdist   = 9.0|cutoffdist   = 12.0|' \
# RUN:     -e 's|pairlistdist = 10.0|pairlistdist = 13.0|' \
# RUN:     -e 's|switchdist   = 7.5|switchdist   = 10.5|' %t/a.toml > %t/small.toml
# RUN: not mdir run %t/small.toml 2>&1 | FileCheck %s --check-prefix=SMALL
# RUN: sed -e 's|cutoffdist   = 9.0|cutoffdist   = 11.4|' \
# RUN:     -e 's|pairlistdist = 10.0|pairlistdist = 12.0|' \
# RUN:     -e 's|switchdist   = 7.5|switchdist   = 10.0|' \
# RUN:     -e 's|pressure    = 200.0|pressure    = 5000.0|' %t/a.toml > %t/shrink.toml
# RUN: not mdir run %t/shrink.toml 2>&1 | FileCheck %s --check-prefix=SHRINK

# SMALL: mdir: the cell is 23.2000 Å along x, less than twice the cutoff, 12.0000 Å
# SHRINK: mdir: the barostat has made the cell 22.{{[0-9]+}} Å along {{[xyz]}}, less than twice the cutoff, 11.4000 Å; the run needs a larger cell

# The trajectory does not depend on how the steps are grouped into loops.
#
# RUN: grep 'INFO: *2000 ' %t/a.log > %t/a.row
# RUN: grep 'INFO: *2000 ' %t/b.log > %t/b.row
# RUN: diff %t/a.row %t/b.row
# RUN: grep 'INFO: *2000 ' %t/leap.log > %t/leap.row
# RUN: diff %t/a.row %t/leap.row

# The energy that the thermostat and the barostat exchange with the bath is
# added to the total energy, and the volume shrinks from 23.2^3 A^3. The
# energy that the scaling gives the positions is that of the scaled
# positions less that of the positions before, so the conserved energy
# changes as at constant energy (D77). Counted to first order in μ − 1, as
# GROMACS does, it drifts as the square of the strain, by about 2e-3 of its
# value here (design-m1.md, Section 11.4).
#
# CHECK:      INFO:      STEP {{.*}}PRESSURE      CONSERVED         VOLUME
# CHECK-NEXT: INFO:         0         0.0000 {{ *}}[[TOTAL:-[0-9.]+]] {{.*}} [[TOTAL]]     12487.1680
# CHECK-NEXT: INFO:      1000 {{.*}} {{11[0-9]{3}\.[0-9]+$}}
# CHECK-NEXT: INFO:      2000 {{.*}} {{11[0-9]{3}\.[0-9]+$}}
# CHECK:      MDIR: the conserved energy changed by {{[0-9.]+}}e-0{{[5-9]}} of its value
# FIRST:      MDIR: the conserved energy changed by {{[0-9.]+}}e-03 of its value

# Leapfrog takes the pressure from the velocities of the time of the
# positions, which its step of energy returns, couples those, and takes the
# forces of the scaled positions as velocity Verlet does: without
# constraints its trajectory is that of velocity Verlet (D76, D77).

# MODULE:      func.func private @mdrtBarostatStrain(
# MODULE:      func.call @mdrtSetBox(

#--- run.toml
[input]
pdbfile = "mixture.pdb"

[energy]
switchdist   = 7.5
cutoffdist   = 9.0
pairlistdist = 10.0

[[energy.pair]]
name       = "lj"
expression = "4*epsilon*((sigma/r)^12 - (sigma/r)^6)"
mixing     = "lorentz-berthelot"

[[energy.type]]
name    = "AR"
mass    = 39.95
epsilon = 0.238465
sigma   = 3.4

[[energy.type]]
name    = "KR"
mass    = 83.80
epsilon = 0.3253
sigma   = 3.65

[dynamics]
integrator        = "VVER"
timestep          = 0.004
nsteps            = 2000
eneout_period = 1000
thermostat_period = 10

[ensemble]
ensemble    = "NPT"
thermostat  = "BUSSI"
temperature = 100.0
tau_t       = 0.5
barostat    = "BERNETTI-BUSSI"
pressure    = 200.0
tau_p       = 2.0

[boundary]
type       = "PBC"
box_size_x = 23.2
box_size_y = 23.2
box_size_z = 23.2
#--- end
