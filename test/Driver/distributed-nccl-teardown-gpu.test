# REQUIRES: cuda, nccl
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/towers-one-step.toml %S/../../examples/argon/argon.pdb %t/
# RUN: sed -e 's/"TOWERS"/"MATRIX"/' -e 's/"MIXED"/"DOUBLE"/' -e 's/steps *= *1$/steps = 3/' %t/towers-one-step.toml > %t/run.toml
