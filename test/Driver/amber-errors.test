# Topologies of Amber that MDIR cannot run are rejected with a message that
# names what the file has.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/run.toml
# RUN: cp %S/Inputs/dipeptide/dipeptide.inpcrd %t

# CMAP with a map of another resolution than 24 points, which sander does
# not read right.
# RUN: cp %S/Inputs/dipeptide/dipeptide.prmtop %t/dipeptide.prmtop
# RUN: printf '%%%%FLAG CMAP_COUNT\n%%%%FORMAT(2I8)\n       1       1\n%%%%FLAG CMAP_RESOLUTION\n%%%%FORMAT(20I4)\n  36\n' >> %t/dipeptide.prmtop
# RUN: not mdir check %t/run.toml 2>&1 | FileCheck %s --check-prefix=CMAP
# CMAP: CMAP_RESOLUTION is 36; only maps of 24 points, as sander reads them, are supported

# 12-6-4 terms.
# RUN: cp %S/Inputs/dipeptide/dipeptide.prmtop %t/dipeptide.prmtop
# RUN: printf '%%%%FLAG LENNARD_JONES_CCOEF\n%%%%FORMAT(5E16.8)\n  0.00000000E+00\n' >> %t/dipeptide.prmtop
# RUN: not mdir check %t/run.toml 2>&1 | FileCheck %s --check-prefix=C4
# C4: 12-6-4 terms are not supported: LENNARD_JONES_CCOEF

# A section that MDIR does not know, with data.
# RUN: cp %S/Inputs/dipeptide/dipeptide.prmtop %t/dipeptide.prmtop
# RUN: printf '%%%%FLAG NEW_PHYSICS\n%%%%FORMAT(5E16.8)\n  1.00000000E+00\n' >> %t/dipeptide.prmtop
# RUN: not mdir check %t/run.toml 2>&1 | FileCheck %s --check-prefix=UNKNOWN
# UNKNOWN: the section NEW_PHYSICS is not known to MDIR and holds data that may change the physics

# Angles that make no cell (triclinic cells are read: triclinic-cell.test).
# RUN: cp %S/Inputs/dipeptide/dipeptide.prmtop %t/dipeptide.prmtop
# RUN: sed '$ s/  90.0000000  90.0000000  90.0000000/ 150.0000000 150.0000000 150.0000000/' %S/Inputs/dipeptide/dipeptide.inpcrd > %t/dipeptide.inpcrd
# RUN: not mdir check %t/run.toml 2>&1 | FileCheck %s --check-prefix=CELL
# CELL: the angles 150, 150, 150 do not make a cell

# A file of coordinates with another number of atoms.
# RUN: cp %S/Inputs/dipeptide/dipeptide.inpcrd %t/dipeptide.inpcrd
# RUN: sed -i '2 s/1168/1167/' %t/dipeptide.inpcrd
# RUN: not mdir check %t/run.toml 2>&1 | FileCheck %s --check-prefix=COUNT
# COUNT: the file has 1167 atoms, and the topology 1168

#--- run.toml
[input]
topology   = "dipeptide.prmtop"
coordinates = "dipeptide.inpcrd"

[energy]
cutoff       = 9.0
pairlist_distance = 10.0

[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.0005
steps      = 10

[boundary]
type = "PERIODIC"
#--- end
