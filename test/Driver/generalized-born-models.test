# RUN: sed -e '/^implicit_solvent/d' -e '/^surface_area_energy/d' %t/salt.toml > %t/stray.toml
# RUN: not mdir check %t/stray.toml 2>&1 | FileCheck %s --check-prefix=STRAY

# HCT:      MDIR:   generalized Born            -141.432807
# HCT-NEXT: MDIR:   nonpolar surface               9.508977
# HCT-PYTHON:      generalized Born -141.432807
# HCT-PYTHON-NEXT: nonpolar surface 9.508977
# HCT-PYTHON-NEXT: forces against differences of the energy: ok

# SALT:      MDIR:   generalized Born            -143.565200
# SALT-NEXT: MDIR:   nonpolar surface               8.214797
# SALT-PYTHON:      generalized Born -143.565200
# SALT-PYTHON-NEXT: nonpolar surface 8.214797
# SALT-PYTHON-NEXT: forces against differences of the energy: ok

# CUT:      MDIR:   generalized Born            -144.112309
# CUT-NEXT: MDIR:   nonpolar surface               8.389662
# CUT-PYTHON:      generalized Born -144.112309
# CUT-PYTHON-NEXT: nonpolar surface 8.389662
# CUT-PYTHON-NEXT: forces against differences of the energy: ok

# MBONDI2:      MDIR:   generalized Born            -143.479635
# MBONDI2-NEXT: MDIR:   nonpolar surface               8.214797

# ROUNDED:      MDIR:   generalized Born            -143.211170
# ROUNDED-NEXT: MDIR:   nonpolar surface               8.220448
# SAME: the columns agree

# RADII: generalized Born needs the radii and the screening of every particle, the sections RADII and SCREEN of a topology of Amber; for another topology give 'born_radii = "MBONDI2"'
# COLD: 'salt_concentration' screens with the Debye length at the temperature of [ensemble], which is 0 K
# FAR: 'born_radius_cutoff', 45 Å, is beyond the cutoff, 40 Å
# REACH: 'born_radius_cutoff' and the largest screened radius reach
# STRAY: 'salt_concentration' is for 'implicit_solvent'
