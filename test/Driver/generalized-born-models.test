# RUN: not mdir check %t/far.toml 2>&1 | FileCheck %s --check-prefix=FAR
# RUN: sed -e 's/^born_radius_cutoff = 8.0/born_radius_cutoff = 39.9/' %t/cut.toml > %t/reach.toml
