# RUN: sed -e 's/^temperature = 0.0/temperature = 300.0/' -e 's/plain.h5/plain300.h5/' %t/plain.toml > %t/plain300.toml
# RUN: cd %t && mdir run plain300.toml > plain300.log && mdir run salt.toml | FileCheck %s --check-prefix=SALT
# RUN: mdir checkpoint --print=forces %t/plain300.h5 > %t/plain300.forces
# RUN: mdir checkpoint --print=forces %t/salt.h5 > %t/salt.forces
# RUN: %python %S/Inputs/check_born.py %t/peptide.prmtop %t/peptide.inpcrd %t/plain300.forces %t/salt.forces --salt 0.15 --temperature 300 | FileCheck %s --check-prefix=SALT-PYTHON
#
# RUN: sed -e 's/^surface_area_energy = 0.0054/&\nborn_radius_cutoff = 8.0/' -e 's/born.h5/cut.h5/' %t/born.toml > %t/cut.toml
# RUN: cd %t && mdir run cut.toml | FileCheck %s --check-prefix=CUT
# RUN: mdir checkpoint --print=forces %t/cut.h5 > %t/cut.forces
# RUN: %python %S/Inputs/check_born.py %t/peptide.prmtop %t/peptide.inpcrd %t/plain.forces %t/cut.forces --radius-cutoff 8.0 | FileCheck %s --check-prefix=CUT-PYTHON
#
# RUN: sed -e 's/^surface_area_energy = 0.0054/&\nborn_radii = "MBONDI2"/' -e 's/born.h5/mbondi2.h5/' %t/born.toml > %t/mbondi2.toml
# RUN: cd %t && mdir run mbondi2.toml | FileCheck %s --check-prefix=MBONDI2
