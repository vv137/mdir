# A run at constant pressure with particle mesh Ewald and rigid water that
# continues from a checkpoint ends in the same state as one that does not
# stop: the automatic grid is that of the cell of the file of coordinates,
# not that of the checkpoint, which the barostat has changed.
#
# REQUIRES: hdf5
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/opc/opc.prmtop %S/Inputs/opc/opc.inpcrd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/whole.toml
# RUN: sed -e 's|^steps *= 200|steps = 100|' -e 's|whole.h5|first.h5|' \
# RUN:     %t/whole.toml > %t/first.toml
# RUN: sed -e 's|first.h5|second.h5|' \
# RUN:     -e 's|^coordinates = \(.*\)|coordinates = \1\ncheckpoint = "first.h5"|' \
# RUN:     %t/first.toml > %t/second.toml
# RUN: mdir run %t/whole.toml > %t/both.log
# RUN: mdir run %t/first.toml
# RUN: mdir run %t/second.toml >> %t/both.log
# RUN: FileCheck %s --check-prefix=LOG < %t/both.log
# RUN: mdir checkpoint %t/whole.h5 %t/second.h5 | FileCheck %s
# RUN: mdir emit %t/second.toml | FileCheck %s --check-prefix=GRID
#
# With the cell scaled every step (D92), the pressure of each scaling is
# that of the state that the step before left, which the checkpoint keeps.
#
# RUN: sed -e 's|^interval = 10|interval = 1|' -e 's|whole.h5|whole1.h5|' %t/whole.toml > %t/whole1.toml
# RUN: sed -e 's|^interval = 10|interval = 1|' -e 's|first.h5|first1.h5|' %t/first.toml > %t/first1.toml
# RUN: sed -e 's|^interval = 10|interval = 1|' -e 's|first.h5|first1.h5|' -e 's|second.h5|second1.h5|' %t/second.toml > %t/second1.toml
# RUN: mdir run %t/whole1.toml > %t/both1.log
# RUN: mdir run %t/first1.toml
# RUN: mdir run %t/second1.toml >> %t/both1.log
# RUN: FileCheck %s --check-prefix=LOG < %t/both1.log
# RUN: mdir checkpoint %t/whole1.h5 %t/second1.h5 | FileCheck %s

# CHECK: the states are identical

# LOG:      INFO:       150         0.3000 {{ *}}[[ROW:-?[0-9.]+ +-?[0-9.]+ +-?[0-9.]+ +-?[0-9.]+ +-?[0-9.]+ +-?[0-9.]+]] {{ *}}{{-?[0-9.]+}} {{ *}}[[VOLUME:[0-9.]+]]
# LOG:      MDIR: continues after step 100
# LOG:      INFO:       150         0.3000 {{ *}}[[ROW]] {{ *}}{{-?[0-9.]+}} {{ *}}[[VOLUME]]

# The spacing puts the edge along z, 25.1596 Å, 24.01 spacings long: 28
# points, where the cell of the checkpoint, a little shorter, would give 24.
#
# GRID: grid([28, 28, 28])

#--- run.toml
[input]
topology   = "opc.prmtop"
coordinates = "opc.inpcrd"

[output]
checkpoint = "whole.h5"
energy_interval = 50
checkpoint_interval = 100

[energy]
cutoff        = 9.0
pairlist_distance = 10.0
electrostatics = "PME"
coulomb_modifier     = "POTENTIAL_SHIFT"

[pme]
max_spacing = 1.0479


[dynamics]
integrator        = "VELOCITY_VERLET"
time_step         = 0.002
steps             = 200

[ensemble]
ensemble    = "NPT"
temperature = 300.0
pressure    = 1.0

[thermostat]
method = "V-RESCALE"
interval = 10
time_constant = 0.5

[barostat]
method = "C-RESCALE"
time_constant = 1.0

[constraints]
rigid_water = true

[boundary]
type = "PERIODIC"
#--- end
