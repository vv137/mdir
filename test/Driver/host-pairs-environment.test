# The host's variables of the lanes of the pair rows (D[host-pair-vector],
# docs/environment.md), checked by the driver before anything is lowered.
#
# 1. MDIR_HOST_CPU names a 64-bit CPU that LLVM's X86 back end knows. An
#    unknown name, or `native`, is an error of the input, which names it.
# 2. The width of a named CPU counts every feature that its own imply:
#    x86-64 is SSE2 (128 bits), x86-64-v3 AVX2 (256), x86-64-v4 AVX-512 (512),
#    as haswell and skylake-avx512 are.
# 3. The machine that compiles the host code is that CPU's: `mdir doctor`
#    reports the CPU and the AVX features of compiler::createHostMachine, so
#    x86-64 reaches the code generator without AVX.
# 4. MDIR_HOST_PAIRS is scalar, lanes, or lanes:W with W a power of two
#    from 1 to 64. Anything else, including a value that would splice text
#    into the pipeline, is an error of the input from `mdir emit`, `mdir
#    run`, and Python, not a failure of a pass.
# 5. The GPU target runs no chooser of the host's lanes.
#
# REQUIRES: host-x86
#
# RUN: rm -rf %t && mkdir -p %t && cd %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > run.toml
# RUN: %python %S/Inputs/argon_lattice.py 8 argon.pdb
# RUN: sed 's|"CPU"|"GPU"|' run.toml > gpu.toml
#
# RUN: not env MDIR_HOST_CPU=bogus mdir emit run.toml --stage=pipeline 2>&1 | FileCheck %s --check-prefix=BADCPU
# RUN: not env MDIR_HOST_CPU=native mdir emit run.toml --stage=pipeline 2>&1 | FileCheck %s --check-prefix=NATIVE
# RUN: not env MDIR_HOST_CPU=bogus mdir run run.toml 2>&1 | FileCheck %s --check-prefix=BADCPU
# RUN: env MDIR_HOST_CPU=x86-64 mdir emit run.toml --stage=pipeline | FileCheck %s --check-prefix=SSE2
# RUN: env MDIR_HOST_CPU=x86-64-v3 mdir emit run.toml --stage=pipeline | FileCheck %s --check-prefix=V3
# RUN: env MDIR_HOST_CPU=x86-64-v4 mdir emit run.toml --stage=pipeline | FileCheck %s --check-prefix=V4
# RUN: env MDIR_HOST_CPU=haswell mdir emit run.toml --stage=pipeline | FileCheck %s --check-prefix=HASWELL
# RUN: env MDIR_HOST_CPU=skylake-avx512 mdir emit run.toml --stage=pipeline | FileCheck %s --check-prefix=SKYLAKE
#
# RUN: env MDIR_HOST_CPU=x86-64 mdir doctor --target=cpu | FileCheck %s --check-prefix=DOCTOR-SSE2
# RUN: env MDIR_HOST_CPU=x86-64-v3 mdir doctor --target=cpu | FileCheck %s --check-prefix=DOCTOR-V3
# RUN: not env MDIR_HOST_CPU=bogus mdir doctor --target=cpu | FileCheck %s --check-prefix=DOCTOR-BAD
#
# RUN: not env MDIR_HOST_PAIRS=fast mdir emit run.toml --stage=pipeline 2>&1 | FileCheck %s --check-prefix=PAIRS -DVALUE=fast
# RUN: not env MDIR_HOST_PAIRS=lanes:3 mdir emit run.toml --stage=pipeline 2>&1 | FileCheck %s --check-prefix=PAIRS -DVALUE=lanes:3
# RUN: not env MDIR_HOST_PAIRS=lanes:128 mdir emit run.toml --stage=pipeline 2>&1 | FileCheck %s --check-prefix=PAIRS -DVALUE=lanes:128
# RUN: not env MDIR_HOST_PAIRS=lanes:-4 mdir emit run.toml --stage=pipeline 2>&1 | FileCheck %s --check-prefix=PAIRS -DVALUE=lanes:-4
# RUN: not env MDIR_HOST_PAIRS=lanes:0 mdir emit run.toml --stage=pipeline 2>&1 | FileCheck %s --check-prefix=PAIRS -DVALUE=lanes:0
# RUN: not env MDIR_HOST_PAIRS=lanes:abc mdir emit run.toml --stage=pipeline 2>&1 | FileCheck %s --check-prefix=PAIRS -DVALUE=lanes:abc
# RUN: not env 'MDIR_HOST_PAIRS=scalar},canonicalize{' mdir emit run.toml --stage=pipeline 2>&1 | FileCheck %s --check-prefix=PAIRS '-DVALUE=scalar},canonicalize{'
# RUN: not env MDIR_HOST_PAIRS=fast mdir run run.toml 2>&1 | FileCheck %s --check-prefix=PAIRS -DVALUE=fast
# RUN: env MDIR_HOST_PAIRS=lanes:16 mdir emit run.toml --stage=pipeline | FileCheck %s --check-prefix=SIXTEEN
# RUN: not ls %t/*reproducer*
#
# RUN: mdir emit gpu.toml --stage=pipeline | FileCheck %s --check-prefix=GPU

# BADCPU: MDIR_HOST_CPU='bogus' is not a 64-bit CPU that LLVM's X86 back end knows, such as x86-64, x86-64-v3, or znver3
# NATIVE: MDIR_HOST_CPU='native' is not a 64-bit CPU
# SSE2: md-exec-choose-host-pairs{mode=scalar cpu=x86-64 vector-bits=128}
# V3: md-exec-choose-host-pairs{mode=scalar cpu=x86-64-v3 vector-bits=256}
# V4: md-exec-choose-host-pairs{mode=scalar cpu=x86-64-v4 vector-bits=512}
# HASWELL: md-exec-choose-host-pairs{mode=scalar cpu=haswell vector-bits=256}
# SKYLAKE: md-exec-choose-host-pairs{mode=scalar cpu=skylake-avx512 vector-bits=512}
# DOCTOR-SSE2: host code: cpu x86-64, avx no, avx512f no
# DOCTOR-V3: host code: cpu x86-64-v3, avx yes, avx512f no
# DOCTOR-BAD: FAIL host code: MDIR_HOST_CPU='bogus' is not a 64-bit CPU
# PAIRS: MDIR_HOST_PAIRS='[[VALUE]]' is not scalar, lanes, or lanes:W with W a power of two from 1 to 64
# PAIRS-NOT: defect
# SIXTEEN: md-exec-choose-host-pairs{mode=lanes width=16 cpu=
# GPU-NOT: choose-host-pairs
# GPU: convert-md-exec-to-gpu

#--- run.toml
[input]
coordinates = "argon.pdb"

[output]
energy_interval = 2

[energy]
cutoff = 9.0

[[energy.pair]]
name       = "lj"
expression = "4*epsilon*((sigma/r)^12 - (sigma/r)^6)"
mixing     = "lorentz-berthelot"

[[energy.type]]
name    = "AR"
mass    = 39.95
epsilon = 0.238465
sigma   = 3.4

[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.002
steps      = 2

[ensemble]
ensemble = "NVE"

[boundary]
type = "PERIODIC"
box  = [30.4, 30.4, 30.4]

[execution]
target = "CPU"
#--- end
