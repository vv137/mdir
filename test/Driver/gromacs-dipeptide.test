# The dipeptide of amber.test, converted to the format of GROMACS with
# ParmEd (Inputs/dipeptide/dipeptide.top, and dipeptide.gro with six
# decimals). Read with the reader of GROMACS, its terms agree with those
# that the reader of Amber gives (Inputs/dipeptide/amber-terms.txt), to the
# digits that ParmEd writes the parameters with.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %S/Inputs/dipeptide/dipeptide.top %S/Inputs/dipeptide/dipeptide.gro %t
# RUN: sed -n '/^#--- run.toml/,/^#--- end/p' %s | sed '1d;$d' > %t/run.toml
# RUN: mdir run %t/run.toml | %python %S/Inputs/check_terms.py %S/Inputs/dipeptide/amber-terms.txt 2e-6 3e-4 | FileCheck %s

# CHECK:      Lennard-Jones 1
# CHECK-NEXT: Coulomb 1
# CHECK-NEXT: bonds 1
# CHECK-NEXT: angles 1
# CHECK-NEXT: dihedrals 1
# CHECK-NEXT: Lennard-Jones 1-4 1
# CHECK-NEXT: Coulomb 1-4 1
# CHECK-NEXT: dispersion 1

# Without -DFLEXIBLE the waters have SETTLE, and without a statement that
# the run is flexible that is an error.
#
# RUN: sed -e '/^\[constraints\]/,/^rigid_water/d' -e '/^defines/d' %t/run.toml > %t/rigid.toml
# RUN: not mdir check %t/rigid.toml 2>&1 | FileCheck %s --check-prefix=SETTLE
# SETTLE: the topology has 382 waters with SETTLE; set 'rigid_water = true' in [constraints] to constrain them, or 'rigid_water = false' to run them flexible, with their bonds

# With 'rigid_water = true' SETTLE keeps them rigid: three degrees of freedom
# fewer for each, 3 × 1168 − 3 × 382 − 3.
#
# RUN: printf '[constraints]\nrigid_water = true\n' >> %t/rigid.toml
# RUN: mdir check %t/rigid.toml | FileCheck %s --check-prefix=RIGID
# RIGID: degrees of freedom: 2355

#--- run.toml
[input]
topology   = "dipeptide.top"
coordinates = "dipeptide.gro"
defines    = ["FLEXIBLE"]

[output]
energy_interval = 0
[energy]
cutoff       = 9.0
pairlist_distance = 10.0

[constraints]
hydrogen_bonds = false
rigid_water = false

[dynamics]
integrator    = "VELOCITY_VERLET"
time_step     = 0.0005
steps         = 0

[ensemble]
ensemble    = "NVE"
temperature = 300.0

[boundary]
type = "PERIODIC"
#--- end
