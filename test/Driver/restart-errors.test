# What is wrong with a checkpoint, or with the way a control file asks for
# one.
#
# REQUIRES: hdf5
#
# RUN: sed -e 's|Inputs/|%S/Inputs/|' \
# RUN:     -e 's|^steps *= 200|steps = 100|' \
# RUN:     %S/mixture.toml > %t.first.toml
# RUN: echo 'checkpoint = "%t.first.h5"' >> %t.first.toml
# RUN: echo 'checkpoint_interval = 100' >> %t.first.toml
# RUN: mdir run --overwrite %t.first.toml

# The velocities of leapfrog are half a step behind those of velocity
# Verlet.
#
# RUN: sed -e 's|"VELOCITY_VERLET"|"LEAPFROG"|' -e 's|%t.first.h5|%t.other.h5|' \
# RUN:     -e 's|^coordinates = \(.*\)|coordinates = \1\ncheckpoint = "%t.first.h5"|' \
# RUN:     %t.first.toml > %t.integrator.toml
# RUN: not mdir run %t.integrator.toml 2>&1 \
# RUN: | FileCheck %s --check-prefix=INTEGRATOR
# INTEGRATOR: was written with the integrator VELOCITY_VERLET, and the run uses LEAPFROG

# RUN: sed -e 's|^box = \[23.2,|box = [23.3,|' \
# RUN:     -e 's|%t.first.h5|%t.other.h5|' \
# RUN:     -e 's|^coordinates = \(.*\)|coordinates = \1\ncheckpoint = "%t.first.h5"|' \
# RUN:     %t.first.toml > %t.box.toml
# RUN: mdir run --overwrite %t.box.toml 2>&1 >/dev/null | FileCheck %s --check-prefix=BOX
# RUN: mdir checkpoint %t.other.h5 | FileCheck %s --check-prefix=BOXED
# A run takes the cell of the checkpoint it continues, which a barostat may
# have changed, and always warns if the input has another.
# BOX: mdir: warning: the cell of '{{.*}}.first.h5', 23.2000 23.2000 23.2000 Å, differs from that of the input, 23.3000 23.2000 23.2000 Å; the run takes that of the checkpoint
# BOXED: box: {{ *}}2.32 2.32 2.32 nm

# RUN: sed -e 's|%t.first.h5|%t.other.h5|' \
# RUN:     -e 's|^coordinates = \(.*\)|coordinates = \1\ncheckpoint = "%t.missing.h5"|' \
# RUN:     %t.first.toml > %t.missing.toml
# RUN: not mdir run %t.missing.toml 2>&1 | FileCheck %s --check-prefix=MISSING
# MISSING: cannot read '{{.*}}.missing.h5' as an HDF5 file

