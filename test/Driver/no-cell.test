# Runs without a periodic cell (D142): `type = "NONE"` in [boundary] puts
# the particles in a cell around them that keeps every image beyond the
# reach of the neighbor structures, and stops the run if they spread so far
# that one could come within it. The peptide of cmap.test, alone in its cell
# of 60 Å with a cutoff of 28 Å that no pair reaches, has the same terms and
# forces without a cell; given a drift of 600 Å/ps it leaves the cell placed
# around it, 97 Å, after 0.2 ps, and the energies and positions are those of
# the periodic run. Two atoms flying apart stop the run at the first
# checkpoint after they spread too far, or without checkpoints at the
# first row of the log. A run continued from its
# checkpoints is the one that was not interrupted, byte for byte, its
# trajectories without a cell.
#
# REQUIRES: hdf5
#
# RUN: rm -rf %t && mkdir -p %t && split-file %s %t
# RUN: cp %S/Inputs/ff19sb/vacuum.prmtop %S/Inputs/ff19sb/vacuum.inpcrd %t
# RUN: sed -e 's/periodic/none/' -e 's/^type = "PERIODIC"/type = "NONE"/' -e '/^dispersion_correction/d' %t/periodic.toml > %t/none.toml
# RUN: cd %t && mdir run periodic.toml > periodic.log && mdir run none.toml > none.log
# RUN: FileCheck %s --check-prefixes=TERMS,PERIODIC < %t/periodic.log
# RUN: FileCheck %s --check-prefixes=TERMS,NONE < %t/none.log
# RUN: mdir checkpoint --print=forces %t/periodic.h5 > %t/periodic.forces
# RUN: mdir checkpoint --print=forces %t/none.h5 > %t/none.forces
# RUN: %python %S/Inputs/compare_columns.py %t/periodic.forces %t/none.forces 1e-9 | FileCheck %s --check-prefix=SAME
#
# RUN: %python %S/Inputs/add_drift.py %t/vacuum.inpcrd %t/drift.rst7 500 300 -200
# RUN: sed -e 's/vacuum.inpcrd/drift.rst7/' -e 's/periodic.h5/drift-periodic.h5/' -e 's/^steps         = 1$/steps         = 2000/' -e 's/= 1$/= 2000/' -e 's/^time_step     = 1e-9/time_step     = 0.0001/' %t/periodic.toml > %t/drift-periodic.toml
# RUN: sed -e 's/drift-periodic/drift-none/' -e 's/^type = "PERIODIC"/type = "NONE"/' -e '/^dispersion_correction/d' %t/drift-periodic.toml > %t/drift-none.toml
# RUN: cd %t && mdir run drift-periodic.toml | FileCheck %s --check-prefix=DRIFT
# RUN: cd %t && mdir run drift-none.toml | FileCheck %s --check-prefix=DRIFT
# RUN: mdir checkpoint --print=positions %t/drift-periodic.h5 > %t/drift-periodic.positions
# RUN: mdir checkpoint --print=positions %t/drift-none.h5 > %t/drift-none.positions
# RUN: %python %S/Inputs/compare_columns.py %t/drift-periodic.positions %t/drift-none.positions 1e-12 | FileCheck %s --check-prefix=SAME
#
# RUN: cd %t && not mdir run two.toml 2>&1 | FileCheck %s --check-prefix=SPREAD
# RUN: sed -e '/^checkpoint/d' -e 's/^energy_interval = 25/energy_interval = 5/' %t/two.toml > %t/rows.toml
# RUN: cd %t && not mdir run rows.toml 2>&1 | FileCheck %s --check-prefix=SPREAD
#
# RUN: sed -e 's/none.h5/whole.h5/' -e 's/^steps         = 1$/steps         = 400/' -e 's/= 1$/= 100/' -e 's/^time_step     = 1e-9/time_step     = 0.0002/' -e 's/^\[output\]/[output]\ntrajectory = "whole.dcd"\ntrajectory_interval = 50/' %t/none.toml > %t/whole.toml
# RUN: sed -e 's/whole/part/g' %t/whole.toml > %t/part.toml
# RUN: sed -e 's/whole.dcd/whole.xtc/' -e 's/whole.h5/frames.h5/' %t/whole.toml > %t/frames.toml
# RUN: cd %t && mdir run whole.toml > /dev/null && mdir run frames.toml > /dev/null
# RUN: %python %S/Inputs/exit_status.py mdir run --continue --max-walltime 0.000001 %t/part.toml > /dev/null
# RUN: %python %S/Inputs/exit_status.py mdir run --continue --max-walltime 0.000001 %t/part.toml > /dev/null
# RUN: mdir run --continue %t/part.toml > /dev/null
# RUN: mdir checkpoint %t/whole.h5 %t/part.h5 | FileCheck %s --check-prefix=IDENTICAL
# RUN: cmp %t/whole.dcd %t/part.dcd
# RUN: %python %S/Inputs/check_no_cell_frames.py %t/whole.dcd %t/whole.xtc | FileCheck %s --check-prefix=FRAMES
#
# RUN: sed -e 's/^electrostatics = "CUTOFF"/electrostatics = "PME"/' %t/none.toml > %t/pme.toml
# RUN: not mdir check %t/pme.toml 2>&1 | FileCheck %s --check-prefix=PME
# RUN: sed -e 's/^electrostatics = "CUTOFF"/&\ndispersion_correction = "ENERGY_PRESSURE"/' %t/none.toml > %t/dispersion.toml
# RUN: not mdir check %t/dispersion.toml 2>&1 | FileCheck %s --check-prefix=DISPERSION
# RUN: sed -e 's/^type = "NONE"/&\nbox = [60.0, 60.0, 60.0]/' %t/none.toml > %t/box.toml
# RUN: not mdir check %t/box.toml 2>&1 | FileCheck %s --check-prefix=BOX
# RUN: sed -e 's/^type = "NONE"/type = "PERIODIC"/' %t/two.toml > %t/two-periodic.toml
# RUN: cd %t && not mdir run two-periodic.toml 2>&1 | FileCheck %s --check-prefix=NOCELL

# NONE:       MDIR: no periodic cell; the particles are in a cell of 96.8242 100.8039 90.0210 Å, whose images stay beyond the reach of the neighbor structures, 29.0000 Å, while the particles spread less than 67.8242 71.8039 61.0210 Å (D142)
# PERIODIC:   INFO:      STEP           TIME      TOTAL_ENE  POTENTIAL_ENE    KINETIC_ENE    TEMPERATURE         VIRIAL       PRESSURE
# NONE:       INFO:      STEP           TIME      TOTAL_ENE  POTENTIAL_ENE    KINETIC_ENE    TEMPERATURE         VIRIAL{{$}}
# TERMS:      MDIR:   Lennard-Jones                  9.710233
# TERMS-NEXT: MDIR:   Coulomb                     -213.951939
# TERMS-NEXT: MDIR:   bonds                          0.148913
# TERMS-NEXT: MDIR:   angles                         0.687548
# TERMS-NEXT: MDIR:   dihedrals                      4.668195
# TERMS-NEXT: MDIR:   Lennard-Jones 1-4             11.303110
# TERMS-NEXT: MDIR:   Coulomb 1-4                  164.940916
# TERMS-NEXT: MDIR:   CMAP                           0.096326
# TERMS-NEXT: MDIR:   dispersion                     0.000000
# TERMS-NEXT: MDIR:   total                        -22.396697
# TERMS-NEXT: MDIR: the diagonal of the virial
# TERMS-NEXT: MDIR:          60.139361       225.143639        63.922041
# SAME:      the columns agree

# DRIFT:      INFO:         0         0.0000    130902.3160       -22.3967    130924.7127   1126220.0514       349.2050
# DRIFT:      INFO:      2000         0.2000    130902.3157       -29.7560    130932.0717   1126283.3520       101.6910
# DRIFT:      MDIR: the total energy changed by 2.043e-09 of its value

# SPREAD: mdir: at step 25 the particles spread 28.9999 Å along x, more than the cell around them less the reach of the neighbor structures, 24.0000 Å; images of the particles would interact. The run stops; begin it again with a larger 'pairlist_distance', which places a larger cell (D142)

# IDENTICAL: the states are identical
# FRAMES:      DCD: cell flag 0, 8 frames of positions alone: ok
# FRAMES-NEXT: XTC: 8 frames with a cell of zeros: ok

# PME: particle mesh Ewald needs a periodic cell; without one, give 'electrostatics = "CUTOFF"' or "REACTION_FIELD"
# DISPERSION: the correction for the dispersion takes a density, which a run without a periodic cell has not; give 'dispersion_correction = "NONE"'
# BOX: a run without a periodic cell takes no 'box'
# NOCELL: the file of coordinates has no periodic cell; for a run without one give 'type = "NONE"' in [boundary]

#--- periodic.toml
[input]
topology    = "vacuum.prmtop"
coordinates = "vacuum.inpcrd"
[output]
energy_interval = 1
checkpoint = "periodic.h5"
checkpoint_interval = 1
[energy]
cutoff            = 28.0
pairlist_distance = 29.0
electrostatics = "CUTOFF"
dispersion_correction = "NONE"
[dynamics]
integrator    = "VELOCITY_VERLET"
time_step     = 1e-9
steps         = 1
[ensemble]
ensemble    = "NVE"
temperature = 300.0
[boundary]
type = "PERIODIC"
#--- two.toml
[input]
topology    = "two.top"
coordinates = "two.gro"
[output]
energy_interval = 25
checkpoint = "two.h5"
checkpoint_interval = 25
[energy]
cutoff            = 9.0
pairlist_distance = 10.0
electrostatics    = "CUTOFF"
[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.001
steps      = 100
[ensemble]
ensemble    = "NVE"
temperature = 300.0
[boundary]
type = "NONE"
#--- two.top
[ defaults ]
1 2 no 1.0 1.0
[ atomtypes ]
AR 18 39.948 0.0 A 0.34 0.996
[ moleculetype ]
AR 1
[ atoms ]
1 AR 1 AR AR 1 0.0 39.948
[ system ]
two argon atoms
[ molecules ]
AR 2
#--- two.gro
Two argon atoms flying apart, without a cell
    2
    1AR      AR    1   1.000   1.000   1.000-50.0000   0.0000   0.0000
    2AR      AR    2   1.400   1.000   1.000  50.0000   0.0000   0.0000
   0.00000   0.00000   0.00000
