# The correction for the dispersion of a topology includes the tail beyond
# the cutoff of every [[energy.pair]] term, over the pairs its groups select
# (D209). On a mixture of 60 A and 60 B
# (pair_tail_system.py): an NBFIX of the A-B pair written as a correction
# term, u(sigma', epsilon') - u(sigma, epsilon), against the topology with
# the same pair in [ nonbond_params ]; and a term -c8/r^8 - a exp(-r/l)/r^4
# that is not a Lennard-Jones. check_pair_tail.py integrates the tails by
# Simpson's rule in ln r: the dispersion line of each run matches it to the
# printed digits, and the correction term gives the energy, the virial, and
# the pressure of [ nonbond_params ] up to the tail of the repulsion of the
# correction (2.7e-4 kcal/mol here), which the topology's correction leaves
# out, as Amber and GROMACS do.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: %python %S/Inputs/pair_tail_system.py %t 60 60 32 3.7 0.5
# RUN: sed -n '/^#--- run.toml/,/^#--- terms/p' %s | sed '1d;$d' > %t/base.toml
# RUN: sed -e 's/TOPOLOGY/plain.top/' %t/base.toml > %t/plain.toml
# RUN: sed -e 's/TOPOLOGY/fixed.top/' %t/base.toml > %t/fixed.toml
# RUN: sed -n '/^#--- nbfix/,/^#--- r8/p' %s | sed '1d;$d' > %t/nbfix.term
# RUN: sed -n '/^#--- r8/,/^#--- lambda/p' %s | sed '1d;$d' > %t/r8.term
# RUN: cat %t/plain.toml %t/nbfix.term > %t/nbfix.toml
# RUN: cat %t/plain.toml %t/r8.term > %t/r8.toml
# RUN: sed -n '/^#--- lambda/,/^#--- observe/p' %s | sed '1d;$d' > %t/lambda.term
# RUN: sed -n '/^#--- observe/,/^#--- end/p' %s | sed '1d;$d' > %t/observe.term
# RUN: sed -e 's/^energy_interval = 1/&\nfree_energy = "lambda.dhdl"/' %t/plain.toml > %t/lambda.head
# RUN: cat %t/lambda.head %t/lambda.term > %t/lambda.toml
# RUN: sed -e 's/^energy_interval = 1/&\nobservables = "observe.obs"/' %t/plain.toml > %t/observe.head
# RUN: cat %t/observe.head %t/observe.term > %t/observe.toml
# RUN: sed -e 's/^dispersion_correction = "ENERGY_PRESSURE"/dispersion_correction = "NONE"/' -e 's/lambda.dhdl/lambda-off.dhdl/' %t/lambda.toml > %t/lambda-off.toml
# RUN: sed -e 's/^dispersion_correction = "ENERGY_PRESSURE"/dispersion_correction = "NONE"/' -e 's/observe.obs/observe-off.obs/' %t/observe.toml > %t/observe-off.toml
# RUN: cd %t && mdir run plain.toml > plain.log && mdir run fixed.toml > fixed.log
# RUN: cd %t && mdir run nbfix.toml > nbfix.log && mdir run r8.toml > r8.log
# RUN: %python %S/Inputs/check_pair_tail.py %t 2e-6 plain fixed nbfix r8 | FileCheck %s
#
# The tails enter the energies of the states of [free_energy] and dH/dlambda
# of a term in lambda, and the columns of `observe` of a term, its energy
# and its derivatives in its constants. These are of the potential shifted
# to 0 at the cutoff (D210), so with the correction on and
# off they differ by the tail and the estimate of the shift,
# (4 pi / 3V) r_c^3 u(r_c) a pair, and their derivatives, which
# check_pair_tail.py writes out by hand.
# RUN: cd %t && mdir run lambda.toml > lambda.log && mdir run lambda-off.toml > lambda-off.log
# RUN: cd %t && mdir run observe.toml > observe.log && mdir run observe-off.toml > observe-off.log
# RUN: %python %S/Inputs/check_pair_tail.py %t 2e-6 derivatives | FileCheck %s --check-prefix=DERIVATIVES
#
# A tail that diverges, or a term of the time, is refused when the control
# file asks for the correction, naming the term; with its own
# 'dispersion_correction = "NONE"' the term is left out, and the run has the
# dispersion line of the topology alone.
# RUN: sed -e 's|^expression = "-c8.*|expression = "-c8/r^3"|' %t/r8.toml > %t/diverges.toml
# RUN: not mdir check %t/diverges.toml 2>&1 | FileCheck %s --check-prefix=DIVERGES
# RUN: sed -e 's|^expression = "-c8.*|expression = "-c8/r^8*(1 + t)"|' %t/r8.toml > %t/time.toml
# RUN: not mdir check %t/time.toml 2>&1 | FileCheck %s --check-prefix=TIME
# RUN: sed -e 's|^name       = "r8"|&\ndispersion_correction = "NONE"|' %t/diverges.toml > %t/out.toml
# RUN: cd %t && mdir run out.toml | FileCheck %s --check-prefix=OUT
#
# Under POTENTIAL_SHIFT the correction adds the estimate of the shift to the
# tail, with no virial (D210): each pair within the
# cutoff loses u(r_c), with rho (4 pi/3) r_c^3 - 1 neighbors a particle,
# itself left out. For the topology's r^-6 part that is the tail times
# 1 - V / (N (4 pi/3) r_c^3): -3.472644 kcal/mol here, the "Disper. corr."
# of GROMACS 2026.3 with Potential-shift and EnerPres on these coordinates
# (-14.529543 kJ/mol). The correction term adds its whole u(r_c), so it
# differs from [ nonbond_params ] by the repulsion's tail and shift. A switch
# stays refused. With the correction off, the correction term gives the
# topology of [ nonbond_params ] exactly.
# RUN: sed -e 's/^lennard_jones_modifier = "NONE"/lennard_jones_modifier = "POTENTIAL_SHIFT"/' %t/nbfix.toml > %t/shift.toml
# RUN: sed -e 's/^lennard_jones_modifier = "NONE"/lennard_jones_modifier = "POTENTIAL_SHIFT"/' %t/fixed.toml > %t/fixed-shift.toml
# RUN: cd %t && mdir run shift.toml > nbfix-shift.log && mdir run fixed-shift.toml > fixed-shift.log
# RUN: %python %S/Inputs/check_pair_tail.py %t 2e-6 fixed-shift nbfix-shift | FileCheck %s --check-prefix=SHIFT
# RUN: sed -e 's/^lennard_jones_modifier = "NONE"/lennard_jones_modifier = "FORCE_SWITCH"\nswitch_distance = 10.0/' %t/nbfix.toml > %t/switch.toml
# RUN: not mdir check %t/switch.toml 2>&1 | FileCheck %s --check-prefix=SWITCH
# RUN: sed -e 's/^dispersion_correction = "ENERGY_PRESSURE"/dispersion_correction = "NONE"/' %t/shift.toml > %t/shift-off.toml
# RUN: sed -e 's/^lennard_jones_modifier = "NONE"/lennard_jones_modifier = "POTENTIAL_SHIFT"/' -e 's/^dispersion_correction = "ENERGY_PRESSURE"/dispersion_correction = "NONE"/' %t/fixed.toml > %t/fixed-off.toml
# RUN: cd %t && mdir run shift-off.toml | grep '^INFO: *0 ' > shift-off.row && mdir run fixed-off.toml | grep '^INFO: *0 ' > fixed-off.row
# RUN: cmp %t/shift-off.row %t/fixed-off.row

# CHECK:      plain: dispersion -0.789900
# CHECK:      fixed: dispersion -1.769704
# CHECK:      nbfix: dispersion -1.769378
# CHECK:      r8: dispersion -0.823726
# CHECK:      nbfix - fixed: repulsion tail 3.2{{[0-9]+}}e-04
# CHECK-NEXT: tails: ok

# DERIVATIVES:      dHdl.s: tail
# DERIVATIVES:      nbfix.energy: tail
# DERIVATIVES:      derivatives: ok

# DIVERGES: the correction for the dispersion integrates the pair term 'r8' beyond the cutoff, and its tail diverges (its energy must decay faster than 1/r^3); give 'dispersion_correction = "NONE"' in the term to leave it out
# TIME: the correction for the dispersion integrates the pair term 'r8' beyond the cutoff, and its expression depends on the time t; give 'dispersion_correction = "NONE"' in the term to leave it out
# OUT: MDIR:   dispersion -0.789900
# SHIFT:      fixed-shift: dispersion -3.472644
# SHIFT:      nbfix-shift: dispersion -3.471377
# SHIFT:      nbfix-shift - fixed-shift: repulsion tail 1.2{{[0-9]+}}e-03
# SHIFT-NEXT: tails: ok
# SWITCH: the correction for the dispersion needs a plain cutoff or "POTENTIAL_SHIFT"; with a switch, give 'dispersion_correction = "NONE"'

#--- run.toml
[input]
topology    = "TOPOLOGY"
coordinates = "system.gro"
[output]
energy_interval = 1
[energy]
cutoff            = 12.0
pairlist_distance = 13.0
electrostatics    = "CUTOFF"
lennard_jones_modifier = "NONE"
dispersion_correction = "ENERGY_PRESSURE"
[dynamics]
integrator = "VELOCITY_VERLET"
time_step  = 0.001
steps      = 1
[ensemble]
ensemble    = "NVE"
temperature = 0.0
[boundary]
type = "PERIODIC"
[execution]
target    = "CPU"
precision = "DOUBLE"
#--- terms
#--- nbfix
[[energy.pair]]
name       = "nbfix"
groups     = [":A", ":B"]
expression = "4*eps*((sig/r)^12 - (sig/r)^6) - 4*epsilon*((sigma/r)^12 - (sigma/r)^6)"
sig = 3.7
eps = 0.5
#--- r8
[[energy.pair]]
name       = "r8"
groups     = [":A", ":A,B"]
expression = "-c8/r^8 - a*exp(-r/l)/r^4"
c8 = 2.0e4
a  = 0.8
l  = 3.0
#--- lambda
[[energy.pair]]
name       = "r8"
groups     = [":A", ":A,B"]
expression = "-lambda_s*c8/r^8"
c8 = 2.0e4
[free_energy]
state = 1
[free_energy.lambdas]
s = [0.0, 0.5, 1.0]
#--- observe
[[energy.pair]]
name       = "nbfix"
groups     = [":A", ":B"]
expression = "4*eps*((sig/r)^12 - (sig/r)^6) - 4*epsilon*((sigma/r)^12 - (sigma/r)^6)"
observe    = ["sig", "eps"]
sig = 3.7
eps = 0.5
#--- end
