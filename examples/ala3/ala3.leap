# Tri-alanine, zwitterionic (NALA-ALA-CALA), with ff19SB in OPC water in a
# cubic box 10 Å beyond the peptide. Made with tleap of AmberTools:
#
#   tleap -f ala3.leap
source leaprc.protein.ff19SB
source leaprc.water.opc
m = sequence { NALA ALA CALA }
solvateBox m OPCBOX 10.0 iso
saveAmberParm m ala3.prmtop ala3.inpcrd
quit
